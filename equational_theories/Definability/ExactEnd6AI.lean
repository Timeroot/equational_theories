/-- The arguments as one mixed-radix index, which is how `rankArr6AI` is addressed. -/
def encT6AI (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2) : Nat :=
  a.1 * 5184 +
    b.1 * 1728 +
    c.1 * 576 +
    d.1 * 144 +
    e.1 * 48 +
    f.1 * 24 +
    g.1 * 12 +
    h.1 * 4 +
    i.1 * 2 +
    j.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank6AI (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    : Fin 2 :=
  ⟨min (rankArr6AI.getD (encT6AI a b c d e f g h i j) 0) 1, by omega⟩


/-- `2` of the `420` demanded maps and `2` of the `46236` forbidden ones, enough to separate the `2`
members from the other `15550` invariant tuples between them. The certificate still demands and
forbids all `46656`; these are the lists `mem_rank6AI` scans, once per tuple, with a scan that is
quadratic in their length. -/
def e0idx6AI : Fin 2 → Fin 420
  | 0 => 4
  | 1 => 69
def x0idx6AI : Fin 2 → Fin 46236
  | 0 => 0
  | 1 => 78

def endE06AI (j : Fin 2) : Fin 6 → Fin 6 := endE6AI (e0idx6AI j)

def endX06AI (j : Fin 2) : Fin 6 → Fin 6 := endX6AI (x0idx6AI j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6AI (i : Fin 2) : Magma (Fin 6) := Magma.mk (mem6AI i)

theorem end6AI_isEndo (i : Fin 2) (j : Fin 420) : (end6AI i).IsEndo (endE6AI j) := by
  revert i j; native_decide

theorem end6AI_not_isEndo (i : Fin 2) (j : Fin 46236) : ¬ (end6AI i).IsEndo (endX6AI j) := by
  revert i j; native_decide

/-- `rank6AI` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6AI` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6AI (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6AI a b c d e f g h i j) endE06AI endX06AI = true) :
    mem6AI (rank6AI a b c d e f g h i j) = tab6AI a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `2` listed
members. -/
theorem mem_of_isExact6AI (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6AI a b c d e f g h i j) endE06AI endX06AI = true) :
    ∃ idx, mem6AI idx = tab6AI a b c d e f g h i j :=
  ⟨_, mem_rank6AI a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6AI`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6AI` turns that into a member index. -/
theorem exists_end6AI {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6AI j))
    (hX : ∀ j, ¬ M.IsEndo (endX6AI j)) : ∃ i, end6AI i = M := by
  have hP : ∀ i, M.IsEndo (permE6AI i) := by
    intro i; rw [permE6AI_eq_endE6AI]; exact hE (uidx6AI i)
  have hop : M.op = Magma.transport permE6AI tr6AI (fun i ↦ M.op (rep6AI i).1 (rep6AI i).2) :=
    Magma.op_eq_transport (rep := rep6AI) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI0) (a := (rep6AI 0).1) (b := (rep6AI 0).2)
    (val := val6AI0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI1) (a := (rep6AI 1).1) (b := (rep6AI 1).2)
    (val := val6AI1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI2) (a := (rep6AI 2).1) (b := (rep6AI 2).2)
    (val := val6AI2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI3) (a := (rep6AI 3).1) (b := (rep6AI 3).2)
    (val := val6AI3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI4) (a := (rep6AI 4).1) (b := (rep6AI 4).2)
    (val := val6AI4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI5) (a := (rep6AI 5).1) (b := (rep6AI 5).2)
    (val := val6AI5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI6) (a := (rep6AI 6).1) (b := (rep6AI 6).2)
    (val := val6AI6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI7) (a := (rep6AI 7).1) (b := (rep6AI 7).2)
    (val := val6AI7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI8) (a := (rep6AI 8).1) (b := (rep6AI 8).2)
    (val := val6AI8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6AI) (idx := stabIdx6AI9) (a := (rep6AI 9).1) (b := (rep6AI 9).2)
    (val := val6AI9) hP (by decide) (by decide)
  have hdec : dec6AI a b c d e f g h i j = fun i ↦ M.op (rep6AI i).1 (rep6AI i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6AI a b c d e f g h i j = M.op := by
    rw [tab6AI_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6AI a b c d e f g h i j) endE06AI endX06AI = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6AI j), fun j ↦ hX (x0idx6AI j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6AI a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`420` monoid of `Magma.endE6AI`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6AI {L L' : Law.NatMagmaLaw} {i : Fin 2}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6AI i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6AI j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6AI i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6AI
    (fun k ↦ (Magma.end6AI_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6AI_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
