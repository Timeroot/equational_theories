/-- Two models of `Equation824` on one carrier with the same `(x ◇ (y ◇ y))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ Lf 1)) Law824 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ Lf 1)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law824.models_iff G M).mp hM
  have hn := (@Law824.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X0 X1) (M.op X0 X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X0 X1) (N.op X0 X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X1)) = (N.op X0 (N.op X1 X1)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq9 : ∀ X0 X3 : G, (M.op X0 (M.op X0 (M.op X0 X3))) = X0 := by
    intro X0 X3
    first
    | (have i₁ := eq5 X0 (M.op (M.op X0 x) (M.op X0 x)) X3
       have i₂ := eq5 X0 x x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq13 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq9 X0 (M.op X0 x)
       have i₂ := eq9 X0 x
       grind)
    | exact superpose eq9 eq9
    | exact resolve eq9 eq9
    | grind
    | grind (splits := 40)
  clear eq9
  have eq18 : ∀ X0 X3 : G, (N.op X0 (N.op X0 (N.op X0 X3))) = X0 := by
    intro X0 X3
    first
    | (have i₁ := eq6 X0 (N.op (N.op X0 x) (N.op X0 x)) X3
       have i₂ := eq6 X0 x x
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq65 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq18 X0 (N.op X0 x)
       have i₂ := eq18 X0 x
       grind)
    | exact superpose eq18 eq18
    | exact resolve eq18 eq18
    | grind
    | grind (splits := 40)
  clear eq18
  have eq79 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq65 X0
       grind)
    | exact superpose eq65 eq7
    | exact resolve eq7 eq65
    | grind
    | grind (splits := 40)
  clear eq65
  have eq81 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq79 X0 X1
       have i₂ := eq13 X0
       grind)
    | exact superpose eq13 eq79
    | exact resolve eq79 eq13
    | grind
    | grind (splits := 40)
  clear eq13 eq79
  have eq144 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq81 b a
       grind)
    | exact superpose eq81 eq8
    | exact resolve eq8 eq81
    | grind
    | grind (splits := 40)
  clear eq81
  have eq163 : False := by grind
  exact eq163

