import equational_theories.Definability.AutBox
import equational_theories.Definability.VBox_01

/-!
# The diagonal obligation for `Equation3480`, inherited

Generated by `defwork/dfmono.py`.  `Equation3480` is `x ◇ x = y ◇ ((x ◇ z) ◇ w)`, which implies
`Equation3473` (`x ◇ x = y ◇ ((x ◇ x) ◇ z)`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation3480 : AutBox.DiagFix Law3480 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation3473
  rw [@Law3473.models_iff G M]
  rw [@Law3480.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y z; grind (splits := 60) (ematch := 40))
