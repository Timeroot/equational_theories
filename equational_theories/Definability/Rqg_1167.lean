import equational_theories.Definability.DiagRow

/-!
# `Equation1167` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1167` is `x = y ◇ ((z ◇ (y ◇ y)) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1167`: `x = y ◇ ((z ◇ (y ◇ y)) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1167 : DiagRow.RowQG Law1167 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1167.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X2 (M.op X1 X1)) X0)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 X1)) (M.op (M.op X0 (M.op X1 X1)) X2)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op X0 (M.op X1 X1)) X1
       have i₂ := eq4 (M.op X0 (M.op X1 X1)) X1 X0
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 X1 X2 : G, (M.op (M.op X2 (M.op X1 X1)) X0) = (M.op X1 X0) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op (M.op X2 (M.op X1 X1)) X0) X1 X2
       have i₂ := eq7 X2 X1 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq19 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 X0 x
       have i₂ := eq12 X1 X0 x
       grind)
    | exact superpose eq12 eq4
    | exact resolve eq4 eq12
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq12
  have eq74 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq19 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq19
    | exact resolve eq19 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq91 : x = y := by
    first
    | (have i₁ := eq74
       have i₂ := eq19 x x
       grind)
    | exact superpose eq19 eq74
    | exact resolve eq74 eq19
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq19 eq74
  have eq92 : False := by grind
  exact eq92

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1167` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1167 : Law3.StructuralFrom Law1167 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1167
