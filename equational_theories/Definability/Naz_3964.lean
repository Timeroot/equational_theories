/-!
# Structurality from `Equation3964` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation3964` is `x ◇ y = (y ◇ (y ◇ y)) ◇ x`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b b) = a then (M.op b a) else if (M.op a a) = b then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pyy_x_pxx_y_pyx_x_pxy_Equation3964`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 5 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation8` from `Equation3964`: `x ◇ y = (y ◇ (y ◇ y)) ◇ x` ⊢ `x = x ◇ (x ◇ x)`,
through `x □ y = if (M.op b b) = a then (M.op b a) else if (M.op a a) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation8_StructuralFromFin_Equation3964 : Law8.StructuralFromFin Law3964 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pyy_x_pxx_y_pyx_x_pxy_Equation3964 (fun {G} M hM ↦ ?_)
  have hm := (@Law3964.models_iff G M).mp hM
  rw [@Law8.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

