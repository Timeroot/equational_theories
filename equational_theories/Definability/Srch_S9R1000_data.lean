namespace Magma

/-- A member of the class, as the `4` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R1000 : Type := {w : Fin 4 → Fin 9 // Magma.tupOK S9R1000.E S9R1000.tr S9R1000.z S9R1000.st S9R1000.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R1000 (v : tup9R1000) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R1000.E S9R1000.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `46` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `81` cells times
the `648` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R10000 : Array Nat := #[0, 0, 0, 6]

def vsrch9R10000 : Magma.tup9R1000 :=
  ⟨fun i ↦ ⟨vdsrch9R10000[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch9R10001 : Array Nat := #[0, 1, 0, 6]

def vsrch9R10001 : Magma.tup9R1000 :=
  ⟨fun i ↦ ⟨vdsrch9R10001[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `648`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R1000Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R10000 : Array (Array Nat) := #[#[0, 0, 0, 0, 0, 0, 6, 7, 8], #[1, 1, 1, 1, 1, 1, 6, 7, 8], #[2, 2, 2, 2, 2, 2, 6, 7, 8], #[0, 1, 2, 3, 3, 3, 3, 3, 3], #[0, 1, 2, 4, 4, 4, 4, 4, 4], #[0, 1, 2, 5, 5, 5, 5, 5, 5], #[6, 6, 6, 3, 4, 5, 6, 6, 6], #[7, 7, 7, 3, 4, 5, 7, 7, 7], #[8, 8, 8, 3, 4, 5, 8, 8, 8]]

def opsrch9R10000 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R10000[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R10000 :
    ∀ x y, Magma.transport S9R1000.E S9R1000.tr vsrch9R10000.1 x y = opsrch9R10000 x y := by
  native_decide

theorem esrch9R10000 : Magma.srch9R1000 vsrch9R10000 = Magma.mk opsrch9R10000 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R10000 x y)

