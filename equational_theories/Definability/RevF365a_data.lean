theorem revF365a_splitFacts : ∀ i : Fin 24,
    (∀ x y, (revF365aSub (revF365aWk i) (revF365aWe i)).op x y = (revF365aClone i).op x y) ∨
      (∀ x y, (revF365aClone i).op x y = (revF365aBad (revF365aWb i)).op x y) := by
  native_decide

theorem revF365a_split (i : Fin 24) :
    (∃ k, InClone (revF365aSub k) (revF365aClone i).op) ∨
      ∃ b, (revF365aClone i).op = (revF365aBad b).op :=
  split_of_witnesses revF365aWk revF365aWe revF365aWb revF365a_splitFacts i

end Magma

