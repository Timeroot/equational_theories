import equational_theories.Definability.DiagRow

/-!
# `Equation1719` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1719` is `x = (y ◇ y) ◇ ((x ◇ x) ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1719`: `x = (y ◇ y) ◇ ((x ◇ x) ◇ y)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1719 : DiagRow.RowQG Law1719 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1719.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op (M.op z z) (M.op (M.op u u) (M.op u u))) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op X1 X1) (M.op (M.op X0 X0) X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op u (M.op (M.op z z) (M.op (M.op u u) (M.op u u)))) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X1 X1) (M.op (M.op X0 X0) (M.op X0 X0)))) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq3 X1 (M.op (M.op X0 X0) (M.op X0 X0))
         have i₂ := eq3 X0 (M.op X0 X0)
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq13 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq5 u z
         grind)
      | exact superpose eq5 eq4
      | (have r₁ := eq4
         have r₂ := eq5 u z
         grind)
      | exact resolve eq4 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq14 : False := by grind
    exact eq14
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op z z) (M.op (M.op u u) (M.op u u))), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X1 X1) (M.op (M.op X0 X0) X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq8 : ∀ X0 X1 : G, (M.op (M.op X0 X0) (M.op X0 X0)) = (M.op (M.op X1 X1) (M.op X0 X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op X0 X0) (M.op X0 X0)) X1
       have i₂ := eq4 X0 (M.op X0 X0)
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq22 : (M.op (M.op x x) (M.op x x)) = (M.op (M.op y y) (M.op x x)) := by
    first
    | (have i₁ := eq8 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq8
    | exact resolve eq8 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq131 : y = (M.op (M.op (M.op x x) (M.op x x)) (M.op (M.op x x) (M.op x x))) := by
    first
    | (have i₁ := eq4 y (M.op x x)
       have i₂ := eq22
       grind)
    | exact superpose eq22 eq4
    | exact resolve eq4 eq22
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq22
  have eq136 : x = y := by
    first
    | (have i₁ := eq131
       have i₂ := eq4 x (M.op x x)
       grind)
    | exact superpose eq4 eq131
    | exact resolve eq131 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq131
  have eq140 : False := by grind
  exact eq140

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1719` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1719 : Law3.StructuralFrom Law1719 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1719
