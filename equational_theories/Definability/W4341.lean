/-! ### The operations

Each is a decision tree over `d x`, `d y`, `x = y`, `x ◇ x = x`, `y ◇ y = y`, `y = x ◇ x` and
`x = y ◇ y`, whose leaves are words in `x` and `y`. A tree has to satisfy three things: that it
keeps the source's diagonal, that it gives the row constant `κ` back at its reserved cell, and how
it reads the columns of `S`. `D` itself is named by the tree's own diagonal. -/

section Ops

variable (M : Magma G) (K : RKer M)

/-! #### Operation `20683`

132 cells, in 14 rows of the open list over 13 sources.  Its off-`D` block is read `split2`, so it
gives `κ` back at `x (M.op x x)`. -/

/-- The tree of operation `20683`. -/
def q20683 : EOp :=
  .ite (.sq (Lf 1))
    (.ite (.eq (Lf 0 ⋆ Lf 0) (Lf 0))
      (.ite (.eq (Lf 0) (Lf 1 ⋆ Lf 1)) (.leaf (Lf 0)) (.leaf (Lf 1)))
      (.ite (.eq (Lf 1) (Lf 0 ⋆ Lf 0))
        (.leaf (Lf 0 ⋆ Lf 1))
        (.ite (.eq (Lf 0) (Lf 1 ⋆ Lf 1)) (.leaf (Lf 1)) (.leaf (Lf 1 ⋆ Lf 1)))))
    (.ite (.sq (Lf 0)) (.leaf (Lf 0 ⋆ Lf 1)) (.leaf (Lf 1 ⋆ Lf 0)))

open scoped Classical in
theorem q20683_apply (a b : G) :
    (q20683.magma M).op a b =
      if K.d b then
        if M.op a a = a then
          if a = M.op b b then a else b
        else if b = M.op a a then M.op a b else if a = M.op b b then b else M.op b b
      else if K.d a then M.op a b else M.op b a := by
  show @EOp.eval _ M q20683 ![a, b] = _
  simp only [q20683, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    rsqex M K]

include K in
theorem q20683_diag (y : G) (hy : K.d y) : (q20683.magma M).op y y = M.op y y := by
  classical
  rw [q20683_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The tree keeps the source's diagonal everywhere, on `D` because that is `κ` and off it because
the off-`D` clause copies the source cell.  This is what names `D`, and it is the one rewrite a
nested application gets: `□ c c` is `M c c`, which is a square. -/
