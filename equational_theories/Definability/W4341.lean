/-- The whole of `StructuralOnMagma` for operation `20683`, bar the law itself. -/
theorem structural_q20683 {β : Type*} {L : Law.MagmaLaw β}
    (hL : @satisfies _ G (q20683.magma M) L) : L.StructuralOnMagma M :=
