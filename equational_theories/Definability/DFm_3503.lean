import equational_theories.Definability.AutBox
import equational_theories.Definability.VBox_02

/-!
# The diagonal obligation for `Equation3503`, inherited

Generated by `defwork/dfmono.py`.  `Equation3503` is `x ◇ x = y ◇ ((z ◇ w) ◇ x)`, which implies
`Equation3477` (`x ◇ x = y ◇ ((x ◇ z) ◇ x)`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation3503 : AutBox.DiagFix Law3503 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation3477
  rw [@Law3477.models_iff G M]
  rw [@Law3503.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y z; grind (splits := 60) (ematch := 40))
