namespace Magma

/-- A member of the class, as the `6` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R400 : Type := {w : Fin 6 → Fin 9 // Magma.tupOK S9R400.E S9R400.tr S9R400.z S9R400.st S9R400.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R400 (v : tup9R400) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R400.E S9R400.tr v.1)

end Magma

