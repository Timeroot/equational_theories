namespace Magma

/-- A member of the class, as the `8` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup10R403 : Type := {w : Fin 8 → Fin 10 // Magma.tupOK S10R403.E S10R403.tr S10R403.z S10R403.st S10R403.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch10R403 (v : tup10R403) : Magma (Fin 10) :=
  Magma.mk (Magma.transport S10R403.E S10R403.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `2` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `100` cells times
the `81` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch10R4030 : Array Nat := #[0, 2, 4, 0, 1, 4, 1, 2]

def vsrch10R4030 : Magma.tup10R403 :=
  ⟨fun i ↦ ⟨vdsrch10R4030[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch10R4031 : Array Nat := #[0, 2, 4, 3, 1, 9, 1, 2]

def vsrch10R4031 : Magma.tup10R403 :=
  ⟨fun i ↦ ⟨vdsrch10R4031[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `81`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R403Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R4030 : Array (Array Nat) := #[#[0, 2, 4, 0, 1, 4, 0, 4, 0, 4], #[4, 1, 0, 1, 2, 0, 1, 0, 1, 0], #[1, 4, 2, 6, 0, 9, 8, 5, 3, 7], #[8, 8, 8, 3, 8, 3, 2, 3, 6, 3], #[2, 0, 1, 4, 4, 1, 4, 1, 4, 1], #[5, 5, 7, 7, 5, 5, 7, 9, 7, 2], #[3, 3, 3, 8, 3, 6, 6, 6, 2, 6], #[7, 7, 9, 9, 7, 2, 9, 7, 9, 5], #[6, 6, 6, 2, 6, 8, 3, 8, 8, 8], #[9, 9, 5, 5, 9, 7, 5, 2, 5, 9]]

def opsrch10R4030 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4030[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4030 :
    ∀ x y, Magma.transport S10R403.E S10R403.tr vsrch10R4030.1 x y = opsrch10R4030 x y := by
  native_decide

