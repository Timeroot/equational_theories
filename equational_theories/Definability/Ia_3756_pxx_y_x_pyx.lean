theorem Equation8_StructuralFromFin_Equation3756 : Law8.StructuralFromFin Law3756 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_y_x_pyx_Equation3756 (fun {G} M hM ↦ ?_)
  have hm := (@Law3756.models_iff G M).mp hM
  rw [@Law8.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
