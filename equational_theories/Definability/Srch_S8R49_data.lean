@[reducible] def tup8R49 : Type := {w : Fin 9 → Fin 8 // Magma.tupOK S8R49.E S8R49.tr S8R49.z S8R49.st S8R49.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
