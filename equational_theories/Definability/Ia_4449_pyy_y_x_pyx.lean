import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_28

/-!
# Structurality from `Equation4449` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation4449` is `x ◇ (y ◇ x) = (y ◇ z) ◇ y`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then X else m(Y,X)`
is an automorphism -- is `GuardAut_pyy_y_x_pyx_Equation4449`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 15 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation99` from `Equation4449`: `x ◇ (y ◇ x) = (y ◇ z) ◇ y` ⊢ `x = x ◇ ((x ◇ x) ◇ x)`,
through `x □ y = if m(Y,Y) = Y then X else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation99_StructuralFromFin_Equation4449 : Law99.StructuralFromFin Law4449 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pyy_y_x_pyx_Equation4449 (fun {G} M hM ↦ ?_)
  have hm := (@Law4449.models_iff G M).mp hM
  rw [@Law99.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

