import equational_theories.Definability.LinearOrders
import equational_theories.Definability.LinearTargets2

/-!
# More linear magmas over orders in number fields

`Definability/LinearOrders.lean` carries seventeen targets over four orders. The elimination
argument behind it does not care which cofactors the target's coefficient system produces, and
`Definability/LinearTargets2.lean` now supplies a lemma for every open target of that shape, so the
same handful of orders reaches a great deal more of the board.

An order costs its defining polynomial, an irreducibility proof, `AdjoinRoot`, and one
`AdjoinRoot.lift` per residue map. After that every obligation is arithmetic in a small `ZMod p`:

* `hc<n>` says the integer `n` is not in the ideal generated by the coefficient modulus `c`,
  witnessed by a residue map that kills `c` but not `n`;
* `hP<t>` says the target's slice polynomial has no root in the order, witnessed by a residue map
  at which it has none modulo `p`.

No single finite quotient does both jobs, which is why these certificates have no `ZMod`
replacement and the models have to be infinite.

Four of these orders also appear in `Definability/LinearOrders.lean`. They are rebuilt here rather
than reopened, because the obligation names in that file were chosen for its narrower signature.

Being clone arguments over infinite models, the certificates refute `TermDefinableFrom`, and only
over all magmas.

This file is generated by `genord2.py`.
-/

open Law Law.MagmaLaw Polynomial

noncomputable section

/-! ### The order `ℤ[θ]` with `θ ^ 3 = 1`, a primitive cube root of unity -/

namespace OrdW

/-- The defining polynomial of the order. -/
abbrev q : ℤ[X] := X ^ 2 + X + 1

theorem q_irr : Irreducible q :=
  irreducible_int_of_no_root
    (by show Monic (X ^ 2 + X + 1 : ℤ[X]); monicity!) (d := 2)
    (by show natDegree (X ^ 2 + X + 1 : ℤ[X]) = 2; compute_degree!)
    (by norm_num) (by norm_num) 2
    (by intro y; simp only [q, eval₂_add, eval₂_pow, eval₂_X, eval₂_one]; revert y; decide)

/-- The order `ℤ[θ]`, a domain because `q` is irreducible. -/
abbrev R : Type := AdjoinRoot q

instance : IsDomain R :=
  AdjoinRoot.isDomain_of_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp q_irr)

/-- The algebraic integer `θ`. -/
abbrev th : R := AdjoinRoot.root q

theorem hq : th ^ 2 + th + 1 = 0 := by
  have h := AdjoinRoot.eval₂_root q
  simp only [q, eval₂_add, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-! The residue maps, each given by a root of `q` modulo `p`. -/

/-- Reduction modulo `3`, sending `θ` to `1`. -/
def r3_1 : R →+* ZMod 3 := AdjoinRoot.lift (Int.castRingHom (ZMod 3)) 1
  (by simp only [q, eval₂_add, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r3_1_th : r3_1 th = 1 := by simp [r3_1]

/-- Reduction modulo `7`, sending `θ` to `2`. -/
def r7_2 : R →+* ZMod 7 := AdjoinRoot.lift (Int.castRingHom (ZMod 7)) 2
  (by simp only [q, eval₂_add, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r7_2_th : r7_2 th = 2 := by simp [r7_2]

/-- Reduction modulo `7`, sending `θ` to `4`. -/
def r7_4 : R →+* ZMod 7 := AdjoinRoot.lift (Int.castRingHom (ZMod 7)) 4
  (by simp only [q, eval₂_add, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r7_4_th : r7_4 th = 4 := by simp [r7_4]

/-! The slice polynomials, each with no root in the order because it has none modulo `p`. -/

theorem hP504_3_1 (z : R) : z ^ 3 - 2 * z ^ 2 + z - 1 ≠ 0 := by
  intro h
  have hr := congrArg r3_1 h
  simp only [map_add, map_sub, map_pow, map_mul, map_one, map_ofNat, map_zero] at hr
  revert hr
  generalize r3_1 z = y
  revert y
  decide

