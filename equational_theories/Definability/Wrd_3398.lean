through the companion `x □ y = (x ◇ ((y ◇ y) ◇ y))`. -/
theorem Equation43_StructuralFromFin_Equation3398 : Law43.StructuralFromFin Law3398 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law3398.models_iff G M).mp hM
  rw [@Law43.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
