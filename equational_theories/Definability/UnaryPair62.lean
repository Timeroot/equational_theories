import equational_theories.Definability.Unary62

/-!
# Source 62: the orbit equation

`Definability/Unary62.lean` settles the targets whose tree names `s` on its own diagonal. The
trees here do not; what they have instead is a pair of `□`-words whose equation cuts out the orbit
of the free variable,

    {w | u(y, w) = v(y, w)} = {y, s y},

and then `Unary.structuralOnMagma_pair` separates the two elements with one universal quantifier:
`z = s y` iff the equation holds at `z` and, should `z` be `y`, the orbit is a singleton.

    x □ y := if s y = x then s x else x
      with `y = ((w □ y) □ w)`  (31 targets, 11,552 cells)

    x □ y := if s² y = x then x else y
      with `y = (y □ w)`  (9 targets, 2,584 cells)

    x □ y := if s y = x then s² x else x
      with `y = (w □ y)`  (4 targets, 1,216 cells)

    x □ y := if s y = x then s x else y
      with `y = ((w □ y) □ w)`  (2 targets, 608 cells)

Generated by `defwork/emitpair.py`. The proofs live in `UnaryPair62_*.lean`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace UnaryPair62

variable {G : Type} (M : Magma G)

/-- `x □ y := if s y = x then s x else x`. -/
def t24 : QFOp :=
  .ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0))

open scoped Classical in
theorem t24_apply (a b : G) :
    (t24.magma M).op a b = if M.op b b = a then M.op a a else a := by
  show @QFOp.eval _ M t24 ![a, b] = _
  simp only [t24, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `y = ((w □ y) □ w)` holds exactly at `z = y` and `z = s y`. -/
theorem t24_pair (h : Equation62 G) (y z : G) :
    @evalInMagma _ _ (t24.magma M) ![y, z] (Lf 0)
        = @evalInMagma _ _ (t24.magma M) ![y, z] (((Lf 1) ⋆ (Lf 0)) ⋆ (Lf 1))
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary62.name_s M h
  show y = (t24.magma M).op ((t24.magma M).op z y) z ↔ _
  simp only [t24_apply M, hs]
  grind

