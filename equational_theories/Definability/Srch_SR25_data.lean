def E (i : Fin 9) (x : Fin 6) : Fin 6 := ⟨(Ed[i.1]!)[x.1]! % 6, Nat.mod_lt _ (by decide)⟩

def Einv (i : Fin 9) (x : Fin 6) : Fin 6 := ⟨(Eid[i.1]!)[x.1]! % 6, Nat.mod_lt _ (by decide)⟩

/-- The `5` excess permutations: one element of each minimal overgroup of the group, so that a table
admitting none of them has the group as its automorphism group exactly. Chosen and checked in
`autsearch.py`. -/
def Xd : Array (Array Nat) := #[#[0, 2, 1, 3, 5, 4], #[0, 1, 2, 3, 5, 4], #[0, 2, 1, 3, 4, 5], #[3, 4, 5, 0, 1, 2], #[3, 5, 4, 0, 2, 1]]

