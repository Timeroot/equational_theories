set_option linter.unreachableTactic false

/-- `Equation1045` from `Equation4520`: `x ◇ (y ◇ z) = (x ◇ w) ◇ z` ⊢ `x = x ◇ ((y ◇ (y ◇ x)) ◇ x)`,
through `x □ y = if a = b then (M.op a a) else if (M.op a b) = b then a else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation1045_StructuralFromFin_Equation4520 : Law1045.StructuralFromFin Law4520 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_x_y_pxy_y_pxx_x_pyx_Equation4520 (fun {G} M hM ↦ ?_)
  have hm := (@Law4520.models_iff G M).mp hM
  rw [@Law1045.models_iff G ((AutBox.iteOf2 (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

