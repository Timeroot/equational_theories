theorem classification (N : Magma (Fin 16)) (h : ∀ i, N.IsEndo (perms i)) :
    ∃ a b : Fin 2, ∃ c : Fin 4, family a b c = N := by
  obtain ⟨v0, hv0⟩ := Magma.exists_val_of_isEndo (idx := stabilizers 0)
    (a := (rep 0).1) (b := (rep 0).2) (val := (![0] : Fin 1 → Fin 16)) h
    (by native_decide) (by native_decide)
  obtain ⟨v1, hv1⟩ := Magma.exists_val_of_isEndo (idx := stabilizers 1)
    (a := (rep 1).1) (b := (rep 1).2) (val := (![0, 1] : Fin 2 → Fin 16)) h
    (by native_decide) (by native_decide)
  obtain ⟨v2, hv2⟩ := Magma.exists_val_of_isEndo (idx := stabilizers 2)
    (a := (rep 2).1) (b := (rep 2).2) (val := (![0, 4] : Fin 2 → Fin 16)) h
    (by native_decide) (by native_decide)
  obtain ⟨v3, hv3⟩ := Magma.exists_val_of_isEndo (idx := stabilizers 3)
    (a := (rep 3).1) (b := (rep 3).2) (val := (![0, 1, 4, 5] : Fin 4 → Fin 16)) h
    (by native_decide) (by native_decide)
  refine ⟨v1, v2, v3, ?_⟩
  have hv : values v1 v2 v3 = fun i => N.op (rep i).1 (rep i).2 := by
    funext i
    fin_cases i
    · simpa using hv0
    · exact hv1
    · exact hv2
    · exact hv3
  have ht := Magma.op_eq_transport (rep := rep) (tr := tr) h (by native_decide)
  apply congrArg Magma.mk
  change Magma.transport perms tr (values v1 v2 v3) = N.op
  rw [hv, ← ht]

