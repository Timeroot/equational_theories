/-- The arguments as one mixed-radix index, which is how `rankArr6O` is addressed. -/
def encT6O (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2) : Nat :=
  a.1 * 5184 +
    b.1 * 1728 +
    c.1 * 576 +
    d.1 * 144 +
    e.1 * 48 +
    f.1 * 24 +
    g.1 * 12 +
    h.1 * 4 +
    i.1 * 2 +
    j.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank6O (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    : Fin 2 :=
  ⟨min (rankArr6O.getD (encT6O a b c d e f g h i j) 0) 1, by omega⟩


/-- `3` of the `628` demanded maps and `2` of the `46028` forbidden ones, enough to separate the `2`
members from the other `15550` invariant tuples between them. The certificate still demands and
forbids all `46656`; these are the lists `mem_rank6O` scans, once per tuple, with a scan that is
quadratic in their length. -/
def e0idx6O : Fin 3 → Fin 628
  | 0 => 1
  | 1 => 155
  | 2 => 251
def x0idx6O : Fin 2 → Fin 46028
  | 0 => 0
  | 1 => 42

def endE06O (j : Fin 3) : Fin 6 → Fin 6 := endE6O (e0idx6O j)

def endX06O (j : Fin 2) : Fin 6 → Fin 6 := endX6O (x0idx6O j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6O (i : Fin 2) : Magma (Fin 6) := Magma.mk (mem6O i)

theorem end6O_isEndo (i : Fin 2) (j : Fin 628) : (end6O i).IsEndo (endE6O j) := by
  revert i j; native_decide

theorem end6O_not_isEndo (i : Fin 2) (j : Fin 46028) : ¬ (end6O i).IsEndo (endX6O j) := by
  revert i j; native_decide

/-- `rank6O` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6O` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6O (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6O a b c d e f g h i j) endE06O endX06O = true) :
    mem6O (rank6O a b c d e f g h i j) = tab6O a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `2` listed
members. -/
theorem mem_of_isExact6O (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6O a b c d e f g h i j) endE06O endX06O = true) :
    ∃ idx, mem6O idx = tab6O a b c d e f g h i j :=
  ⟨_, mem_rank6O a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6O`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6O` turns that into a member index. -/
theorem exists_end6O {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6O j))
    (hX : ∀ j, ¬ M.IsEndo (endX6O j)) : ∃ i, end6O i = M := by
  have hP : ∀ i, M.IsEndo (permE6O i) := by
    intro i; rw [permE6O_eq_endE6O]; exact hE (uidx6O i)
  have hop : M.op = Magma.transport permE6O tr6O (fun i ↦ M.op (rep6O i).1 (rep6O i).2) :=
    Magma.op_eq_transport (rep := rep6O) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O0) (a := (rep6O 0).1) (b := (rep6O 0).2)
    (val := val6O0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O1) (a := (rep6O 1).1) (b := (rep6O 1).2)
    (val := val6O1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O2) (a := (rep6O 2).1) (b := (rep6O 2).2)
    (val := val6O2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O3) (a := (rep6O 3).1) (b := (rep6O 3).2)
    (val := val6O3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O4) (a := (rep6O 4).1) (b := (rep6O 4).2)
    (val := val6O4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O5) (a := (rep6O 5).1) (b := (rep6O 5).2)
    (val := val6O5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O6) (a := (rep6O 6).1) (b := (rep6O 6).2)
    (val := val6O6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O7) (a := (rep6O 7).1) (b := (rep6O 7).2)
    (val := val6O7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O8) (a := (rep6O 8).1) (b := (rep6O 8).2)
    (val := val6O8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6O) (idx := stabIdx6O9) (a := (rep6O 9).1) (b := (rep6O 9).2)
    (val := val6O9) hP (by decide) (by decide)
  have hdec : dec6O a b c d e f g h i j = fun i ↦ M.op (rep6O i).1 (rep6O i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6O a b c d e f g h i j = M.op := by
    rw [tab6O_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6O a b c d e f g h i j) endE06O endX06O = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6O j), fun j ↦ hX (x0idx6O j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6O a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`628` monoid of `Magma.endE6O`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6O {L L' : Law.NatMagmaLaw} {i : Fin 2}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6O i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6O j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6O i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6O
    (fun k ↦ (Magma.end6O_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6O_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
