import equational_theories.Definability.DiagRow

/-!
# `Equation1977` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1977` is `x = (y ◇ (z ◇ y)) ◇ (x ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1977`: `x = (y ◇ (z ◇ y)) ◇ (x ◇ z)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1977 : DiagRow.RowQG Law1977 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1977.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op u (M.op (M.op z u) u)) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X1)) (M.op X0 X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op u (M.op (M.op z u) u))) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X0 X1) X0) (M.op X3 (M.op X2 (M.op X1 X2)))) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X0 X1) (M.op X2 (M.op X1 X2))
         have i₂ := eq3 X0 X2 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq6 : ∀ X0 X1 X2 X3 : G, (M.op X3 (M.op X2 X3)) = (M.op (M.op X1 (M.op (M.op X0 X2) X1)) X0) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op X3 (M.op X2 X3)) X1 (M.op X0 X2)
         have i₂ := eq3 X0 X3 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq9 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op X2 (M.op X3 (M.op (M.op X1 (M.op X0 X1)) X3)))) = X2 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq5 (M.op X0 X1) (M.op X1 (M.op X0 X1)) X3 X2
         have i₂ := eq3 X0 (M.op X0 X1) X1
         grind)
      | exact superpose eq3 eq5
      | exact resolve eq5 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq30 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X1 X0)) = (M.op X2 (M.op X1 X2)) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq6 x x X1 X0
         have i₂ := eq6 x x X1 X2
         grind)
      | exact superpose eq6 eq6
      | exact resolve eq6 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq87 : ∀ X0 : G, z ≠ (M.op u (M.op X0 (M.op (M.op z u) X0))) := by
      intro X0
      first
      | (have i₁ := eq4
         have i₂ := eq30 u (M.op z u) X0
         grind)
      | (have i₁ := eq4
         have i₂ := eq30 X0 (M.op z u) u
         grind)
      | exact superpose eq30 eq4
      | exact resolve eq4 eq30
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq30
    have eq131 : ∀ X0 : G, z ≠ (M.op (M.op X0 (M.op u X0)) (M.op z u)) := by
      intro X0
      first
      | (have i₁ := eq87 (M.op (M.op X0 (M.op u X0)) (M.op z u))
         have i₂ := eq9 u X0 (M.op (M.op X0 (M.op u X0)) (M.op z u)) (M.op z u)
         grind)
      | exact superpose eq9 eq87
      | exact resolve eq87 eq9
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq9 eq87
    have eq132 : False := by grind
    exact eq132
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op z u) u)), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X1)) (M.op X0 X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, (M.op (M.op y (M.op x x)) (M.op X0 x)) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X0 X1) X0) (M.op X3 (M.op X2 (M.op X1 X2)))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op X0 X1) (M.op X2 (M.op X1 X2))
       have i₂ := eq4 X0 X2 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 : G, x = (M.op (M.op X0 (M.op y X0)) (M.op x x)) := by
    intro X0
    first
    | (have i₁ := eq4 x X0 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 X1 X2 X3 : G, (M.op X3 (M.op X2 X3)) = (M.op (M.op X1 (M.op (M.op X0 X2) X1)) X0) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op X3 (M.op X2 X3)) X1 (M.op X0 X2)
       have i₂ := eq4 X0 X3 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq14 : ∀ X0 X1 : G, (M.op (M.op (M.op x x) x) (M.op X1 (M.op X0 (M.op y X0)))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op x x) (M.op X0 (M.op y X0))
       have i₂ := eq9 X0
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq80 : ∀ X0 X1 X2 X3 X4 : G, (M.op X4 X2) = (M.op (M.op (M.op X3 X4) X3) (M.op (M.op X0 (M.op (M.op X1 X2) X0)) X1)) := by
    intro X0 X1 X2 X3 X4
    first
    | (have i₁ := eq8 X3 X4 X2 (M.op X4 X2)
       have i₂ := eq10 X1 X0 X2 (M.op X4 X2)
       grind)
    | exact superpose eq10 eq8
    | exact resolve eq8 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq331 : ∀ X0 X1 X2 : G, (M.op y X2) = (M.op (M.op (M.op x x) x) (M.op (M.op X0 (M.op (M.op X1 X2) X0)) X1)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq14 X2 (M.op y X2)
       have i₂ := eq10 X1 X0 X2 (M.op y X2)
       grind)
    | exact superpose eq10 eq14
    | exact resolve eq14 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10 eq14
  have eq353 : ∀ X2 : G, (M.op y X2) = (M.op x X2) := by
    intro X2
    first
    | (have i₁ := eq331 x x X2
       have i₂ := eq80 x x X2 x x
       grind)
    | exact superpose eq80 eq331
    | exact resolve eq331 eq80
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq80 eq331
  have eq409 : y = (M.op (M.op y (M.op x x)) (M.op x x)) := by
    first
    | (have i₁ := eq7 y
       have i₂ := eq353 x
       grind)
    | exact superpose eq353 eq7
    | exact resolve eq7 eq353
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq353
  have eq410 : x = y := by
    first
    | (have i₁ := eq409
       have i₂ := eq7 x
       grind)
    | exact superpose eq7 eq409
    | exact resolve eq409 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq409
  have eq433 : False := by grind
  exact eq433

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1977` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1977 : Law3.StructuralFrom Law1977 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1977
