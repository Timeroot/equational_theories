  IsSubclone.of_table (rev168aP 0 k) (rev168aP 1 k) (rev168aSc k)
    (rev168a_subFacts.1 k) (rev168a_subFacts.2.1 k) (rev168a_subFacts.2.2.1 k)

theorem rev168a_notInSub (k : Fin 4) : ¬ InClone (rev168aSub k) rev168a.op :=
  notInClone_of (rev168a_subFacts.2.2.2 k)

