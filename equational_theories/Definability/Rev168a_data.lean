      (∀ k i j l x y, (rev168aSub k (rev168aSc k i j l)).op x y =
        (rev168aSub k i).op ((rev168aSub k j).op x y) ((rev168aSub k l).op x y)) ∧
      ∀ k j, ¬ ∀ x y, (rev168aSub k j).op x y = rev168a.op x y := by
  decideFin!

