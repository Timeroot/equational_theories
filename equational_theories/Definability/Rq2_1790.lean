import equational_theories.Definability.DiagRow

/-!
# `Equation1790` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1790` is `x = (y ◇ z) ◇ ((z ◇ x) ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1790`: `x = (y ◇ z) ◇ ((z ◇ x) ◇ y)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1790 : DiagRow.RowQG Law1790 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1790.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op u (M.op u (M.op u z))) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X2 X0) X1)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op u (M.op u (M.op u z)))) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op (M.op (M.op X2 X0) X1) X3) (M.op X1 X2))) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X1 X2) (M.op (M.op X2 X0) X1)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X0) X2) X2) X0) = X1 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X1 (M.op (M.op X1 X0) X2) X2
         have i₂ := eq3 X0 X2 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq21 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op X1 (M.op X0 X2)))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq5 X1 X1 (M.op X0 X2) X2
         have i₂ := eq7 X2 X0 X1
         grind)
      | exact superpose eq7 eq5
      | exact resolve eq5 eq7
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5 eq7
    have eq219 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq21 u u z
         grind)
      | exact superpose eq21 eq4
      | (have r₁ := eq4
         have r₂ := eq21 u u z
         grind)
      | exact resolve eq4 eq21
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq21
    have eq220 : False := by grind
    exact eq220
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op u (M.op u z))), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X2 X0) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op X0 x) (M.op (M.op x x) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : x = y := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1790` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1790 : Law3.StructuralFrom Law1790 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1790
