import equational_theories.Definability.DiagRow

/-!
# `Equation1710` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1710` is `x = (y ◇ x) ◇ ((z ◇ z) ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1710`: `x = (y ◇ x) ◇ ((z ◇ z) ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1710 : DiagRow.ColQG Law1710 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1710.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op u (M.op u u)) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) (M.op (M.op X2 X2) X1)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op (M.op u (M.op u u)) z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X2 X2) X1) = (M.op X0 (M.op (M.op X3 X3) (M.op X1 X0))) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op (M.op X2 X2) X1) (M.op X1 X0) X3
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X1) X0) X2) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op (M.op X1 X1) X0) X0
         have i₂ := eq3 X0 X0 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq11 : ∀ X0 X1 : G, (M.op X0 X0) = (M.op X1 X1) := by
      intro X0 X1
      first
      | (have i₁ := eq7 X0 (M.op X1 X1) (M.op X1 X1)
         have i₂ := eq7 (M.op X1 X1) X1 X0
         grind)
      | exact superpose eq7 eq7
      | exact resolve eq7 eq7
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq33 : ∀ X0 X1 X2 X4 : G, (M.op (M.op (M.op X0 (M.op (M.op X1 X1) (M.op X2 X0))) X4) X2) = X4 := by
      intro X0 X1 X2 X4
      by_contra hcon
      push Not at hcon
      have f33_6 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X1) X0) X2) X0) = X2 := by
        intro X0 X1 X2
        grind
      have f33_7 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X2 X2) X1) = (M.op X0 (M.op (M.op X3 X3) (M.op X1 X0))) := by
        intro X0 X1 X2 X3
        grind
      have f33_10 : X4 ≠ (M.op (M.op (M.op X0 (M.op (M.op X1 X1) (M.op X2 X0))) X4) X2) := by grind
      have f33_219 : ∀ X0 : G, X4 ≠ (M.op (M.op (M.op (M.op X0 X0) X2) X4) X2) := by
        intro X0
        first
        | (have i₁ := f33_10
           have i₂ := f33_7 X0 X2 X0 X1
           grind)
        | exact superpose f33_7 f33_10
        | exact resolve f33_10 f33_7
        | grind
        | grind (splits := 40)
        | grind (splits := 40) (ematch := 20)
      have f33_220 : False := by
        first
        | (have r₁ := f33_219 x
           have r₂ := f33_6 X2 x X4
           grind)
        | exact resolve f33_219 f33_6
        | grind
        | grind (splits := 40)
        | grind (splits := 40) (ematch := 20)
      exact f33_220
    clear eq5 eq7
    have eq81 : ∀ X0 : G, z ≠ (M.op (M.op (M.op u (M.op X0 X0)) z) u) := by
      intro X0
      first
      | (have i₁ := eq4
         have i₂ := eq11 u X0
         grind)
      | (have i₁ := eq4
         have i₂ := eq11 X0 u
         grind)
      | exact superpose eq11 eq4
      | exact resolve eq4 eq11
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq11
    have eq744 : z ≠ z := by
      first
      | (have i₁ := eq81 (M.op u u)
         have i₂ := eq33 u u u z
         grind)
      | exact superpose eq33 eq81
      | (have r₁ := eq81 (M.op u u)
         have r₂ := eq33 u u u z
         grind)
      | exact resolve eq81 eq33
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq33 eq81
    have eq745 : False := by grind
    exact eq745
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) (M.op (M.op X2 X2) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op (M.op x x) (M.op (M.op X0 X0) y)) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X1) X0) X2) X0) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op (M.op X1 X1) X0) X0
       have i₂ := eq4 X0 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 X1 : G, (M.op (M.op (M.op (M.op X0 X0) y) X1) x) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op (M.op X0 X0) y) x
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq22 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op X3 X3) (M.op (M.op (M.op X1 X1) X2) X0))) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 (M.op (M.op (M.op X1 X1) X2) X0) X3
       have i₂ := eq10 X2 X1 X0
       grind)
    | exact superpose eq10 eq4
    | exact resolve eq4 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq114 : ∀ X0 X1 X2 : G, x = (M.op X0 (M.op (M.op X2 X2) (M.op (M.op (M.op X1 X1) y) X0))) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 x (M.op (M.op (M.op X1 X1) y) X0) X2
       have i₂ := eq12 X1 X0
       grind)
    | exact superpose eq12 eq4
    | exact resolve eq4 eq12
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq12
  have eq115 : y = x := by
    first
    | (have i₁ := eq114 x x x
       have i₂ := eq22 x x y x
       grind)
    | exact superpose eq22 eq114
    | exact resolve eq114 eq22
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq22 eq114
  have eq118 : False := by grind
  exact eq118

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1710` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1710 : Law3.StructuralFrom Law1710 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1710
