-- at `1152`.  The heartbeat bump is for `tupOK` on the source exhibits below, which the kernel
-- checks: it is `|H|` endomorphism tests of `n^2` cells each.
set_option maxRecDepth 10000
set_option maxHeartbeats 1000000

