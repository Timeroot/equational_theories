/-!
# Structurality from `Equation329` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation329` is `x ◇ y = x ◇ (z ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if a = b then (M.op a a) else if (M.op b a) = (M.op b b) then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_x_y_pyx_pyy_pxx_x_pxy_Equation329`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 6 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation104` from `Equation329`: `x ◇ y = x ◇ (z ◇ y)` ⊢ `x = x ◇ ((y ◇ x) ◇ x)`,
through `x □ y = if a = b then (M.op a a) else if (M.op b a) = (M.op b b) then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation104_StructuralFromFin_Equation329 : Law104.StructuralFromFin Law329 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_x_y_pyx_pyy_pxx_x_pxy_Equation329 (fun {G} M hM ↦ ?_)
  have hm := (@Law329.models_iff G M).mp hM
  rw [@Law104.models_iff G ((AutBox.iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

