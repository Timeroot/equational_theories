import equational_theories.Definability.DiagRow

/-!
# `Equation2485` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2485` is `x = (x ◇ ((y ◇ z) ◇ z)) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2485`: `x = (x ◇ ((y ◇ z) ◇ z)) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2485 : DiagRow.ColQG Law2485 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2485.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op (M.op u u) u)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op (M.op X1 X2) X2)) X1) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op X0 X1) = (M.op X0 (M.op (M.op (M.op (M.op X1 X2) X2) X3) X3)) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op X0 (M.op (M.op (M.op (M.op X1 X2) X2) X3) X3)) X1 X2
       have i₂ := eq4 X0 (M.op (M.op X1 X2) X2) X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq75 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X1) (M.op (M.op X1 X2) X2)) = X0 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X0 (M.op (M.op X1 X2) X2) x
       have i₂ := eq9 X0 X1 X2 x
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq107 : ∀ X0 : G, y = (M.op (M.op x x) (M.op (M.op x X0) X0)) := by
    intro X0
    first
    | (have i₁ := eq75 y x X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq75
    | exact resolve eq75 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq144 : y = x := by
    first
    | (have i₁ := eq107 x
       have i₂ := eq75 x x x
       grind)
    | exact superpose eq75 eq107
    | exact resolve eq107 eq75
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq75 eq107
  have eq145 : False := by grind
  exact eq145

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2485` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2485 : Law3.StructuralFrom Law2485 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2485

