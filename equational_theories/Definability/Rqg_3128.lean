import equational_theories.Definability.DiagRow

/-!
# `Equation3128` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation3128` is `x = (((y ◇ x) ◇ z) ◇ y) ◇ z`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3128`: `x = (((y ◇ x) ◇ z) ◇ y) ◇ z`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation3128 : DiagRow.ColQG Law3128 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law3128.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u z) u) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X0) X2) X1) X2) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq10 : ∀ X0 X1 : G, (M.op X1 X0) = (M.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op X0 X1) (M.op X0 X1) X0
       have i₂ := eq4 X1 X0 (M.op X0 X1)
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq25 : (M.op x x) = (M.op x y) := by
    first
    | (have i₁ := eq5
       have i₂ := eq10 x y
       grind)
    | (have i₁ := eq5
       have i₂ := eq10 y x
       grind)
    | exact superpose eq10 eq5
    | exact resolve eq5 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq44 : ∀ X0 : G, y = (M.op (M.op (M.op (M.op x x) X0) x) X0) := by
    intro X0
    first
    | (have i₁ := eq4 y x X0
       have i₂ := eq25
       grind)
    | exact superpose eq25 eq4
    | exact resolve eq4 eq25
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq25
  have eq45 : y = x := by
    first
    | (have i₁ := eq44 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq44
    | exact resolve eq44 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq44
  have eq46 : False := by grind
  exact eq46

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation3128` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation3128 : Law3.StructuralFrom Law3128 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation3128

