import equational_theories.Definability.VBox_03

/-!
# The diagonal obligation for `Equation3744`, inherited

Generated by `defwork/dfmono.py`.  `Equation3744` is `x ◇ y = (x ◇ z) ◇ (w ◇ y)`, which implies
`Equation3670` (`x ◇ x = (x ◇ y) ◇ (z ◇ x)`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation3744 : AutBox.DiagFix Law3744 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation3670
  rw [@Law3670.models_iff G M]
  rw [@Law3744.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y z; grind (splits := 60) (ematch := 40))
