import equational_theories.Definability.AutBox
import equational_theories.Definability.CanBox_00

/-!
# Structurality from `Equation556` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation556` is `x = y ◇ (z ◇ (y ◇ (x ◇ z)))`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation556`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3724` from `Equation556`: `x = y ◇ (z ◇ (y ◇ (x ◇ z)))` ⊢ `x ◇ y = (x ◇ y) ◇ (y ◇ x)`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation3724_StructuralFromFin_Equation556 : Law3724.StructuralFromFin Law556 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation556
    (fun {G} M hM ↦ ?_)
  have hm := (@Law556.models_iff G M).mp hM
  rw [@Law3724.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

