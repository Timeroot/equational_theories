import equational_theories.Definability.AutBox
import equational_theories.Definability.ImpBox_02

/-!
# The diagonal obligation for `Equation2666`, inherited

Generated by `defwork/dfmono.py`.  `Equation2666` is `x = ((x ◇ y) ◇ (x ◇ z)) ◇ y`, which implies
`Equation2660` (`x = ((x ◇ y) ◇ (x ◇ x)) ◇ y`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

theorem DiagFix_Equation2666 : AutBox.DiagFix Law2666 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation2660
  rw [@Law2660.models_iff G M]
  rw [@Law2666.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y; grind (splits := 60) (ematch := 40))
