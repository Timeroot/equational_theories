/-- The arguments as one mixed-radix index, which is how `rankArr6AC` is addressed. -/
def encT6AC (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2) : Nat :=
  a.1 * 5184 +
    b.1 * 1728 +
    c.1 * 576 +
    d.1 * 144 +
    e.1 * 48 +
    f.1 * 24 +
    g.1 * 12 +
    h.1 * 4 +
    i.1 * 2 +
    j.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank6AC (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    : Fin 12 :=
  ⟨min (rankArr6AC.getD (encT6AC a b c d e f g h i j) 0) 11, by omega⟩


/-- `2` of the `882` demanded maps and `2` of the `45774` forbidden ones, enough to separate the
`12` members from the other `15540` invariant tuples between them. The certificate still demands and
forbids all `46656`; these are the lists `mem_rank6AC` scans, once per tuple, with a scan that is
quadratic in their length. -/
def e0idx6AC : Fin 2 → Fin 882
  | 0 => 11
  | 1 => 189
def x0idx6AC : Fin 2 → Fin 45774
  | 0 => 0
  | 1 => 79

def endE06AC (j : Fin 2) : Fin 6 → Fin 6 := endE6AC (e0idx6AC j)

def endX06AC (j : Fin 2) : Fin 6 → Fin 6 := endX6AC (x0idx6AC j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6AC (i : Fin 12) : Magma (Fin 6) := Magma.mk (mem6AC i)

theorem end6AC_isEndo (i : Fin 12) (j : Fin 882) : (end6AC i).IsEndo (endE6AC j) := by
  revert i j; native_decide

theorem end6AC_not_isEndo (i : Fin 12) (j : Fin 45774) : ¬ (end6AC i).IsEndo (endX6AC j) := by
  revert i j; native_decide

/-- `rank6AC` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6AC` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6AC (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6AC a b c d e f g h i j) endE06AC endX06AC = true) :
    mem6AC (rank6AC a b c d e f g h i j) = tab6AC a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `12` listed
members. -/
theorem mem_of_isExact6AC (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6AC a b c d e f g h i j) endE06AC endX06AC = true) :
    ∃ idx, mem6AC idx = tab6AC a b c d e f g h i j :=
  ⟨_, mem_rank6AC a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6AC`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6AC` turns that into a member index. -/
theorem exists_end6AC {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6AC j))
    (hX : ∀ j, ¬ M.IsEndo (endX6AC j)) : ∃ i, end6AC i = M := by
  have hP : ∀ i, M.IsEndo (permE6AC i) := by
    intro i; rw [permE6AC_eq_endE6AC]; exact hE (uidx6AC i)
  have hop : M.op = Magma.transport permE6AC tr6AC (fun i ↦ M.op (rep6AC i).1 (rep6AC i).2) :=
    Magma.op_eq_transport (rep := rep6AC) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC0) (a := (rep6AC 0).1) (b := (rep6AC 0).2)
    (val := val6AC0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC1) (a := (rep6AC 1).1) (b := (rep6AC 1).2)
    (val := val6AC1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC2) (a := (rep6AC 2).1) (b := (rep6AC 2).2)
    (val := val6AC2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC3) (a := (rep6AC 3).1) (b := (rep6AC 3).2)
    (val := val6AC3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC4) (a := (rep6AC 4).1) (b := (rep6AC 4).2)
    (val := val6AC4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC5) (a := (rep6AC 5).1) (b := (rep6AC 5).2)
    (val := val6AC5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC6) (a := (rep6AC 6).1) (b := (rep6AC 6).2)
    (val := val6AC6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC7) (a := (rep6AC 7).1) (b := (rep6AC 7).2)
    (val := val6AC7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC8) (a := (rep6AC 8).1) (b := (rep6AC 8).2)
    (val := val6AC8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6AC) (idx := stabIdx6AC9) (a := (rep6AC 9).1) (b := (rep6AC 9).2)
    (val := val6AC9) hP (by decide) (by decide)
  have hdec : dec6AC a b c d e f g h i j = fun i ↦ M.op (rep6AC i).1 (rep6AC i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6AC a b c d e f g h i j = M.op := by
    rw [tab6AC_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6AC a b c d e f g h i j) endE06AC endX06AC = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6AC j), fun j ↦ hX (x0idx6AC j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6AC a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`882` monoid of `Magma.endE6AC`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6AC {L L' : Law.NatMagmaLaw} {i : Fin 12}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6AC i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6AC j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6AC i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6AC
    (fun k ↦ (Magma.end6AC_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6AC_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
