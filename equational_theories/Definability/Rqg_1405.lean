import equational_theories.Definability.DiagRow

/-!
# `Equation1405` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1405` is `x = y ◇ (((z ◇ w) ◇ y) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1405`: `x = y ◇ (((z ◇ w) ◇ y) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1405 : DiagRow.RowQG Law1405 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1405.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u u) u) z), (hm z u u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op (M.op (M.op X2 X3) X1) X0)) = X0 := by
    intro X0 X1 X2 X3
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X5 : G, (M.op X1 (M.op (M.op X0 X1) X5)) = X5 := by
    intro X0 X1 X5
    first
    | (have i₁ := eq4 X5 X1 x (M.op (M.op (M.op x x) x) X0)
       have i₂ := eq4 X0 x x x
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 X3 X4 X5 : G, (M.op (M.op (M.op (M.op X1 X2) (M.op X3 X4)) X0) (M.op X0 X5)) = X5 := by
    intro X0 X1 X2 X3 X4 X5
    first
    | (have i₁ := eq4 X5 (M.op (M.op (M.op X1 X2) (M.op X3 X4)) X0) X3 X4
       have i₂ := eq4 X0 (M.op X3 X4) X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X0 X3)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq8 X2 (M.op (M.op X1 X2) X0) X3
       have i₂ := eq8 X1 X2 X0
       grind)
    | exact superpose eq8 eq8
    | exact resolve eq8 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq44 : ∀ X0 X1 X2 X3 : G, y = (M.op (M.op (M.op (M.op X0 X1) (M.op X2 X3)) x) (M.op x x)) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq9 x X0 X1 X2 X3 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq50 : x = y := by
    first
    | (have i₁ := eq44 x x x x
       have i₂ := eq13 x (M.op x x) (M.op x x) x
       grind)
    | exact superpose eq13 eq44
    | exact resolve eq44 eq13
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13 eq44
  have eq53 : False := by grind
  exact eq53

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1405` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1405 : Law3.StructuralFrom Law1405 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1405
