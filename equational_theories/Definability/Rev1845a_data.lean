theorem rev1845a_splitFacts : ∀ i : Fin 25,
    (∀ x y, (rev1845aSub (rev1845aWk i) (rev1845aWe i)).op x y = (rev1845aClone i).op x y) ∨
      (∀ x y, (rev1845aClone i).op x y = (rev1845aBad (rev1845aWb i)).op x y) := by
