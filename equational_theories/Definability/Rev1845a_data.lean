theorem rev1845a_subFacts :
    (∀ k x y, (rev1845aSub k (rev1845aP 0 k)).op x y = x) ∧
      (∀ k x y, (rev1845aSub k (rev1845aP 1 k)).op x y = y) ∧
      (∀ k i j l x y, (rev1845aSub k (rev1845aSc k i j l)).op x y =
        (rev1845aSub k i).op ((rev1845aSub k j).op x y) ((rev1845aSub k l).op x y)) ∧
      ∀ k j, ¬ ∀ x y, (rev1845aSub k j).op x y = rev1845a.op x y := by
  decideFin!

theorem rev1845a_isSubclone (k : Fin 4) : IsSubclone (rev1845aSub k) :=
  IsSubclone.of_table (rev1845aP 0 k) (rev1845aP 1 k) (rev1845aSc k)
    (rev1845a_subFacts.1 k) (rev1845a_subFacts.2.1 k) (rev1845a_subFacts.2.2.1 k)

theorem rev1845a_notInSub (k : Fin 4) : ¬ InClone (rev1845aSub k) rev1845a.op :=
  notInClone_of (rev1845a_subFacts.2.2.2 k)

