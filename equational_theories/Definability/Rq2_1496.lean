import equational_theories.Definability.DiagRow

/-!
# `Equation1496` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1496` is `x = (y ◇ x) ◇ (y ◇ (z ◇ z))`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1496`: `x = (y ◇ x) ◇ (y ◇ (z ◇ z))`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1496 : DiagRow.ColQG Law1496 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1496.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op (M.op u u) u) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) (M.op X1 (M.op X2 X2))) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op (M.op (M.op u u) u) z) u) := by grind
    clear hm nh hM
    have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X1) X0) X2) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op (M.op X1 X1) X0) (M.op X1 X1)
         have i₂ := eq3 X0 (M.op X1 X1) X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq13 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq7 u u z
         grind)
      | exact superpose eq7 eq4
      | (have r₁ := eq4
         have r₂ := eq7 u u z
         grind)
      | exact resolve eq4 eq7
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq7
    have eq16 : False := by grind
    exact eq16
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u u) u) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) (M.op X1 (M.op X2 X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op (M.op x x) (M.op y (M.op X0 X0))) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X1) X0) X2) X0) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op (M.op X1 X1) X0) (M.op X1 X1)
       have i₂ := eq4 X0 (M.op X1 X1) X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq15 : ∀ X0 X1 : G, (M.op (M.op x X1) (M.op y (M.op X0 X0))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq10 (M.op y (M.op X0 X0)) x X1
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq10
    | exact resolve eq10 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq18 : ∀ X0 X1 : G, (M.op X0 X0) = (M.op X1 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq10 X0 (M.op X1 X1) (M.op X1 X1)
       have i₂ := eq10 (M.op X1 X1) X1 X0
       grind)
    | exact superpose eq10 eq10
    | exact resolve eq10 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq80 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X0) (M.op X1 (M.op X2 X2))) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 X1 X2
       have i₂ := eq18 X1 X0
       grind)
    | (have i₁ := eq4 X1 X1 X2
       have i₂ := eq18 X0 X1
       grind)
    | exact superpose eq18 eq4
    | exact resolve eq4 eq18
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq18
  have eq320 : y = x := by
    first
    | (have i₁ := eq15 x x
       have i₂ := eq80 x y x
       grind)
    | exact superpose eq80 eq15
    | exact resolve eq15 eq80
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq15 eq80
  have eq348 : False := by grind
  exact eq348

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1496` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1496 : Law3.StructuralFrom Law1496 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1496
