import equational_theories.Definability.DiagRow

/-!
# `Equation1932` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1932` is `x = (y ◇ (y ◇ y)) ◇ (x ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1932`: `x = (y ◇ (y ◇ y)) ◇ (x ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1932 : DiagRow.ColQG Law1932 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1932.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op u (M.op u u)) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op X1 (M.op X1 X1)) (M.op X0 X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op (M.op (M.op u (M.op u u)) z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 : G, (M.op X1 (M.op X1 X1)) = (M.op (M.op (M.op X0 X1) (M.op (M.op X0 X1) (M.op X0 X1))) X0) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op X1 (M.op X1 X1)) (M.op X0 X1)
         have i₂ := eq3 X0 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq8 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op (M.op X1 X0) (M.op X1 X0))) = (M.op (M.op X1 (M.op X1 X1)) (M.op X0 (M.op X0 X0))) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op X1 X0) (M.op (M.op X1 X0) (M.op X1 X0))) X1
         have i₂ := eq5 X1 X0
         grind)
      | exact superpose eq5 eq3
      | exact resolve eq3 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq19 : ∀ X0 X1 : G, (M.op X1 (M.op X1 X1)) = (M.op (M.op (M.op X0 (M.op X0 X0)) (M.op X1 (M.op X1 X1))) X0) := by
      intro X0 X1
      first
      | (have i₁ := eq5 X0 X1
         have i₂ := eq8 X1 X0
         grind)
      | exact superpose eq8 eq5
      | exact resolve eq5 eq8
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq23 : ∀ X0 : G, (M.op (M.op (M.op X0 X0) X0) (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0))) = X0 := by
      intro X0
      first
      | (have i₁ := eq3 X0 (M.op X0 X0)
         have i₂ := eq8 X0 (M.op X0 X0)
         grind)
      | exact superpose eq8 eq3
      | exact resolve eq3 eq8
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq8
    have eq134 : ∀ X0 X1 : G, (M.op (M.op (M.op X1 (M.op X1 X1)) X0) X1) = X0 := by
      intro X0 X1
      first
      | (have i₁ := eq19 X0 (M.op (M.op X0 X0) X0)
         have i₂ := eq23 X0
         grind)
      | exact superpose eq23 eq19
      | exact resolve eq19 eq23
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq19 eq23
    have eq220 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq134 z u
         grind)
      | exact superpose eq134 eq4
      | (have r₁ := eq4
         have r₂ := eq134 z u
         grind)
      | exact resolve eq4 eq134
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq134
    have eq227 : False := by grind
    exact eq227
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X1 (M.op X1 X1)) (M.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : y = (M.op (M.op x (M.op x x)) (M.op x x)) := by
    first
    | (have i₁ := eq4 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : y = x := by
    first
    | (have i₁ := eq7
       have i₂ := eq4 x x
       grind)
    | exact superpose eq4 eq7
    | exact resolve eq7 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq10 : False := by grind
  exact eq10

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1932` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1932 : Law3.StructuralFrom Law1932 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1932
