import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_13

/-!
# Structurality from `Equation329` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation329` is `x ◇ y = x ◇ (z ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = Y then X else m(Y,X)`
is an automorphism -- is `GuardAut_pxx_y_x_pyx_Equation329`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 13 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation8` from `Equation329`: `x ◇ y = x ◇ (z ◇ y)` ⊢ `x = x ◇ (x ◇ x)`,
through `x □ y = if m(X,X) = Y then X else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation8_StructuralFromFin_Equation329 : Law8.StructuralFromFin Law329 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_y_x_pyx_Equation329 (fun {G} M hM ↦ ?_)
  have hm := (@Law329.models_iff G M).mp hM
  rw [@Law8.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

