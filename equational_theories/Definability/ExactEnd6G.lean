def e0idx6G : Fin 2 → Fin 100
  | 0 => 0
  | 1 => 27
def x0idx6G : Fin 2 → Fin 46556
  | 0 => 42
  | 1 => 43

def endE06G (j : Fin 2) : Fin 6 → Fin 6 := endE6G (e0idx6G j)

def endX06G (j : Fin 2) : Fin 6 → Fin 6 := endX6G (x0idx6G j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6G (i : Fin 3) : Magma (Fin 6) := Magma.mk (mem6G i)

theorem end6G_isEndo (i : Fin 3) (j : Fin 100) : (end6G i).IsEndo (endE6G j) := by
  revert i j; native_decide

theorem end6G_not_isEndo (i : Fin 3) (j : Fin 46556) : ¬ (end6G i).IsEndo (endX6G j) := by
  revert i j; native_decide

/-- `rank6G` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6G` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6G (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6G a b c d e f g h i j) endE06G endX06G = true) :
    mem6G (rank6G a b c d e f g h i j) = tab6G a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `3` listed
members. -/
theorem mem_of_isExact6G (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6G a b c d e f g h i j) endE06G endX06G = true) :
    ∃ idx, mem6G idx = tab6G a b c d e f g h i j :=
  ⟨_, mem_rank6G a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6G`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6G` turns that into a member index. -/
theorem exists_end6G {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6G j))
    (hX : ∀ j, ¬ M.IsEndo (endX6G j)) : ∃ i, end6G i = M := by
  have hP : ∀ i, M.IsEndo (permE6G i) := by
    intro i; rw [permE6G_eq_endE6G]; exact hE (uidx6G i)
  have hop : M.op = Magma.transport permE6G tr6G (fun i ↦ M.op (rep6G i).1 (rep6G i).2) :=
    Magma.op_eq_transport (rep := rep6G) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G0) (a := (rep6G 0).1) (b := (rep6G 0).2)
    (val := val6G0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G1) (a := (rep6G 1).1) (b := (rep6G 1).2)
    (val := val6G1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G2) (a := (rep6G 2).1) (b := (rep6G 2).2)
    (val := val6G2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G3) (a := (rep6G 3).1) (b := (rep6G 3).2)
    (val := val6G3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G4) (a := (rep6G 4).1) (b := (rep6G 4).2)
    (val := val6G4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G5) (a := (rep6G 5).1) (b := (rep6G 5).2)
    (val := val6G5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G6) (a := (rep6G 6).1) (b := (rep6G 6).2)
    (val := val6G6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G7) (a := (rep6G 7).1) (b := (rep6G 7).2)
    (val := val6G7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G8) (a := (rep6G 8).1) (b := (rep6G 8).2)
    (val := val6G8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6G) (idx := stabIdx6G9) (a := (rep6G 9).1) (b := (rep6G 9).2)
    (val := val6G9) hP (by decide) (by decide)
  have hdec : dec6G a b c d e f g h i j = fun i ↦ M.op (rep6G i).1 (rep6G i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6G a b c d e f g h i j = M.op := by
    rw [tab6G_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6G a b c d e f g h i j) endE06G endX06G = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6G j), fun j ↦ hX (x0idx6G j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6G a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`100` monoid of `Magma.endE6G`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6G {L L' : Law.NatMagmaLaw} {i : Fin 3}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6G i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6G j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6G i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6G
    (fun k ↦ (Magma.end6G_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6G_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
