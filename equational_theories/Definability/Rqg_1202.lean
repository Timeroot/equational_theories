import equational_theories.Definability.DiagRow

/-!
# `Equation1202` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1202` is `x = y ◇ ((z ◇ (w ◇ y)) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1202`: `x = y ◇ ((z ◇ (w ◇ y)) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1202 : DiagRow.RowQG Law1202 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1202.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), (hm z u u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op (M.op X2 (M.op X3 X1)) X0)) = X0 := by
    intro X0 X1 X2 X3
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq9 : ∀ X0 X4 : G, (M.op X0 (M.op X0 X4)) = X4 := by
    intro X0 X4
    first
    | (have i₁ := eq4 X4 X0 x (M.op x (M.op x x))
       have i₂ := eq4 X0 x x x
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq9 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq16 : x = y := by
    first
    | (have i₁ := eq11
       have i₂ := eq9 x x
       grind)
    | (have i₁ := eq11
       have i₂ := eq9 x (M.op x (M.op x x))
       grind)
    | exact superpose eq9 eq11
    | exact resolve eq11 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9 eq11
  have eq17 : False := by grind
  exact eq17

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1202` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1202 : Law3.StructuralFrom Law1202 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1202
