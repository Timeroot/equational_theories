import equational_theories.Definability.AutBox
import equational_theories.Definability.Kax_17

/-!
# Structurality from `Equation4388` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation4388` is `x ◇ (x ◇ x) = (y ◇ y) ◇ x`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then X else m(Y,X)`
is an automorphism -- is `GuardAut_pyy_y_x_pyx_Equation4388`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation817` from `Equation4388`: `x ◇ (x ◇ x) = (y ◇ y) ◇ x` ⊢ `x = x ◇ ((x ◇ x) ◇ (x ◇ x))`,
through `x □ y = if m(Y,Y) = Y then X else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation817_StructuralFromFin_Equation4388 : Law817.StructuralFromFin Law4388 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pyy_y_x_pyx_Equation4388 (fun {G} M hM ↦ ?_)
  have hm := (@Law4388.models_iff G M).mp hM
  rw [@Law817.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

