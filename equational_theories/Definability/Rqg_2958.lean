import equational_theories.Definability.DiagRow

/-!
# `Equation2958` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2958` is `x = ((y ◇ (y ◇ z)) ◇ x) ◇ z`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2958`: `x = ((y ◇ (y ◇ z)) ◇ x) ◇ z`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2958 : DiagRow.ColQG Law2958 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2958.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 (M.op X1 X2)) X0) X2) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op (M.op X1 (M.op X1 X2)) X0) X0) X3) X2) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op X1 (M.op X1 X2)) X0) X2
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X0 (M.op X0 X1)) X2) X2) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 (M.op X0 (M.op X0 X1)) X2
       have i₂ := eq4 (M.op (M.op X0 (M.op X0 X1)) X2) X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X2 X3 : G, (M.op (M.op X2 X3) X2) = X3 := by
    intro X2 X3
    first
    | (have i₁ := eq8 x x X2 X3
       have i₂ := eq9 x X2 x
       grind)
    | exact superpose eq9 eq8
    | exact resolve eq8 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq9
  have eq11 : x = (M.op (M.op x x) y) := by
    first
    | (have i₁ := eq10 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq10
    | exact resolve eq10 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq10 (M.op X1 X0) X1
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq10
    | exact resolve eq10 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq17 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq10 (M.op x x) y
       have i₂ := eq11
       grind)
    | exact superpose eq11 eq10
    | exact resolve eq10 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10 eq11
  have eq20 : y = x := by
    first
    | (have i₁ := eq17
       have i₂ := eq13 x x
       grind)
    | exact superpose eq13 eq17
    | exact resolve eq17 eq13
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13 eq17
  have eq21 : False := by grind
  exact eq21

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2958` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2958 : Law3.StructuralFrom Law2958 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2958
