import equational_theories.Definability.AutBox
import equational_theories.Definability.ImpBox_00

/-!
# The diagonal obligation for `Equation960`, inherited

Generated by `defwork/dfmono.py`.  `Equation960` is `x = y ◇ ((z ◇ y) ◇ (x ◇ x))`, which implies
`Equation879` (`x = y ◇ ((x ◇ y) ◇ (x ◇ x))`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation960 : AutBox.DiagFix Law960 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation879
  rw [@Law879.models_iff G M]
  rw [@Law960.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y; grind (splits := 60) (ematch := 40))
