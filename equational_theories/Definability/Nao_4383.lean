theorem Equation1629_StructuralFromFin_Equation4383 : Law1629.StructuralFromFin Law4383 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxy_y_pyy_x_pxy_y_pxy_Equation4383 (fun {G} M hM ↦ ?_)
  have hm := (@Law4383.models_iff G M).mp hM
  rw [@Law1629.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

