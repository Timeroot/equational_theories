import equational_theories.Definability.DiagRow

/-!
# `Equation2167` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2167` is `x = ((y ◇ z) ◇ x) ◇ (y ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2167`: `x = ((y ◇ z) ◇ x) ◇ (y ◇ z)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation2167 : DiagRow.RowQG Law2167 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2167.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op z u) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X1 X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op z u)) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X3 : G, (M.op (M.op X0 X3) X0) = X3 := by
      intro X0 X3
      first
      | (have i₁ := eq3 X0 (M.op (M.op x x) X0) (M.op x x)
         have i₂ := eq3 X0 x x
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq9 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X0)) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq3 X1 X1 X0
         have i₂ := eq6 X1 X0
         grind)
      | exact superpose eq6 eq3
      | exact resolve eq3 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq21 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq9 u z
         grind)
      | exact superpose eq9 eq4
      | (have r₁ := eq4
         have r₂ := eq9 u z
         grind)
      | exact resolve eq4 eq9
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq9
    have eq22 : False := by grind
    exact eq22
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z u), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X1 X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 X3 : G, (M.op (M.op X0 X3) X0) = X3 := by
    intro X0 X3
    first
    | (have i₁ := eq4 X0 (M.op (M.op x x) X0) (M.op x x)
       have i₂ := eq4 X0 x x
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : y = (M.op (M.op x x) x) := by
    first
    | (have i₁ := eq9 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq15 : x = y := by
    first
    | (have i₁ := eq10
       have i₂ := eq9 x x
       grind)
    | (have i₁ := eq10
       have i₂ := eq9 x (M.op (M.op x x) x)
       grind)
    | exact superpose eq9 eq10
    | exact resolve eq10 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9 eq10
  have eq16 : False := by grind
  exact eq16

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation2167` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2167 : Law3.StructuralFrom Law2167 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation2167
