import equational_theories.Definability.DiagRow

/-!
# `Equation1304` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1304` is `x = y ◇ (((x ◇ z) ◇ z) ◇ y)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1304`: `x = y ◇ (((x ◇ z) ◇ z) ◇ y)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1304 : DiagRow.RowQG Law1304 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1304.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op z u) u) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op (M.op X0 X2) X2) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op (M.op X0 (M.op (M.op (M.op X0 X3) X3) X2)) X1)) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 X1 (M.op (M.op (M.op X0 X3) X3) X2)
       have i₂ := eq4 X0 X2 X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op X0 X1) X1) (M.op (M.op X2 X3) X3)) X0) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 (M.op (M.op (M.op X0 X1) X1) (M.op (M.op X2 X3) X3)) X3
       have i₂ := eq4 X0 (M.op (M.op X2 X3) X3) X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq21 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X1)) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq8 X0 X1 X0 x
       have i₂ := eq4 X0 X0 x
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq49 : ∀ X0 X1 X2 X3 X4 : G, (M.op X1 (M.op (M.op (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) (M.op X0 X4)) X1)) = X4 := by
    intro X0 X1 X2 X3 X4
    first
    | (have i₁ := eq8 (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) X1 X4 (M.op (M.op X0 X2) X2)
       have i₂ := eq9 (M.op (M.op X0 X2) X2) X3 X0 X2
       grind)
    | exact superpose eq9 eq8
    | exact resolve eq8 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq50 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op X0 X1)) = (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) X1 (M.op (M.op X0 X2) X2)
       have i₂ := eq9 (M.op (M.op X0 X2) X2) X3 X0 X2
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq58 : ∀ X0 X2 X3 : G, (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) = X0 := by
    intro X0 X2 X3
    first
    | (have i₁ := eq50 X0 x X2 X3
       have i₂ := eq21 X0 x
       grind)
    | exact superpose eq21 eq50
    | exact resolve eq50 eq21
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq50
  have eq59 : ∀ X0 X2 X3 X4 : G, (M.op (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) (M.op X0 X4)) = X4 := by
    intro X0 X2 X3 X4
    first
    | (have i₁ := eq49 X0 x X2 X3 X4
       have i₂ := eq21 (M.op (M.op (M.op (M.op (M.op X0 X2) X2) X3) X3) (M.op X0 X4)) x
       grind)
    | exact superpose eq21 eq49
    | exact resolve eq49 eq21
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq49
  have eq69 : ∀ X0 X4 : G, (M.op X0 (M.op X0 X4)) = X4 := by
    intro X0 X4
    first
    | (have i₁ := eq59 X0 x x X4
       have i₂ := eq58 X0 x x
       grind)
    | exact superpose eq58 eq59
    | exact resolve eq59 eq58
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq58 eq59
  have eq150 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq69 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq69
    | exact resolve eq69 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq69
  have eq185 : x = y := by
    first
    | (have i₁ := eq150
       have i₂ := eq21 x x
       grind)
    | exact superpose eq21 eq150
    | exact resolve eq150 eq21
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq21 eq150
  have eq193 : False := by grind
  exact eq193

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1304` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1304 : Law3.StructuralFrom Law1304 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1304
