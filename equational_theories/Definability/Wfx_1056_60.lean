/-- Two models of `Equation1056` on one carrier with the same `(x ◇ (y ◇ (x ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) Law1056 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law1056.models_iff G M).mp hM
  have hn := (@Law1056.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 (M.op X2 X0)) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X1 (N.op X2 X0)) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op X0 X0))) = (N.op X0 (N.op X1 (N.op X0 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X1 X0 (M.op X1 (M.op x X0))
       have i₂ := eq5 X0 X1 x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq16 : ∀ X0 X1 : G, (N.op X1 (N.op X0 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X1 X0 (N.op X1 (N.op x X0))
       have i₂ := eq6 X0 X1 x
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq22 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op X1 X1))) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq16 X1 X0
       grind)
    | exact superpose eq16 eq7
    | exact resolve eq7 eq16
    | grind
    | grind (splits := 40)
  clear eq16
  have eq37 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq22 X0 X1
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq22
    | exact resolve eq22 eq10
    | grind
    | grind (splits := 40)
  clear eq10 eq22
  have eq80 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq37 b a
       grind)
    | exact superpose eq37 eq8
    | exact resolve eq8 eq37
    | grind
    | grind (splits := 40)
  clear eq37
  have eq94 : False := by grind
  exact eq94

