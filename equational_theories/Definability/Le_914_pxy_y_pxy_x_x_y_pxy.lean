      (∀ a b : G, (M.op a b) = b ∨ (M.op a b) = a ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law3288 by
    refine h _ (fun a b ↦ ?_) (fun a b ↦ ?_) (fun a b ↦ ?_)
    · rw [AutBox.iteOf2_apply ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 0) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1)) M a b]
