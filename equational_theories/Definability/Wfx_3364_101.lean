through the companion `x □ y = (x ◇ (x ◇ (x ◇ y)))`. -/
theorem Equation3319_StructuralFromFin_Equation3364 : Law3319.StructuralFromFin Law3364 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law3364.models_iff G M).mp hM
  rw [@Law3319.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 1)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

