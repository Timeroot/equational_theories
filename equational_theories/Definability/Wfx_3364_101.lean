/-- Two models of `Equation3364` on one carrier with the same `(x ◇ (x ◇ (x ◇ y)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 1))) Law3364 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law3364.models_iff G M).mp hM
  have hn := (@Law3364.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 X1) = (M.op X1 (M.op X2 (M.op X0 X2))) := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 X1) = (N.op X1 (N.op X2 (N.op X0 X2))) := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X0 X1))) = (N.op X0 (N.op X0 (N.op X0 X1))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 X2 : G, (M.op X1 X2) = (M.op X2 (M.op X0 (M.op X0 X1))) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq5 X1 X2 (M.op X0 X1)
       have i₂ := eq5 X0 (M.op X0 X1) X1
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq12 : ∀ X0 X1 X2 : G, (N.op X1 X2) = (N.op X2 (N.op X0 (N.op X0 X1))) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq6 X1 X2 (N.op X0 X1)
       have i₂ := eq6 X0 (N.op X0 X1) X1
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq66 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X1 (M.op X1 (M.op X1 X0))) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq12 X1 X0 X1
       grind)
    | exact superpose eq12 eq7
    | exact resolve eq7 eq12
    | grind
    | grind (splits := 40)
  clear eq12
  have eq74 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq66 X0 X1
       have i₂ := eq10 X1 X0 X1
       grind)
    | exact superpose eq10 eq66
    | exact resolve eq66 eq10
    | grind
    | grind (splits := 40)
  clear eq10 eq66
  have eq210 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq74 a b
       grind)
    | exact superpose eq74 eq8
    | exact resolve eq8 eq74
    | grind
    | grind (splits := 40)
  clear eq74
  have eq222 : False := by grind
  exact eq222

