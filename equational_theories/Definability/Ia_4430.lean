import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_27

/-!
# Structurality from `Equation4430` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation4430` is `x ◇ (x ◇ y) = (z ◇ w) ◇ w`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,Y) = Y then X else m(X,Y)`
is an automorphism -- is `GuardAut_pxy_y_x_pxy_Equation4430`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 6 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1224` from `Equation4430`: `x ◇ (x ◇ y) = (z ◇ w) ◇ w` ⊢ `x = x ◇ (((x ◇ x) ◇ x) ◇ y)`,
through `x □ y = if m(X,Y) = Y then X else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation1224_StructuralFromFin_Equation4430 : Law1224.StructuralFromFin Law4430 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxy_y_x_pxy_Equation4430 (fun {G} M hM ↦ ?_)
  have hm := (@Law4430.models_iff G M).mp hM
  rw [@Law1224.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

