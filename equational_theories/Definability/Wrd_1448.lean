import equational_theories.Definability.AutBox

/-!
# Structurality from `Equation1448` through a word companion

Generated by `defwork/wcell.py`.  `Equation1448` is `x = (x ◇ y) ◇ (x ◇ (z ◇ y))`.  The companion is
`x □ y = W(x, y)` for a word `W` below: `haut` says the companion
has no automorphism the magma lacks, which is the whole reverse half of `StructuralOnMagma` on a
finite carrier, and each theorem then only has to check that the source forces its target of `W`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

/-- Every bijection of a model of `Equation1448` respecting `(y ◇ (x ◇ x))` respects `◇`. -/
private theorem haut0 : ∀ {G : Type} [Finite G] (M : Magma G), satisfies G Law1448 →
    ∀ σ τ : G → G, (∀ a : G, τ (σ a) = a) → (∀ a : G, σ (τ a) = a) →
    (∀ a b : G, σ (@evalInMagma _ _ M ![a, b] (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)))
      = @evalInMagma _ _ M ![σ a, σ b] (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) →
    ∀ a b : G, σ (M.op a b) = M.op (σ a) (σ b) := by
  intro G _ M hM σ τ h1 h2 hw a b
  have h := (@Law1448.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hw
  first
  | grind
  | grind (splits := 30) (ematch := 20)

/-- `Equation10` from `Equation1448`: `x = (x ◇ y) ◇ (x ◇ (z ◇ y))` ⊢ `x = x ◇ (y ◇ x)`,
through the companion `x □ y = (y ◇ (x ◇ x))`. -/
theorem Equation10_StructuralFromFin_Equation1448 : Law10.StructuralFromFin Law1448 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law1448.models_iff G M).mp hM
  rw [@Law10.models_iff _ ((AutBox.wordOf (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
