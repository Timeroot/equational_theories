/-- `Equation10` from `Equation1448`: `x = (x ◇ y) ◇ (x ◇ (z ◇ y))` ⊢ `x = x ◇ (y ◇ x)`,
through the companion `x □ y = (y ◇ (x ◇ x))`.  Vampire refutation replayed step by step. -/
theorem Equation10_StructuralFromFin_Equation1448 : Law10.StructuralFromFin Law1448 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law1448.models_iff G M).mp hM
  suffices hk : ∀ N : Magma G, (∀ a b : G, N.op a b = @evalInMagma _ _ M ![a, b] (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) →
      @satisfies _ G N Law10 by
    exact hk _ (fun a b ↦ AutBox.wordOf_apply (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)) M a b)
  intro N hw
  rw [@Law10.models_iff G N]
  intro x y
  
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Matrix.cons_val_fin_one] at hw
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X1) (M.op X0 (M.op X2 X1))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X1 (M.op X0 X0)) := by
    intro X0 X1
    grind
  have eq6 : x ≠ (N.op x (N.op y x)) := by grind
  clear h hw nh hM
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X1 (M.op X0 (M.op X2 X3))) (M.op X1 X0)) = X1 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X1 (M.op X0 (M.op X2 X3)) (M.op X0 X3)
       have i₂ := eq4 X0 X3 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
