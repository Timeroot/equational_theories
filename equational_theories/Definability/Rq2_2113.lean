import equational_theories.Definability.DiagRow

/-!
# `Equation2113` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2113` is `x = ((y ◇ x) ◇ z) ◇ (y ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2113`: `x = ((y ◇ x) ◇ z) ◇ (y ◇ z)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation2113 : DiagRow.ColQG Law2113 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2113.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op u z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X0) X2) (M.op X1 X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op u z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X1 X2) = (M.op (M.op X0 X3) (M.op (M.op (M.op X1 X0) X2) X3)) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op X1 X2) (M.op (M.op X1 X0) X2) X3
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq6 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 X0) (M.op X1 X2))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X1 X0) (M.op X1 X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq24 : ∀ X0 X1 X2 : G, (M.op X1 X2) = (M.op (M.op X0 (M.op X1 X2)) X0) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq5 X0 X1 X2 (M.op X1 X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq5
      | exact resolve eq5 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq38 : ∀ X0 X3 : G, (M.op (M.op X3 X0) X3) = X0 := by
      intro X0 X3
      first
      | (have i₁ := eq24 X0 X0 (M.op (M.op x X0) (M.op x x))
         have i₂ := eq6 X0 x x
         grind)
      | exact superpose eq6 eq24
      | exact resolve eq24 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6 eq24
    have eq236 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq38 z u
         grind)
      | exact superpose eq38 eq4
      | (have r₁ := eq4
         have r₂ := eq38 z u
         grind)
      | exact resolve eq4 eq38
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq38
    have eq247 : False := by grind
    exact eq247
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X0) X2) (M.op X1 X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op (M.op (M.op x x) X0) (M.op y X0)) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 X2) = (M.op (M.op X0 X3) (M.op (M.op (M.op X1 X0) X2) X3)) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op X1 X2) (M.op (M.op X1 X0) X2) X3
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op (M.op X1 X0) X2) X3) (M.op X1 X2)) X0) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op X1 X0) X2) (M.op X1 X2)
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq15 : ∀ X0 X1 : G, (M.op y X0) = (M.op (M.op x X1) (M.op (M.op (M.op x x) X0) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op y X0) (M.op (M.op x x) X0) X1
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq16 : ∀ X0 : G, (M.op y X0) = (M.op x X0) := by
    intro X0
    first
    | (have i₁ := eq15 X0 x
       have i₂ := eq8 x x X0 x
       grind)
    | exact superpose eq8 eq15
    | exact resolve eq15 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq15
  have eq150 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 X2) X3) (M.op X1 X3)) = (M.op (M.op X0 X2) X0) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq8 X0 (M.op (M.op X1 X2) X3) (M.op X1 X3) X2
       have i₂ := eq11 X2 X1 X3 X0
       grind)
    | exact superpose eq11 eq8
    | exact resolve eq8 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq11
  have eq159 : ∀ X0 X2 : G, (M.op (M.op X0 X2) X0) = X2 := by
    intro X0 X2
    first
    | (have i₁ := eq150 X0 x X2 x
       have i₂ := eq4 X2 x x
       grind)
    | exact superpose eq4 eq150
    | exact resolve eq150 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq150
  have eq185 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq159 (M.op X1 X0) X1
       have i₂ := eq159 X1 X0
       grind)
    | exact superpose eq159 eq159
    | exact resolve eq159 eq159
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq159
  have eq263 : ∀ X0 : G, y = (M.op X0 (M.op x X0)) := by
    intro X0
    first
    | (have i₁ := eq185 X0 y
       have i₂ := eq16 X0
       grind)
    | exact superpose eq16 eq185
    | exact resolve eq185 eq16
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq16
  have eq301 : y = x := by
    first
    | (have i₁ := eq263 x
       have i₂ := eq185 x x
       grind)
    | exact superpose eq185 eq263
    | exact resolve eq263 eq185
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq185 eq263
  have eq316 : False := by grind
  exact eq316

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2113` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2113 : Law3.StructuralFrom Law2113 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2113
