import equational_theories.Definability.AutBox
import equational_theories.Definability.DFn_1904

/-!
# Structurality from `Equation1904` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation1904` is `x = (y ◇ (x ◇ z)) ◇ (x ◇ x)`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation1904`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation619` from `Equation1904`: `x = (y ◇ (x ◇ z)) ◇ (x ◇ x)` ⊢ `x = x ◇ (x ◇ ((y ◇ x) ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation619_StructuralFromFin_Equation1904 : Law619.StructuralFromFin Law1904 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation1904
    (fun {G} M hM ↦ ?_)
  have hm := (@Law1904.models_iff G M).mp hM
  rw [@Law619.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

/-- `Equation832` from `Equation1904`: `x = (y ◇ (x ◇ z)) ◇ (x ◇ x)` ⊢ `x = x ◇ ((y ◇ x) ◇ (x ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation832_StructuralFromFin_Equation1904 : Law832.StructuralFromFin Law1904 := by
