import equational_theories.Definability.DiagRow

/-!
# `Equation2044` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2044` is `x = ((x ◇ x) ◇ y) ◇ (y ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2044`: `x = ((x ◇ x) ◇ y) ◇ (y ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation2044 : DiagRow.ColQG Law2044 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2044.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op z z) (M.op (M.op u u) (M.op u u))) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X0) X1) (M.op X1 X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op (M.op (M.op z z) (M.op (M.op u u) (M.op u u))) u) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 : G, (M.op (M.op (M.op X1 X1) (M.op (M.op X0 X0) (M.op X0 X0))) X0) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq3 X1 (M.op (M.op X0 X0) (M.op X0 X0))
         have i₂ := eq3 X0 (M.op X0 X0)
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq31 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq6 u z
         grind)
      | exact superpose eq6 eq4
      | (have r₁ := eq4
         have r₂ := eq6 u z
         grind)
      | exact resolve eq4 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq32 : False := by grind
    exact eq32
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op z z) (M.op (M.op u u) (M.op u u))), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X0) X1) (M.op X1 X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) (M.op X0 X0)) = (M.op (M.op X0 X1) (M.op X1 X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op X0 X0) (M.op X0 X0)) X1
       have i₂ := eq4 X0 (M.op X0 X0)
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq19 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X1) (M.op X1 X1)) (M.op (M.op X0 X1) (M.op X1 X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X0 (M.op X0 X0)
       have i₂ := eq7 X0 X1
       grind)
    | (have i₁ := eq4 X1 (M.op X1 X1)
       have i₂ := eq7 X1 X1
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq127 : y = (M.op (M.op (M.op x x) (M.op x x)) (M.op (M.op x x) (M.op x x))) := by
    first
    | (have i₁ := eq19 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq19
    | exact resolve eq19 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq19
  have eq166 : y = x := by
    first
    | (have i₁ := eq127
       have i₂ := eq4 x (M.op x x)
       grind)
    | exact superpose eq4 eq127
    | exact resolve eq127 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq127
  have eq167 : False := by grind
  exact eq167

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2044` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2044 : Law3.StructuralFrom Law2044 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2044
