/-!
# Structurality from `Equation840` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation840` is `x = x ◇ ((y ◇ x) ◇ (z ◇ z))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = m(Y,X) then X else m(Y,X)`
is an automorphism -- is `GuardAut_pxx_pyx_x_pyx_Equation840`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 11 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3` from `Equation840`: `x = x ◇ ((y ◇ x) ◇ (z ◇ z))` ⊢ `x = x ◇ x`,
through `x □ y = if m(X,X) = m(Y,X) then X else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3_StructuralFromFin_Equation840 : Law3.StructuralFromFin Law840 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_pyx_x_pyx_Equation840 (fun {G} M hM ↦ ?_)
  have hm := (@Law840.models_iff G M).mp hM
  rw [@Law3.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

