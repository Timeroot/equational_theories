import equational_theories.Definability.DiagRow

/-!
# `Equation2316` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2316` is `x = (y ◇ (x ◇ (z ◇ y))) ◇ z`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2316`: `x = (y ◇ (x ◇ (z ◇ y))) ◇ z`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2316 : DiagRow.ColQG Law2316 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2316.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op z (M.op u u))), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X0 (M.op X2 X1))) X2) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X1 (M.op X2 X0)) (M.op X3 (M.op X0 (M.op X1 X3)))) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 X1 (M.op X3 (M.op X0 (M.op X1 X3)))
       have i₂ := eq4 X0 X3 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq20 : ∀ X0 X1 : G, y = (M.op (M.op X0 (M.op x x)) (M.op X1 (M.op x (M.op X0 X1)))) := by
    intro X0 X1
    first
    | (have i₁ := eq8 x X0 y X1
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq8
    | exact resolve eq8 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq40 : y = x := by
    first
    | (have i₁ := eq20 x x
       have i₂ := eq8 x x x x
       grind)
    | exact superpose eq8 eq20
    | exact resolve eq20 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq20
  have eq42 : False := by grind
  exact eq42

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2316` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2316 : Law3.StructuralFrom Law2316 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2316
