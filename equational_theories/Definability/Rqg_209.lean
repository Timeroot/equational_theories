import equational_theories.Definability.DiagRow

/-!
# `Equation209` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation209` is `x = (x ◇ (y ◇ x)) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation209`: `x = (x ◇ (y ◇ x)) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation209 : DiagRow.ColQG Law209 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law209.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op u z)), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X0 (M.op X1 X0)) X1) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : x = (M.op (M.op x (M.op x x)) y) := by
    first
    | (have i₁ := eq4 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op X0 (M.op X1 X0))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op X0 (M.op X1 X0))
       have i₂ := eq4 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : y = (M.op (M.op y x) (M.op x (M.op x x))) := by
    first
    | (have i₁ := eq4 y (M.op x (M.op x x))
       have i₂ := eq7
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq10 : y = (M.op (M.op x x) (M.op x (M.op x x))) := by
    first
    | (have i₁ := eq9
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq11 : y = x := by
    first
    | (have i₁ := eq10
       have i₂ := eq8 x x
       grind)
    | exact superpose eq8 eq10
    | exact resolve eq10 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq10
  have eq12 : False := by grind
  exact eq12

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation209` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation209 : Law3.StructuralFrom Law209 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation209
