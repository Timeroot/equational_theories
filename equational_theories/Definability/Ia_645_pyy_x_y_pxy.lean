import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_34

/-!
# Structurality from `Equation645` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation645` is `x = x ◇ (y ◇ ((y ◇ z) ◇ x))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = X then Y else m(X,Y)`
is an automorphism -- is `GuardAut_pyy_x_y_pxy_Equation645`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1629` from `Equation645`: `x = x ◇ (y ◇ ((y ◇ z) ◇ x))` ⊢ `x = (x ◇ x) ◇ ((x ◇ x) ◇ x)`,
through `x □ y = if m(Y,Y) = X then Y else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation1629_StructuralFromFin_Equation645 : Law1629.StructuralFromFin Law645 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pyy_x_y_pxy_Equation645 (fun {G} M hM ↦ ?_)
  have hm := (@Law645.models_iff G M).mp hM
  rw [@Law1629.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

