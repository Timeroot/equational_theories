namespace Magma

/-- A member of the class, as the `6` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R302 : Type := {w : Fin 6 → Fin 9 // Magma.tupOK S9R302.E S9R302.tr S9R302.z S9R302.st S9R302.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R302 (v : tup9R302) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R302.E S9R302.tr v.1)

end Magma

/-! ### The source exhibits

`3` members of the class, chosen by greedy cover so that between them they model all `43` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `decide!` rather than `decide` because the invariance test is `81` cells times the `48`
group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R3020 : Array Nat := #[2, 0, 1, 5, 0, 2]

def vsrch9R3020 : Magma.tup9R302 :=
  ⟨fun i ↦ ⟨vdsrch9R3020[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩

def vdsrch9R3021 : Array Nat := #[2, 1, 0, 8, 1, 2]

def vsrch9R3021 : Magma.tup9R302 :=
  ⟨fun i ↦ ⟨vdsrch9R3021[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩

def vdsrch9R3022 : Array Nat := #[1, 2, 0, 4, 0, 2]

def vsrch9R3022 : Magma.tup9R302 :=
  ⟨fun i ↦ ⟨vdsrch9R3022[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `48`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R302Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R3020 : Array (Array Nat) := #[#[2, 0, 1, 5, 3, 4, 8, 6, 7], #[1, 2, 0, 4, 5, 3, 7, 8, 6], #[0, 1, 2, 3, 4, 5, 6, 7, 8], #[8, 6, 7, 2, 0, 1, 5, 3, 4], #[7, 8, 6, 1, 2, 0, 4, 5, 3], #[6, 7, 8, 0, 1, 2, 3, 4, 5], #[5, 3, 4, 8, 6, 7, 2, 0, 1], #[4, 5, 3, 7, 8, 6, 1, 2, 0], #[3, 4, 5, 6, 7, 8, 0, 1, 2]]

def opsrch9R3020 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R3020[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R3020 :
    ∀ x y, Magma.transport S9R302.E S9R302.tr vsrch9R3020.1 x y = opsrch9R3020 x y := by
  native_decide

theorem esrch9R3020 : Magma.srch9R302 vsrch9R3020 = Magma.mk opsrch9R3020 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R3020 x y)

