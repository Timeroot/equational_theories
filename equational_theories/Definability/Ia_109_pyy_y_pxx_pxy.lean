import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_04

/-!
# Structurality from `Equation109` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation109` is `x = x ◇ ((y ◇ y) ◇ z)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then m(X,X) else m(X,Y)`
is an automorphism -- is `GuardAut_pyy_y_pxx_pxy_Equation109`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3457` from `Equation109`: `x = x ◇ ((y ◇ y) ◇ z)` ⊢ `x ◇ x = x ◇ ((x ◇ x) ◇ y)`,
through `x □ y = if m(Y,Y) = Y then m(X,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3457_StructuralFromFin_Equation109 : Law3457.StructuralFromFin Law109 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pyy_y_pxx_pxy_Equation109 (fun {G} M hM ↦ ?_)
  have hm := (@Law109.models_iff G M).mp hM
  rw [@Law3457.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

