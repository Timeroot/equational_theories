/-- Two models of `Equation3541` on one carrier with the same `(y ◇ ((x ◇ y) ◇ x))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 1 ⋆ ((Lf 0 ⋆ Lf 1) ⋆ Lf 0)) Law3541 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 1 ⋆ ((Lf 0 ⋆ Lf 1) ⋆ Lf 0)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law3541.models_iff G M).mp hM
  have hn := (@Law3541.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X0 X1) = (M.op X0 (M.op (M.op X2 X3) X1)) := by
    intro X0 X1 X2 X3
    grind
  have eq6 : ∀ X0 X1 X2 X3 : G, (N.op X0 X1) = (N.op X0 (N.op (N.op X2 X3) X1)) := by
    intro X0 X1 X2 X3
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X1 (M.op (M.op X0 X1) X0)) = (N.op X1 (N.op (N.op X0 X1) X0)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq19 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X0 (M.op (M.op X1 X0) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 X1 X1 X0
       have i₂ := eq7 X1 X0
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq24 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq19 X0 X1
       have i₂ := eq5 X0 X1 X1 X0
       grind)
    | exact superpose eq5 eq19
    | exact resolve eq19 eq5
    | grind
    | grind (splits := 40)
  clear eq19
  have eq42 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq24 a b
       grind)
    | exact superpose eq24 eq8
    | exact resolve eq8 eq24
    | grind
    | grind (splits := 40)
  clear eq24
  have eq49 : False := by grind
  exact eq49

