/-- `Equation332` from `Equation492`: `x = y ◇ (x ◇ (z ◇ (z ◇ y)))` ⊢ `x ◇ y = y ◇ (x ◇ x)`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation332_StructuralFromFin_Equation492 : Law332.StructuralFromFin Law492 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation492
    (fun {G} M hM ↦ ?_)
  exact key492_332 M _ hM
    (fun a b ↦ (eq_or_ne a b).imp id (QFOp.diagOf_ne (Lf 0) M a b))
    (fun a ↦ by rw [QFOp.diagOf_eq (Lf 0) M a a rfl]; simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one])
