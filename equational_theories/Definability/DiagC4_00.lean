      have eq11 : x ≠ x := by first | exact superpose eq6 eq8 | exact mod_symm (superpose eq6 eq8) | exact superpose eq8 eq6 | exact mod_symm (superpose eq8 eq6)
      first | exact eq11 rfl | exact eq11 _ rfl | exact eq11 _ _ rfl | exact eq11 _ _ _ rfl

