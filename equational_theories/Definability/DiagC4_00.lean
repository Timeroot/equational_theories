  rcases eq_or_ne x (M.op x (M.op (M.op x x) x)) with e0 | e0
  · skip
    simp only [qA_diag, qA_eq M _ _ e0]
    all_goals
      by_contra nh
      have eq7 : x = (x ◇ ((x ◇ x) ◇ x)) := mod_symm e0
      have eq8 : x ≠ (x ◇ ((x ◇ x) ◇ x)) := mod_symm nh
