/-- the companion: `x □ y = if x = y then (x ◇ ((x ◇ x) ◇ x)) else x ◇ y` -/
private def qA : QFOp := QFOp.diagOf (Lf 0 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ Lf 0))

private theorem qA_ne {G : Type} (M : Magma G) (a b : G) (h : a ≠ b) :
    (qA.magma M).op a b = M.op a b := QFOp.diagOf_ne _ M a b h

private theorem qA_eq {G : Type} (M : Magma G) (a b : G) (h : a = b) :
    (qA.magma M).op a b = (M.op a (M.op (M.op a a) a)) := by
  refine (QFOp.diagOf_eq (Lf 0 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ Lf 0)) M a b h).trans ?_
  first | rfl | simp [evalInMagma]

private theorem qA_diag {G : Type} (M : Magma G) (a : G) :
    (qA.magma M).op a a = (M.op a (M.op (M.op a a) a)) := qA_eq M a a rfl

/-- `x = y ◇ (y ◇ ((z ◇ z) ◇ x))`: the word `((x □ x) □ (x □ x))` names `x ◇ x` whenever `a ≠ x`. -/
private theorem sound731 {G : Type} (M : Magma G) (hM : satisfies G Law731) (x a : G)
    (hax : a ≠ x) :
    @evalInMagma _ _ (qA.magma M) ![x, a] ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) = M.op x x := by
  have h := (@Law731.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]
  simp only [qA_diag]
  all_goals
    by_contra nh
    have eq6 (X0 X1 X2 : G) : (X1 ◇ (X1 ◇ ((X2 ◇ X2) ◇ X0))) = X0 := mod_symm (h ..)
    have eq8 : (x ◇ x) ≠ ((x ◇ ((x ◇ x) ◇ x)) ◇ (((x ◇ ((x ◇ x) ◇ x)) ◇ (x ◇ ((x ◇ x) ◇ x))) ◇ (x ◇ ((x ◇ x) ◇ x)))) := mod_symm nh
    have eq9 (X0 X1 X2 X3 : G) : ((X2 ◇ X2) ◇ ((X3 ◇ X3) ◇ X0)) = (X1 ◇ (X1 ◇ X0)) := by first | exact superpose eq6 eq6 | exact mod_symm (superpose eq6 eq6) | exact superpose eq6 eq6 | exact mod_symm (superpose eq6 eq6)
    have eq10 (X0 X1 X2 : G) : ((X2 ◇ X2) ◇ X0) = ((X1 ◇ X1) ◇ X0) := by first | exact superpose eq6 eq6 | exact mod_symm (superpose eq6 eq6) | exact superpose eq6 eq6 | exact mod_symm (superpose eq6 eq6)
    have eq28 (X0 : G) : (x ◇ x) ≠ ((x ◇ ((x ◇ x) ◇ x)) ◇ ((X0 ◇ X0) ◇ (x ◇ ((x ◇ x) ◇ x)))) := by first | exact superpose eq10 eq8 | exact mod_symm (superpose eq10 eq8) | exact superpose eq8 eq10 | exact mod_symm (superpose eq8 eq10)
    have eq36 (X0 X1 : G) : (x ◇ x) ≠ ((x ◇ ((X0 ◇ X0) ◇ x)) ◇ ((X1 ◇ X1) ◇ (x ◇ ((X0 ◇ X0) ◇ x)))) := by first | exact superpose eq10 eq28 | exact mod_symm (superpose eq10 eq28) | exact superpose eq28 eq10 | exact mod_symm (superpose eq28 eq10)
    have eq50 (X0 X1 X4 : G) : (X0 ◇ (X0 ◇ X1)) = (X4 ◇ (X4 ◇ X1)) := by first | exact superpose eq9 eq9 | exact mod_symm (superpose eq9 eq9) | exact superpose eq9 eq9 | exact mod_symm (superpose eq9 eq9)
    have eq67 (X0 X1 X2 X4 : G) : ((X4 ◇ X4) ◇ X1) = (X2 ◇ (X2 ◇ (X0 ◇ (X0 ◇ X1)))) := by first | exact superpose eq9 eq6 | exact mod_symm (superpose eq9 eq6) | exact superpose eq6 eq9 | exact mod_symm (superpose eq6 eq9)
    have eq68 (X0 X1 X2 : G) : ((X2 ◇ X2) ◇ (X0 ◇ (X0 ◇ X1))) = X1 := by first | exact superpose eq9 eq6 | exact mod_symm (superpose eq9 eq6) | exact superpose eq6 eq9 | exact mod_symm (superpose eq6 eq9)
    have eq193 (X0 X1 X2 X3 : G) : (((X0 ◇ X0) ◇ (X1 ◇ X1)) ◇ (X2 ◇ (X2 ◇ X3))) = X3 := by first | exact superpose eq10 eq68 | exact mod_symm (superpose eq10 eq68) | exact superpose eq68 eq10 | exact mod_symm (superpose eq68 eq10)
    have eq196 (X0 X1 X2 X3 : G) : (X3 ◇ X1) = ((X2 ◇ X2) ◇ (X3 ◇ (X0 ◇ (X0 ◇ X1)))) := by first | exact superpose eq50 eq68 | exact mod_symm (superpose eq50 eq68) | exact superpose eq68 eq50 | exact mod_symm (superpose eq68 eq50)
    have eq789 (X0 X1 X3 : G) : (x ◇ x) ≠ ((x ◇ (X0 ◇ (X0 ◇ (X1 ◇ (X1 ◇ x))))) ◇ ((X3 ◇ X3) ◇ (x ◇ (X0 ◇ (X0 ◇ (X1 ◇ (X1 ◇ x))))))) := by first | exact superpose eq67 eq36 | exact mod_symm (superpose eq67 eq36) | exact superpose eq36 eq67 | exact mod_symm (superpose eq36 eq67)
