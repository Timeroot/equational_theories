    have eq16 : (x ◇ x) ≠ ((x ◇ ((x ◇ x) ◇ x)) ◇ (((x ◇ x) ◇ (x ◇ ((x ◇ x) ◇ x))) ◇ (x ◇ ((x ◇ x) ◇ x)))) := by first | exact superpose eq11 eq8 | exact mod_symm (superpose eq11 eq8) | exact superpose eq8 eq11 | exact mod_symm (superpose eq8 eq11)
    have eq25 : (x ◇ x) ≠ (x ◇ (x ◇ (x ◇ ((x ◇ x) ◇ x)))) := by first | exact superpose eq10 eq16 | exact mod_symm (superpose eq10 eq16) | exact superpose eq16 eq10 | exact mod_symm (superpose eq16 eq10)
