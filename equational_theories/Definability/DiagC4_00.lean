/-- `x = y ◇ (z ◇ ((y ◇ z) ◇ x))`: the word `((x □ x) □ (x □ x))` names `x ◇ x` whenever `a ≠ x`. -/
private theorem sound765 {G : Type} (M : Magma G) (hM : satisfies G Law765) (x a : G)
    (hax : a ≠ x) :
    @evalInMagma _ _ (qA.magma M) ![x, a] ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) = M.op x x := by
  have h := (@Law765.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]
  simp only [qA_diag]
  all_goals
    by_contra nh
    have eq6 (X0 X1 X2 : G) : (X1 ◇ (X2 ◇ ((X1 ◇ X2) ◇ X0))) = X0 := mod_symm (h ..)
    have eq8 : (x ◇ x) ≠ ((x ◇ ((x ◇ x) ◇ x)) ◇ (((x ◇ ((x ◇ x) ◇ x)) ◇ (x ◇ ((x ◇ x) ◇ x))) ◇ (x ◇ ((x ◇ x) ◇ x)))) := mod_symm nh
