    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq89 : ∀ X0 X1 : G, y = (M.op (M.op X0 x) (M.op (M.op (M.op x x) (M.op X1 X0)) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq9 X1 X0 y (M.op (M.op x x) (M.op X1 X0))
       have i₂ := eq7 (M.op X1 X0)
