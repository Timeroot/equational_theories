def opsrch9R10011 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R10011[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R10011 :
    ∀ x y, Magma.transport S9R1001.E S9R1001.tr vsrch9R10011.1 x y = opsrch9R10011 x y := by
