import equational_theories.Definability.DiagRow

/-!
# `Equation2789` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2789` is `x = ((y ◇ z) ◇ (y ◇ x)) ◇ z`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2789`: `x = ((y ◇ z) ◇ (y ◇ x)) ◇ z`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2789 : DiagRow.ColQG Law2789 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2789.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u u) (M.op u z)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X2) (M.op X1 X0)) X2) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 (M.op (M.op (M.op X1 X2) (M.op X1 X0)) X3)) X2) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op X1 X2) (M.op X1 X0)) X2
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 : G, x = (M.op (M.op (M.op y X0) (M.op x x)) X0) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq28 : ∀ X0 X2 : G, (M.op (M.op X0 X0) X2) = X2 := by
    intro X0 X2
    first
    | (have i₁ := eq8 X0 x X2 X2
       have i₂ := eq4 X0 x X2
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq40 : x = (M.op (M.op x x) y) := by
    first
    | (have i₁ := eq9 y
       have i₂ := eq28 y (M.op x x)
       grind)
    | exact superpose eq28 eq9
    | exact resolve eq9 eq28
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq50 : y = x := by
    first
    | (have i₁ := eq40
       have i₂ := eq28 x y
       grind)
    | (have i₁ := eq40
       have i₂ := eq28 x (M.op (M.op x x) y)
       grind)
    | exact superpose eq28 eq40
    | exact resolve eq40 eq28
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq28 eq40
  have eq51 : False := by grind
  exact eq51

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2789` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2789 : Law3.StructuralFrom Law2789 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2789
