namespace Magma

/-- A member of the class, as the `11` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R414 : Type := {w : Fin 11 → Fin 9 // Magma.tupOK S9R414.E S9R414.tr S9R414.z S9R414.st S9R414.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R414 (v : tup9R414) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R414.E S9R414.tr v.1)

end Magma

/-! ### The source exhibits

`1` members of the class, chosen by greedy cover so that between them they model all `4` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `81` cells times
the `144` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R4140 : Array Nat := #[3, 0, 7, 0, 0, 3, 3, 5, 0, 3, 3]

def vsrch9R4140 : Magma.tup9R414 :=
  ⟨fun i ↦ ⟨vdsrch9R4140[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `144`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R414Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R4140 : Array (Array Nat) := #[#[3, 0, 7, 0, 0, 0, 0, 8, 2], #[0, 3, 2, 3, 5, 6, 4, 7, 8], #[8, 2, 3, 2, 2, 2, 2, 0, 7], #[0, 3, 2, 3, 3, 3, 3, 7, 8], #[0, 6, 2, 3, 3, 1, 5, 7, 8], #[0, 4, 2, 3, 6, 3, 1, 7, 8], #[0, 5, 2, 3, 1, 4, 3, 7, 8], #[2, 7, 8, 7, 7, 7, 7, 3, 0], #[7, 8, 0, 8, 8, 8, 8, 2, 3]]

def opsrch9R4140 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R4140[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R4140 :
    ∀ x y, Magma.transport S9R414.E S9R414.tr vsrch9R4140.1 x y = opsrch9R4140 x y := by
  native_decide

theorem esrch9R4140 : Magma.srch9R414 vsrch9R4140 = Magma.mk opsrch9R4140 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R4140 x y)
