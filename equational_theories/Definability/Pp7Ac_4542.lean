/-!
# Structurality from `Equation4542` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation4542` is `x ◇ (y ◇ z) = (z ◇ x) ◇ z`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a a) = (M.op b b) then (M.op a b) else if (M.op b b) = b then (M.op a a) else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pxx_pyy_pyy_y_pxy_pxx_pxy_Equation4542`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3262` from `Equation4542`: `x ◇ (y ◇ z) = (z ◇ x) ◇ z` ⊢ `x ◇ x = x ◇ (y ◇ (y ◇ y))`,
through `x □ y = if (M.op a a) = (M.op b b) then (M.op a b) else if (M.op b b) = b then (M.op a a) else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation3262_StructuralFromFin_Equation4542 : Law3262.StructuralFromFin Law4542 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_pyy_pyy_y_pxy_pxx_pxy_Equation4542 (fun {G} M hM ↦ ?_)
  have hm := (@Law4542.models_iff G M).mp hM
  rw [@Law3262.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

