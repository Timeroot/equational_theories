/-!
# Structurality from `Equation3755` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation3755` is `x ◇ y = (y ◇ x) ◇ (z ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a b) = a then b else if (M.op a b) = b then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pxy_x_pxy_y_y_x_pxy_Equation3755`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation820` from `Equation3755`: `x ◇ y = (y ◇ x) ◇ (z ◇ y)` ⊢ `x = x ◇ ((x ◇ x) ◇ (y ◇ y))`,
through `x □ y = if (M.op a b) = a then b else if (M.op a b) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation820_StructuralFromFin_Equation3755 : Law820.StructuralFromFin Law3755 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxy_x_pxy_y_y_x_pxy_Equation3755 (fun {G} M hM ↦ ?_)
  have hm := (@Law3755.models_iff G M).mp hM
  rw [@Law820.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

