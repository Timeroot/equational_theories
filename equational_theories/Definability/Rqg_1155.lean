import equational_theories.Definability.DiagRow

/-!
# `Equation1155` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1155` is `x = y ◇ ((z ◇ (x ◇ z)) ◇ y)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1155`: `x = y ◇ ((z ◇ (x ◇ z)) ◇ y)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1155 : DiagRow.RowQG Law1155 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1155.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op z u)) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X2 (M.op X0 X2)) X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op X0 (M.op (M.op y (M.op x x)) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 x X0 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X3 : G, (M.op X3 (M.op X0 X3)) = (M.op X1 (M.op X0 X1)) := by
    intro X0 X1 X3
    first
    | (have i₁ := eq4 (M.op X1 (M.op X0 X1)) X3 x
       have i₂ := eq4 X0 x X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 : G, (M.op y (M.op x x)) = (M.op X0 (M.op x X0)) := by
    intro X0
    first
    | (have i₁ := eq4 (M.op y (M.op x x)) X0 x
       have i₂ := eq7 x
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq43 : ∀ X0 X1 X2 X3 : G, (M.op X2 (M.op (M.op (M.op X1 X3) (M.op X0 (M.op X1 X0))) X2)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 X2 (M.op X1 X3)
       have i₂ := eq9 X1 X0 X3
       grind)
    | (have i₁ := eq4 X3 X2 (M.op X1 X3)
       have i₂ := eq9 X1 X3 X0
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq89 : ∀ X0 X1 : G, y = (M.op X1 (M.op (M.op (M.op x x) (M.op X0 (M.op x X0))) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 y X1 (M.op x x)
       have i₂ := eq13 X0
       grind)
    | exact superpose eq13 eq4
    | exact resolve eq4 eq13
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13
  have eq102 : x = y := by
    first
    | (have i₁ := eq89 x x
       have i₂ := eq43 x x x x
       grind)
    | exact superpose eq43 eq89
    | exact resolve eq89 eq43
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq43 eq89
  have eq103 : False := by grind
  exact eq103

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1155` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1155 : Law3.StructuralFrom Law1155 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1155
