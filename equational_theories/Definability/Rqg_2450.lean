import equational_theories.Definability.DiagRow

/-!
# `Equation2450` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2450` is `x = (x ◇ ((x ◇ y) ◇ y)) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2450`: `x = (x ◇ ((x ◇ y) ◇ y)) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2450 : DiagRow.ColQG Law2450 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2450.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op (M.op z u) u)), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X0 (M.op (M.op X0 X1) X1)) X1) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : y = (M.op (M.op y (M.op (M.op x x) x)) x) := by
    first
    | (have i₁ := eq4 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X0 X1) X1)) = (M.op (M.op (M.op X0 (M.op (M.op X0 X1) X1)) (M.op X0 X1)) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op X0 (M.op (M.op X0 X1) X1)) X1
       have i₂ := eq4 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 X1 : G, (M.op (M.op X0 (M.op (M.op X0 X1) X1)) (M.op X0 X1)) = (M.op (M.op (M.op (M.op X0 (M.op (M.op X0 X1) X1)) (M.op X0 X1)) X0) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq8 (M.op X0 (M.op (M.op X0 X1) X1)) X1
       have i₂ := eq4 X0 X1
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq30 : ∀ X0 : G, (M.op (M.op X0 (M.op (M.op X0 X0) X0)) (M.op X0 X0)) = (M.op (M.op X0 (M.op (M.op X0 X0) X0)) X0) := by
    intro X0
    first
    | (have i₁ := eq12 X0 X0
       have i₂ := eq8 X0 X0
       grind)
    | exact superpose eq8 eq12
    | exact resolve eq12 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq38 : ∀ X0 : G, (M.op (M.op X0 (M.op (M.op X0 X0) X0)) (M.op X0 X0)) = X0 := by
    intro X0
    first
    | (have i₁ := eq30 X0
       have i₂ := eq4 X0 X0
       grind)
    | exact superpose eq4 eq30
    | exact resolve eq30 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq30
  have eq51 : ∀ X0 : G, (M.op (M.op X0 X0) X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq12 X0 X0
       have i₂ := eq38 X0
       grind)
    | exact superpose eq38 eq12
    | exact resolve eq12 eq38
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq12 eq38
  have eq93 : y = (M.op (M.op y x) x) := by
    first
    | (have i₁ := eq7
       have i₂ := eq51 x
       grind)
    | exact superpose eq51 eq7
    | exact resolve eq7 eq51
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq100 : y = (M.op (M.op x x) x) := by
    first
    | (have i₁ := eq93
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq93
    | exact resolve eq93 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq93
  have eq106 : y = x := by
    first
    | (have i₁ := eq100
       have i₂ := eq51 x
       grind)
    | exact superpose eq51 eq100
    | exact resolve eq100 eq51
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq51 eq100
  have eq110 : False := by grind
  exact eq110

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2450` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2450 : Law3.StructuralFrom Law2450 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2450
