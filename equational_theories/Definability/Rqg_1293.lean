import equational_theories.Definability.DiagRow

/-!
# `Equation1293` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1293` is `x = y ◇ (((x ◇ y) ◇ z) ◇ z)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1293`: `x = y ◇ (((x ◇ y) ◇ z) ◇ z)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1293 : DiagRow.RowQG Law1293 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1293.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op z u) u) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op (M.op X0 X1) X2) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op y (M.op (M.op (M.op x x) X0) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op X0 X1) X2) X2) (M.op (M.op X0 X3) X3)) = X1 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X1 (M.op (M.op (M.op X0 X1) X2) X2) X3
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : ∀ X0 X1 : G, y = (M.op (M.op (M.op (M.op x x) X0) X0) (M.op (M.op x X1) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 y (M.op (M.op (M.op x x) X0) X0) X1
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq12 : x = y := by
    first
    | (have i₁ := eq11 x x
       have i₂ := eq8 x x x x
       grind)
    | exact superpose eq8 eq11
    | exact resolve eq11 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq11
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1293` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1293 : Law3.StructuralFrom Law1293 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1293
