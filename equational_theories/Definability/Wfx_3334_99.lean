/-!
# Structurality from `Equation3334` through the companion `x □ y = (y ◇ (x ◇ (x ◇ x)))`

Generated by `defwork/wffit.py`.  `Equation3334` is `x ◇ y = x ◇ (z ◇ (z ◇ y))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation3334` on one carrier with the same table of
`(y ◇ (x ◇ (x ◇ x)))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation3334` on one carrier with the same `(y ◇ (x ◇ (x ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 1 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 0))) Law3334 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 1 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law3334.models_iff G M).mp hM
  have hn := (@Law3334.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 X1) = (M.op X0 (M.op X2 (M.op X2 X1))) := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 X1) = (N.op X0 (N.op X2 (N.op X2 X1))) := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op X0 X0))) = (N.op X1 (N.op X0 (N.op X0 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq17 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X0 (M.op X1 (M.op X1 X1))) := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 X1 X1
       have i₂ := eq7 X1 X0
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq20 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq17 X0 X1
       have i₂ := eq5 X0 X1 X1
       grind)
    | exact superpose eq5 eq17
    | exact resolve eq17 eq5
    | grind
    | grind (splits := 40)
  clear eq17
  have eq43 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq20 a b
       grind)
    | exact superpose eq20 eq8
    | exact resolve eq8 eq20
    | grind
    | grind (splits := 40)
  clear eq20
  have eq50 : False := by grind
  exact eq50

/-- `Equation4131` from `Equation3334`: `x ◇ y = x ◇ (z ◇ (z ◇ y))` ⊢ `x ◇ y = ((x ◇ y) ◇ y) ◇ y`,
through the companion `x □ y = (y ◇ (x ◇ (x ◇ x)))`. -/
theorem Equation4131_StructuralFromFin_Equation3334 : Law4131.StructuralFromFin Law3334 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 1 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law3334.models_iff G M).mp hM
  rw [@Law4131.models_iff _ ((AutBox.wordOf (Lf 1 ⋆ (Lf 0 ⋆ (Lf 0 ⋆ Lf 0)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

