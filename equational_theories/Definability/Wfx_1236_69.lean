  have eq19 : ∀ X0 X1 : G, (N.op X0 (N.op X0 X1)) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq18 X0 X1 x x
       have i₂ := eq6 (N.op X0 X1) x x
       grind)
    | exact superpose eq6 eq18
    | exact resolve eq18 eq6
    | grind
    | grind (splits := 40)
  clear eq18
  have eq38 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq19 X0 (N.op X0 x)
       have i₂ := eq19 X0 x
       grind)
    | exact superpose eq19 eq19
    | exact resolve eq19 eq19
    | grind
    | grind (splits := 40)
  clear eq19
  have eq57 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X0 X1
       have i₂ := eq38 X0
       grind)
    | exact superpose eq38 eq7
    | exact resolve eq7 eq38
    | grind
    | grind (splits := 40)
  clear eq38
  have eq60 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq57 X0 X1
       have i₂ := eq13 X0
       grind)
    | exact superpose eq13 eq57
    | exact resolve eq57 eq13
    | grind
    | grind (splits := 40)
  clear eq13 eq57
  have eq156 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq60 b a
       grind)
    | exact superpose eq60 eq8
    | exact resolve eq8 eq60
    | grind
    | grind (splits := 40)
  clear eq60
