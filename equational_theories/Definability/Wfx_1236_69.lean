/-- Two models of `Equation1236` on one carrier with the same `(y ◇ (x ◇ x))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)) Law1236 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law1236.models_iff G M).mp hM
  have hn := (@Law1236.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op (M.op X0 X1) X2) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op (N.op X0 X1) X2) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = (N.op X1 (N.op X0 X0)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op X0 X1) (M.op (M.op (M.op (M.op X0 X1) X2) X3) X3))) = X0 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq5 X0 X1 (M.op (M.op (M.op (M.op X0 X1) X2) X3) X3)
       have i₂ := eq5 (M.op X0 X1) X2 X3
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq11 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq10 X0 X1 x x
       have i₂ := eq5 (M.op X0 X1) x x
       grind)
    | exact superpose eq5 eq10
    | exact resolve eq10 eq5
    | grind
    | grind (splits := 40)
  clear eq10
  have eq13 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq11 X0 (M.op X0 x)
       have i₂ := eq11 X0 x
       grind)
    | exact superpose eq11 eq11
    | exact resolve eq11 eq11
    | grind
    | grind (splits := 40)
  clear eq11
  have eq18 : ∀ X0 X1 X2 X3 : G, (N.op X0 (N.op (N.op X0 X1) (N.op (N.op (N.op (N.op X0 X1) X2) X3) X3))) = X0 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq6 X0 X1 (N.op (N.op (N.op (N.op X0 X1) X2) X3) X3)
       have i₂ := eq6 (N.op X0 X1) X2 X3
       grind)
    | exact superpose eq6 eq6
