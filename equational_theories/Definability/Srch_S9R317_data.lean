namespace Magma

/-- A member of the class, as the `3` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R317 : Type := {w : Fin 3 → Fin 9 // Magma.tupOK S9R317.E S9R317.tr S9R317.z S9R317.st S9R317.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R317 (v : tup9R317) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R317.E S9R317.tr v.1)

end Magma

/-! ### The source exhibits

`1` members of the class, chosen by greedy cover so that between them they model all `28` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `decide!` rather than `decide` because the invariance test is `81` cells times the `72`
group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R3170 : Array Nat := #[0, 0, 4]

def vsrch9R3170 : Magma.tup9R317 :=
  ⟨fun i ↦ ⟨vdsrch9R3170[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `72`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R317Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R3170 : Array (Array Nat) := #[#[0, 0, 0, 0, 4, 5, 0, 7, 8], #[1, 1, 1, 3, 1, 5, 6, 1, 8], #[2, 2, 2, 3, 4, 2, 6, 7, 2], #[3, 1, 2, 3, 3, 3, 3, 7, 8], #[0, 4, 2, 4, 4, 4, 6, 4, 8], #[0, 1, 5, 5, 5, 5, 6, 7, 5], #[6, 1, 2, 6, 4, 5, 6, 6, 6], #[0, 7, 2, 3, 7, 5, 7, 7, 7], #[0, 1, 8, 3, 4, 8, 8, 8, 8]]

def opsrch9R3170 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R3170[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R3170 :
    ∀ x y, Magma.transport S9R317.E S9R317.tr vsrch9R3170.1 x y = opsrch9R3170 x y := by
  native_decide

theorem esrch9R3170 : Magma.srch9R317 vsrch9R3170 = Magma.mk opsrch9R3170 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R3170 x y)
