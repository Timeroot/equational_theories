/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `54`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R174Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R1740 : Array (Array Nat) := #[#[0, 2, 3, 4, 5, 6, 1, 0, 0], #[2, 1, 7, 1, 0, 1, 8, 6, 4], #[3, 7, 2, 8, 2, 0, 2, 5, 1], #[4, 3, 8, 3, 7, 3, 0, 2, 6], #[5, 0, 4, 7, 4, 8, 4, 1, 3], #[6, 5, 0, 5, 8, 5, 7, 4, 2], #[1, 8, 6, 0, 6, 7, 6, 3, 5], #[7, 6, 5, 2, 1, 4, 3, 7, 7], #[8, 4, 1, 6, 3, 2, 5, 8, 8]]

def opsrch9R1740 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R1740[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R1740 :
    ∀ x y, Magma.transport S9R174.E S9R174.tr vsrch9R1740.1 x y = opsrch9R1740 x y := by
  native_decide

theorem esrch9R1740 : Magma.srch9R174 vsrch9R1740 = Magma.mk opsrch9R1740 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R1740 x y)

