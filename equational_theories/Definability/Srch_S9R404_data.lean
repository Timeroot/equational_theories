namespace Magma

/-- A member of the class, as the `9` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R404 : Type := {w : Fin 9 → Fin 9 // Magma.tupOK S9R404.E S9R404.tr S9R404.z S9R404.st S9R404.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R404 (v : tup9R404) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R404.E S9R404.tr v.1)

end Magma

