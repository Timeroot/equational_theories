import equational_theories.Definability.UnaryGen

/-!
# The generic unary map: the orbit equation

`UnaryGen.lean` settles the targets of `Equation39` and `Equation38` with a tree whose diagonal
names the unary map, `y □ y = s y`. That shape runs out at 61 of the 125 open targets, and for the
other 64 there is no `□`-word equal to `s y` at all -- the search goes to six leaves and returns
nothing.

What works instead is `Unary.structuralOnMagma_pair`: a pair of words whose equation cuts out the
whole orbit, plus one universal quantifier to tell its two elements apart. A single tree,

    x □ y := if y = s x then s x else x,

carries every target that is reachable at all. It is `y`, overwritten to `x` off the orbit of `x`;
so `y □ z = z` says exactly that `z` is `y` or `s y`, and `s y` is the one that is not forced to be
`y` when the orbit is a singleton.

The 64 leftover targets do not all get settled: for 50 of them the tree that satisfies the
target does not determine `s`, in the strong sense that two unary maps on the same carrier induce
the same `□`. A formula may depend on the model and still be legal, so those are not refuted -- but
no uniform device can reach them.

Generated by `defwork/unarypair.py`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma UnaryGen

namespace UnaryPair

variable {G : Type} (M : Magma G)

/-- `x □ y := if y = s x then s x else x`. -/
def t : QFOp :=
  .ite (Lf 1) (Lf 0 ⋆ Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0))

open scoped Classical in
theorem t_apply (a b : G) : (t.magma M).op a b = if b = M.op a a then M.op a a else a := by
  show @QFOp.eval _ M t ![a, b] = _
  simp only [t, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- The orbit equation: `w = (y □ w)` holds exactly at `z = y` and `z = s y`. -/
theorem t_pair (y z : G) :
    @evalInMagma _ _ (t.magma M) ![y, z] (Lf 1)
      = @evalInMagma _ _ (t.magma M) ![y, z] ((Lf 0) ⋆ (Lf 1)) ↔ (z = y ∨ z = M.op y y) := by
  classical
  show z = (t.magma M).op y z ↔ _
  rw [t_apply M y z]
  grind

end UnaryPair

namespace Law.MagmaLaw

/-- `x = x ◇ x` holds in the orbit tree over every magma. -/
theorem satPair3 {G : Type} (M : Magma G) : @satisfies _ G (UnaryPair.t.magma M) Law3 := by
  classical
  obtain ⟨s, hs⟩ : ∃ s : G → G, ∀ v : G, M.op v v = s v := ⟨_, fun _ ↦ rfl⟩
  rw [@Law3.models_iff]
  intro x
  simp only [UnaryPair.t_apply M, hs]
  grind

theorem Equation3_StructuralFrom_Equation39 : Law3.StructuralFrom Law39 := by
  intro G M hM
  exact Unary.structuralOnMagma_pair M UnaryPair.t (Lf 1) ((Lf 0) ⋆ (Lf 1))
    (sop39 M (Law39.models_iff.mp hM)) (UnaryPair.t_pair M) (satPair3 M)

theorem Equation3_StructuralFrom_Equation38 : Law3.StructuralFrom Law38 := by
  intro G M hM
  exact Unary.structuralOnMagma_lpair M UnaryPair.t (Lf 1) ((Lf 0) ⋆ (Lf 1))
    (sop38 M (Law38.models_iff.mp hM)) (UnaryPair.t_pair M) (satPair3 M)

