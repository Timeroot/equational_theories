/-- Two models of `Equation1053` on one carrier with the same `(x ◇ (y ◇ (x ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) Law1053 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law1053.models_iff G M).mp hM
  have hn := (@Law1053.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 (M.op X1 X2)) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X1 (N.op X1 X2)) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op X0 X0))) = (N.op X0 (N.op X1 (N.op X0 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq11 : ∀ X0 X1 X2 X3 : G, (M.op X3 (M.op X0 (M.op X0 (M.op (M.op X1 (M.op X1 X2)) X2)))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq5 X3 X0 (M.op (M.op X1 (M.op X1 X2)) X2)
       have i₂ := eq5 (M.op X0 (M.op X0 (M.op (M.op X1 (M.op X1 X2)) X2))) X1 X2
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq12 : ∀ X0 X3 : G, (M.op X3 (M.op X0 X0)) = X3 := by
    intro X0 X3
    first
    | (have i₁ := eq11 X0 x x X3
       have i₂ := eq5 X0 x x
       grind)
    | exact superpose eq5 eq11
    | exact resolve eq11 eq5
    | grind
    | grind (splits := 40)
  clear eq11
  have eq23 : ∀ X0 X1 X2 X3 : G, (N.op X3 (N.op X0 (N.op X0 (N.op (N.op X1 (N.op X1 X2)) X2)))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq6 X3 X0 (N.op (N.op X1 (N.op X1 X2)) X2)
       have i₂ := eq6 (N.op X0 (N.op X0 (N.op (N.op X1 (N.op X1 X2)) X2))) X1 X2
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq24 : ∀ X0 X3 : G, (N.op X3 (N.op X0 X0)) = X3 := by
    intro X0 X3
    first
    | (have i₁ := eq23 X0 x x X3
       have i₂ := eq6 X0 x x
       grind)
    | exact superpose eq6 eq23
    | exact resolve eq23 eq6
    | grind
    | grind (splits := 40)
  clear eq23
  have eq35 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op X1 X1))) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq24 X1 X0
       grind)
    | exact superpose eq24 eq7
    | exact resolve eq7 eq24
    | grind
    | grind (splits := 40)
  clear eq24
  have eq50 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq35 X0 X1
       have i₂ := eq12 X1 X0
       grind)
    | (have i₁ := eq35 X0 X1
       have i₂ := eq12 X0 (M.op X0 (M.op X1 X1))
       grind)
    | exact superpose eq12 eq35
    | exact resolve eq35 eq12
    | grind
    | grind (splits := 40)
  clear eq12 eq35
  have eq83 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq50 b a
       grind)
    | exact superpose eq50 eq8
    | exact resolve eq8 eq50
    | grind
    | grind (splits := 40)
  clear eq50
  have eq94 : False := by grind
  exact eq94

/-- `Equation3319` from `Equation1053`: `x = x ◇ ((y ◇ (y ◇ z)) ◇ z)` ⊢ `x ◇ y = x ◇ (y ◇ (y ◇ y))`,
through the companion `x □ y = (x ◇ (y ◇ (x ◇ x)))`. -/
theorem Equation3319_StructuralFromFin_Equation1053 : Law3319.StructuralFromFin Law1053 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law1053.models_iff G M).mp hM
  rw [@Law3319.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

