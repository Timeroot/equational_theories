/-- `Equation107` from `Equation4434`: `x ◇ (y ◇ x) = (x ◇ x) ◇ z` ⊢ `x = x ◇ ((y ◇ y) ◇ x)`,
through `x □ y = if (M.op a a) = a then (M.op a b) else if (M.op b b) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation107_StructuralFromFin_Equation4434 : Law107.StructuralFromFin Law4434 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_x_pyy_y_pxy_x_pxy_Equation4434 (fun {G} M hM ↦ ?_)
  have hm := (@Law4434.models_iff G M).mp hM
  rw [@Law107.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

