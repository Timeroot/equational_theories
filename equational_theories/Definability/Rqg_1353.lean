import equational_theories.Definability.DiagRow

/-!
# `Equation1353` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1353` is `x = y ◇ (((z ◇ x) ◇ y) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1353`: `x = y ◇ (((z ◇ x) ◇ y) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1353 : DiagRow.RowQG Law1353 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1353.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u z) u) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op (M.op X2 X0) X1) X0)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, y = (M.op X0 (M.op (M.op (M.op x x) X0) y)) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op X1 X0) (M.op X2 X3)) X0) (M.op X0 X3)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op (M.op X1 X0) (M.op X2 X3)) X0) X2
       have i₂ := eq4 X0 (M.op X2 X3) X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq30 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op X0 X1)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op X1 X0) (M.op (M.op x X1) (M.op x X0))
       have i₂ := eq9 X1 x x X0
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq68 : y = (M.op (M.op x x) (M.op x y)) := by
    first
    | (have i₁ := eq7 (M.op x x)
       have i₂ := eq30 x x
       grind)
    | exact superpose eq30 eq7
    | exact resolve eq7 eq30
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq77 : y = (M.op (M.op x x) (M.op x x)) := by
    first
    | (have i₁ := eq68
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq68
    | exact resolve eq68 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq68
  have eq78 : x = y := by
    first
    | (have i₁ := eq77
       have i₂ := eq30 x x
       grind)
    | exact superpose eq30 eq77
    | exact resolve eq77 eq30
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq30 eq77
  have eq79 : False := by grind
  exact eq79

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1353` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1353 : Law3.StructuralFrom Law1353 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1353

/-- `Equation825` from `Equation1353`: `x = y ◇ (((z ◇ x) ◇ y) ◇ x)` ⊢ `x = x ◇ ((x ◇ y) ◇ (y ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation825_StructuralFrom_Equation1353 : Law825.StructuralFrom Law1353 := by
  classical
  refine DiagRow.structuralFrom_diagOf_row (Lf 0) RowQG_Equation1353
    (fun {G} M hM ↦ ?_)
  have hm := (@Law1353.models_iff G M).mp hM
  have key : ∀ N : Magma G, (∀ a b : G, a = b ∨ N.op a b = M.op a b) →
      (∀ a : G, N.op a a = a) → @satisfies _ G N Law825 := by
    intro N hne heq
    rw [@Law825.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ (eq_or_ne a b).imp id (QFOp.diagOf_ne (Lf 0) M a b))
    (fun a ↦ ?_)
  rw [QFOp.diagOf_eq (Lf 0) M a a rfl]
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]

