/-- A member of the class, as the `13` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R702 : Type := {w : Fin 13 → Fin 9 // Magma.tupOK S9R702.E S9R702.tr S9R702.z S9R702.st S9R702.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R702 (v : tup9R702) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R702.E S9R702.tr v.1)

end Magma

