/-- `Equation1025` from `Equation4416`: `x ◇ (x ◇ y) = (z ◇ x) ◇ y` ⊢ `x = x ◇ ((x ◇ (y ◇ x)) ◇ x)`,
through `x □ y = if (M.op a a) = b then a else if (M.op b a) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation1025_StructuralFromFin_Equation4416 : Law1025.StructuralFromFin Law4416 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) (Lf 0) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_y_pyx_y_x_x_pxy_Equation4416 (fun {G} M hM ↦ ?_)
  have hm := (@Law4416.models_iff G M).mp hM
  rw [@Law1025.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) (Lf 0) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

