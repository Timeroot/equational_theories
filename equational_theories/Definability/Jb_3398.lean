theorem Equation1637_StructuralFromFin_Equation3398 : Law1637.StructuralFromFin Law3398 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_x_y_pyy_x_pxx_y_pyx_Equation3398 (fun {G} M hM ↦ ?_)
  have hm := (@Law3398.models_iff G M).mp hM
  rw [@Law1637.models_iff G ((AutBox.iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

