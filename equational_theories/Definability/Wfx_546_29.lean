/-- Two models of `Equation546` on one carrier with the same `(y ◇ ((y ◇ y) ◇ x))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 1 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 0)) Law546 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 1 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 0)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law546.models_iff G M).mp hM
  have hn := (@Law546.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X2 (M.op X0 (M.op X2 X1)))) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X1 (N.op X2 (N.op X0 (N.op X2 X1)))) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X1 (M.op (M.op X1 X1) X0)) = (N.op X1 (N.op (N.op X1 X1) X0)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 X2)) (M.op X1 X0)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq5 X2 (M.op X0 (M.op X1 X2)) X1
       have i₂ := eq5 X0 X2 X1
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq11 : ∀ X0 X1 : G, (M.op (M.op X1 X0) X0) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X1 (M.op X1 X0) X0
       have i₂ := eq5 X0 X0 X1
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq18 : ∀ X0 X1 : G, (N.op (N.op X1 X0) X0) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X1 (N.op X1 X0) X0
       have i₂ := eq6 X0 X0 X1
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq29 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X0 X0) (N.op X1 (N.op (N.op X0 X0) X0)))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X1 X0 (N.op X0 X0)
       have i₂ := eq7 (N.op X1 (N.op (N.op X0 X0) X0)) X0
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq33 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X0 X0) (N.op X1 X0))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq29 X0 X1
       have i₂ := eq18 X0 X0
       grind)
    | exact superpose eq18 eq29
    | exact resolve eq29 eq18
    | grind
    | grind (splits := 40)
  clear eq18 eq29
  have eq108 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X0 (M.op (M.op X1 X1) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq10 X1 (M.op X1 X1) (N.op X0 X1)
       have i₂ := eq33 X1 X0
       grind)
    | exact superpose eq33 eq10
    | exact resolve eq10 eq33
    | grind
    | grind (splits := 40)
  clear eq10 eq33
  have eq116 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq108 X0 X1
       have i₂ := eq11 X1 X1
       grind)
    | exact superpose eq11 eq108
