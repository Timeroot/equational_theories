/-!
# Structurality from `Equation433` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation433` is `x = x ◇ (y ◇ (x ◇ (z ◇ y)))`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b b) = a then a else if a = b then a else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pyy_x_x_y_x_x_pyx_Equation433`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 5 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3309` from `Equation433`: `x = x ◇ (y ◇ (x ◇ (z ◇ y)))` ⊢ `x ◇ y = x ◇ (x ◇ (y ◇ y))`,
through `x □ y = if (M.op b b) = a then a else if a = b then a else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation3309_StructuralFromFin_Equation433 : Law3309.StructuralFromFin Law433 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) (Lf 0) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyy_x_x_y_x_x_pyx_Equation433 (fun {G} M hM ↦ ?_)
  have hm := (@Law433.models_iff G M).mp hM
  rw [@Law3309.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) (Lf 0) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

