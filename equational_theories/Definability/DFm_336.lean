import equational_theories.Definability.AutBox
import equational_theories.Definability.VBox_00

/-!
# The diagonal obligation for `Equation336`, inherited

Generated by `defwork/dfmono.py`.  `Equation336` is `x ◇ y = y ◇ (y ◇ y)`, which implies
`Equation315` (`x ◇ x = y ◇ (y ◇ x)`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation336 : AutBox.DiagFix Law336 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation315
  rw [@Law315.models_iff G M]
  rw [@Law336.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y; grind (splits := 60) (ematch := 40))
