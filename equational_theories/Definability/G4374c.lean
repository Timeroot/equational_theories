/-! ### The operations

Each is a decision tree over `t x`, `t y`, `x = y`, `x ◇ x = x` and `y ◇ y = y`, whose leaves are
words in `x` and `y`. The three facts a tree has to satisfy are that its values stay in `T`, that
it keeps `γ` on the diagonal of `T`, and how it reads the columns of `S`; `gker_image` turns those
into the whole reverse read. -/

section Ops

variable (M : Magma G) (K : GKer M)

/-! #### Operation `9328148`

808 cells, in 32 rows of the open list over 4 sources.  Its diagonal of `S` is read `tcol`, its
columns direct on `T × S` and direct on `S × S`. -/

/-- The tree of operation `9328148`. -/
def q9328148 : EOp :=
  .ite (.mem (Lf 1))
    (.ite (.mem (Lf 0))
      (.ite (.eq (Lf 0) (Lf 1))
        (.leaf (Lf 0 ⋆ Lf 1))
        (.ite (.eq (Lf 1 ⋆ Lf 1) (Lf 1))
          (.leaf (Lf 1 ⋆ Lf 0))
          (.ite (.eq (Lf 0 ⋆ Lf 0) (Lf 0)) (.leaf (Lf 0)) (.leaf ((Lf 1 ⋆ Lf 1) ⋆ (Lf 1 ⋆ Lf 1))))))
      (.leaf (Lf 0 ⋆ Lf 0)))
    (.ite (.eq (Lf 0) (Lf 1)) (.leaf ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0))) (.leaf (Lf 0 ⋆ Lf 1)))

open scoped Classical in
theorem q9328148_apply (a b : G) :
    (q9328148.magma M).op a b =
      if K.t b then
        if K.t a then
          if a = b then
            M.op a b
          else if M.op b b = b then
            M.op b a
          else if M.op a a = a then a else M.op (M.op b b) (M.op b b)
        else M.op a a
      else if a = b then M.op (M.op a a) (M.op a a) else M.op a b := by
  show @EOp.eval _ M q9328148 ![a, b] = _
  simp only [q9328148, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    gtimex M K]

