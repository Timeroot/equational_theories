    GuardAut3_pyx_x_x_y_pyx_pyy_pyy_pxx_x_pyx_Equation4596 (fun {G} M hM ↦ ?_)
  have hm := (@Law4596.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op b a) ≠ a ∨ N.op a b = (M.op b b)) →
      (∀ a b : G, (M.op b a) = a ∨ a ≠ b ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, (M.op b a) = a ∨ a = b ∨ (M.op b a) ≠ (M.op b b) ∨ N.op a b = a) →
      (∀ a b : G, (M.op b a) = a ∨ a = b ∨ (M.op b a) = (M.op b b) ∨ N.op a b = (M.op b a)) →
        @satisfies _ G N Law101 := by
    intro N h1 h2 h3 h4
    rw [@Law101.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_) (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf3_apply ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b a)) (a)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf3_apply ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b a)) (a)).imp id (fun h ↦
      (eq_or_ne (a) (b)).symm.imp id (fun h' ↦ (if_neg h).trans (if_pos h')))
  · rw [AutBox.iteOf3_apply ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b a)) (a)).imp id (fun h ↦
      (eq_or_ne (a) (b)).imp id (fun h' ↦
        (eq_or_ne ((M.op b a)) ((M.op b b))).symm.imp id (fun h'' ↦
          ((if_neg h).trans (if_neg h')).trans (if_pos h''))))
  · rw [AutBox.iteOf3_apply ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b a)) (a)).imp id (fun h ↦
      (eq_or_ne (a) (b)).imp id (fun h' ↦
        (eq_or_ne ((M.op b a)) ((M.op b b))).imp id (fun h'' ↦
          ((if_neg h).trans (if_neg h')).trans (if_neg h''))))

