/-- The arguments as one mixed-radix index, which is how `rankArr6AA` is addressed. -/
def encT6AA (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2) : Nat :=
  a.1 * 5184 +
    b.1 * 1728 +
    c.1 * 576 +
    d.1 * 144 +
    e.1 * 48 +
    f.1 * 24 +
    g.1 * 12 +
    h.1 * 4 +
    i.1 * 2 +
    j.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank6AA (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    : Fin 12 :=
  ⟨min (rankArr6AA.getD (encT6AA a b c d e f g h i j) 0) 11, by omega⟩


/-- `1` of the `29` demanded maps and `3` of the `46627` forbidden ones, enough to separate the `12`
members from the other `15540` invariant tuples between them. The certificate still demands and
forbids all `46656`; these are the lists `mem_rank6AA` scans, once per tuple, with a scan that is
quadratic in their length. -/
def e0idx6AA : Fin 1 → Fin 29
  | 0 => 7
def x0idx6AA : Fin 3 → Fin 46627
  | 0 => 0
  | 1 => 1555
  | 2 => 9539

def endE06AA (j : Fin 1) : Fin 6 → Fin 6 := endE6AA (e0idx6AA j)

def endX06AA (j : Fin 3) : Fin 6 → Fin 6 := endX6AA (x0idx6AA j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6AA (i : Fin 12) : Magma (Fin 6) := Magma.mk (mem6AA i)

theorem end6AA_isEndo (i : Fin 12) (j : Fin 29) : (end6AA i).IsEndo (endE6AA j) := by
  revert i j; native_decide

theorem end6AA_not_isEndo (i : Fin 12) (j : Fin 46627) : ¬ (end6AA i).IsEndo (endX6AA j) := by
  revert i j; native_decide

/-- `rank6AA` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6AA` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6AA (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6AA a b c d e f g h i j) endE06AA endX06AA = true) :
    mem6AA (rank6AA a b c d e f g h i j) = tab6AA a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `12` listed
members. -/
theorem mem_of_isExact6AA (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6AA a b c d e f g h i j) endE06AA endX06AA = true) :
    ∃ idx, mem6AA idx = tab6AA a b c d e f g h i j :=
  ⟨_, mem_rank6AA a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6AA`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6AA` turns that into a member index. -/
theorem exists_end6AA {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6AA j))
    (hX : ∀ j, ¬ M.IsEndo (endX6AA j)) : ∃ i, end6AA i = M := by
  have hP : ∀ i, M.IsEndo (permE6AA i) := by
    intro i; rw [permE6AA_eq_endE6AA]; exact hE (uidx6AA i)
  have hop : M.op = Magma.transport permE6AA tr6AA (fun i ↦ M.op (rep6AA i).1 (rep6AA i).2) :=
    Magma.op_eq_transport (rep := rep6AA) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA0) (a := (rep6AA 0).1) (b := (rep6AA 0).2)
    (val := val6AA0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA1) (a := (rep6AA 1).1) (b := (rep6AA 1).2)
    (val := val6AA1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA2) (a := (rep6AA 2).1) (b := (rep6AA 2).2)
    (val := val6AA2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA3) (a := (rep6AA 3).1) (b := (rep6AA 3).2)
    (val := val6AA3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA4) (a := (rep6AA 4).1) (b := (rep6AA 4).2)
    (val := val6AA4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA5) (a := (rep6AA 5).1) (b := (rep6AA 5).2)
    (val := val6AA5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA6) (a := (rep6AA 6).1) (b := (rep6AA 6).2)
    (val := val6AA6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA7) (a := (rep6AA 7).1) (b := (rep6AA 7).2)
    (val := val6AA7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA8) (a := (rep6AA 8).1) (b := (rep6AA 8).2)
    (val := val6AA8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6AA) (idx := stabIdx6AA9) (a := (rep6AA 9).1) (b := (rep6AA 9).2)
    (val := val6AA9) hP (by decide) (by decide)
  have hdec : dec6AA a b c d e f g h i j = fun i ↦ M.op (rep6AA i).1 (rep6AA i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6AA a b c d e f g h i j = M.op := by
    rw [tab6AA_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6AA a b c d e f g h i j) endE06AA endX06AA = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6AA j), fun j ↦ hX (x0idx6AA j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6AA a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`29` monoid of `Magma.endE6AA`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6AA {L L' : Law.NatMagmaLaw} {i : Fin 12}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6AA i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6AA j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6AA i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6AA
    (fun k ↦ (Magma.end6AA_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6AA_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
