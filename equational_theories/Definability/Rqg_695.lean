import equational_theories.Definability.DiagRow

/-!
# `Equation695` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation695` is `x = y ◇ (x ◇ ((z ◇ z) ◇ y))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation695`: `x = y ◇ (x ◇ ((z ◇ z) ◇ y))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation695 : DiagRow.RowQG Law695 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law695.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op (M.op u u) u)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op (M.op X2 X2) X1))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 (M.op (M.op X1 X1) (M.op X2 X2))) (M.op X3 X0)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op X0 (M.op (M.op X1 X1) (M.op X2 X2))) X2
       have i₂ := eq4 X0 (M.op X2 X2) X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X1) X2) (M.op X0 X0)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op (M.op X1 X1) X2) X0
       have i₂ := eq4 (M.op X0 X0) X2 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 X1 X2 : G, (M.op X1 X1) = (M.op (M.op X0 X0) (M.op X2 X2)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq8 X2 (M.op X0 X0) (M.op X1 X1)
       have i₂ := eq8 X1 X0 (M.op X0 X0)
       grind)
    | exact superpose eq8 eq8
    | exact resolve eq8 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq38 : ∀ X0 X1 : G, (M.op X0 X0) = (M.op X1 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq8 x X1 (M.op X1 X1)
       have i₂ := eq10 (M.op X1 X1) X0 x
       grind)
    | (have i₁ := eq8 (M.op X1 X1) X1 (M.op X1 X1)
       have i₂ := eq10 X0 (M.op (M.op X1 X1) (M.op X1 X1)) x
       grind)
    | exact superpose eq10 eq8
    | exact resolve eq8 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq58 : ∀ X0 X1 X4 : G, (M.op (M.op X1 (M.op X0 X0)) (M.op X4 X1)) = X4 := by
    intro X0 X1 X4
    first
    | (have i₁ := eq7 X1 x x X4
       have i₂ := eq10 x X0 x
       grind)
    | (have i₁ := eq7 X0 X1 X1 x
       have i₂ := eq10 X0 (M.op X1 X1) x
       grind)
    | exact superpose eq10 eq7
    | exact resolve eq7 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq10
  have eq384 : ∀ X0 : G, x = (M.op (M.op y (M.op X0 X0)) (M.op x x)) := by
    intro X0
    first
    | (have i₁ := eq58 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq58
    | exact resolve eq58 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq387 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X2)) (M.op X0 X0)) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq58 X2 X1 X1
       have i₂ := eq38 X1 X0
       grind)
    | (have i₁ := eq58 X2 X1 X1
       have i₂ := eq38 X0 X1
       grind)
    | exact superpose eq38 eq58
    | exact resolve eq58 eq38
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq38 eq58
  have eq438 : x = y := by
    first
    | (have i₁ := eq384 x
       have i₂ := eq387 x y x
       grind)
    | exact superpose eq387 eq384
    | exact resolve eq384 eq387
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq384 eq387
  have eq439 : False := by grind
  exact eq439

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation695` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation695 : Law3.StructuralFrom Law695 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation695
