that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `100` cells times
the `120` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch10R4040 : Array Nat := #[0, 5, 0]

def vsrch10R4040 : Magma.tup10R404 :=
  ⟨fun i ↦ ⟨vdsrch10R4040[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch10R4041 : Array Nat := #[0, 5, 3]

def vsrch10R4041 : Magma.tup10R404 :=
  ⟨fun i ↦ ⟨vdsrch10R4041[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `120`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R404Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R4040 : Array (Array Nat) := #[#[0, 5, 3, 0, 0, 0, 4, 4, 5, 3], #[5, 1, 6, 9, 6, 1, 1, 9, 5, 1], #[3, 6, 2, 2, 6, 8, 2, 8, 2, 3], #[3, 9, 3, 3, 0, 0, 2, 9, 2, 3], #[4, 6, 6, 0, 4, 0, 4, 4, 7, 7], #[5, 5, 8, 0, 0, 5, 1, 8, 5, 1], #[4, 6, 6, 2, 6, 1, 6, 4, 2, 1], #[4, 9, 8, 9, 7, 8, 4, 7, 7, 7], #[5, 5, 8, 2, 7, 8, 2, 8, 8, 7], #[3, 9, 3, 9, 7, 1, 1, 9, 7, 9]]

def opsrch10R4040 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4040[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4040 :
    ∀ x y, Magma.transport S10R404.E S10R404.tr vsrch10R4040.1 x y = opsrch10R4040 x y := by
  native_decide

theorem esrch10R4040 : Magma.srch10R404 vsrch10R4040 = Magma.mk opsrch10R4040 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R4040 x y)

def tdsrch10R4041 : Array (Array Nat) := #[#[0, 5, 3, 3, 4, 5, 4, 4, 5, 3], #[5, 1, 6, 9, 6, 5, 6, 9, 5, 9], #[3, 6, 2, 3, 6, 8, 6, 8, 8, 3], #[0, 9, 2, 3, 0, 0, 2, 9, 2, 9], #[0, 6, 6, 0, 4, 0, 6, 7, 7, 7], #[0, 1, 8, 0, 0, 5, 1, 8, 8, 1], #[4, 1, 2, 2, 4, 1, 6, 4, 2, 1], #[4, 9, 8, 9, 4, 8, 4, 7, 8, 9], #[5, 5, 2, 2, 7, 5, 2, 7, 8, 7], #[3, 1, 3, 3, 7, 1, 1, 7, 7, 9]]

def opsrch10R4041 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4041[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4041 :
    ∀ x y, Magma.transport S10R404.E S10R404.tr vsrch10R4041.1 x y = opsrch10R4041 x y := by
  native_decide

theorem esrch10R4041 : Magma.srch10R404 vsrch10R4041 = Magma.mk opsrch10R4041 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R4041 x y)
