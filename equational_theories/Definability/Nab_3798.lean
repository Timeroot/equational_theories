/-- `Equation333` from `Equation3798`: `x ◇ y = (z ◇ x) ◇ (w ◇ y)` ⊢ `x ◇ y = y ◇ (x ◇ y)`,
through `x □ y = if (M.op b a) = a then (M.op b b) else if (M.op a b) = b then (M.op a a) else (M.op b b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation333_StructuralFromFin_Equation3798 : Law333.StructuralFromFin Law3798 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1))
    GuardAut2_pyx_x_pxy_y_pyy_pxx_pyy_Equation3798 (fun {G} M hM ↦ ?_)
  have hm := (@Law3798.models_iff G M).mp hM
  rw [@Law333.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

