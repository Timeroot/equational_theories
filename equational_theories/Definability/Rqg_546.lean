import equational_theories.Definability.DiagRow

/-!
# `Equation546` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation546` is `x = y ◇ (z ◇ (x ◇ (z ◇ y)))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation546`: `x = y ◇ (z ◇ (x ◇ (z ◇ y)))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation546 : DiagRow.RowQG Law546 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law546.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op z (M.op u u))), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X2 (M.op X0 (M.op X2 X1)))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op y (M.op x (M.op X0 (M.op x x)))) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 X1 : G, (M.op (M.op X1 X0) X0) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op X1 X0) X0
       have i₂ := eq4 X0 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X2 (M.op X0 (M.op X2 X1)))) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq10 (M.op X2 (M.op X0 (M.op X2 X1))) X1
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq10
    | exact resolve eq10 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq22 : ∀ X0 : G, y = (M.op X0 (M.op x (M.op X0 (M.op x x)))) := by
    intro X0
    first
    | (have i₁ := eq10 (M.op x (M.op X0 (M.op x x))) y
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq10
    | exact resolve eq10 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq10
  have eq24 : x = y := by
    first
    | (have i₁ := eq22 x
       have i₂ := eq12 x x x
       grind)
    | exact superpose eq12 eq22
    | exact resolve eq22 eq12
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq12 eq22
  have eq26 : False := by grind
  exact eq26

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation546` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation546 : Law3.StructuralFrom Law546 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation546
