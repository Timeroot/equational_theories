/-- Two models of `Equation1481` on one carrier with the same `((x ◇ (y ◇ x)) ◇ x)` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull ((Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) ⋆ Lf 0) Law1481 := by
  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) ⋆ Lf 0) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law1481.models_iff G M).mp hM
  have hn := (@Law1481.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op X0 (M.op X1 X0))) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op (N.op X1 X0) (N.op X0 (N.op X1 X0))) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 (M.op X1 X0)) X0) = (N.op (N.op X0 (N.op X1 X0)) X0) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 : G, (M.op X1 X0) = (M.op (M.op X0 (M.op X1 X0)) X0) := by
    intro X0 X1
    first
    | (have i₁ := eq5 (M.op X1 X0) X0
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq12 : ∀ X0 X1 : G, (N.op X1 X0) = (N.op (N.op X0 (N.op X1 X0)) X0) := by
    intro X0 X1
    first
    | (have i₁ := eq6 (N.op X1 X0) X0
       have i₂ := eq6 X0 X1
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq35 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op (M.op X1 (M.op X0 X1)) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq12 X1 X0
       grind)
    | exact superpose eq12 eq7
    | exact resolve eq7 eq12
    | grind
    | grind (splits := 40)
  clear eq12
  have eq39 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq35 X0 X1
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq35
    | exact resolve eq35 eq10
    | grind
    | grind (splits := 40)
  clear eq10 eq35
  have eq52 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq39 a b
       grind)
    | exact superpose eq39 eq8
    | exact resolve eq8 eq39
    | grind
    | grind (splits := 40)
  clear eq39
  have eq62 : False := by grind
  exact eq62

/-- `Equation2051` from `Equation1481`: `x = (y ◇ x) ◇ (x ◇ (y ◇ x))` ⊢ `x = ((x ◇ y) ◇ x) ◇ (x ◇ y)`,
through the companion `x □ y = ((x ◇ (y ◇ x)) ◇ x)`. -/
theorem Equation2051_StructuralFromFin_Equation1481 : Law2051.StructuralFromFin Law1481 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull ((Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) ⋆ Lf 0) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law1481.models_iff G M).mp hM
  rw [@Law2051.models_iff _ ((AutBox.wordOf ((Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) ⋆ Lf 0)).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

