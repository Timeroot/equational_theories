namespace Magma

/-- A member of the class, as the `3` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup10R402 : Type := {w : Fin 3 → Fin 10 // Magma.tupOK S10R402.E S10R402.tr S10R402.z S10R402.st S10R402.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch10R402 (v : tup10R402) : Magma (Fin 10) :=
  Magma.mk (Magma.transport S10R402.E S10R402.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `2` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `decide!` rather than `decide` because the invariance test is `100` cells times the
`60` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch10R4020 : Array Nat := #[0, 3, 0]

def vsrch10R4020 : Magma.tup10R402 :=
  ⟨fun i ↦ ⟨vdsrch10R4020[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by decide!⟩

def vdsrch10R4021 : Array Nat := #[0, 7, 2]

def vsrch10R4021 : Magma.tup10R402 :=
  ⟨fun i ↦ ⟨vdsrch10R4021[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by decide!⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `60`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R402Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R4020 : Array (Array Nat) := #[#[0, 3, 0, 0, 2, 8, 8, 2, 0, 3], #[7, 1, 1, 2, 9, 2, 9, 1, 7, 1], #[2, 2, 2, 1, 0, 1, 2, 0, 6, 6], #[3, 0, 7, 3, 5, 3, 7, 3, 5, 0], #[6, 8, 8, 6, 4, 7, 4, 4, 4, 7], #[9, 6, 9, 5, 3, 5, 5, 6, 3, 5], #[4, 5, 6, 4, 6, 6, 6, 5, 2, 2], #[1, 7, 3, 7, 7, 4, 3, 7, 1, 4], #[8, 4, 4, 9, 8, 0, 0, 9, 8, 8], #[5, 9, 5, 8, 1, 9, 1, 8, 9, 9]]

def opsrch10R4020 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4020[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4020 :
    ∀ x y, Magma.transport S10R402.E S10R402.tr vsrch10R4020.1 x y = opsrch10R4020 x y := by
  native_decide

theorem esrch10R4020 : Magma.srch10R402 vsrch10R4020 = Magma.mk opsrch10R4020 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R4020 x y)

def tdsrch10R4021 : Array (Array Nat) := #[#[0, 7, 2, 3, 6, 9, 4, 1, 8, 5], #[3, 1, 2, 0, 8, 6, 5, 7, 4, 9], #[0, 1, 2, 7, 8, 9, 6, 3, 4, 5], #[0, 2, 1, 3, 6, 5, 4, 7, 9, 8], #[2, 9, 0, 5, 4, 3, 6, 7, 8, 1], #[8, 2, 1, 3, 7, 5, 6, 4, 0, 9], #[8, 9, 2, 7, 4, 5, 6, 3, 0, 1], #[2, 1, 0, 3, 4, 6, 5, 7, 9, 8], #[0, 7, 6, 5, 4, 3, 2, 1, 8, 9], #[3, 1, 6, 0, 7, 5, 2, 4, 8, 9]]

def opsrch10R4021 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4021[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4021 :
    ∀ x y, Magma.transport S10R402.E S10R402.tr vsrch10R4021.1 x y = opsrch10R4021 x y := by
