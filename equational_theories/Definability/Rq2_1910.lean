import equational_theories.Definability.DiagRow

/-!
# `Equation1910` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1910` is `x = (y ◇ (x ◇ z)) ◇ (y ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1910`: `x = (y ◇ (x ◇ z)) ◇ (y ◇ z)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1910 : DiagRow.ColQG Law1910 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1910.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op z u) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X0 X2)) (M.op X1 X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op z u) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X2 (M.op X0 X3)) = (M.op (M.op X1 X0) (M.op X1 (M.op X2 X3))) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op X2 (M.op X0 X3)) X1 (M.op X2 X3)
         have i₂ := eq3 X0 X2 X3
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 (M.op X0 X2)) (M.op X3 (M.op X1 X2))) X0) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X1 (M.op X0 X2)) (M.op X1 X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq49 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op (M.op X1 X2) X2)) X1) = X0 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq7 X1 X0 X2 X0
         have i₂ := eq5 (M.op X1 X2) X0 X0 X2
         grind)
      | exact superpose eq5 eq7
      | exact resolve eq7 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5 eq7
    have eq100 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X1) = X0 := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op X0 X1) X1) X0 X1
         have i₂ := eq49 X0 (M.op X0 X1) X1
         grind)
      | exact superpose eq49 eq3
      | exact resolve eq3 eq49
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq49
    have eq336 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq100 z u
         grind)
      | exact superpose eq100 eq4
      | (have r₁ := eq4
         have r₂ := eq100 z u
         grind)
      | exact resolve eq4 eq100
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq100
    have eq337 : False := by grind
    exact eq337
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z u), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X0 X2)) (M.op X1 X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, y = (M.op (M.op X0 (M.op x x)) (M.op X0 x)) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : y = x := by
    first
    | (have i₁ := eq7 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq7
    | exact resolve eq7 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1910` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1910 : Law3.StructuralFrom Law1910 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1910
