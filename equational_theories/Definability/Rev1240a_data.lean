theorem rev1240a_subFacts :
    (∀ k x y, (rev1240aSub k (rev1240aP 0 k)).op x y = x) ∧
      (∀ k x y, (rev1240aSub k (rev1240aP 1 k)).op x y = y) ∧
      (∀ k i j l x y, (rev1240aSub k (rev1240aSc k i j l)).op x y =
        (rev1240aSub k i).op ((rev1240aSub k j).op x y) ((rev1240aSub k l).op x y)) ∧
      ∀ k j, ¬ ∀ x y, (rev1240aSub k j).op x y = rev1240a.op x y := by
  decideFin!

theorem rev1240a_isSubclone (k : Fin 4) : IsSubclone (rev1240aSub k) :=
  IsSubclone.of_table (rev1240aP 0 k) (rev1240aP 1 k) (rev1240aSc k)
    (rev1240a_subFacts.1 k) (rev1240a_subFacts.2.1 k) (rev1240a_subFacts.2.2.1 k)

theorem rev1240a_notInSub (k : Fin 4) : ¬ InClone (rev1240aSub k) rev1240a.op :=
  notInClone_of (rev1240a_subFacts.2.2.2 k)

/-- The `2` clone members left over: those that do generate `◇`. -/
