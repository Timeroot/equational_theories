theorem rev1240a_splitFacts : ∀ i : Fin 24,
    (∀ x y, (rev1240aSub (rev1240aWk i) (rev1240aWe i)).op x y = (rev1240aClone i).op x y) ∨
      (∀ x y, (rev1240aClone i).op x y = (rev1240aBad (rev1240aWb i)).op x y) := by
  decideFin!

theorem rev1240a_split (i : Fin 24) :
    (∃ k, InClone (rev1240aSub k) (rev1240aClone i).op) ∨
      ∃ b, (rev1240aClone i).op = (rev1240aBad b).op :=
  split_of_witnesses rev1240aWk rev1240aWe rev1240aWb rev1240a_splitFacts i

