theorem revF32199a_subFacts :
    (∀ k x y, (revF32199aSub k (revF32199aP 0 k)).op x y = x) ∧
      (∀ k x y, (revF32199aSub k (revF32199aP 1 k)).op x y = y) ∧
      ∀ k j, ¬ ∀ x y, (revF32199aSub k j).op x y = revF32199a.op x y := by
  native_decide

theorem revF32199a_subComp :
  ∀ k i j l x y, (revF32199aSub k (revF32199aSc k i j l)).op x y =
    (revF32199aSub k i).op ((revF32199aSub k j).op x y) ((revF32199aSub k l).op x y) := by
  native_decide

