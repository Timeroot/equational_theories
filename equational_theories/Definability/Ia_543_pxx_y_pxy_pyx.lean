/-- `Equation647` from `Equation543`: `x = y ◇ (z ◇ (x ◇ (y ◇ z)))` ⊢ `x = x ◇ (y ◇ ((y ◇ z) ◇ z))`,
through `x □ y = if m(X,X) = Y then m(X,Y) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation647_StructuralFromFin_Equation543 : Law647.StructuralFromFin Law543 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_y_pxy_pyx_Equation543 (fun {G} M hM ↦ ?_)
  have hm := (@Law543.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op a a) ≠ b ∨ N.op a b = (M.op a b)) →
      (∀ a b : G, (M.op a a) = b ∨ N.op a b = (M.op b a)) → @satisfies _ G N Law647 := by
    intro N hthen helse
    rw [@Law647.models_iff G N]
    intro x y z
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (b)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (b)).imp id (fun h ↦ if_neg h)

