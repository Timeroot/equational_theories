import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_31

/-!
# Structurality from `Equation543` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation543` is `x = y ◇ (z ◇ (x ◇ (y ◇ z)))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = Y then m(X,Y) else m(Y,X)`
is an automorphism -- is `GuardAut_pxx_y_pxy_pyx_Equation543`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 7 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation617` from `Equation543`: `x = y ◇ (z ◇ (x ◇ (y ◇ z)))` ⊢ `x = x ◇ (x ◇ ((x ◇ y) ◇ y))`,
through `x □ y = if m(X,X) = Y then m(X,Y) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation617_StructuralFromFin_Equation543 : Law617.StructuralFromFin Law543 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_y_pxy_pyx_Equation543 (fun {G} M hM ↦ ?_)
  have hm := (@Law543.models_iff G M).mp hM
  rw [@Law617.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

