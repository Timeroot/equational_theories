def tr (x y : Fin 64) := (trData.getD x.val #[]).getD y.val (0, 0)
def sizes : Fin 4 → ℕ := ![1, 2, 4, 2]
def valuesData : Array (Array (Fin 64)) := #[#[0], #[0, 1], #[0, 1, 4, 5], #[0, 21]]
def values (i : Fin 4) (j : Fin (sizes i)) : Fin 64 := (valuesData.getD i.val #[]).getD j.val 0
def stabilizersData : Array (Array (Fin 2883)) := #[#[64, 65, 0], #[65, 577, 578], #[65, 1730, 578], #[64, 2882, 0]]
def stabilizers (i : Fin 4) (j : Fin 3) : Fin 2883 := (stabilizersData.getD i.val #[]).getD j.val 0

theorem transport_correct : ∀ x y,
    wordPerm genPerm (words (tr x y).2) (rep (tr x y).1).1 = x ∧
    wordPerm genPerm (words (tr x y).2) (rep (tr x y).1).2 = y := by native_decide
theorem stabilizers_correct : ∀ i j,
    wordPerm genPerm (words (stabilizers i j)) (rep i).1 = (rep i).1 ∧
    wordPerm genPerm (words (stabilizers i j)) (rep i).2 = (rep i).2 := by native_decide
theorem values_complete : ∀ i x,
    (∀ j, wordPerm genPerm (words (stabilizers i j)) x = x) →
    ∃ a, values i a = x := by native_decide

abbrev Params := (i : Fin 4) → Fin (sizes i)
@[implicit_reducible] def fam (p : Params) : Magma (Fin 64) := family genPerm words tr sizes values p
@[implicit_reducible] def source : Magma (Fin 64) := ⟨sourceRow⟩
def pattern : Fin 1 → Bool := fun _ => false

theorem coverage (N : Magma (Fin 64)) (hg : ∀ i, N.IsEndo (genPerm i)) : ∃ p, fam p = N :=
  classification genPerm words rep tr sizes values stabilizers
