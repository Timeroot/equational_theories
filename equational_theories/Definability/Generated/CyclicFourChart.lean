def trData : Array (Array (Fin 6 × Fin 41476)) :=
  trCodes.map (fun row => row.map (fun code => (Fin.ofNat 6 (code / 41476), Fin.ofNat 41476 code)))
def tr (x y : Fin 256) := (trData.getD x.val #[]).getD y.val (0, 0)
def sizes : Fin 6 → ℕ := ![1, 2, 4, 2, 8, 2]
def valuesData : Array (Array (Fin 256)) := #[#[0], #[0, 1], #[0, 1, 4, 5], #[0, 17], #[0, 1, 4, 5, 16, 17, 20, 21], #[0, 85]]
def values (i : Fin 6) (j : Fin (sizes i)) : Fin 256 := (valuesData.getD i.val #[]).getD j.val 0
def stabilizersData : Array (Array (Fin 41476)) := #[#[256, 257, 0, 0], #[257, 3073, 3074, 3075], #[257, 3073, 9219, 3075], #[3154, 12303, 0, 0], #[257, 12303, 9219, 3075], #[256, 41475, 0, 0]]
def stabilizers (i : Fin 6) (j : Fin 4) : Fin 41476 := (stabilizersData.getD i.val #[]).getD j.val 0

theorem transport_correct : ∀ x y,
    wordPerm genPerm (words (tr x y).2) (rep (tr x y).1).1 = x ∧
    wordPerm genPerm (words (tr x y).2) (rep (tr x y).1).2 = y := by native_decide
theorem stabilizers_correct : ∀ i j,
    wordPerm genPerm (words (stabilizers i j)) (rep i).1 = (rep i).1 ∧
    wordPerm genPerm (words (stabilizers i j)) (rep i).2 = (rep i).2 := by native_decide
theorem values_complete : ∀ i x,
    (∀ j, wordPerm genPerm (words (stabilizers i j)) x = x) →
    ∃ a, values i a = x := by native_decide

abbrev Params := (i : Fin 6) → Fin (sizes i)
@[implicit_reducible] def fam (p : Params) : Magma (Fin 256) := family genPerm words tr sizes values p
def pattern : Fin 1 → Bool := fun _ => false

theorem coverage (N : Magma (Fin 256)) (hg : ∀ i, N.IsEndo (genPerm i)) : ∃ p, fam p = N :=
  classification genPerm words rep tr sizes values stabilizers
    transport_correct stabilizers_correct values_complete N hg

end Magma.CyclicFourChart
