theorem Equation307_StructuralFromFin_Equation31 : Law307.StructuralFromFin Law31 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyx_y_pyx_x_x_y_pyx_Equation31 (fun {G} M hM ↦ ?_)
  have hm := (@Law31.models_iff G M).mp hM
  rw [@Law307.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

