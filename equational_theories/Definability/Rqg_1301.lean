import equational_theories.Definability.DiagRow

/-!
# `Equation1301` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1301` is `x = y ◇ (((x ◇ z) ◇ y) ◇ z)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1301`: `x = y ◇ (((x ◇ z) ◇ y) ◇ z)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1301 : DiagRow.RowQG Law1301 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1301.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op z u) u) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op (M.op X0 X2) X1) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op (M.op X0 X1) (M.op (M.op (M.op X0 X3) X2) X3))) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 X1 (M.op (M.op (M.op X0 X3) X2) X3)
       have i₂ := eq4 X0 X2 X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op (M.op X0 X1) (M.op X2 X3)) X1) (M.op X0 X3)) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 (M.op (M.op (M.op X0 X1) (M.op X2 X3)) X1) X3
       have i₂ := eq4 X0 (M.op X2 X3) X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq26 : ∀ X0 X1 : G, (M.op X0 X1) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq8 X1 X0 (M.op X1 X0) x
       have i₂ := eq4 X1 (M.op X1 X0) x
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq62 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op (M.op X0 X2) X1) X0)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq8 (M.op X0 X2) X1 X2 (M.op X0 x)
       have i₂ := eq9 X0 X2 X0 x
       grind)
    | exact superpose eq9 eq8
    | exact resolve eq8 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq9
  have eq73 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op (M.op X0 X2) X1))) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq62 X0 X1 X2
       have i₂ := eq26 (M.op (M.op X0 X2) X1) X0
       grind)
    | (have i₁ := eq62 X0 X1 X2
       have i₂ := eq26 X0 (M.op (M.op X0 X2) X1)
       grind)
    | exact superpose eq26 eq62
    | exact resolve eq62 eq26
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq26 eq62
  have eq179 : ∀ X0 : G, y = (M.op X0 (M.op x (M.op (M.op x x) X0))) := by
    intro X0
    first
    | (have i₁ := eq73 x X0 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq73
    | exact resolve eq73 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq226 : x = y := by
    first
