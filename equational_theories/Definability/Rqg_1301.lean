       have i₂ := eq73 x x x
       grind)
    | exact superpose eq73 eq179
    | exact resolve eq179 eq73
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq73 eq179
  have eq232 : False := by grind
  exact eq232

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1301` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1301 : Law3.StructuralFrom Law1301 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1301

