/-!
# Structurality from `Equation3591` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation3591` is `x ◇ y = z ◇ ((x ◇ z) ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then m(Y,Y) else m(Y,X)`
is an automorphism -- is `GuardAut_pyy_y_pyy_pyx_Equation3591`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 5 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation312` from `Equation3591`: `x ◇ y = z ◇ ((x ◇ z) ◇ y)` ⊢ `x ◇ x = y ◇ (x ◇ x)`,
through `x □ y = if m(Y,Y) = Y then m(Y,Y) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation312_StructuralFromFin_Equation3591 : Law312.StructuralFromFin Law3591 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pyy_y_pyy_pyx_Equation3591 (fun {G} M hM ↦ ?_)
  have hm := (@Law3591.models_iff G M).mp hM
  rw [@Law312.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

