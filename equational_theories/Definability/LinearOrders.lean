/-!
# Linear magmas over orders in number fields

The blocks of the definability board that no finite magma reaches are carried by linear models
`x ◇ y = a * x + b * y` over rings of integers `ℤ[θ]`, where `θ` is an algebraic number of small
degree. `Definability/LinearTargets.lean` reduces such a refutation, over any domain, to three
arithmetic facts -- `hc`, `hP` and sometimes `h₃` -- so an order costs only:

* a proof that its defining polynomial `q` is irreducible, hence that `AdjoinRoot q` is a domain;
* one residue map `ℤ[θ] → ZMod m` per fact, given by a root of `q` modulo `m`;
* one `linear_combination` against `q θ = 0` per source law the model satisfies.

The residue maps are what a finite model cannot imitate. `hP` says an explicit cubic or quadratic
has no root in `ℤ[θ]`, and that is witnessed by a single small residue field; but `hc` needs a
*different* one, since in the residue field of `c` the polynomial `hP` names does have a root. No
single finite quotient sees both, which is why these certificates have no `ZMod` replacement and
the model has to be infinite.

Being clone arguments over infinite models, the certificates refute `TermDefinableFrom`, and only
over all magmas.

This file is generated by `genord.py`.
-/

open Law Law.MagmaLaw Polynomial

namespace Magma

/-- If `φ` kills `c` but not `n`, then `n` is not in the ideal `(c)`, so `n + c * x` never
vanishes. This is how a coefficient modulus is shown not to be a unit, and how the extra factor
`3` some targets need is shown to be prime to it. -/
theorem add_mul_ne_zero_of_hom {R S : Type} [CommRing R] [CommRing S] (φ : R →+* S) (n c : R)
    (hc : φ c = 0) (hn : φ n ≠ 0) (x : R) : n + c * x ≠ 0 := by
  intro h
  refine hn ?_
  have h' := congrArg φ h
  rwa [map_add, map_mul, hc, zero_mul, add_zero, map_zero] at h'

end Magma

/-- A monic integer polynomial of degree `2` or `3` with no root in some `ZMod m` is irreducible:
a factorization would have a linear factor, whose root would survive the reduction. -/
theorem irreducible_int_of_no_root {q : ℤ[X]} (hm : q.Monic) {d : ℕ} (hd : q.natDegree = d)
    (h2 : 2 ≤ d) (h3 : d ≤ 3) (m : ℕ)
    (h : ∀ y : ZMod m, q.eval₂ (Int.castRingHom (ZMod m)) y ≠ 0) : Irreducible q := by
  rw [Polynomial.Monic.irreducible_iff_roots_eq_zero_of_degree_le_three hm (hd ▸ h2) (hd ▸ h3),
    Multiset.eq_zero_iff_forall_notMem]
  intro x hx
  rw [mem_roots hm.ne_zero] at hx
  exact h (Int.castRingHom (ZMod m) x) (by rw [eval₂_at_apply, hx.eq_zero, map_zero])

noncomputable section

/-! ### `ℤ[θ]` with `q θ = 0` for `q = X ^ 3 - X - 1`: the plastic ratio, `θ ^ 3 = θ + 1` -/

namespace Plastic

/-- The defining polynomial of the order. -/
abbrev q : ℤ[X] := X ^ 3 - X - 1

theorem q_irr : Irreducible q :=
  X_pow_sub_X_sub_one_irreducible (by norm_num)

/-- The order `ℤ[θ]`, a domain because `q` is irreducible. -/
abbrev R : Type := AdjoinRoot q

instance : IsDomain R :=
  AdjoinRoot.isDomain_of_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp q_irr)

/-- The algebraic integer `θ`. -/
abbrev th : R := AdjoinRoot.root q

theorem hq : th ^ 3 - th - 1 = 0 := by
  have h := AdjoinRoot.eval₂_root q
  simp only [q, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-! The residue maps, each given by a root of `q` modulo `m`. -/

/-- Reduction modulo `7`, sending `θ` to `5`. -/
def r7_5 : R →+* ZMod 7 := AdjoinRoot.lift (Int.castRingHom (ZMod 7)) 5
  (by simp only [q, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r7_5_th : r7_5 th = 5 := by simp [r7_5]

/-- Reduction modulo `5`, sending `θ` to `2`. -/
def r5_2 : R →+* ZMod 5 := AdjoinRoot.lift (Int.castRingHom (ZMod 5)) 2
  (by simp only [q, eval₂_sub, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r5_2_th : r5_2 th = 2 := by simp [r5_2]

/-! #### The model `x ◇ y = (-th ^ 2) * x + (th) * y`, with coefficient modulus `c = -th ^ 2 + th - 1`. -/

theorem hc (x : R) : (1 : R) + (-th ^ 2 + th - 1) * x ≠ 0 :=
  Magma.add_mul_ne_zero_of_hom r7_5 1 _
    (by simp; decide)
    (by simp only [map_one]; decide) x

theorem h₃ (x : R) : (3 : R) + (-th ^ 2 + th - 1) * x ≠ 0 :=
  Magma.add_mul_ne_zero_of_hom r7_5 3 _
    (by simp; decide)
    (by simp only [map_ofNat]; decide) x

theorem hP3272 (z : R) : z ^ 2 - z + 1 ≠ 0 := by
  intro h
  have hr := congrArg r5_2 h
  simp only [map_sub, map_add, map_pow, map_one, map_zero] at hr
  revert hr
  generalize r5_2 z = y
  revert y
  decide

/-- Equation `2707`, `x = ((y ◇ x) ◇ (y ◇ x)) ◇ y`, holds in the model. -/
theorem sat_2707 : @Equation2707 R (Magma.lin (-th ^ 2) (th)) := by
  intro x y
  simp only [Magma.lin_op]
  linear_combination (th ^ 3 * y - th ^ 2 * x - th ^ 2 * y + th * x + th * y - x) * hq

end Plastic

