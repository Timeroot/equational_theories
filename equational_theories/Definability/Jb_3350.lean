/-!
# Structurality from `Equation3350` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation3350` is `x ◇ y = y ◇ (x ◇ (z ◇ z))`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a a) = b then a else if (M.op b b) = b then a else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pxx_y_pyy_y_x_x_pyx_Equation3350`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation817` from `Equation3350`: `x ◇ y = y ◇ (x ◇ (z ◇ z))` ⊢ `x = x ◇ ((x ◇ x) ◇ (x ◇ x))`,
through `x □ y = if (M.op a a) = b then a else if (M.op b b) = b then a else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation817_StructuralFromFin_Equation3350 : Law817.StructuralFromFin Law3350 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pxx_y_pyy_y_x_x_pyx_Equation3350 (fun {G} M hM ↦ ?_)
  have hm := (@Law3350.models_iff G M).mp hM
  rw [@Law817.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

