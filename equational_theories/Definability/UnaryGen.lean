import equational_theories.Definability.UnaryCore

/-!
# The generic unary map: sources 38 and 39

`Equation39`, `x ◇ x = y ◇ x`, says every product is the square of its right argument and says
nothing else, so its models are exactly the sets with a unary map, `x ◇ y = s y` for an arbitrary
`s`; `Equation38` is the mirror, `x ◇ y = s x`. They are the root of the right-unary down-set --
2296 of the 4694 laws imply 39 -- and a target settled here is settled for every one of them.

With no identity on `s` the language names `x, s x, y, s y` and stops: `s² x` would add a fifth
coordinate to the pattern and take the operation count from `31104` to about `10^29`. That leaves
twelve equality patterns for `(x, s x, y, s y)`, and a `∅`-definable binary operation is a choice
of one of the four values per pattern -- a `QFOp` decision tree, so `QFOp.definable_graph` is the
forward half of `StructuralOnMagma` for free.

What is special here is that a tree is built from `v ↦ v ◇ v` and equality alone. **Every magma
carries every one of these operations**, and the laws they satisfy they satisfy unconditionally;
the source is used only for the reverse half, where `M.Graph` has to be recovered from `□`. So the
satisfaction proofs below take no hypothesis, and the two sources differ by one formula:
`z = y □ y` for 39, `z = x □ x` for 38.

Generated by `defwork/unarygen.py`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace UnaryGen

variable {G : Type} (M : Magma G)

/-! ## The two normal forms -/

/-- Under `Equation39` every product is the square of its right argument. -/
theorem sop39 (h : Equation39 G) (a b : G) : M.op a b = M.op b b := (h b a).symm

/-- Under `Equation38` every product is the square of its left argument. -/
theorem sop38 (h : Equation38 G) (a b : G) : M.op a b = M.op a a := (h a b).symm

/-! ## The operations

Each tree tests `x, s x, y, s y` against each other and returns one of them. Its diagonal names
`s`, which is what `Unary.definable_graph_diag` and its mirror ask for. -/

/-- `x □ y := if y = x then s x else x`. -/
def t1296 : QFOp :=
  .ite (Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0))

open scoped Classical in
theorem t1296_apply (a b : G) :
    (t1296.magma M).op a b = if b = a then M.op a a else a := by
  show @QFOp.eval _ M t1296 ![a, b] = _
  simp only [t1296, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `x □ x = s x`: on the diagonal every branch of `t1296` returns the square. -/
theorem t1296_diag (y : G) : (t1296.magma M).op y y = M.op y y := by
  classical grind [t1296_apply M y y]

/-- `x □ y := if y = x then s x else if s y = x then y else x`. -/
def t17568 : QFOp :=
  .ite (Lf 1) (Lf 0)
    (.leaf (Lf 0 ⋆ Lf 0))
    (.ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 1)) (.leaf (Lf 0)))

open scoped Classical in
theorem t17568_apply (a b : G) :
    (t17568.magma M).op a b = if b = a then M.op a a else if M.op b b = a then b else a := by
  show @QFOp.eval _ M t17568 ![a, b] = _
  simp only [t17568, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `x □ x = s x`: on the diagonal every branch of `t17568` returns the square. -/
theorem t17568_diag (y : G) : (t17568.magma M).op y y = M.op y y := by
  classical grind [t17568_apply M y y]

/-- `x □ y := if s y = x then y else if y = s x then x else s x`. -/
def t17585 : QFOp :=
  .ite (Lf 1 ⋆ Lf 1) (Lf 0)
    (.leaf (Lf 1))
    (.ite (Lf 1) (Lf 0 ⋆ Lf 0) (.leaf (Lf 0)) (.leaf (Lf 0 ⋆ Lf 0)))

open scoped Classical in
theorem t17585_apply (a b : G) :
    (t17585.magma M).op a b =
      if M.op b b = a then b else if b = M.op a a then a else M.op a a := by
  show @QFOp.eval _ M t17585 ![a, b] = _
  simp only [t17585, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `x □ x = s x`: on the diagonal every branch of `t17585` returns the square. -/
theorem t17585_diag (y : G) : (t17585.magma M).op y y = M.op y y := by
