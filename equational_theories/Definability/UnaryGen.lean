/-- `x □ y := if s y = x then y else s x`. -/
def t18017 : QFOp :=
  .ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 1)) (.leaf (Lf 0 ⋆ Lf 0))

open scoped Classical in
theorem t18017_apply (a b : G) :
    (t18017.magma M).op a b = if M.op b b = a then b else M.op a a := by
  show @QFOp.eval _ M t18017 ![a, b] = _
  simp only [t18017, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

