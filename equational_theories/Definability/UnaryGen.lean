  show @QFOp.eval _ M t27322 ![a, b] = _
  simp only [t27322, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `x □ x = s x`: on the diagonal every branch of `t27322` returns the square. -/
