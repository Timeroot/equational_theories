/-- `x □ y := if s x = x then if s y = y then x else y else if y = s x then if s y = x then s x
else x else if y = x then s x else y`. -/
def t20194 : QFOp :=
  .ite (Lf 0 ⋆ Lf 0) (Lf 0)
    (.ite (Lf 1 ⋆ Lf 1) (Lf 1) (.leaf (Lf 0)) (.leaf (Lf 1)))
    (.ite (Lf 1) (Lf 0 ⋆ Lf 0)
      (.ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0)))
      (.ite (Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 1))))

open scoped Classical in
theorem t20194_apply (a b : G) :
    (t20194.magma M).op a b =
      if M.op a a = a then
        if M.op b b = b then a else b
      else if b = M.op a a then
        if M.op b b = a then M.op a a else a
      else if b = a then M.op a a
      else b := by
  show @QFOp.eval _ M t20194 ![a, b] = _
  simp only [t20194, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `x □ x = s x`: on the diagonal every branch of `t20194` returns the square. -/
theorem t20194_diag (y : G) : (t20194.magma M).op y y = M.op y y := by
  classical grind [t20194_apply M y y]

