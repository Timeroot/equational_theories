def t27322 : QFOp :=
  .ite (Lf 1) (Lf 0)
    (.leaf (Lf 0 ⋆ Lf 0))
    (.ite (Lf 1) (Lf 0 ⋆ Lf 0) (.leaf (Lf 0)) (.leaf (Lf 1)))

open scoped Classical in
theorem t27322_apply (a b : G) :
