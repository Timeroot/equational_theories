import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination
import equational_theories.Definability.Invariant
import equational_theories.Definability.CertSyntax
import equational_theories.Equations.All

/-!
# Linear magmas over a commutative ring, and their coefficient congruence

`Definability/Affine.lean` handles a linear magma `x ◇ y = a * x + b * y` by *listing* its clone as
a finite family of coefficient pairs, which costs `k ^ 2` closure identities and needs the clone to
be small. This file replaces the list by the one congruence that governs it.

Every binary term of `Magma.lin a b` is `α * x + β * y`, the two projections have `α + β = 1`, and
a composite has `α + β = a * (α₁ + β₁) + b * (α₂ + β₂)`. So if `α₁ + β₁` and `α₂ + β₂` are both
`1` modulo the ideal `(c)`, the composite's is `a + b`, which is again `1` modulo `(c)` as soon as
`c` divides `a + b - 1`. That is `Magma.LinShift`, and `Magma.lin_isCloneInvariant` is the two-line
induction; nothing is enumerated and the ring is arbitrary.

The gain is not only in size. Over `ZMod m` the invariant `{(α, β) : α + β ≡ 1 mod c}` turns out to
be *exactly* the clone for every model the board needs, so nothing is lost, and the refutation
becomes a scan over `m ^ 2` coefficient pairs instead of a closure computation — cheap enough that
`m` in the fifties is routine. `Definability/LinearZMod.lean` carries those models.

`Definability/LinearInt.lean` is the same argument over `ℤ`, written out by hand because there the
scan is not available and the refutations have to be algebra.

Like every clone argument this refutes `TermDefinableFrom` and says nothing about `DefinableFrom`.
-/

open Law Law.MagmaLaw

namespace Magma

variable {R : Type} [CommRing R]

/-- The linear magma `x ◇ y = a * x + b * y` over a commutative ring. -/
@[implicit_reducible]
def lin (a b : R) : Magma R := Magma.mk fun x y ↦ a * x + b * y

@[simp] theorem lin_op (a b x y : R) : (lin a b).op x y = a * x + b * y := rfl

/-- `LinShift c f` says that `f` is the linear operation with some coefficient pair `(α, β)` whose
sum is `1` modulo the ideal generated by `c`. -/
def LinShift (c : R) (f : R → R → R) : Prop :=
  ∃ α β γ : R, (∀ x y, f x y = α * x + β * y) ∧ α + β = 1 + c * γ

/-- The coefficient congruence is a clone invariant of `Magma.lin a b` whenever `c` divides
`a + b - 1`, the divisibility being given as a witness `e`. -/
theorem lin_isCloneInvariant (a b c e : R) (hab : a + b = 1 + c * e) :
    (lin a b).IsCloneInvariant (LinShift c) where
  fst := ⟨1, 0, 0, fun x y ↦ by ring, by ring⟩
  snd := ⟨0, 1, 0, fun x y ↦ by ring, by ring⟩
  comp := by
    rintro f g ⟨α₁, β₁, γ₁, hf, h₁⟩ ⟨α₂, β₂, γ₂, hg, h₂⟩
    refine ⟨a * α₁ + b * α₂, a * β₁ + b * β₂, e + a * γ₁ + b * γ₂, fun x y ↦ ?_, ?_⟩
    · show (lin a b).op (f x y) (g x y) = _
      rw [lin_op, hf, hg]; ring
    · linear_combination a * h₁ + b * h₂ + hab

/-- The operations satisfying `Magma.LinShift c`, parametrized so that the index runs over a plain
product rather than a subtype: `α` is the first coefficient and `γ` the shift, and the second
coefficient is whatever the congruence forces. Over a fintype this makes `FamilyRefutes` a scan
over `R × R`. -/
@[implicit_reducible]
def linFam (c α γ : R) : Magma R := Magma.mk fun x y ↦ α * x + (1 + c * γ - α) * y

end Magma

namespace Law.MagmaLaw

variable {β : Type*} {L L' : Law.MagmaLaw β}

/-- **The linear obstruction.** If `L'` holds in `Magma.lin a b` over a commutative ring, and no
member of `Magma.linFam c` satisfies `L`, then `L` is not term-definable from `L'` — provided
`c` divides `a + b - 1`, with `e` the witness.

The point of the `Magma.linFam` parametrization is that its hypothesis is decidable over a finite
ring, so the whole certificate is one `Satisfies` and one `FamilyRefutes`. -/
theorem not_termDefinableFrom_of_lin {R : Type} [CommRing R] (a b c e : R)
    (hab : a + b = 1 + c * e) (hM : @satisfies _ R (Magma.lin a b) L')
    (hL : ∀ α γ : R, ¬ @satisfies _ R (Magma.linFam c α γ) L) :
    ¬ L.TermDefinableFrom L' := by
  refine not_termDefinableFrom_of_invariant (Magma.lin a b) hM
    (Magma.lin_isCloneInvariant a b c e hab) ?_
  rintro op ⟨α, β, γ, hop, hs⟩ h
  refine hL α γ ?_
  have hβ : β = 1 + c * γ - α := by linear_combination hs
  subst hβ
  have : Magma.mk op = Magma.linFam c α γ :=
    congrArg Magma.mk (funext fun x ↦ funext fun y ↦ hop x y)
  exact this ▸ h

end Law.MagmaLaw
