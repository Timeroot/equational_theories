import equational_theories.Definability.AutBox
import equational_theories.Definability.Gfx_02

/-!
# Structurality from `Equation2536` through a guarded box

Generated by `defwork/gcell.py`.  `Equation2536` is `x = (y ◇ ((y ◇ x) ◇ z)) ◇ x`.  Its guarded obligation --
a bijection of a finite model respecting the recipe `G0V0` companion off the diagonal is an
automorphism -- is `GuardFix_G0V0_Equation2536`, proved elsewhere for the `Equation3` cell.  That
obligation names no target, so every law the companion satisfies is another cell for free, and
there are 6 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation47` from `Equation2536`: `x = (y ◇ ((y ◇ x) ◇ z)) ◇ x` ⊢ `x = x ◇ (x ◇ (x ◇ x))`,
through `x □ y = if x = y then x else (if Y = m(X,X) then X else x ◇ y)`. -/
theorem Equation47_StructuralFromFin_Equation2536 : Law47.StructuralFromFin Law2536 := by
  classical
  refine AutBox.structuralFromFin_guardOf (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardFix_G0V0_Equation2536 (fun {G} M hM ↦ ?_)
  have hm := (@Law2536.models_iff G M).mp hM
  rw [@Law47.models_iff G ((AutBox.boxIteD (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.boxIteD_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

