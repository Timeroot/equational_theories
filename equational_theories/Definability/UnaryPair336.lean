import equational_theories.Definability.Unary336

/-!
# Source 336: the orbit equation

`Definability/Unary336.lean` settles the targets whose tree names `s` on its own diagonal. The
trees here do not; what they have instead is a pair of `□`-words whose equation cuts out the orbit
of the free variable,

    {w | u(y, w) = v(y, w)} = {y, s y},

and then `Unary.structuralOnMagma_pair` separates the two elements with one universal quantifier:
`z = s y` iff the equation holds at `z` and, should `z` be `y`, the orbit is a singleton.

    x □ y := if y = s x then s x else x
      with `w = (y □ w)`  (3 targets, 296 cells)

Generated by `defwork/emitpair.py`. The proofs live in `UnaryPair336_*.lean`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace UnaryPair336

variable {G : Type} (M : Magma G)

/-- `x □ y := if y = s x then s x else x`. -/
def t36 : QFOp :=
  .ite (Lf 1) (Lf 0 ⋆ Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0))

open scoped Classical in
theorem t36_apply (a b : G) :
    (t36.magma M).op a b = if b = M.op a a then M.op a a else a := by
  show @QFOp.eval _ M t36 ![a, b] = _
  simp only [t36, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- `w = (y □ w)` holds exactly at `z = y` and `z = s y`. -/
theorem t36_pair (h : Equation336 G) (y z : G) :
    @evalInMagma _ _ (t36.magma M) ![y, z] (Lf 1)
        = @evalInMagma _ _ (t36.magma M) ![y, z] ((Lf 0) ⋆ (Lf 1))
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary336.name_s M h
  show z = (t36.magma M).op y z ↔ _
  simp only [t36_apply M, hs]
  grind

end UnaryPair336
