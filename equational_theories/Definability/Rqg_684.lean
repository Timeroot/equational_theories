import equational_theories.Definability.DiagRow

/-!
# `Equation684` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation684` is `x = y ◇ (x ◇ ((y ◇ z) ◇ z))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation684`: `x = y ◇ (x ◇ ((y ◇ z) ◇ z))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation684 : DiagRow.RowQG Law684 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law684.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op (M.op u u) u)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op (M.op X1 X2) X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op X2 (M.op X0 (M.op X0 (M.op (M.op X1 X3) X3))))) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 X1 (M.op X0 (M.op (M.op X1 X3) X3))
       have i₂ := eq4 X0 X1 X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X0 (M.op (M.op X1 X2) X2))) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 X0 (M.op (M.op X1 X2) X2)
       have i₂ := eq4 (M.op X0 (M.op (M.op X1 X2) X2)) X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X1 X2 : G, (M.op X1 (M.op X2 X1)) = X2 := by
    intro X1 X2
    first
    | (have i₁ := eq8 x X1 X2 x
       have i₂ := eq9 x X1 x
       grind)
    | exact superpose eq9 eq8
    | exact resolve eq8 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq9
  have eq11 : x = (M.op y (M.op x x)) := by
    first
    | (have i₁ := eq10 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq10
    | exact resolve eq10 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X0) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq10 (M.op X0 X1) X1
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq10
    | exact resolve eq10 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq17 : y = (M.op (M.op x x) x) := by
    first
    | (have i₁ := eq10 (M.op x x) y
       have i₂ := eq11
       grind)
    | exact superpose eq11 eq10
    | exact resolve eq10 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10 eq11
  have eq20 : x = y := by
    first
    | (have i₁ := eq17
       have i₂ := eq13 x x
       grind)
    | exact superpose eq13 eq17
    | exact resolve eq17 eq13
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13 eq17
  have eq21 : False := by grind
  exact eq21

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation684` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation684 : Law3.StructuralFrom Law684 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation684
