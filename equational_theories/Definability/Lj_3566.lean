/-!
# Structurality from `Equation3566` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation3566` is `x ◇ y = y ◇ ((z ◇ x) ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b a) = (M.op b b) then (M.op a a) else if (M.op a a) = (M.op b a) then (M.op b b) else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pyx_pyy_pxx_pyx_pxx_pyy_pyx_Equation3566`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation323` from `Equation3566`: `x ◇ y = y ◇ ((z ◇ x) ◇ y)` ⊢ `x ◇ y = x ◇ (x ◇ y)`,
through `x □ y = if (M.op b a) = (M.op b b) then (M.op a a) else if (M.op a a) = (M.op b a) then (M.op b b) else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation323_StructuralFromFin_Equation3566 : Law323.StructuralFromFin Law3566 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyx_pyy_pxx_pyx_pxx_pyy_pyx_Equation3566 (fun {G} M hM ↦ ?_)
  have hm := (@Law3566.models_iff G M).mp hM
  rw [@Law323.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

