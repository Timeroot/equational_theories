import equational_theories.Definability.AutBox

/-!
# Structurality from `Equation3737` through a word companion

Generated by `defwork/wcell.py`.  `Equation3737` is `x ◇ y = (x ◇ z) ◇ (y ◇ z)`.  The companion is
`x □ y = W(x, y)` for 2 words `W` below: `haut` says the companion
has no automorphism the magma lacks, which is the whole reverse half of `StructuralOnMagma` on a
finite carrier, and each theorem then only has to check that the source forces its target of `W`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

/-- Every bijection of a model of `Equation3737` respecting `(x ◇ ((y ◇ y) ◇ y))` respects `◇`. -/
private theorem haut0 : ∀ {G : Type} [Finite G] (M : Magma G), satisfies G Law3737 →
    ∀ σ τ : G → G, (∀ a : G, τ (σ a) = a) → (∀ a : G, σ (τ a) = a) →
    (∀ a b : G, σ (@evalInMagma _ _ M ![a, b] (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1)))
      = @evalInMagma _ _ M ![σ a, σ b] (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1))) →
    ∀ a b : G, σ (M.op a b) = M.op (σ a) (σ b) := by
  intro G _ M hM σ τ h1 h2 hw a b
  have h := (@Law3737.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hw
  first
  | grind
  | grind (splits := 30) (ematch := 20)

/-- `Equation4380` from `Equation3737`: `x ◇ y = (x ◇ z) ◇ (y ◇ z)` ⊢ `x ◇ (x ◇ x) = (x ◇ x) ◇ x`,
through the companion `x □ y = (x ◇ ((y ◇ y) ◇ y))`. -/
theorem Equation4380_StructuralFromFin_Equation3737 : Law4380.StructuralFromFin Law3737 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law3737.models_iff G M).mp hM
  rw [@Law4380.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ Lf 1))).magma M)]
  intro x
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | grind
  | grind (splits := 30) (ematch := 20)

