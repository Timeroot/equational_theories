end S8R52

namespace Magma

/-- A member of the class, as the `8` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup8R52 : Type := {w : Fin 8 → Fin 8 // Magma.tupOK S8R52.E S8R52.tr S8R52.z S8R52.st S8R52.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch8R52 (v : tup8R52) : Magma (Fin 8) :=
  Magma.mk (Magma.transport S8R52.E S8R52.tr v.1)

end Magma

