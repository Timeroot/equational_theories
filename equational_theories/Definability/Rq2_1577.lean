import equational_theories.Definability.DiagRow

/-!
# `Equation1577` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1577` is `x = (y ◇ z) ◇ (y ◇ (z ◇ x))`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1577`: `x = (y ◇ z) ◇ (y ◇ (z ◇ x))`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1577 : DiagRow.RowQG Law1577 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1577.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op u (M.op (M.op u u) z)) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op X1 (M.op X2 X0))) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op u (M.op (M.op u u) z))) := by grind
    clear hm nh hM
    have eq7 : ∀ X0 X1 X2 : G, (M.op X2 X0) = (M.op (M.op (M.op X1 X2) X1) X0) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 (M.op X2 X0) (M.op X1 X2) X1
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq10 : ∀ X0 X1 X2 : G, (M.op X1 X2) = (M.op (M.op X0 (M.op X1 X0)) X2) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq7 X2 (M.op X1 X0) X1
         have i₂ := eq7 (M.op X1 X0) X1 X0
         grind)
      | exact superpose eq7 eq7
      | exact resolve eq7 eq7
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq7
    have eq61 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X1 (M.op (M.op X0 X1) X2))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 X1 (M.op X0 X1)
         have i₂ := eq10 X1 X0 (M.op X1 (M.op (M.op X0 X1) X2))
         grind)
      | exact superpose eq10 eq3
      | exact resolve eq3 eq10
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq10
    have eq774 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq61 u u z
         grind)
      | exact superpose eq61 eq4
      | (have r₁ := eq4
         have r₂ := eq61 u u z
         grind)
      | exact resolve eq4 eq61
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq61
    have eq775 : False := by grind
    exact eq775
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op u u) z)), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op X1 (M.op X2 X0))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op X0 x) (M.op X0 (M.op x x))) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : x = y := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1577` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1577 : Law3.StructuralFrom Law1577 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1577
