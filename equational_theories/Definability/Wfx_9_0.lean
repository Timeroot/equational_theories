/-- Two models of `Equation9` on one carrier with the same `((x ◇ x) ◇ y)` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) Law9 := by
  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law9.models_iff G M).mp hM
  have hn := (@Law9.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 (N.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) X1) = (N.op (N.op X0 X0) X1) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq9 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq5 X0 (M.op X0 x)
       have i₂ := eq5 X0 x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq10 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq6 X0 (N.op X0 x)
       have i₂ := eq6 X0 x
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq13 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op (M.op X0 X0) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X0 X1
       have i₂ := eq10 X0
       grind)
    | exact superpose eq10 eq7
    | exact resolve eq7 eq10
    | grind
    | grind (splits := 40)
  clear eq10
  have eq26 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq13 X0 X1
       have i₂ := eq9 X0
       grind)
    | exact superpose eq9 eq13
    | exact resolve eq13 eq9
    | grind
    | grind (splits := 40)
  clear eq9 eq13
  have eq41 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq26 a b
       grind)
    | exact superpose eq26 eq8
    | exact resolve eq8 eq26
    | grind
    | grind (splits := 40)
  clear eq26
  have eq43 : False := by grind
  exact eq43

