import equational_theories.Definability.AutBox
import equational_theories.Superposition

/-!
# Structurality from `Equation3322` through the companion `x □ y = (x ◇ (y ◇ (x ◇ y)))`

Generated by `defwork/wffit.py`.  `Equation3322` is `x ◇ y = x ◇ (y ◇ (z ◇ y))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation3322` on one carrier with the same table of
`(x ◇ (y ◇ (x ◇ y)))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation3322` on one carrier with the same `(x ◇ (y ◇ (x ◇ y)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 1))) Law3322 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law3322.models_iff G M).mp hM
  have hn := (@Law3322.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 X1) = (M.op X0 (M.op X1 (M.op X2 X1))) := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 X1) = (N.op X0 (N.op X1 (N.op X2 X1))) := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op X0 X1))) = (N.op X0 (N.op X1 (N.op X0 X1))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq19 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op X0 (M.op X1 (M.op X0 X1))) := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 X1 X0
       have i₂ := eq7 X0 X1
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq22 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq19 X0 X1
       have i₂ := eq5 X0 X1 X0
       grind)
    | exact superpose eq5 eq19
    | exact resolve eq19 eq5
    | grind
    | grind (splits := 40)
  clear eq19
  have eq46 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq22 a b
       grind)
    | exact superpose eq22 eq8
    | exact resolve eq8 eq22
    | grind
    | grind (splits := 40)
  clear eq22
  have eq53 : False := by grind
  exact eq53

/-- `Equation3255` from `Equation3322`: `x ◇ y = x ◇ (y ◇ (z ◇ y))` ⊢ `x ◇ x = x ◇ (x ◇ (y ◇ x))`,
through the companion `x □ y = (x ◇ (y ◇ (x ◇ y)))`. -/
theorem Equation3255_StructuralFromFin_Equation3322 : Law3255.StructuralFromFin Law3322 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law3322.models_iff G M).mp hM
  rw [@Law3255.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 1)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

