/-! ### The operations

Each is a decision tree over `d x`, `d y`, `x = y`, `x ◇ x = x`, `y ◇ y = y`, `y = x ◇ x` and
`x = y ◇ y`, whose leaves are words in `x` and `y`. A tree has to satisfy three things: that it
keeps the source's diagonal, that it gives the row constant `κ` back at its reserved cell, and how
it reads the columns of `S`. `D` itself is named by the tree's own diagonal. -/

section Ops

variable (M : Magma G) (K : RKer M)

/-! #### Operation `0`

4 cells, in 1 rows of the open list over 1 sources.  Its off-`D` block is read `self`, so it gives
`κ` back at `x (M.op x x)`. -/

/-- The tree of operation `0`. -/
def q0 : EOp :=
  .ite (.sq (Lf 1))
    (.ite (.eq (Lf 0) (Lf 1))
      (.leaf (Lf 0 ⋆ Lf 1))
      (.ite (.eq (Lf 1) (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0 ⋆ Lf 1)) (.leaf (Lf 0))))
    (.leaf (Lf 0 ⋆ Lf 1))

open scoped Classical in
theorem q0_apply (a b : G) :
    (q0.magma M).op a b =
      if K.d b then
        if a = b then M.op a b else if b = M.op a a then M.op a b else a
      else M.op a b := by
  show @EOp.eval _ M q0 ![a, b] = _
  simp only [q0, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    rsqex M K]

include K in
theorem q0_diag (y : G) (hy : K.d y) : (q0.magma M).op y y = M.op y y := by
  classical
  rw [q0_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The tree keeps the source's diagonal everywhere, on `D` because that is `κ` and off it because
the off-`D` clause copies the source cell.  This is what names `D`, and it is the one rewrite a
nested application gets: `□ c c` is `M c c`, which is a square. -/
theorem q0_dg (a : G) : (q0.magma M).op a a = M.op a a := by
  classical
  rw [q0_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The row constant, at the one cell the read reserves for it. -/
theorem q0_kap (x : G) : (q0.magma M).op x (M.op x x) = M.op x (M.op x x) := by
  classical
  rw [q0_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  first
  | (split_ifs <;> grind)
  | (split_ifs <;> simp_all <;> grind)

include K in
theorem q0_out (x y : G) (hy : ¬ K.d y) :
    (q0.magma M).op x y = M.op x y := by
  classical
  rw [q0_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The whole of `StructuralOnMagma` for operation `0`, bar the law itself. -/
theorem structural_q0 {β : Type*} {L : Law.MagmaLaw β}
    (hL : @satisfies _ G (q0.magma M) L) : L.StructuralOnMagma M :=
  structuralOn_selfKappaD M K q0 hL (q0_diag M K) (q0_kap M K)
    (q0_out M K)

/-! #### Operation `14506`

84 cells, in 16 rows of the open list over 6 sources.  Its off-`D` block is read `split2`, so it
gives `κ` back at `x (M.op x x)`. -/

/-- The tree of operation `14506`. -/
def q14506 : EOp :=
  .ite (.sq (Lf 1))
    (.leaf (Lf 0 ⋆ Lf 1))
    (.ite (.sq (Lf 0)) (.leaf (Lf 0 ⋆ Lf 1)) (.leaf (Lf 1 ⋆ Lf 0)))

open scoped Classical in
theorem q14506_apply (a b : G) :
    (q14506.magma M).op a b =
      if K.d b then M.op a b else if K.d a then M.op a b else M.op b a := by
  show @EOp.eval _ M q14506 ![a, b] = _
  simp only [q14506, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    rsqex M K]

include K in
theorem q14506_diag (y : G) (hy : K.d y) : (q14506.magma M).op y y = M.op y y := by
  classical
  rw [q14506_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The tree keeps the source's diagonal everywhere, on `D` because that is `κ` and off it because
the off-`D` clause copies the source cell.  This is what names `D`, and it is the one rewrite a
nested application gets: `□ c c` is `M c c`, which is a square. -/
theorem q14506_dg (a : G) : (q14506.magma M).op a a = M.op a a := by
  classical
  rw [q14506_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The row constant, at the one cell the read reserves for it. -/
theorem q14506_kap (x : G) : (q14506.magma M).op x (M.op x x) = M.op x (M.op x x) := by
  classical
  rw [q14506_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  first
  | (split_ifs <;> grind)
  | (split_ifs <;> simp_all <;> grind)

include K in
theorem q14506_ts (x y : G) (hx : K.d x) (hy : ¬ K.d y) :
    (q14506.magma M).op x y = M.op x y := by
  classical
  rw [q14506_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
theorem q14506_ss (x y : G) (hx : ¬ K.d x) (hy : ¬ K.d y) :
    (q14506.magma M).op y x = M.op x y := by
  classical
  rw [q14506_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op p (M.op p p) := K.hin
  split_ifs <;> grind

include K in
/-- The whole of `StructuralOnMagma` for operation `14506`, bar the law itself. -/
theorem structural_q14506 {β : Type*} {L : Law.MagmaLaw β}
    (hL : @satisfies _ G (q14506.magma M) L) : L.StructuralOnMagma M :=
  structuralOn_splitKappaD' M K q14506 hL (q14506_diag M K) (q14506_kap M K)
    (q14506_ts M K) (q14506_ss M K)

end Ops

end Rw4341S
