import equational_theories.Definability.DiagRow

/-!
# `Equation170` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation170` is `x = (y ◇ x) ◇ (y ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation170`: `x = (y ◇ x) ◇ (y ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation170 : DiagRow.ColQG Law170 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law170.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op u u) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op X1 X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op (M.op (M.op u u) z) u) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X0) X1) X0) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq3 X1 (M.op X0 X0)
         have i₂ := eq3 X0 X0
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq9 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq6 u z
         grind)
      | exact superpose eq6 eq4
      | (have r₁ := eq4
         have r₂ := eq6 u z
         grind)
      | exact resolve eq4 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq11 : False := by grind
    exact eq11
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u u) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op X1 X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : x = (M.op (M.op x x) (M.op y y)) := by
    first
    | (have i₁ := eq4 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 : G, (M.op X1 X1) = (M.op X0 (M.op (M.op X1 X0) (M.op X1 X0))) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op X1 X1) (M.op X1 X0)
       have i₂ := eq4 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : (M.op y y) = (M.op x (M.op (M.op x x) (M.op x x))) := by
    first
    | (have i₁ := eq4 (M.op y y) (M.op x x)
       have i₂ := eq7
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq11 : (M.op x x) = (M.op y y) := by
    first
    | (have i₁ := eq10
       have i₂ := eq8 x x
       grind)
    | exact superpose eq8 eq10
    | exact resolve eq10 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq10
  have eq13 : y = (M.op (M.op x x) (M.op x x)) := by
    first
    | (have i₁ := eq4 y y
       have i₂ := eq11
       grind)
    | exact superpose eq11 eq4
    | exact resolve eq4 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq15 : y = x := by
    first
    | (have i₁ := eq13
       have i₂ := eq4 x x
       grind)
    | exact superpose eq4 eq13
    | exact resolve eq13 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13
  have eq16 : False := by grind
  exact eq16

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation170` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation170 : Law3.StructuralFrom Law170 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation170
