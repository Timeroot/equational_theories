  · skip
    simp only [QFOp.idem_diag, QFOp.idem_ne M _ _ hax, QFOp.idem_eq M _ _ e0]
    all_goals
      by_contra nh
      have eq7 (X0 X1 X2 X3 : G) : (X0 ◇ X0) = (X1 ◇ (X0 ◇ (X2 ◇ X3))) := mod_symm (h ..)
      have eq9 : x = (a ◇ x) := mod_symm e0
      have eq10 : x ≠ (x ◇ x) := mod_symm nh
      have eq13 (X0 X1 : G) : (X0 ◇ X0) = (X1 ◇ (X0 ◇ x)) := by first | exact superpose eq9 eq7 | exact mod_symm (superpose eq9 eq7) | exact superpose eq7 eq9 | exact mod_symm (superpose eq7 eq9)
      have eq16 (X0 X1 X2 : G) : (X1 ◇ X1) = (X2 ◇ (X0 ◇ X0)) := by first | exact superpose eq7 eq7 | exact mod_symm (superpose eq7 eq7) | exact superpose eq7 eq7 | exact mod_symm (superpose eq7 eq7)
      have eq23 (X0 : G) : (X0 ◇ x) = (a ◇ a) := by first | exact superpose eq9 eq13 | exact mod_symm (superpose eq9 eq13) | exact superpose eq13 eq9 | exact mod_symm (superpose eq13 eq9)
      have eq47 (X0 X1 : G) : (X0 ◇ X0) = (X1 ◇ X1) := by first | exact superpose eq16 eq16 | exact mod_symm (superpose eq16 eq16) | exact superpose eq16 eq16 | exact mod_symm (superpose eq16 eq16)
      have eq201 (X0 : G) : (X0 ◇ X0) ≠ x := by first | exact superpose eq47 eq10 | exact mod_symm (superpose eq47 eq10) | exact superpose eq10 eq47 | exact mod_symm (superpose eq10 eq47)
