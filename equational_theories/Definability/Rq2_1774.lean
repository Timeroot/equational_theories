import equational_theories.Definability.DiagRow

/-!
# `Equation1774` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1774` is `x = (y ◇ z) ◇ ((y ◇ x) ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1774`: `x = (y ◇ z) ◇ ((y ◇ x) ◇ z)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1774 : DiagRow.RowQG Law1774 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1774.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op u z) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X1 X0) X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op u z)) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op (M.op X1 X2) X3) (M.op (M.op X1 X0) X2))) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X1 X2) (M.op (M.op X1 X0) X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op (M.op X1 X0) X2)) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 X1 (M.op (M.op X1 X0) X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq27 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X1 X2)) X2) = (M.op X0 X0) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq7 X0 (M.op X1 X2) (M.op (M.op X1 (M.op X1 X2)) X2)
         have i₂ := eq5 (M.op X1 X2) X1 X2 X0
         grind)
      | exact superpose eq5 eq7
      | exact resolve eq7 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq7
    have eq64 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X2 (M.op X2 X3)) (M.op (M.op X0 (M.op X0 X1)) X1)) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 X2 (M.op X2 X3)
         have i₂ := eq27 (M.op X2 X3) X0 X1
         grind)
      | exact superpose eq27 eq3
      | exact resolve eq3 eq27
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq65 : ∀ X0 X1 X2 : G, (M.op X2 (M.op (M.op X0 (M.op X0 X1)) X1)) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq5 X2 x X2 X2
         have i₂ := eq27 (M.op (M.op x X2) X2) X0 X1
         grind)
      | exact superpose eq27 eq5
      | exact resolve eq5 eq27
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5 eq27
    have eq66 : ∀ X2 X3 : G, (M.op X2 (M.op X2 X3)) = X3 := by
      intro X2 X3
      first
      | (have i₁ := eq64 x x X2 X3
         have i₂ := eq65 x x (M.op X2 (M.op X2 X3))
         grind)
      | exact superpose eq65 eq64
      | exact resolve eq64 eq65
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq64 eq65
    have eq340 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq66 u z
         grind)
      | exact superpose eq66 eq4
      | (have r₁ := eq4
         have r₂ := eq66 u z
         grind)
      | exact resolve eq4 eq66
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq66
    have eq362 : False := by grind
    exact eq362
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X1 X0) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op x X0) (M.op (M.op x x) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 y x X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : x = y := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1774` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1774 : Law3.StructuralFrom Law1774 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1774
