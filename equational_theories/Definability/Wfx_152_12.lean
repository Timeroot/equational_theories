/-!
# Structurality from `Equation152` through the companion `x □ y = (x ◇ ((y ◇ y) ◇ (y ◇ x)))`

Generated by `defwork/wffit.py`.  `Equation152` is `x = (x ◇ x) ◇ (x ◇ y)`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation152` on one carrier with the same table of
`(x ◇ ((y ◇ y) ◇ (y ◇ x)))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation152` on one carrier with the same `(x ◇ ((y ◇ y) ◇ (y ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 1 ⋆ Lf 0))) Law152 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 1 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law152.models_iff G M).mp hM
  have hn := (@Law152.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op (M.op X0 X0) (M.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op (N.op X0 X0) (N.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X1 X1) (M.op X1 X0))) = (N.op X0 (N.op (N.op X1 X1) (N.op X1 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq16 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 (M.op (M.op X0 X0) (M.op X0 X1))) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq6 X0 X1
       grind)
    | exact superpose eq6 eq7
    | exact resolve eq7 eq6
    | grind
    | grind (splits := 40)
  have eq25 : ∀ X0 X1 : G, (M.op X1 X0) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq16 X0 X1
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq16
    | exact resolve eq16 eq5
    | grind
    | grind (splits := 40)
  clear eq16
  have eq49 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq25 b a
       grind)
    | exact superpose eq25 eq8
    | exact resolve eq8 eq25
    | grind
    | grind (splits := 40)
  clear eq25
  have eq57 : False := by grind
  exact eq57

