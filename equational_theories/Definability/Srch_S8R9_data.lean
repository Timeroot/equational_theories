def Ed : Array (Array Nat) := #[#[0, 1, 2, 3, 4, 5, 6, 7], #[1, 0, 3, 2, 5, 4, 7, 6], #[2, 3, 0, 1, 6, 7, 4, 5], #[3, 2, 1, 0, 7, 6, 5, 4], #[4, 6, 5, 7, 0, 2, 1, 3], #[5, 7, 4, 6, 1, 3, 0, 2], #[6, 4, 7, 5, 2, 0, 3, 1], #[7, 5, 6, 4, 3, 1, 2, 0]]

