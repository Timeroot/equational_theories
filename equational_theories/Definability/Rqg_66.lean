import equational_theories.Definability.DiagRow

/-!
# `Equation66` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation66` is `x = y ◇ (x ◇ (y ◇ y))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation66`: `x = y ◇ (x ◇ (y ◇ y))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation66 : DiagRow.RowQG Law66 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law66.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op u u)), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op X1 X1))) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op (M.op X0 X0) (M.op X0 X0)) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 (M.op X0 X0)
       have i₂ := eq4 (M.op X0 X0) X0
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 : G, (M.op (M.op X0 X0) (M.op X1 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op X0 X0)
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : x = (M.op (M.op y y) (M.op x x)) := by
    first
    | (have i₁ := eq8 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq8
    | exact resolve eq8 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq16 : (M.op x x) = (M.op y y) := by
    first
    | (have i₁ := eq4 (M.op y y) x
       have i₂ := eq11
       grind)
    | exact superpose eq11 eq4
    | exact resolve eq4 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq23 : y = (M.op (M.op x x) (M.op x x)) := by
    first
    | (have i₁ := eq8 y y
       have i₂ := eq16
       grind)
    | exact superpose eq16 eq8
    | exact resolve eq8 eq16
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq16
  have eq24 : x = y := by
    first
    | (have i₁ := eq23
       have i₂ := eq7 x
       grind)
    | exact superpose eq7 eq23
    | exact resolve eq23 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq23
  have eq26 : False := by grind
  exact eq26

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation66` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation66 : Law3.StructuralFrom Law66 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation66
