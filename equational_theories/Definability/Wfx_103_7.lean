/-- Two models of `Equation103` on one carrier with the same `((x ◇ x) ◇ y)` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) Law103 := by
  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law103.models_iff G M).mp hM
