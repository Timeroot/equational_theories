  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X0 X1 (M.op (M.op (M.op X0 X1) x) x)
       have i₂ := eq5 (M.op X0 X1) x x
