  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X0 X1) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X0 X1) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) X1) = (N.op (N.op X0 X0) X1) := by
