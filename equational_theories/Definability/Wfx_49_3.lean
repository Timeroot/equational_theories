import equational_theories.Definability.AutBox
import equational_theories.Superposition

/-!
# Structurality from `Equation49` through the companion `x □ y = (x ◇ (y ◇ (y ◇ (y ◇ y))))`

Generated by `defwork/wffit.py`.  `Equation49` is `x = x ◇ (x ◇ (y ◇ x))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation49` on one carrier with the same table of
`(x ◇ (y ◇ (y ◇ (y ◇ y))))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation49` on one carrier with the same `(x ◇ (y ◇ (y ◇ (y ◇ y))))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ Lf 1)))) Law49 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ Lf 1)))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law49.models_iff G M).mp hM
  have hn := (@Law49.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X1 X0))) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 (N.op X0 (N.op X1 X0))) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op X1 (M.op X1 X1)))) = (N.op X0 (N.op X1 (N.op X1 (N.op X1 X1)))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq12 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 (M.op X0 (M.op X0 (M.op X0 X0)))) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq6 X0 X0
       grind)
    | exact superpose eq6 eq7
    | exact resolve eq7 eq6
    | grind
    | grind (splits := 40)
  have eq17 : ∀ X0 X1 : G, (M.op X1 X0) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq12 X0 X1
       have i₂ := eq5 X0 X0
       grind)
    | exact superpose eq5 eq12
    | exact resolve eq12 eq5
    | grind
    | grind (splits := 40)
  clear eq12
  have eq27 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq17 b a
       grind)
    | exact superpose eq17 eq8
    | exact resolve eq8 eq17
    | grind
    | grind (splits := 40)
  clear eq17
  have eq35 : False := by grind
  exact eq35

/-- `Equation619` from `Equation49`: `x = x ◇ (x ◇ (y ◇ x))` ⊢ `x = x ◇ (x ◇ ((y ◇ x) ◇ x))`,
through the companion `x □ y = (x ◇ (y ◇ (y ◇ (y ◇ y))))`. -/
theorem Equation619_StructuralFromFin_Equation49 : Law619.StructuralFromFin Law49 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ Lf 1)))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law49.models_iff G M).mp hM
  rw [@Law619.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ (Lf 1 ⋆ Lf 1))))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

