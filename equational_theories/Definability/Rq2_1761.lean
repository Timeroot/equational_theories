import equational_theories.Definability.DiagRow

/-!
# `Equation1761` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1761` is `x = (y ◇ z) ◇ ((x ◇ y) ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1761`: `x = (y ◇ z) ◇ ((x ◇ y) ◇ z)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1761 : DiagRow.ColQG Law1761 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1761.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op z u) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X0 X1) X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op z u) u) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 X2 X3 : G, (M.op X1 X2) = (M.op (M.op (M.op (M.op X0 X1) X2) X3) (M.op X0 X3)) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op X1 X2) (M.op (M.op X0 X1) X2) X3
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op (M.op X0 X2) X1)) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 X1 (M.op (M.op X0 X2) X1)
         have i₂ := eq3 X0 X2 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq13 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X1 X0) X2) X1) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op (M.op X1 X0) X2) X1
         have i₂ := eq7 X1 X2 X0
         grind)
      | exact superpose eq7 eq3
      | exact resolve eq3 eq7
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq7
    have eq73 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X1) = X0 := by
      intro X0 X1
      first
      | (have i₁ := eq13 X1 (M.op x X0) X0
         have i₂ := eq6 x X0 X1 X0
         grind)
      | exact superpose eq6 eq13
      | exact resolve eq13 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6 eq13
    have eq117 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq73 z u
         grind)
      | exact superpose eq73 eq4
      | (have r₁ := eq4
         have r₂ := eq73 z u
         grind)
      | exact resolve eq4 eq73
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq73
    have eq118 : False := by grind
    exact eq118
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z u), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X0 X1) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op x X0) (M.op (M.op x x) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 y x X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : y = x := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1761` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1761 : Law3.StructuralFrom Law1761 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1761
