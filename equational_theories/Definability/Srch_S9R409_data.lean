namespace Magma

/-- A member of the class, as the `12` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R409 : Type := {w : Fin 12 → Fin 9 // Magma.tupOK S9R409.E S9R409.tr S9R409.z S9R409.st S9R409.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R409 (v : tup9R409) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R409.E S9R409.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `2` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `decide!` rather than `decide` because the invariance test is `81` cells times the `48`
group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R4090 : Array Nat := #[3, 2, 2, 8, 3, 8, 6, 8, 6, 8, 8, 8]

def vsrch9R4090 : Magma.tup9R409 :=
  ⟨fun i ↦ ⟨vdsrch9R4090[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩

def vdsrch9R4091 : Array Nat := #[3, 2, 2, 8, 8, 3, 2, 6, 8, 3, 2, 8]

def vsrch9R4091 : Magma.tup9R409 :=
  ⟨fun i ↦ ⟨vdsrch9R4091[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `48`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R409Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R4090 : Array (Array Nat) := #[#[3, 2, 2, 8, 2, 6, 6, 6, 3], #[6, 4, 2, 6, 8, 2, 6, 2, 4], #[8, 8, 6, 8, 8, 8, 8, 8, 6], #[8, 2, 2, 0, 2, 6, 6, 6, 0], #[6, 8, 2, 6, 1, 2, 6, 2, 1], #[2, 6, 2, 2, 6, 7, 6, 8, 7], #[8, 8, 8, 8, 8, 8, 2, 8, 2], #[2, 6, 2, 2, 6, 8, 6, 5, 5], #[8, 8, 8, 8, 8, 8, 8, 8, 8]]

def opsrch9R4090 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R4090[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R4090 :
    ∀ x y, Magma.transport S9R409.E S9R409.tr vsrch9R4090.1 x y = opsrch9R4090 x y := by
  native_decide

theorem esrch9R4090 : Magma.srch9R409 vsrch9R4090 = Magma.mk opsrch9R4090 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R4090 x y)

