/-- `Magma.bigCert2Data` as bytes, for constant-time indexing. -/
def bigCert2Bytes : ByteArray := bigCert2Data.toUTF8

/-- `Magma.bigCert2Comp` as bytes, for constant-time indexing. -/
def bigCert2CompBytes : ByteArray := bigCert2Comp.toUTF8

/-- The `%` keeps the index in range without a proof about the string. -/
private def bigCert2Digit (p : Nat) : Fin 8 :=
  ⟨(bigCert2Bytes.get! p).toNat % 8, Nat.mod_lt _ (by omega)⟩

/-- The clone of `Magma.bigCert2`, read out of `Magma.bigCert2Data`. -/
@[implicit_reducible]
def bigCert2Clone (i : Fin 1024) : Magma (Fin 8) :=
  ⟨fun x y ↦ bigCert2Digit (i.val * 64 + x.val * 8 + y.val)⟩

/-- The composition table, read out of `Magma.bigCert2Comp`. -/
def bigCert2Comp' (i j : Fin 1024) : Fin 1024 :=
  ⟨(((bigCert2CompBytes.get! (2 * (i.val * 1024 + j.val))).toNat - 48) * 40 +
      ((bigCert2CompBytes.get! (2 * (i.val * 1024 + j.val) + 1)).toNat - 48)) % 1024,
    Nat.mod_lt _ (by omega)⟩

/-- The three clone-family facts in one `native_decide`: each call recompiles the module, and the
module carries megabytes of string, so the calls are what the build time is made of. -/
theorem bigCert2_cloneFacts :
    (∀ x y, (bigCert2Clone 0).op x y = x) ∧ (∀ x y, (bigCert2Clone 1).op x y = y) ∧
      ∀ i j x y, (bigCert2Clone (bigCert2Comp' i j)).op x y =
        bigCert2.op ((bigCert2Clone i).op x y) ((bigCert2Clone j).op x y) := by
  native_decide

theorem bigCert2_isCloneFamily :
    bigCert2.IsCloneFamily bigCert2Clone 0 1 bigCert2Comp' :=
  ⟨bigCert2_cloneFacts.1, bigCert2_cloneFacts.2.1, bigCert2_cloneFacts.2.2⟩

end Magma

theorem bigCert2_satisfies_883 : @Equation883 (Fin 8) Magma.bigCert2 := by decide!

/-- No member of the clone satisfies any of the targets, again in one call. -/
theorem bigCert2_refutes :
    ∀ i, ¬ @Equation870 (Fin 8) (Magma.bigCert2Clone i) ∧
      ¬ @Equation917 (Fin 8) (Magma.bigCert2Clone i) := by native_decide

theorem bigCert2_refutes_870 :
    ∀ i, ¬ @Equation870 (Fin 8) (Magma.bigCert2Clone i) := fun i ↦ (bigCert2_refutes i).1

theorem bigCert2_refutes_917 :
    ∀ i, ¬ @Equation917 (Fin 8) (Magma.bigCert2Clone i) := fun i ↦ (bigCert2_refutes i).2


theorem Equation870_not_termDefinableFromFin_Equation883 :
    ¬ Law870.TermDefinableFromFin Law883 :=
  not_termDefinableFromFin_of_clone Magma.bigCert2
    ((@Law883.models_iff (Fin 8) Magma.bigCert2).mpr bigCert2_satisfies_883)
    Magma.bigCert2_isCloneFamily fun i h ↦ bigCert2_refutes_870 i
      ((@Law870.models_iff (Fin 8) (Magma.bigCert2Clone i)).mp h)

theorem Equation917_not_termDefinableFromFin_Equation883 :
    ¬ Law917.TermDefinableFromFin Law883 :=
  not_termDefinableFromFin_of_clone Magma.bigCert2
    ((@Law883.models_iff (Fin 8) Magma.bigCert2).mpr bigCert2_satisfies_883)
    Magma.bigCert2_isCloneFamily fun i h ↦ bigCert2_refutes_917 i
      ((@Law917.models_iff (Fin 8) (Magma.bigCert2Clone i)).mp h)
