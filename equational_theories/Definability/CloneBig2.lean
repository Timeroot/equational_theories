     ![1, 4, 3, 2, 7, 6, 5, 0],
     ![3, 5, 4, 1, 6, 0, 7, 2],
     ![4, 7, 5, 6, 0, 2, 3, 1],
     ![7, 0, 6, 5, 1, 3, 2, 4],
     ![5, 6, 7, 4, 2, 1, 0, 3]]⟩

/-- The `1024` operations term-definable from `Magma.bigCert2`, as `64` digits apiece. -/
def bigCert2Data : String :=
  ""

