import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_17

/-!
# Structurality from `Equation3591` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation3591` is `x ◇ y = z ◇ ((x ◇ z) ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = X then Y else m(X,Y)`
is an automorphism -- is `GuardAut_pxx_x_y_pxy_Equation3591`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1637` from `Equation3591`: `x ◇ y = z ◇ ((x ◇ z) ◇ y)` ⊢ `x = (x ◇ x) ◇ ((y ◇ y) ◇ x)`,
through `x □ y = if m(X,X) = X then Y else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation1637_StructuralFromFin_Equation3591 : Law1637.StructuralFromFin Law3591 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_y_pxy_Equation3591 (fun {G} M hM ↦ ?_)
  have hm := (@Law3591.models_iff G M).mp hM
  rw [@Law1637.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

