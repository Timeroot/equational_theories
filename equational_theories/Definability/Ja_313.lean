import equational_theories.Definability.Jax_09

/-!
# Structurality from `Equation313` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation313` is `x ◇ x = y ◇ (x ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b b) = a then (M.op a b) else if (M.op a a) = b then a else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pyy_x_pxx_y_pxy_x_pyx_Equation313`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1036` from `Equation313`: `x ◇ x = y ◇ (x ◇ y)` ⊢ `x = x ◇ ((y ◇ (x ◇ x)) ◇ y)`,
through `x □ y = if (M.op b b) = a then (M.op a b) else if (M.op a a) = b then a else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation1036_StructuralFromFin_Equation313 : Law1036.StructuralFromFin Law313 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyy_x_pxx_y_pxy_x_pyx_Equation313 (fun {G} M hM ↦ ?_)
  have hm := (@Law313.models_iff G M).mp hM
  rw [@Law1036.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

