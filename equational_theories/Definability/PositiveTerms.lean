    first | exact superpose ef8 ef5 | exact superpose ef5 ef8
  have ef15 (X0 X1 X2 : G) : (X2 ◇ X2) ◇ X0 = (X1 ◇ X1) ◇ X0 := by
    first | exact superpose ef8 ef5 | exact superpose ef5 ef8
