  have ef70 (X0 X1 : G) :
      x ≠ (y ◇ y) ◇
      (y ◇ ((x ◇ x) ◇ (x ◇ (((X0 ◇ X0) ◇ (X1 ◇ X1)) ◇ (((z ◇ z) ◇ (z ◇ y)) ◇ z))))) := by
    first | exact superpose ef10 ef6 | exact superpose ef6 ef10
