import equational_theories.Definability.Basic
import equational_theories.Equations.All
import equational_theories.Superposition

set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-!
# Term-definability facts witnessed by an explicit term

`Law.MagmaLaw.TermDefinableFrom t s` asks that every magma satisfying the law `s` carry a
term-defined operation satisfying `t`. A *uniform* witness is a single binary term `w (x, y)` in
the source operation with `s ⊢ t[◇ := w]`; over the class of all magmas a uniform witness is no
loss, because an identity holds throughout the variety generated by `s` exactly when it holds in
its free algebra, so the whole question is which `w` works.

The cells below were found by enumerating the binary term clone of a product of small models of
the source law and testing the surviving candidates `w` with Vampire. Each cell contributes a
`private` lemma carrying the equational content `s ⊢ t[◇ := w]`, replayed from the Vampire
refutation in the style of `Generated/VampireProven`, and a packaging theorem naming the term.
One term usually serves several targets from the same source, so the file is grouped by source
law.

These are positive facts, so they are out of reach of the clone-refutation certificates that make
up the rest of the `Definability` directory.
-/

open FirstOrder.Language
open Law
open Law.MagmaLaw

namespace Law.MagmaLaw

variable {G : Type}

/-- The magma operation as a two-variable term, for building `TermDefinable` witnesses. -/
private abbrev tm (a b : (MagmaLanguage.withConstants (∅ : Set G)).Term (Fin 2)) :
    (MagmaLanguage.withConstants (∅ : Set G)).Term (Fin 2) :=
  Functions.apply₂ (Sum.inl ()) a b

/-- Equation 3751 `x ◇ y = (y ◇ x) ◇ (y ◇ x)` is term-definable from equation 332
`x ◇ y = y ◇ (x ◇ x)`, via the term `x □ y := (x ◇ y) ◇ (x ◇ y)`. -/
private theorem aux332_3751 [Magma G] (h : Equation332 G) (x y : G) :
    (x ◇ y) ◇ (x ◇ y) = (((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x))) ◇
      (((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x))) := by
  by_contra nh
  have ef5 (X0 X1 : G) : X0 ◇ X1 = X1 ◇ (X0 ◇ X0) := mod_symm (h ..)
  have ef6 :
      (x ◇ y) ◇ (x ◇ y) ≠ (((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x))) ◇
      (((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x))) := mod_symm nh
  have ef7 (X0 X1 : G) : (X0 ◇ X0) ◇ X1 = X1 ◇ (X0 ◇ (X0 ◇ X0)) := superpose ef5 ef5
  have ef9 :
      (x ◇ y) ◇ (x ◇ y) ≠ ((y ◇ x) ◇ (y ◇ x)) ◇ (((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x))) := by
    first | exact superpose ef5 ef6 | exact superpose ef6 ef5
  have ef10 : (x ◇ y) ◇ (x ◇ y) ≠ ((y ◇ x) ◇ (y ◇ x)) ◇ ((y ◇ x) ◇ (y ◇ x)) := by
    first | exact superpose ef5 ef9 | exact superpose ef9 ef5
  have ef12 (X0 X1 : G) : X1 ◇ (X0 ◇ X0) = (X0 ◇ X0) ◇ X1 := by
    first | exact superpose ef5 ef7 | exact superpose ef7 ef5
  have ef13 : (x ◇ y) ◇ (x ◇ y) ≠ (y ◇ x) ◇ ((y ◇ x) ◇ (y ◇ x)) := by
    first | exact superpose ef5 ef10 | exact superpose ef10 ef5
  have ef15 (X0 X1 : G) : X0 ◇ X1 = (X0 ◇ X0) ◇ X1 := by
    first | exact superpose ef5 ef12 | exact superpose ef12 ef5
  have ef16 : (x ◇ y) ◇ (x ◇ y) ≠ (y ◇ x) ◇ (y ◇ x) := by
    first | exact superpose ef5 ef13 | exact superpose ef13 ef5
  have ef24 (X0 X1 : G) : X1 ◇ (X0 ◇ X0) = X0 ◇ (X1 ◇ X1) := by
    first | exact superpose ef15 ef5 | exact superpose ef5 ef15
  have ef25 (X0 X1 : G) : X1 ◇ (X0 ◇ X0) = X1 ◇ X0 := by
    first | exact superpose ef5 ef24 | exact superpose ef24 ef5
  have ef43 (X0 X1 : G) : X0 ◇ X1 = X1 ◇ X0 := by
    first | exact superpose ef25 ef5 | exact superpose ef5 ef25
  have ef69 : (x ◇ y) ◇ (x ◇ y) ≠ (x ◇ y) ◇ (x ◇ y) := by
    first | exact superpose ef43 ef16 | exact superpose ef16 ef43
  exact absurd rfl ef69

theorem Equation3751_termDefinableFrom_Equation332 : Law3751.TermDefinableFrom Law332 := by
  intro G M hGL
  have h : Equation332 G := Law332.models_iff.mp hGL
  refine ⟨⟨fun x y ↦ (M.op (M.op x y) (M.op x y))⟩, ?_, ?_⟩
  · rw [@Law3751.models_iff]
    exact fun x y ↦ @aux332_3751 G M h x y
  · exact ⟨(tm (tm (Term.var 0) (Term.var 1)) (tm (Term.var 0) (Term.var 1))), rfl⟩

/-- Equation 14 `x = y ◇ (x ◇ y)` is term-definable from equation 695 `x = y ◇ (x ◇ ((z ◇ z) ◇ y))`,
via the term `x □ y := (x ◇ x) ◇ (x ◇ y)`. -/
private theorem aux695_14 [Magma G] (h : Equation695 G) (x y : G) :
    x = (y ◇ y) ◇ (y ◇ ((x ◇ x) ◇ (x ◇ y))) := by
  by_contra nh
  have ef5 (X0 X1 X2 : G) : X1 ◇ (X0 ◇ ((X2 ◇ X2) ◇ X1)) = X0 := mod_symm (h ..)
  have ef6 : x ≠ (y ◇ y) ◇ (y ◇ ((x ◇ x) ◇ (x ◇ y))) := mod_symm nh
  have ef7 (X0 X1 X2 X3 : G) : (X0 ◇ ((X1 ◇ X1) ◇ (X2 ◇ X2))) ◇ (X3 ◇ X0) = X3 := superpose ef5 ef5
  have ef8 (X0 X1 X2 : G) : ((X1 ◇ X1) ◇ X2) ◇ (X0 ◇ X0) = X2 := superpose ef5 ef5
  have ef10 (X0 X1 X2 : G) : X1 ◇ X1 = (X0 ◇ X0) ◇ (X2 ◇ X2) := superpose ef8 ef8
  have ef15 (X0 X1 X2 : G) : (X2 ◇ X2) ◇ X0 = (X1 ◇ X1) ◇ X0 := by
    first | exact superpose ef8 ef5 | exact superpose ef5 ef8
  have ef22 (X0 X1 X3 : G) : (X1 ◇ (X0 ◇ X0)) ◇ (X3 ◇ X1) = X3 := by
    first | exact superpose ef8 ef7 | exact superpose ef7 ef8
  have ef30 (X0 X1 X2 X3 X4 X5 : G) :
      X1 ◇ ((X4 ◇ X4) ◇ (X5 ◇ X5)) = ((X0 ◇ X1) ◇ ((X2 ◇ X2) ◇ (X3 ◇ X3))) ◇ X0 := superpose ef7 ef7
  have ef72 (X0 X1 X2 X3 : G) : (X2 ◇ X2) ◇ (X3 ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1))) = X3 := by
    first | exact superpose ef10 ef5 | exact superpose ef5 ef10
  have ef75 (X0 X1 : G) : X0 ◇ X0 = X1 ◇ X1 := by
    first | exact superpose ef10 ef8 | exact superpose ef8 ef10
  have ef189 (X0 : G) : x ≠ (y ◇ y) ◇ (y ◇ ((X0 ◇ X0) ◇ (x ◇ y))) := by
    first | exact superpose ef75 ef6 | exact superpose ef6 ef75
  have ef307 (X0 X1 : G) : x ≠ (y ◇ y) ◇ (y ◇ (((X0 ◇ X0) ◇ (X1 ◇ X1)) ◇ (x ◇ y))) := by
    first | exact superpose ef15 ef189 | exact superpose ef189 ef15
  have ef416 (X0 X1 X2 X3 : G) : X0 ◇ (X3 ◇ (X0 ◇ ((X1 ◇ X1) ◇ (X2 ◇ X2)))) = X3 := by
    first | exact superpose ef7 ef22 | exact superpose ef22 ef7
  have ef2176 (X0 X1 : G) : x ≠ (y ◇ y) ◇ (y ◇ ((x ◇ y) ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1)))) := by
    first | exact superpose ef30 ef307 | exact superpose ef307 ef30
  have ef2469 (X0 X1 X2 : G) :
      x ≠ (y ◇ y) ◇ (y ◇ (((X0 ◇ (x ◇ y)) ◇ ((X1 ◇ X1) ◇ (X2 ◇ X2))) ◇ X0)) := by
    first | exact superpose ef30 ef2176 | exact superpose ef2176 ef30
  have ef8762 (X0 X1 X2 X3 : G) :
      x ≠ (y ◇ y) ◇ (((y ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1))) ◇ (x ◇ y)) ◇ ((X2 ◇ X2) ◇ (X3 ◇ X3))) := by
    first | exact superpose ef416 ef2469 | exact superpose ef2469 ef416
  have ef8765 (X0 X1 : G) : x ≠ (y ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1))) ◇ (x ◇ y) := by
    first | exact superpose ef72 ef8762 | exact superpose ef8762 ef72
  subsumption ef8765 ef7

theorem Equation14_termDefinableFrom_Equation695 : Law14.TermDefinableFrom Law695 := by
  intro G M hGL
  have h : Equation695 G := Law695.models_iff.mp hGL
  refine ⟨⟨fun x y ↦ (M.op (M.op x x) (M.op x y))⟩, ?_, ?_⟩
  · rw [@Law14.models_iff]
    exact fun x y ↦ @aux695_14 G M h x y
  · exact ⟨(tm (tm (Term.var 0) (Term.var 0)) (tm (Term.var 0) (Term.var 1))), rfl⟩

/-- Equation 692 `x = y ◇ (x ◇ ((z ◇ y) ◇ z))` is term-definable from equation 695
