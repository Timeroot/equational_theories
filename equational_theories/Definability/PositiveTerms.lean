  have ef189 (X0 : G) : x ≠ (y ◇ y) ◇ (y ◇ ((X0 ◇ X0) ◇ (x ◇ y))) := by
    first | exact superpose ef75 ef6 | exact superpose ef6 ef75
  have ef307 (X0 X1 : G) : x ≠ (y ◇ y) ◇ (y ◇ (((X0 ◇ X0) ◇ (X1 ◇ X1)) ◇ (x ◇ y))) := by
    first | exact superpose ef15 ef189 | exact superpose ef189 ef15
  have ef416 (X0 X1 X2 X3 : G) : X0 ◇ (X3 ◇ (X0 ◇ ((X1 ◇ X1) ◇ (X2 ◇ X2)))) = X3 := by
    first | exact superpose ef7 ef22 | exact superpose ef22 ef7
  have ef2176 (X0 X1 : G) : x ≠ (y ◇ y) ◇ (y ◇ ((x ◇ y) ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1)))) := by
    first | exact superpose ef30 ef307 | exact superpose ef307 ef30
  have ef2469 (X0 X1 X2 : G) :
      x ≠ (y ◇ y) ◇ (y ◇ (((X0 ◇ (x ◇ y)) ◇ ((X1 ◇ X1) ◇ (X2 ◇ X2))) ◇ X0)) := by
    first | exact superpose ef30 ef2176 | exact superpose ef2176 ef30
  have ef8762 (X0 X1 X2 X3 : G) :
      x ≠ (y ◇ y) ◇ (((y ◇ ((X0 ◇ X0) ◇ (X1 ◇ X1))) ◇ (x ◇ y)) ◇ ((X2 ◇ X2) ◇ (X3 ◇ X3))) := by
