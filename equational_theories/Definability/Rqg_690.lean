import equational_theories.Definability.DiagRow

/-!
# `Equation690` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation690` is `x = y ◇ (x ◇ ((z ◇ y) ◇ x))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation690`: `x = y ◇ (x ◇ ((z ◇ y) ◇ x))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation690 : DiagRow.RowQG Law690 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law690.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op (M.op u u) z)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op (M.op X2 X1) X0))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op y (M.op X0 (M.op (M.op x x) X0))) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 (M.op (M.op X1 X2) X0)) (M.op X3 (M.op X0 X3))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op X0 (M.op (M.op X1 X2) X0)) X2
       have i₂ := eq4 X0 X2 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq25 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 X0)) (M.op X2 (M.op X0 X2))) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op X0 (M.op X1 X0)) (M.op X1 (M.op (M.op x x) X1))
       have i₂ := eq8 X1 x x X0
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq62 : ∀ X0 : G, y = (M.op (M.op x (M.op X0 x)) (M.op y (M.op x x))) := by
    intro X0
    first
    | (have i₁ := eq25 x X0 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq25
    | exact resolve eq25 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq72 : (M.op y (M.op x x)) = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq7 (M.op x (M.op x x))
       have i₂ := eq25 x x (M.op x x)
       grind)
    | exact superpose eq25 eq7
    | exact resolve eq7 eq25
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq80 : ∀ X0 : G, y = (M.op (M.op x (M.op X0 x)) (M.op x (M.op x x))) := by
    intro X0
    first
    | (have i₁ := eq62 X0
       have i₂ := eq72
       grind)
    | exact superpose eq72 eq62
    | exact resolve eq62 eq72
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq62 eq72
  have eq82 : x = y := by
    first
    | (have i₁ := eq80 x
       have i₂ := eq25 x x x
       grind)
    | exact superpose eq25 eq80
    | exact resolve eq80 eq25
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq25 eq80
  have eq83 : False := by grind
  exact eq83

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation690` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation690 : Law3.StructuralFrom Law690 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation690
