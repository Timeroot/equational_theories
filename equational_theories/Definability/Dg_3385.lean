import equational_theories.Definability.AutBox
import equational_theories.Definability.SBox_01

/-!
# Structurality from `Equation3385` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation3385` is `x ◇ y = z ◇ (x ◇ (y ◇ z))`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation3385`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation332` from `Equation3385`: `x ◇ y = z ◇ (x ◇ (y ◇ z))` ⊢ `x ◇ y = y ◇ (x ◇ x)`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation332_StructuralFromFin_Equation3385 : Law332.StructuralFromFin Law3385 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation3385
    (fun {G} M hM ↦ ?_)
  have hm := (@Law3385.models_iff G M).mp hM
  rw [@Law332.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

