import equational_theories.Definability.DiagRow

/-!
# `Equation528` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation528` is `x = y ◇ (y ◇ (z ◇ (z ◇ x)))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation528`: `x = y ◇ (y ◇ (z ◇ (z ◇ x)))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation528 : DiagRow.RowQG Law528 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law528.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op u (M.op u z))), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X1 (M.op X2 (M.op X2 X0)))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, y = (M.op X0 (M.op X0 (M.op x (M.op x x)))) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : x = y := by
    first
    | (have i₁ := eq7 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq7
    | exact resolve eq7 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq11 : False := by grind
  exact eq11

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation528` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation528 : Law3.StructuralFrom Law528 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation528

/-- `Equation3261` from `Equation528`: `x = y ◇ (y ◇ (z ◇ (z ◇ x)))` ⊢ `x ◇ x = x ◇ (y ◇ (y ◇ x))`,
through the companion `x □ y = if x = y then (x ◇ (x ◇ (x ◇ x))) else x ◇ y`. -/
theorem Equation3261_StructuralFrom_Equation528 : Law3261.StructuralFrom Law528 := by
  classical
  refine DiagRow.structuralFrom_diagOf_row ((Lf 0) ⋆ ((Lf 0) ⋆ ((Lf 0) ⋆ (Lf 0)))) RowQG_Equation528
    (fun {G} M hM ↦ ?_)
  have hm := (@Law528.models_iff G M).mp hM
  rw [@Law3261.models_iff G ((QFOp.diagOf ((Lf 0) ⋆ ((Lf 0) ⋆ ((Lf 0) ⋆ (Lf 0))))).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))
