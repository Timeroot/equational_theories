theorem Equation3253_StructuralFromFin_Equation4432 : Law3253.StructuralFromFin Law4432 := by
  classical
  refine AutBox.structuralFromFin_iteOf3 ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut3_pxy_y_x_y_pxx_pxy_pxx_pxx_y_pxy_Equation4432 (fun {G} M hM ↦ ?_)
  have hm := (@Law4432.models_iff G M).mp hM
  rw [@Law3253.models_iff G ((AutBox.iteOf3 ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf3_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

