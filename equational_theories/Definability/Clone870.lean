/-- `Magma.cert23Data` as bytes, for constant-time indexing. -/
def cert23Bytes : ByteArray := cert23Data.toUTF8

/-- `Magma.cert23Comp` as bytes, for constant-time indexing. -/
def cert23CompBytes : ByteArray := cert23Comp.toUTF8

/-- The `%` keeps the index in range without a proof about the string. -/
private def cert23Digit (p : Nat) : Fin 8 :=
  ⟨(cert23Bytes.get! p).toNat % 8, Nat.mod_lt _ (by omega)⟩

/-- The clone of `Magma.negCert23`, read out of `Magma.cert23Data`. -/
@[implicit_reducible]
def negCert23Clone (i : Fin 1024) : Magma (Fin 8) :=
  ⟨fun x y ↦ cert23Digit (i.val * 64 + x.val * 8 + y.val)⟩

/-- The composition table, read out of `Magma.cert23Comp`. -/
def negCert23Comp (i j : Fin 1024) : Fin 1024 :=
  ⟨(((cert23CompBytes.get! (2 * (i.val * 1024 + j.val))).toNat - 48) * 32 +
      ((cert23CompBytes.get! (2 * (i.val * 1024 + j.val) + 1)).toNat - 48)) % 1024,
    Nat.mod_lt _ (by omega)⟩

/-- The three clone-family facts in one `native_decide`: each call recompiles the module, and the
module carries two megabytes of string, so the calls are what the build time is made of. -/
theorem negCert23_cloneFacts :
    (∀ x y, (negCert23Clone 0).op x y = x) ∧ (∀ x y, (negCert23Clone 1).op x y = y) ∧
      ∀ i j x y, (negCert23Clone (negCert23Comp i j)).op x y =
        negCert23.op ((negCert23Clone i).op x y) ((negCert23Clone j).op x y) := by
  native_decide

theorem negCert23_isCloneFamily :
    negCert23.IsCloneFamily negCert23Clone 0 1 negCert23Comp :=
  ⟨negCert23_cloneFacts.1, negCert23_cloneFacts.2.1, negCert23_cloneFacts.2.2⟩

end Magma

theorem negCert23_satisfies_870 : @Equation870 (Fin 8) Magma.negCert23 := by decide!

/-- No member of the clone satisfies any of the six targets, again in one call. -/
theorem negCert23_refutes :
    ∀ i, ¬ @Equation917 (Fin 8) (Magma.negCert23Clone i) ∧
      ¬ @Equation1086 (Fin 8) (Magma.negCert23Clone i) ∧
      ¬ @Equation1729 (Fin 8) (Magma.negCert23Clone i) ∧
      ¬ @Equation1898 (Fin 8) (Magma.negCert23Clone i) ∧
      ¬ @Equation2541 (Fin 8) (Magma.negCert23Clone i) ∧
      ¬ @Equation2710 (Fin 8) (Magma.negCert23Clone i) := by native_decide

theorem negCert23_refutes_917 :
    ∀ i, ¬ @Equation917 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).1

theorem negCert23_refutes_1086 :
    ∀ i, ¬ @Equation1086 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).2.1

theorem negCert23_refutes_1729 :
    ∀ i, ¬ @Equation1729 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).2.2.1

theorem negCert23_refutes_1898 :
    ∀ i, ¬ @Equation1898 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).2.2.2.1

theorem negCert23_refutes_2541 :
    ∀ i, ¬ @Equation2541 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).2.2.2.2.1

theorem negCert23_refutes_2710 :
    ∀ i, ¬ @Equation2710 (Fin 8) (Magma.negCert23Clone i) := fun i ↦ (negCert23_refutes i).2.2.2.2.2


theorem Equation917_not_termDefinableFrom_Equation870 :
    ¬ Law917.TermDefinableFrom Law870 :=
  not_termDefinableFrom_of_clone Magma.negCert23
    ((@Law870.models_iff (Fin 8) Magma.negCert23).mpr negCert23_satisfies_870)
    Magma.negCert23_isCloneFamily fun i h ↦ negCert23_refutes_917 i
      ((@Law917.models_iff (Fin 8) (Magma.negCert23Clone i)).mp h)

