/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `42`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R400Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R4000 : Array (Array Nat) := #[#[7, 3, 3, 7, 7, 3, 4, 7, 4, 4], #[4, 7, 3, 7, 7, 4, 4, 7, 3, 3], #[4, 4, 7, 7, 7, 3, 3, 7, 3, 4], #[7, 7, 7, 7, 7, 7, 7, 7, 7, 7], #[7, 7, 7, 7, 7, 7, 7, 7, 7, 7], #[4, 3, 4, 7, 7, 7, 3, 7, 4, 3], #[3, 3, 4, 7, 7, 4, 7, 7, 3, 4], #[7, 7, 7, 7, 7, 7, 7, 7, 7, 7], #[3, 4, 4, 7, 7, 3, 4, 7, 7, 3], #[3, 4, 3, 7, 7, 4, 3, 7, 4, 7]]

def opsrch10R4000 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4000[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4000 :
    ∀ x y, Magma.transport S10R400.E S10R400.tr vsrch10R4000.1 x y = opsrch10R4000 x y := by
  native_decide

theorem esrch10R4000 : Magma.srch10R400 vsrch10R4000 = Magma.mk opsrch10R4000 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R4000 x y)

