/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R403 (v : tup9R403) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R403.E S9R403.tr v.1)

end Magma

