/-- `Equation333` from `Equation4517`: `x ◇ (y ◇ z) = (x ◇ z) ◇ w` ⊢ `x ◇ y = y ◇ (x ◇ y)`,
through `x □ y = if (M.op a b) = a then (M.op b b) else if (M.op b a) = (M.op b b) then b else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation333_StructuralFromFin_Equation4517 : Law333.StructuralFromFin Law4517 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pxy_x_pyx_pyy_pyy_y_pyx_Equation4517 (fun {G} M hM ↦ ?_)
  have hm := (@Law4517.models_iff G M).mp hM
  rw [@Law333.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

