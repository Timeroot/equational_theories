def E (i : Fin 1711) (x : Fin 59) : Fin 59 := ⟨(Ud[i.1 / 59]! * x.1 + i.1 % 59) % 59, Nat.mod_lt _ (by decide)⟩

def Einv (i : Fin 1711) (x : Fin 59) : Fin 59 := ⟨Uid[i.1 / 59]! * ((x.1 + 59 - i.1 % 59) % 59) % 59, Nat.mod_lt _ (by decide)⟩

/-- One ordered pair per orbit (3 of them), and for each pair the orbit it lies in
together with a permutation carrying that orbit's representative to it. -/
