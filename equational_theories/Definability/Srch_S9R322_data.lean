/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `72`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R322Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R3220 : Array (Array Nat) := #[#[0, 3, 6, 4, 7, 1, 8, 2, 5], #[7, 1, 4, 2, 5, 8, 3, 6, 0], #[5, 8, 2, 6, 0, 3, 1, 4, 7], #[2, 5, 8, 3, 6, 0, 7, 1, 4], #[6, 0, 3, 1, 4, 7, 5, 8, 2], #[4, 7, 1, 8, 2, 5, 0, 3, 6], #[1, 4, 7, 5, 8, 2, 6, 0, 3], #[8, 2, 5, 0, 3, 6, 4, 7, 1], #[3, 6, 0, 7, 1, 4, 2, 5, 8]]

def opsrch9R3220 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R3220[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R3220 :
    ∀ x y, Magma.transport S9R322.E S9R322.tr vsrch9R3220.1 x y = opsrch9R3220 x y := by
  native_decide

theorem esrch9R3220 : Magma.srch9R322 vsrch9R3220 = Magma.mk opsrch9R3220 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R3220 x y)

