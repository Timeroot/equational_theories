import equational_theories.Definability.DiagRow

/-!
# `Equation928` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation928` is `x = y ◇ ((y ◇ z) ◇ (x ◇ z))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation928`: `x = y ◇ ((y ◇ z) ◇ (x ◇ z))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation928 : DiagRow.RowQG Law928 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law928.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u u) (M.op z u)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X1 X2) (M.op X0 X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op x (M.op (M.op x x) (M.op X0 y))) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op X0 (M.op X3 (M.op (M.op X1 X2) (M.op X0 X2))))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 X1 (M.op (M.op X1 X2) (M.op X0 X2))
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq58 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq8 X0 X1 x X1
       have i₂ := eq4 X0 X1 x
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq98 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq7 y
       have i₂ := eq58 y (M.op x x)
       grind)
    | exact superpose eq58 eq7
    | exact resolve eq7 eq58
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq100 : x = y := by
    first
    | (have i₁ := eq98
       have i₂ := eq58 x x
       grind)
    | exact superpose eq58 eq98
    | exact resolve eq98 eq58
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq58 eq98
  have eq105 : False := by grind
  exact eq105

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation928` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation928 : Law3.StructuralFrom Law928 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation928
