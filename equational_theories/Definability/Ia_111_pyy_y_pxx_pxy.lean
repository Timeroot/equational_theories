import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_04

/-!
# Structurality from `Equation111` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation111` is `x = x ◇ ((y ◇ z) ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then m(X,X) else m(X,Y)`
is an automorphism -- is `GuardAut_pyy_y_pxx_pxy_Equation111`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3458` from `Equation111`: `x = x ◇ ((y ◇ z) ◇ y)` ⊢ `x ◇ x = x ◇ ((x ◇ y) ◇ x)`,
through `x □ y = if m(Y,Y) = Y then m(X,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3458_StructuralFromFin_Equation111 : Law3458.StructuralFromFin Law111 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pyy_y_pxx_pxy_Equation111 (fun {G} M hM ↦ ?_)
  have hm := (@Law111.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op b b) ≠ b ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, (M.op b b) = b ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law3458 := by
    intro N hthen helse
    rw [@Law3458.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b b)) (b)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op b b)) (b)).imp id (fun h ↦ if_neg h)

