import equational_theories.Definability.AutBox
import equational_theories.Definability.VBox_00

/-!
# The diagonal obligation for `Equation1904`, inherited

Generated by `defwork/dfmono.py`.  `Equation1904` is `x = (y ◇ (x ◇ z)) ◇ (x ◇ x)`, which implies
`Equation1687` (`x = (y ◇ x) ◇ ((x ◇ z) ◇ x)`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

theorem DiagFix_Equation1904 : AutBox.DiagFix Law1904 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation1687
  rw [@Law1687.models_iff G M]
  rw [@Law1904.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y z; grind (splits := 60) (ematch := 40))
