/-- The arguments as one mixed-radix index, which is how `rankArr7A` is addressed. -/
def encT7A (a b : Fin 2) (c : Fin 4) (d e : Fin 5) (f : Fin 1) (g : Fin 3) : Nat :=
  a.1 * 600 +
    b.1 * 300 +
    c.1 * 75 +
    d.1 * 15 +
    e.1 * 3 +
    f.1 * 3 +
    g.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank7A (a b : Fin 2) (c : Fin 4) (d e : Fin 5) (f : Fin 1) (g : Fin 3) : Fin 2 :=
  ⟨min (rankArr7A.getD (encT7A a b c d e f g) 0) 1, by omega⟩


/-- `2` of the `675` demanded maps and `2` of the `822868` forbidden ones, enough to separate the
`2` members from the other `1198` invariant tuples between them. The certificate demands all `675`
-- the group has to be among them -- but forbids only these: `mem_rank7A` scans them once per tuple
with a scan quadratic in their length, and nothing else reads the forbidden side. -/
def e0idx7A : Fin 2 → Fin 675
  | 0 => 0
  | 1 => 42
def x0idx7A : Fin 2 → Fin 822868
  | 0 => 0
  | 1 => 547505

def endE07A (j : Fin 2) : Fin 7 → Fin 7 := endE7A (e0idx7A j)

def endX07A (j : Fin 2) : Fin 7 → Fin 7 := endX7A (x0idx7A j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end7A (i : Fin 2) : Magma (Fin 7) := Magma.mk (mem7A i)

theorem end7A_isEndo (i : Fin 2) (j : Fin 675) : (end7A i).IsEndo (endE7A j) := by
  revert i j; native_decide

theorem end7A_not_isEndo (i : Fin 2) (j : Fin 2) : ¬ (end7A i).IsEndo (endX07A j) := by
  revert i j; native_decide

/-- `rank7A` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem7A` for the index would be a comparison per tuple and
member. -/
theorem mem_rank7A (a b : Fin 2) (c : Fin 4) (d e : Fin 5) (f : Fin 1) (g : Fin 3)
    (hx : Magma.isExact (tab7A a b c d e f g) endE07A endX07A = true) :
    mem7A (rank7A a b c d e f g) = tab7A a b c d e f g := by
  revert hx; revert a b c d e f g; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `2` listed
members. -/
theorem mem_of_isExact7A (a b : Fin 2) (c : Fin 4) (d e : Fin 5) (f : Fin 1) (g : Fin 3)
    (hx : Magma.isExact (tab7A a b c d e f g) endE07A endX07A = true) :
    ∃ idx, mem7A idx = tab7A a b c d e f g :=
  ⟨_, mem_rank7A a b c d e f g hx⟩

/-- A magma on `Fin 7` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end7A`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact7A` turns that into a member index. -/
theorem exists_end7A {M : Magma (Fin 7)} (hE : ∀ j, M.IsEndo (endE7A j))
    (hX : ∀ j, ¬ M.IsEndo (endX07A j)) : ∃ i, end7A i = M := by
  have hP : ∀ i, M.IsEndo (permE7A i) := by
    intro i; rw [permE7A_eq_endE7A]; exact hE (uidx7A i)
  have hop : M.op = Magma.transport permE7A tr7A (fun i ↦ M.op (rep7A i).1 (rep7A i).2) :=
    Magma.op_eq_transport (rep := rep7A) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A0) (a := (rep7A 0).1) (b := (rep7A 0).2)
    (val := val7A0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A1) (a := (rep7A 1).1) (b := (rep7A 1).2)
    (val := val7A1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A2) (a := (rep7A 2).1) (b := (rep7A 2).2)
    (val := val7A2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A3) (a := (rep7A 3).1) (b := (rep7A 3).2)
    (val := val7A3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A4) (a := (rep7A 4).1) (b := (rep7A 4).2)
    (val := val7A4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A5) (a := (rep7A 5).1) (b := (rep7A 5).2)
    (val := val7A5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE7A) (idx := stabIdx7A6) (a := (rep7A 6).1) (b := (rep7A 6).2)
    (val := val7A6) hP (by decide) (by decide)
  have hdec : dec7A a b c d e f g = fun i ↦ M.op (rep7A i).1 (rep7A i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
  have key : tab7A a b c d e f g = M.op := by
    rw [tab7A_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab7A a b c d e f g) endE07A endX07A = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx7A j), hX⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact7A a b c d e f g hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 7`.** If `L'` has a model on `Fin 7` whose endomorphism
monoid is exactly the order-`675` monoid of `Magma.endE7A`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end7A {L L' : Law.NatMagmaLaw} {i : Fin 2}
    (hsrc : @satisfies _ (Fin 7) (Magma.end7A i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 7) (Magma.end7A j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end7A i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end7A
    (fun k ↦ (Magma.end7A_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end7A_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
