import equational_theories.Definability.DiagRow

/-!
# `Equation2552` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2552` is `x = (y ◇ ((y ◇ z) ◇ x)) ◇ z`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2552`: `x = (y ◇ ((y ◇ z) ◇ x)) ◇ z`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2552 : DiagRow.ColQG Law2552 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2552.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op u u) z)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op (M.op X1 X2) X0)) X2) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op (M.op y (M.op (M.op x x) X0)) x) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 (M.op (M.op X1 X2) X0)) (M.op X0 X3)) X2) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op X1 (M.op (M.op X1 X2) X0)) X2
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) (M.op (M.op X1 X2) X0)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 X1 (M.op (M.op X1 X2) X0)
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : ∀ X0 X1 : G, (M.op (M.op (M.op y (M.op (M.op x x) X0)) (M.op X0 X1)) x) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 (M.op y (M.op (M.op x x) X0)) x
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq22 : ∀ X0 : G, (M.op (M.op y X0) x) = (M.op (M.op x X0) x) := by
    intro X0
    first
    | (have i₁ := eq7 (M.op (M.op x X0) x)
       have i₂ := eq9 x x X0
       grind)
    | exact superpose eq9 eq7
    | exact resolve eq7 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq41 : ∀ X0 X2 : G, (M.op X0 (M.op X0 X2)) = X2 := by
    intro X0 X2
    first
    | (have i₁ := eq8 X0 x (M.op X0 X2) X2
       have i₂ := eq4 X0 x (M.op X0 X2)
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq42 : ∀ X0 X1 X2 : G, (M.op X0 X2) = (M.op (M.op X1 X2) (M.op X1 X0)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq8 (M.op X1 X0) X1 X2 (M.op (M.op X1 X2) (M.op X1 X0))
       have i₂ := eq9 (M.op (M.op X1 X2) (M.op X1 X0)) X1 X0
       grind)
    | exact superpose eq9 eq8
    | exact resolve eq8 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq62 : ∀ X0 X1 X2 : G, (M.op X1 X0) = (M.op (M.op X1 X2) (M.op X0 X2)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq9 X2 X1 (M.op X1 X0)
       have i₂ := eq41 X1 X0
       grind)
    | exact superpose eq41 eq9
    | exact resolve eq9 eq41
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq67 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) X0) = (M.op (M.op X1 X0) X2) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op (M.op X1 X0) X2) X1 X0
       have i₂ := eq41 (M.op X1 X0) X2
       grind)
    | exact superpose eq41 eq4
    | exact resolve eq4 eq41
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq41
  have eq116 : ∀ X0 : G, (M.op (M.op y x) (M.op (M.op x X0) x)) = X0 := by
    intro X0
    first
    | (have i₁ := eq9 x y X0
       have i₂ := eq22 X0
       grind)
    | exact superpose eq22 eq9
    | exact resolve eq9 eq22
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9 eq22
  have eq132 : ∀ X0 : G, (M.op y (M.op x X0)) = X0 := by
    intro X0
    first
    | (have i₁ := eq116 X0
       have i₂ := eq62 (M.op x X0) y x
       grind)
    | exact superpose eq62 eq116
    | exact resolve eq116 eq62
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq116
  have eq160 : ∀ X0 X1 X2 X3 : G, (M.op X2 (M.op X3 X0)) = (M.op (M.op X0 X1) (M.op (M.op X3 X1) X2)) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq42 X2 (M.op X3 X1) (M.op X3 X0)
       have i₂ := eq42 X0 X3 X1
       grind)
    | exact superpose eq42 eq42
    | exact resolve eq42 eq42
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq42
  have eq256 : x = (M.op (M.op (M.op y (M.op (M.op x x) y)) (M.op x x)) x) := by
    first
    | (have i₁ := eq11 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq11
    | exact resolve eq11 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq306 : x = (M.op (M.op (M.op y (M.op (M.op x x) y)) x) (M.op x x)) := by
    first
    | (have i₁ := eq256
       have i₂ := eq67 x (M.op y (M.op (M.op x x) y)) (M.op x x)
       grind)
    | (have i₁ := eq256
       have i₂ := eq67 (M.op x x) (M.op y (M.op (M.op x x) y)) x
       grind)
    | exact superpose eq67 eq256
    | exact resolve eq256 eq67
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq256
  have eq332 : x = (M.op (M.op y (M.op (M.op x x) y)) x) := by
    first
    | (have i₁ := eq306
       have i₂ := eq62 x (M.op y (M.op (M.op x x) y)) x
       grind)
    | exact superpose eq62 eq306
    | exact resolve eq306 eq62
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq62 eq306
  have eq355 : x = (M.op (M.op y x) (M.op (M.op x x) y)) := by
    first
    | (have i₁ := eq332
       have i₂ := eq67 x y (M.op (M.op x x) y)
       grind)
    | (have i₁ := eq332
       have i₂ := eq67 (M.op (M.op x x) y) y x
       grind)
    | exact superpose eq67 eq332
    | exact resolve eq332 eq67
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq67 eq332
  have eq374 : x = (M.op y (M.op x y)) := by
    first
    | (have i₁ := eq355
       have i₂ := eq160 y x y x
       grind)
    | exact superpose eq160 eq355
    | exact resolve eq355 eq160
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq160 eq355
  have eq386 : y = x := by
    first
    | (have i₁ := eq374
       have i₂ := eq132 y
       grind)
    | exact superpose eq132 eq374
    | exact resolve eq374 eq132
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq132 eq374
  have eq397 : False := by grind
  exact eq397

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2552` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2552 : Law3.StructuralFrom Law2552 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2552
