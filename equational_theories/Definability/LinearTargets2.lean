/-- Which coefficient pairs can satisfy equation `14`, `x = y ◇ (x ◇ y)`.

The coefficient equations eliminate to `(s - 1) * (s + 2) = 0` for the sum `s = α + β`, with
integral cofactors; on the slice `s = 1` the system collapses to `α ^ 2 - α + 1 = 0`. -/
theorem lin_not_14 (α β : R)
    (h₁ : 1 = α * β)
    (h₂ : 0 = α + β ^ 2) :
    α + β + 2 = 0 ∨ α ^ 2 - α + 1 = 0 := by
  have key : (α + β + 2) * ((α + β - 1)) = 0 := by
    linear_combination (β - 2) * h₁ + (-α - 1) * h₂
  rcases mul_eq_zero.mp key with h | h
  · exact Or.inl h
  · refine Or.inr ?_
    linear_combination (β) * h₁ + (-α) * h₂ + (-1) * h

/-- No operation in `Magma.linFam c` satisfies equation `14`. The hypotheses rule out the
coefficient sums with `α + β + 2 = 0`, and `hP` the slice `s = 1`. -/
theorem linFam_not_14 (c α γ : R)
    (hc3 : ∀ x : R, (3 : R) + c * x ≠ 0)
    (hP : ∀ x : R, x ^ 2 - x + 1 ≠ 0) :
    ¬ @Equation14 R (linFam c α γ) := by
  intro he
  have h₁ := he 1 0
  have h₂ := he 0 1
  simp only [linFam_op] at h₁ h₂
  rcases lin_not_14 α (1 + c * γ - α)
      (by linear_combination h₁) (by linear_combination h₂) with h | h
  · exact hc3 (γ) (by linear_combination h)
  · exact hP α h

