    · exact Or.inr (Or.inl h)
    · refine Or.inr (Or.inr ?_)
      linear_combination (-2) * h₁ + (-1) * h₂ + (β - 1) * h

/-- No operation in `Magma.linFam c` satisfies equation `4408`. The hypotheses rule out the
coefficient sums with `α + β = 0`, `α + β = 0`, and `hP` the slice `s = 1`. -/
theorem linFam_not_4408 (c α γ : R)
    (hc1 : ∀ x : R, (1 : R) + c * x ≠ 0)
    (hP : ∀ x : R, x ^ 2 - 3 * x + 1 ≠ 0) :
    ¬ @Equation4408 R (linFam c α γ) := by
  intro he
  have h₁ := he 1 0
  have h₂ := he 0 1
  simp only [linFam_op] at h₁ h₂
  rcases lin_not_4408 α (1 + c * γ - α)
      (by linear_combination h₁) (by linear_combination h₂) with h | h | h
  · exact hc1 (γ) (by linear_combination h)
  · exact hc1 (γ) (by linear_combination h)
  · exact hP α h

/-- Which coefficient pairs can satisfy equation `4443`, `x ◇ (y ◇ x) = (y ◇ x) ◇ y`.

The coefficient equations eliminate to `(s - 1) * (s) = 0` for the sum `s = α + β`, with
integral cofactors; on the slice `s = 1` the system collapses to `2 * α ^ 2 - 2 * α + 1 = 0`. -/
theorem lin_not_4443 (α β : R)
    (h₁ : α + β ^ 2 = α * β)
    (h₂ : α * β = α ^ 2 + β) :
    α + β = 0 ∨ 2 * α ^ 2 - 2 * α + 1 = 0 := by
  have key : (α + β) * ((α + β - 1)) = 0 := by
    linear_combination (2 * α - 1) * h₁ + (1 - 2 * β) * h₂
  rcases mul_eq_zero.mp key with h | h
  · exact Or.inl h
  · refine Or.inr ?_
    linear_combination (α - 1) * h₁ + (-β - 1) * h₂ + (-1) * h

/-- No operation in `Magma.linFam c` satisfies equation `4443`. The hypotheses rule out the
coefficient sums with `α + β = 0`, and `hP` the slice `s = 1`. -/
theorem linFam_not_4443 (c α γ : R)
    (hc1 : ∀ x : R, (1 : R) + c * x ≠ 0)
    (hP : ∀ x : R, 2 * x ^ 2 - 2 * x + 1 ≠ 0) :
    ¬ @Equation4443 R (linFam c α γ) := by
  intro he
  have h₁ := he 1 0
  have h₂ := he 0 1
  simp only [linFam_op] at h₁ h₂
  rcases lin_not_4443 α (1 + c * γ - α)
      (by linear_combination h₁) (by linear_combination h₂) with h | h
  · exact hc1 (γ) (by linear_combination h)
  · exact hP α h

/-- Which coefficient pairs can satisfy equation `4541`, `x ◇ (y ◇ z) = (z ◇ x) ◇ y`.

The coefficient equations eliminate to `(s - 2) * (s) = 0` for the sum `s = α + β`, with
integral cofactors. -/
theorem lin_not_4541 (α β : R)
    (h₁ : α = α * β)
    (h₂ : α * β = β) :
    α + β - 2 = 0 ∨ α + β = 0 := by
  have key : (α + β - 2) * ((α + β)) = 0 := by
    linear_combination (α - β - 2) * h₁ + (α - β + 2) * h₂
  rcases mul_eq_zero.mp key with h | h
  · exact Or.inl h
  · exact Or.inr h

/-- No operation in `Magma.linFam c` satisfies equation `4541`. The hypotheses rule out the
coefficient sums with `α + β - 2 = 0`, `α + β = 0`. -/
theorem linFam_not_4541 (c α γ : R)
    (hc1 : ∀ x : R, (1 : R) + c * x ≠ 0) :
    ¬ @Equation4541 R (linFam c α γ) := by
  intro he
  have h₁ := he 1 0 0
  have h₂ := he 0 1 0
  simp only [linFam_op] at h₁ h₂
  rcases lin_not_4541 α (1 + c * γ - α)
      (by linear_combination h₁) (by linear_combination h₂) with h | h
  · exact hc1 (-γ) (by linear_combination -h)
  · exact hc1 (γ) (by linear_combination h)

end Magma
