namespace Magma

/-- A member of the class, as the `14` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup7R305 : Type := {w : Fin 14 → Fin 7 // Magma.tupOK S7R305.E S7R305.tr S7R305.z S7R305.st S7R305.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch7R305 (v : tup7R305) : Magma (Fin 7) :=
  Magma.mk (Magma.transport S7R305.E S7R305.tr v.1)

end Magma

