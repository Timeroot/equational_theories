    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq18 : ∀ X0 X1 : G, (N.op X1 X0) = (N.op (N.op X1 X0) X0) := by
    intro X0 X1
    first
    | (have i₁ := eq16 X0 (N.op X1 X0)
       have i₂ := eq16 X1 X0
       grind)
    | exact superpose eq16 eq16
    | exact resolve eq16 eq16
    | grind
    | grind (splits := 40)
  clear eq16
  have eq115 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X0 X1
       have i₂ := eq18 X1 X0
       grind)
    | exact superpose eq18 eq7
    | exact resolve eq7 eq18
    | grind
    | grind (splits := 40)
  clear eq18
  have eq122 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq115 X0 X1
       have i₂ := eq12 X1 X0
       grind)
    | exact superpose eq12 eq115
    | exact resolve eq115 eq12
    | grind
    | grind (splits := 40)
  clear eq12 eq115
  have eq179 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq122 a b
       grind)
    | exact superpose eq122 eq8
    | exact resolve eq8 eq122
    | grind
    | grind (splits := 40)
  clear eq122
  have eq180 : False := by grind
  exact eq180

