  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ Lf 1) ⋆ Lf 1) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law106.models_iff G M).mp hM
  have hn := (@Law106.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 X0) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X1 X0) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X1) = (N.op (N.op X0 X1) X1) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X1)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X1 X0 (M.op (M.op x (M.op X0 X1)) x)
       have i₂ := eq5 (M.op X0 X1) x x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq12 : ∀ X0 X1 : G, (M.op X1 X0) = (M.op (M.op X1 X0) X0) := by
    intro X0 X1
    first
    | (have i₁ := eq10 X0 (M.op X1 X0)
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq10
    | exact resolve eq10 eq10
    | grind
    | grind (splits := 40)
  clear eq10
  have eq16 : ∀ X0 X1 : G, (N.op X1 (N.op X0 X1)) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X1 X0 (N.op (N.op x (N.op X0 X1)) x)
       have i₂ := eq6 (N.op X0 X1) x x
