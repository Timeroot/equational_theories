import equational_theories.Definability.DiagRow

/-!
# `Equation1150` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1150` is `x = y ◇ ((z ◇ (x ◇ y)) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1150`: `x = y ◇ ((z ◇ (x ◇ y)) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1150 : DiagRow.RowQG Law1150 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1150.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op z u)) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X2 (M.op X0 X1)) X0)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op y (M.op (M.op X0 (M.op x x)) x)) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 (M.op X0 X2)) X0) (M.op (M.op X3 X0) X2)) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 (M.op (M.op X1 (M.op X0 X2)) X0) X3
       have i₂ := eq4 X0 X2 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq25 : ∀ X0 X2 X3 : G, (M.op X3 X2) = (M.op X0 (M.op X0 (M.op X3 X2))) := by
    intro X0 X2 X3
    first
    | (have i₁ := eq4 (M.op X3 X2) X0 (M.op (M.op x (M.op X2 X0)) X2)
       have i₂ := eq8 X2 x X0 X3
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq46 : ∀ X0 X4 : G, (M.op X4 (M.op X4 X0)) = X0 := by
    intro X0 X4
    first
    | (have i₁ := eq25 X0 (M.op (M.op x X0) x) (M.op (M.op x (M.op X0 x)) X0)
       have i₂ := eq8 X0 x x x
       grind)
    | exact superpose eq8 eq25
    | exact resolve eq25 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq48 : ∀ X1 : G, x = (M.op X1 (M.op X1 x)) := by
    intro X1
    first
    | (have i₁ := eq25 x (M.op (M.op x (M.op x x)) x) y
       have i₂ := eq7 x
       grind)
    | exact superpose eq7 eq25
    | exact resolve eq25 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq25
  have eq80 : y = (M.op x (M.op x x)) := by
    first
    | (have i₁ := eq46 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq46
    | exact resolve eq46 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq46
  have eq94 : x = y := by
    first
    | (have i₁ := eq80
       have i₂ := eq48 x
       grind)
    | exact superpose eq48 eq80
    | exact resolve eq80 eq48
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq48 eq80
  have eq95 : False := by grind
  exact eq95

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1150` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1150 : Law3.StructuralFrom Law1150 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1150
