/-!
# Structurality from `Equation323` through the companion `x □ y = (y ◇ (y ◇ x))`

Generated by `defwork/wffit.py`.  `Equation323` is `x ◇ y = x ◇ (x ◇ y)`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation323` on one carrier with the same table of
`(y ◇ (y ◇ x))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation323` on one carrier with the same `(y ◇ (y ◇ x))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 1 ⋆ (Lf 1 ⋆ Lf 0)) Law323 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 1 ⋆ (Lf 1 ⋆ Lf 0)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law323.models_iff G M).mp hM
  have hn := (@Law323.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 X1) = (M.op X0 (M.op X0 X1)) := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 X1) = (N.op X0 (N.op X0 X1)) := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X1 (M.op X1 X0)) = (N.op X1 (N.op X1 X0)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq14 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 X1
       have i₂ := eq7 X1 X0
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq17 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq14 X0 X1
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq14
    | exact resolve eq14 eq5
    | grind
    | grind (splits := 40)
  clear eq14
  have eq26 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq17 a b
       grind)
    | exact superpose eq17 eq8
    | exact resolve eq8 eq17
    | grind
    | grind (splits := 40)
  clear eq17
  have eq31 : False := by grind
  exact eq31

/-- `Equation4131` from `Equation323`: `x ◇ y = x ◇ (x ◇ y)` ⊢ `x ◇ y = ((x ◇ y) ◇ y) ◇ y`,
through the companion `x □ y = (y ◇ (y ◇ x))`. -/
theorem Equation4131_StructuralFromFin_Equation323 : Law4131.StructuralFromFin Law323 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 1 ⋆ (Lf 1 ⋆ Lf 0)) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law323.models_iff G M).mp hM
  rw [@Law4131.models_iff _ ((AutBox.wordOf (Lf 1 ⋆ (Lf 1 ⋆ Lf 0))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

