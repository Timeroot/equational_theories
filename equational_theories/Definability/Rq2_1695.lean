import equational_theories.Definability.DiagRow

/-!
# `Equation1695` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1695` is `x = (y ◇ x) ◇ ((y ◇ y) ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1695`: `x = (y ◇ x) ◇ ((y ◇ y) ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1695 : DiagRow.ColQG Law1695 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1695.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op u (M.op u u)) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op (M.op X1 X1) X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op (M.op (M.op u (M.op u u)) z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 : G, (M.op (M.op X1 X1) X1) = (M.op X0 (M.op (M.op (M.op X1 X0) (M.op X1 X0)) (M.op X1 X0))) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op X1 X1) X1) (M.op X1 X0)
         have i₂ := eq3 X0 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq8 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X1) (M.op X0 X1)) (M.op X0 X1)) = (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1)) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op (M.op X0 X1) (M.op X0 X1)) (M.op X0 X1)) X1
         have i₂ := eq5 X1 X0
         grind)
      | exact superpose eq5 eq3
      | exact resolve eq3 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq16 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X0 X1) X2) (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X0 X1)
         have i₂ := eq8 X0 X1
         grind)
      | exact superpose eq8 eq3
      | exact resolve eq3 eq8
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq8
    have eq61 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 (M.op X0 X0)) X1) X0) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq16 X0 (M.op X0 X0) X1
         have i₂ := eq3 X0 (M.op X0 X0)
         grind)
      | exact superpose eq3 eq16
      | exact resolve eq16 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq16
    have eq154 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq61 u z
         grind)
      | exact superpose eq61 eq4
      | (have r₁ := eq4
         have r₂ := eq61 u z
         grind)
      | exact resolve eq4 eq61
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq61
    have eq161 : False := by grind
    exact eq161
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X1 X0) (M.op (M.op X1 X1) X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : x = (M.op (M.op x x) (M.op (M.op y y) y)) := by
    first
    | (have i₁ := eq4 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 : G, (M.op (M.op X1 X1) X1) = (M.op X0 (M.op (M.op (M.op X1 X0) (M.op X1 X0)) (M.op X1 X0))) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op X1 X1) X1) (M.op X1 X0)
       have i₂ := eq4 X0 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : (M.op (M.op y y) y) = (M.op x (M.op (M.op (M.op x x) (M.op x x)) (M.op x x))) := by
    first
    | (have i₁ := eq4 (M.op (M.op y y) y) (M.op x x)
       have i₂ := eq7
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq10 : (M.op (M.op y y) y) = (M.op (M.op x x) x) := by
    first
    | (have i₁ := eq9
       have i₂ := eq8 x x
       grind)
    | exact superpose eq8 eq9
    | exact resolve eq9 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : y = (M.op (M.op (M.op x x) x) (M.op (M.op (M.op y y) (M.op y y)) (M.op y y))) := by
    first
    | (have i₁ := eq4 y (M.op y y)
       have i₂ := eq10
       grind)
    | exact superpose eq10 eq4
    | exact resolve eq4 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq19 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X1) (M.op X0 X1)) (M.op X0 X1)) = (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op (M.op X0 X1) (M.op X0 X1)) (M.op X0 X1)) X1
       have i₂ := eq8 X1 X0
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq42 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X0 X1) X2) (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1))) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op X0 X1)
       have i₂ := eq19 X0 X1
       grind)
    | exact superpose eq19 eq4
    | exact resolve eq4 eq19
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq55 : y = (M.op (M.op (M.op x x) x) (M.op (M.op (M.op y y) y) (M.op (M.op y y) y))) := by
    first
    | (have i₁ := eq13
       have i₂ := eq19 y y
       grind)
    | exact superpose eq19 eq13
    | exact resolve eq13 eq19
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13 eq19
  have eq62 : y = (M.op (M.op (M.op x x) x) (M.op (M.op (M.op x x) x) (M.op (M.op x x) x))) := by
    first
    | (have i₁ := eq55
       have i₂ := eq10
       grind)
    | exact superpose eq10 eq55
    | exact resolve eq55 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10 eq55
  have eq65 : y = x := by
    first
    | (have i₁ := eq62
       have i₂ := eq42 x x x
       grind)
    | exact superpose eq42 eq62
    | exact resolve eq62 eq42
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq42 eq62
  have eq66 : False := by grind
  exact eq66

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1695` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1695 : Law3.StructuralFrom Law1695 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1695
