theorem Equation1028_StructuralFromFin_Equation3740 : Law1028.StructuralFromFin Law3740 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyy_x_pxx_y_pyx_x_pyx_Equation3740 (fun {G} M hM ↦ ?_)
  have hm := (@Law3740.models_iff G M).mp hM
  rw [@Law1028.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

