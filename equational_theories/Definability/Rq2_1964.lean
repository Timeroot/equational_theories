import equational_theories.Definability.DiagRow

/-!
# `Equation1964` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1964` is `x = (y ◇ (z ◇ x)) ◇ (y ◇ z)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1964`: `x = (y ◇ (z ◇ x)) ◇ (y ◇ z)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1964 : DiagRow.ColQG Law1964 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1964.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op u (M.op (M.op u u) z)) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X0)) (M.op X1 X2)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op u (M.op (M.op u u) z)) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X2 X3) = (M.op (M.op X1 X0) (M.op X1 (M.op X2 (M.op X3 X0)))) := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 (M.op X2 X3) X1 (M.op X2 (M.op X3 X0))
         have i₂ := eq3 X0 X2 X3
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq6 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 (M.op X2 X0)) X1)) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X1 (M.op X2 X0)) X1
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq7 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 (M.op X2 X0)) (M.op (M.op X1 X2) X3)) X0) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X1 (M.op X2 X0)) (M.op X1 X2)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq11 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X1 (M.op X2 (M.op X0 X1)))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 X1 (M.op X2 (M.op X0 X1))
         have i₂ := eq6 X1 X2 X0
         grind)
      | exact superpose eq6 eq3
      | exact resolve eq3 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq42 : ∀ X0 X1 : G, (M.op X0 (M.op X0 X1)) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq11 X0 (M.op X1 x) X1
         have i₂ := eq5 x X1 X0 X1
         grind)
      | exact superpose eq5 eq11
      | exact resolve eq11 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq11
    have eq102 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op (M.op X1 X1) X2)) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq7 X0 X1 X1 X2
         have i₂ := eq42 X1 X0
         grind)
      | exact superpose eq42 eq7
      | exact resolve eq7 eq42
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq7
    have eq104 : ∀ X0 X1 X2 : G, (M.op X1 X1) = (M.op (M.op X2 X0) (M.op X2 X0)) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq5 X0 X2 X1 X1
         have i₂ := eq42 X1 X0
         grind)
      | exact superpose eq42 eq5
      | exact resolve eq5 eq42
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq110 : ∀ X0 X1 X2 : G, (M.op X2 X0) = (M.op (M.op X1 X0) (M.op X1 X2)) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 (M.op X2 X0) X1 X2
         have i₂ := eq42 X2 X0
         grind)
      | exact superpose eq42 eq3
      | exact resolve eq3 eq42
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq42
    have eq123 : ∀ X0 X1 : G, (M.op X1 X1) = (M.op X0 X0) := by
      intro X0 X1
      first
      | (have i₁ := eq104 X0 X1 x
         have i₂ := eq110 X0 x X0
         grind)
      | exact superpose eq110 eq104
      | exact resolve eq104 eq110
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq104 eq110
    have eq621 : ∀ X0 : G, z ≠ (M.op (M.op u (M.op (M.op X0 X0) z)) u) := by
      intro X0
      first
      | (have i₁ := eq4
         have i₂ := eq123 X0 u
         grind)
      | (have i₁ := eq4
         have i₂ := eq123 u X0
         grind)
      | exact superpose eq123 eq4
      | exact resolve eq4 eq123
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq123
    have eq622 : False := by grind
    exact eq622
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op u u) z)), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X0)) (M.op X1 X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op (M.op X0 (M.op x x)) (M.op X0 y)) := by
    intro X0
    first
    | (have i₁ := eq4 x X0 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 (M.op X2 X0)) X1)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X2 (M.op X1 (M.op X2 X0)) X1
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 : G, y = (M.op x (M.op (M.op X0 (M.op x x)) X0)) := by
    intro X0
    first
    | (have i₁ := eq4 y (M.op X0 (M.op x x)) X0
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq17 : y = x := by
    first
    | (have i₁ := eq13 x
       have i₂ := eq9 x x x
       grind)
    | exact superpose eq9 eq13
    | exact resolve eq13 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9 eq13
  have eq18 : False := by grind
  exact eq18

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1964` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1964 : Law3.StructuralFrom Law1964 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1964
