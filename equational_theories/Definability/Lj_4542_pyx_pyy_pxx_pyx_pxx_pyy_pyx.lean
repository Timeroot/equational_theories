    exact (eq_or_ne ((M.op b a)) ((M.op b b))).imp id (fun h ↦
      (eq_or_ne ((M.op a a)) ((M.op b a))).symm.imp id (fun h' ↦ (if_neg h).trans (if_pos h')))
  · rw [AutBox.iteOf2_apply ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0)) M a b]
