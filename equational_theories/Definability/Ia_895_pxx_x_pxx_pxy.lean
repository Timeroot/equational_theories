/-!
# Structurality from `Equation895` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation895` is `x = y ◇ ((x ◇ z) ◇ (y ◇ z))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = X then m(X,X) else m(X,Y)`
is an automorphism -- is `GuardAut_pxx_x_pxx_pxy_Equation895`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 10 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation100` from `Equation895`: `x = y ◇ ((x ◇ z) ◇ (y ◇ z))` ⊢ `x = x ◇ ((x ◇ x) ◇ y)`,
through `x □ y = if m(X,X) = X then m(X,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation100_StructuralFromFin_Equation895 : Law100.StructuralFromFin Law895 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_pxx_pxy_Equation895 (fun {G} M hM ↦ ?_)
  have hm := (@Law895.models_iff G M).mp hM
  rw [@Law100.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

