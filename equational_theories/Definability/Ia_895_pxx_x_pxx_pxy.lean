/-- `Equation843` from `Equation895`: `x = y ◇ ((x ◇ z) ◇ (y ◇ z))` ⊢ `x = x ◇ ((y ◇ y) ◇ (x ◇ y))`,
through `x □ y = if m(X,X) = X then m(X,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation843_StructuralFromFin_Equation895 : Law843.StructuralFromFin Law895 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_pxx_pxy_Equation895 (fun {G} M hM ↦ ?_)
  have hm := (@Law895.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op a a) ≠ a ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, (M.op a a) = a ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law843 := by
    intro N hthen helse
    rw [@Law843.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).imp id (fun h ↦ if_neg h)

