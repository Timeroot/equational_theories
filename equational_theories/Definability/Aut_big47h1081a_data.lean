/-- The 23 units the group uses, and their inverses: permutation `u * 47 + v` is `x ↦ u x + v`. -/
def Ud : Array Nat := #[1, 2, 3, 4, 6, 7, 8, 9, 12, 14, 16, 17, 18, 21, 24, 25, 27, 28, 32, 34, 36, 37, 42]

def Uid : Array Nat := #[1, 24, 16, 12, 8, 27, 6, 21, 4, 37, 3, 36, 34, 9, 2, 32, 7, 42, 25, 18, 17, 14, 28]

def E (i : Fin 1081) (x : Fin 47) : Fin 47 := ⟨(Ud[i.1 / 47]! * x.1 + i.1 % 47) % 47, Nat.mod_lt _ (by decide)⟩

def Einv (i : Fin 1081) (x : Fin 47) : Fin 47 := ⟨Uid[i.1 / 47]! * ((x.1 + 47 - i.1 % 47) % 47) % 47, Nat.mod_lt _ (by decide)⟩

/-- One ordered pair per orbit (3 of them), and for each pair the orbit it lies in
together with a permutation carrying that orbit's representative to it. -/
