def opsrch10R8030 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R8030[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R8030 :
    ∀ x y, Magma.transport S10R803.E S10R803.tr vsrch10R8030.1 x y = opsrch10R8030 x y := by
  native_decide

theorem esrch10R8030 : Magma.srch10R803 vsrch10R8030 = Magma.mk opsrch10R8030 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R8030 x y)

