import equational_theories.Definability.DiagRow

/-!
# `Equation2494` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2494` is `x = (y ◇ ((x ◇ x) ◇ x)) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2494`: `x = (y ◇ ((x ◇ x) ◇ x)) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2494 : DiagRow.ColQG Law2494 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2494.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op z z) z)), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op X1 (M.op (M.op X0 X0) X0)) X1) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) X0) = (M.op (M.op X1 X0) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op X0 X0) X0) X1
       have i₂ := eq4 X0 (M.op (M.op X0 X0) X0)
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : (M.op (M.op x x) x) = (M.op (M.op x x) y) := by
    first
    | (have i₁ := eq7 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq7
    | exact resolve eq7 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq16 : ∀ X0 X1 X2 : G, (M.op (M.op X2 (M.op (M.op X0 X1) X0)) X2) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 X2
       have i₂ := eq7 X1 X0
       grind)
    | (have i₁ := eq4 X0 X1
       have i₂ := eq7 X0 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq79 : ∀ X0 : G, y = (M.op (M.op X0 (M.op (M.op (M.op x x) x) (M.op x x))) X0) := by
    intro X0
    first
    | (have i₁ := eq16 (M.op x x) y X0
       have i₂ := eq11
       grind)
    | exact superpose eq11 eq16
    | exact resolve eq16 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq108 : y = x := by
    first
    | (have i₁ := eq79 x
       have i₂ := eq16 (M.op x x) x x
       grind)
    | exact superpose eq16 eq79
    | exact resolve eq79 eq16
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq16 eq79
  have eq110 : False := by grind
  exact eq110

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2494` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2494 : Law3.StructuralFrom Law2494 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2494
