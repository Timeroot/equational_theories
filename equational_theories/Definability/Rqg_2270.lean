import equational_theories.Definability.DiagRow

/-!
# `Equation2270` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2270` is `x = (x ◇ (y ◇ (y ◇ z))) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2270`: `x = (x ◇ (y ◇ (y ◇ z))) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2270 : DiagRow.ColQG Law2270 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2270.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op u (M.op u u))), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 (M.op X1 X2))) X1) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op X0 X1) = (M.op X0 (M.op (M.op X1 (M.op X1 X2)) (M.op (M.op X1 (M.op X1 X2)) X3))) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op X0 (M.op (M.op X1 (M.op X1 X2)) (M.op (M.op X1 (M.op X1 X2)) X3))) X1 X2
       have i₂ := eq4 X0 (M.op X1 (M.op X1 X2)) X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq23 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X1) (M.op X1 (M.op X1 X2))) = X0 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X0 (M.op X1 (M.op X1 X2)) x
       have i₂ := eq9 X0 X1 X2 x
       grind)
    | exact superpose eq9 eq4
    | exact resolve eq4 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq49 : ∀ X0 : G, y = (M.op (M.op x x) (M.op x (M.op x X0))) := by
    intro X0
    first
    | (have i₁ := eq23 y x X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq23
    | exact resolve eq23 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq73 : y = x := by
    first
    | (have i₁ := eq49 x
       have i₂ := eq23 x x x
       grind)
    | exact superpose eq23 eq49
    | exact resolve eq49 eq23
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq23 eq49
  have eq74 : False := by grind
  exact eq74

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2270` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2270 : Law3.StructuralFrom Law2270 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2270
