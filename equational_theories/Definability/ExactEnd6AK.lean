/-- The arguments as one mixed-radix index, which is how `rankArr6AK` is addressed. -/
def encT6AK (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2) : Nat :=
  a.1 * 5184 +
    b.1 * 1728 +
    c.1 * 576 +
    d.1 * 144 +
    e.1 * 48 +
    f.1 * 24 +
    g.1 * 12 +
    h.1 * 4 +
    i.1 * 2 +
    j.1

/-- The member index of the tuple the arguments name. The `min` is what makes the bound free; on a
tuple the table really names it changes nothing. -/
def rank6AK (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    : Fin 1 :=
  ⟨min (rankArr6AK.getD (encT6AK a b c d e f g h i j) 0) 0, by omega⟩


/-- `2` of the `63` demanded maps and `3` of the `46593` forbidden ones, enough to separate the `1`
members from the other `15551` invariant tuples between them. The certificate still demands and
forbids all `46656`; these are the lists `mem_rank6AK` scans, once per tuple, with a scan that is
quadratic in their length. -/
def e0idx6AK : Fin 2 → Fin 63
  | 0 => 1
  | 1 => 2
def x0idx6AK : Fin 3 → Fin 46593
  | 0 => 75
  | 1 => 1552
  | 2 => 9280

def endE06AK (j : Fin 2) : Fin 6 → Fin 6 := endE6AK (e0idx6AK j)

def endX06AK (j : Fin 3) : Fin 6 → Fin 6 := endX6AK (x0idx6AK j)

/-- The same as a family of magmas, which is what `FamilyRefutes` scans. -/
@[implicit_reducible]
def end6AK (i : Fin 1) : Magma (Fin 6) := Magma.mk (mem6AK i)

theorem end6AK_isEndo (i : Fin 1) (j : Fin 63) : (end6AK i).IsEndo (endE6AK j) := by
  revert i j; native_decide

theorem end6AK_not_isEndo (i : Fin 1) (j : Fin 46593) : ¬ (end6AK i).IsEndo (endX6AK j) := by
  revert i j; native_decide

/-- `rank6AK` really does name the member a tuple is. Deciding this is one array read and one table
comparison per tuple, where searching `mem6AK` for the index would be a comparison per tuple and
member. -/
theorem mem_rank6AK (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3) (i j : Fin 2)
    (hx : Magma.isExact (tab6AK a b c d e f g h i j) endE06AK endX06AK = true) :
    mem6AK (rank6AK a b c d e f g h i j) = tab6AK a b c d e f g h i j := by
  revert hx; revert a b c d e f g h i j; native_decide

/-- Every invariant tuple whose endomorphism monoid really is this one names one of the `1` listed
members. -/
theorem mem_of_isExact6AK (a b c : Fin 3) (d : Fin 4) (e : Fin 3) (f g : Fin 2) (h : Fin 3)
    (i j : Fin 2)
    (hx : Magma.isExact (tab6AK a b c d e f g h i j) endE06AK endX06AK = true) :
    ∃ idx, mem6AK idx = tab6AK a b c d e f g h i j :=
  ⟨_, mem_rank6AK a b c d e f g h i j hx⟩

/-- A magma on `Fin 6` admitting every demanded map and none of the forbidden ones *is* a member of
`Magma.end6AK`. The demanded maps include the group, so its values at the orbit representatives name
an invariant tuple, and `mem_of_isExact6AK` turns that into a member index. -/
theorem exists_end6AK {M : Magma (Fin 6)} (hE : ∀ j, M.IsEndo (endE6AK j))
    (hX : ∀ j, ¬ M.IsEndo (endX6AK j)) : ∃ i, end6AK i = M := by
  have hP : ∀ i, M.IsEndo (permE6AK i) := by
    intro i; rw [permE6AK_eq_endE6AK]; exact hE (uidx6AK i)
  have hop : M.op = Magma.transport permE6AK tr6AK (fun i ↦ M.op (rep6AK i).1 (rep6AK i).2) :=
    Magma.op_eq_transport (rep := rep6AK) hP (by decide)
  obtain ⟨a, ha⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK0) (a := (rep6AK 0).1) (b := (rep6AK 0).2)
    (val := val6AK0) hP (by decide) (by decide)
  obtain ⟨b, hb⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK1) (a := (rep6AK 1).1) (b := (rep6AK 1).2)
    (val := val6AK1) hP (by decide) (by decide)
  obtain ⟨c, hc⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK2) (a := (rep6AK 2).1) (b := (rep6AK 2).2)
    (val := val6AK2) hP (by decide) (by decide)
  obtain ⟨d, hd⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK3) (a := (rep6AK 3).1) (b := (rep6AK 3).2)
    (val := val6AK3) hP (by decide) (by decide)
  obtain ⟨e, he⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK4) (a := (rep6AK 4).1) (b := (rep6AK 4).2)
    (val := val6AK4) hP (by decide) (by decide)
  obtain ⟨f, hf⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK5) (a := (rep6AK 5).1) (b := (rep6AK 5).2)
    (val := val6AK5) hP (by decide) (by decide)
  obtain ⟨g, hg⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK6) (a := (rep6AK 6).1) (b := (rep6AK 6).2)
    (val := val6AK6) hP (by decide) (by decide)
  obtain ⟨h, hh⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK7) (a := (rep6AK 7).1) (b := (rep6AK 7).2)
    (val := val6AK7) hP (by decide) (by decide)
  obtain ⟨i, hi⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK8) (a := (rep6AK 8).1) (b := (rep6AK 8).2)
    (val := val6AK8) hP (by decide) (by decide)
  obtain ⟨j, hj⟩ := Magma.exists_val_of_isEndo
    (E := permE6AK) (idx := stabIdx6AK9) (a := (rep6AK 9).1) (b := (rep6AK 9).2)
    (val := val6AK9) hP (by decide) (by decide)
  have hdec : dec6AK a b c d e f g h i j = fun i ↦ M.op (rep6AK i).1 (rep6AK i).2 := by
    funext i; fin_cases i
    · exact ha
    · exact hb
    · exact hc
    · exact hd
    · exact he
    · exact hf
    · exact hg
    · exact hh
    · exact hi
    · exact hj
  have key : tab6AK a b c d e f g h i j = M.op := by
    rw [tab6AK_eq_transport, hdec, ← hop]
  have hok : Magma.isExact (tab6AK a b c d e f g h i j) endE06AK endX06AK = true := by
    rw [key, Magma.isExact_iff]; exact ⟨fun j ↦ hE (e0idx6AK j), fun j ↦ hX (x0idx6AK j)⟩
  obtain ⟨idx, hidx⟩ := mem_of_isExact6AK a b c d e f g h i j hok
  exact ⟨idx, (congrArg Magma.mk (hidx.trans key)).trans (Magma.mk_op M)⟩

end Magma

namespace Law.MagmaLaw

/-- **Exact-`End` certificate on `Fin 6`.** If `L'` has a model on `Fin 6` whose endomorphism
monoid is exactly the order-`63` monoid of `Magma.endE6AK`, and no such magma satisfies `L`, then
`L` is not term-structural from `L'`, not even over finite carriers. -/
theorem not_termStructuralFromFin_of_end6AK {L L' : Law.NatMagmaLaw} {i : Fin 1}
    (hsrc : @satisfies _ (Fin 6) (Magma.end6AK i) L')
    (htgt : ∀ j, ¬ @satisfies _ (Fin 6) (Magma.end6AK j) L) :
    ¬ L.TermStructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.end6AK i) hsrc
  obtain ⟨j, hM⟩ := Magma.exists_end6AK
    (fun k ↦ (Magma.end6AK_isEndo i k).of_termDefinable hfwd)
    (fun k hn ↦ Magma.end6AK_not_isEndo i k (hn.of_termDefinable hback))
  exact htgt j (by rw [hM]; exact hM')

end Law.MagmaLaw
