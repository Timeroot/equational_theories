/-!
# Structurality from `Equation311` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation311` is `x ◇ x = x ◇ (y ◇ z)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a b) = (M.op b b) then (M.op a a) else if (M.op a a) = (M.op a b) then (M.op b b) else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pxy_pyy_pxx_pxy_pxx_pyy_pxy_Equation311`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation4272` from `Equation311`: `x ◇ x = x ◇ (y ◇ z)` ⊢ `x ◇ (x ◇ x) = y ◇ (x ◇ x)`,
through `x □ y = if (M.op a b) = (M.op b b) then (M.op a a) else if (M.op a a) = (M.op a b) then (M.op b b) else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation4272_StructuralFromFin_Equation311 : Law4272.StructuralFromFin Law311 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxy_pyy_pxx_pxy_pxx_pyy_pxy_Equation311 (fun {G} M hM ↦ ?_)
  have hm := (@Law311.models_iff G M).mp hM
  rw [@Law4272.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

