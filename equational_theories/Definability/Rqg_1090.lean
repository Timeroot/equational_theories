import equational_theories.Definability.DiagRow

/-!
# `Equation1090` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1090` is `x = y ◇ ((x ◇ (y ◇ z)) ◇ z)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1090`: `x = y ◇ ((x ◇ (y ◇ z)) ◇ z)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation1090 : DiagRow.RowQG Law1090 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1090.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op z (M.op u u)) u), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X0 (M.op X1 X2)) X2)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op x (M.op (M.op X0 (M.op x x)) y)) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X1 (M.op (M.op X2 X0) (M.op (M.op X0 (M.op X1 X3)) X3))) = X2 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X2 X1 (M.op (M.op X0 (M.op X1 X3)) X3)
       have i₂ := eq4 X0 X1 X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 X2)) (M.op X0 X2)) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 (M.op X0 (M.op X1 X2)) X2
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : ∀ X0 X1 : G, (M.op x (M.op (M.op X1 X0) (M.op (M.op X0 (M.op x x)) y))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq4 X1 x (M.op (M.op X0 (M.op x x)) y)
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq42 : ∀ X0 X1 : G, (M.op (M.op X1 X0) X0) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq8 X0 (M.op X1 X0) X1 x
       have i₂ := eq4 X0 (M.op X1 X0) x
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq63 : ∀ X0 X1 X2 : G, (M.op X0 X2) = (M.op (M.op X1 X0) (M.op X1 X2)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq9 X1 (M.op X0 X2) X2
       have i₂ := eq42 X2 X0
       grind)
    | exact superpose eq42 eq9
    | exact resolve eq9 eq42
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq67 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X1 X2)) = (M.op X1 (M.op X0 X2)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op X1 (M.op X0 X2)) X0 X2
       have i₂ := eq42 (M.op X0 X2) X1
       grind)
    | exact superpose eq42 eq4
    | exact resolve eq4 eq42
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq42
  have eq71 : ∀ X0 X1 X2 : G, (M.op X0 X2) = (M.op X1 (M.op (M.op X1 X0) X2)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq63 X0 X1 X2
       have i₂ := eq67 (M.op X1 X0) X1 X2
       grind)
    | (have i₁ := eq63 X0 X1 X2
       have i₂ := eq67 X1 (M.op X1 X0) X2
       grind)
    | exact superpose eq67 eq63
    | exact resolve eq63 eq67
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq63 eq67
  have eq203 : x = (M.op x (M.op (M.op x x) (M.op (M.op y (M.op x x)) y))) := by
    first
    | (have i₁ := eq11 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq11
    | exact resolve eq11 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq255 : x = (M.op x (M.op (M.op y (M.op x x)) y)) := by
    first
    | (have i₁ := eq203
       have i₂ := eq71 x x (M.op (M.op y (M.op x x)) y)
       grind)
    | exact superpose eq71 eq203
    | exact resolve eq203 eq71
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq71 eq203
  have eq271 : x = y := by
    first
    | (have i₁ := eq255
       have i₂ := eq7 y
       grind)
    | exact superpose eq7 eq255
    | exact resolve eq255 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq255
  have eq281 : False := by grind
  exact eq281

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1090` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1090 : Law3.StructuralFrom Law1090 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1090
