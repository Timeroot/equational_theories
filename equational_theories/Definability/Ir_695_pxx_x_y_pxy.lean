  have eq8 : (N.op x y) ≠ (N.op (N.op x x) (N.op x y)) := by grind
  clear hm ht he nh hM
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 (M.op (M.op X1 X1) (M.op X2 X2))) (M.op X3 X0)) = X3 := by
    intro X0 X1 X2 X3
    first
