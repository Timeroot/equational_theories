Vampire refutation replayed step by step. -/
theorem Equation3712_StructuralFromFin_Equation695 : Law3712.StructuralFromFin Law695 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_y_pxy_Equation695 (fun {G} M hM ↦ ?_)
  have hm := (@Law695.models_iff G M).mp hM
  suffices h : ∀ N : Magma G,
      (∀ a b : G, (M.op a a) ≠ a ∨ N.op a b = b) →
      (∀ a b : G, (M.op a a) = a ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law3712 by
    refine h _ (fun a b ↦ ?_) (fun a b ↦ ?_)
    · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1)) M a b]
      simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
      exact (eq_or_ne ((M.op a a)) (a)).symm.imp id (fun hg ↦ if_pos hg)
    · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 1)) M a b]
      simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
      exact (eq_or_ne ((M.op a a)) (a)).imp id (fun hg ↦ if_neg hg)
  intro N ht he
  rw [@Law3712.models_iff G N]
  intro x y
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X1 (M.op X0 (M.op (M.op X2 X2) X1))) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 : G, (M.op X0 X0) ≠ X0 ∨ (N.op X0 X1) = X1 := by
