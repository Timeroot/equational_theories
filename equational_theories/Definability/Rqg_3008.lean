import equational_theories.Definability.DiagRow

/-!
# `Equation3008` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation3008` is `x = ((y ◇ (z ◇ z)) ◇ x) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3008`: `x = ((y ◇ (z ◇ z)) ◇ x) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation3008 : DiagRow.ColQG Law3008 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law3008.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u (M.op u u)) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 (M.op X2 X2)) X0) X1) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 X3) (M.op (M.op (M.op X1 X1) (M.op X2 X2)) X0)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op (M.op X1 X1) (M.op X2 X2)) X0) X1
       have i₂ := eq4 X0 (M.op X1 X1) X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X0) (M.op X1 (M.op X2 X2))) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 (M.op X1 (M.op X2 X2)) X0
       have i₂ := eq4 (M.op X0 X0) X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : ∀ X0 X1 X2 : G, (M.op X2 X2) = (M.op (M.op X1 X1) (M.op X0 X0)) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq8 X1 (M.op X2 X2) (M.op X0 X0)
       have i₂ := eq8 X2 (M.op X0 X0) X0
       grind)
    | exact superpose eq8 eq8
    | exact resolve eq8 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq38 : ∀ X0 X2 : G, (M.op X2 X2) = (M.op X0 X0) := by
    intro X0 X2
    first
    | (have i₁ := eq8 x (M.op X0 X0) X0
       have i₂ := eq11 (M.op X0 X0) x X2
       grind)
    | (have i₁ := eq8 (M.op X2 X2) (M.op X2 X2) X2
       have i₂ := eq11 X0 x (M.op (M.op X2 X2) (M.op X2 X2))
       grind)
    | exact superpose eq11 eq8
    | exact resolve eq8 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq64 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op (M.op X0 X0) X1)) = X2 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq7 X1 x x X2
       have i₂ := eq11 x x X0
       grind)
    | (have i₁ := eq7 X0 X1 X1 x
       have i₂ := eq11 X0 X1 (M.op X1 X1)
       grind)
    | exact superpose eq11 eq7
    | exact resolve eq7 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7 eq11
  have eq361 : ∀ X0 : G, x = (M.op (M.op x x) (M.op (M.op X0 X0) y)) := by
    intro X0
    first
    | (have i₁ := eq64 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq64
    | exact resolve eq64 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq370 : ∀ X0 X1 X2 : G, (M.op (M.op X0 X0) (M.op (M.op X2 X2) X1)) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq64 X2 X1 X1
       have i₂ := eq38 X0 X1
       grind)
    | (have i₁ := eq64 X2 X1 X1
       have i₂ := eq38 X1 X0
       grind)
    | exact superpose eq38 eq64
    | exact resolve eq64 eq38
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq38 eq64
  have eq439 : y = x := by
    first
    | (have i₁ := eq361 x
       have i₂ := eq370 x y x
       grind)
    | exact superpose eq370 eq361
    | exact resolve eq361 eq370
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq361 eq370
  have eq440 : False := by grind
  exact eq440

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation3008` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation3008 : Law3.StructuralFrom Law3008 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation3008
