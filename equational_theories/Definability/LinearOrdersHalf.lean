import Mathlib.RingTheory.Polynomial.GaussLemma
import equational_theories.Definability.LinearOrdersFF

/-!
# Linear magmas over `ℤ[i][1/2]`

The models left over are half-integral: coefficients like `-(i + 1) / 2` put them outside the ring
of integers `ℤ[i]` and into the localization `ℤ[i][1/2]`. That ring is monogenic, which spares us
any localization API. Writing `v = (1 + i) / 2`, both generators come back --
`i = 2 v - 1` and `1 / 2 = v - v ^ 2` -- so `ℤ[i][1/2] = ℤ[v]`, and `v` is a root of

`2 X ^ 2 - 2 X + 1`.

So these models are integral over `ℤ[v]` and everything in `Definability/LinearOrders.lean`
applies unchanged. The single new ingredient is that this defining polynomial is not monic, so
`Monic.irreducible_iff_roots_eq_zero_of_degree_le_three` does not apply. Gauss's lemma does: the
polynomial is primitive, hence irreducible over `ℤ` exactly when it is over `ℚ`, and over a field
a quadratic is irreducible as soon as it has no root. Gauss's lemma is also what keeps the
cofactors of the `linear_combination`s below integral.

This file is generated by `genordhalf.py`.
-/

open Law Law.MagmaLaw Polynomial

/-- A primitive integer polynomial of degree at most three with no rational root is irreducible.
Unlike `irreducible_int_of_no_root` this does not ask `q` to be monic, which is what the order
`ℤ[(1 + i) / 2]` needs. A coefficient equal to `1` already forces primitivity, and Gauss's lemma
moves the question to `ℚ`. -/
theorem irreducible_int_of_no_rat_root {q : ℤ[X]} {n : ℕ} (hn : q.coeff n = 1) {d : ℕ}
    (hd : q.natDegree = d) (h1 : 1 ≤ d) (h3 : d ≤ 3)
    (h : ∀ x : ℚ, (q.map (Int.castRingHom ℚ)).eval x ≠ 0) : Irreducible q := by
  have hprim : q.IsPrimitive := by
    rintro r ⟨g, rfl⟩
    rw [coeff_C_mul] at hn
    exact IsUnit.of_mul_eq_one (g.coeff n) hn
  refine (Polynomial.IsPrimitive.Int.irreducible_iff_irreducible_map_cast hprim).mpr
    (irreducible_of_degree_le_three_of_not_isRoot ?_ h)
  rw [natDegree_map_eq_of_injective Int.cast_injective q, hd]
  exact Finset.mem_Icc.mpr ⟨h1, h3⟩

noncomputable section

/-! ### `ℤ[v]` with `q v = 0` for `q = 2 * X ^ 2 - 2 * X + 1`: `(1 + i) / 2`, a generator of `ℤ[i][1/2]` -/

namespace HalfGauss

/-- The defining polynomial of the ring. -/
abbrev q : ℤ[X] := 2 * X ^ 2 - 2 * X + 1

/-- `q` is primitive and has no rational root, its discriminant being `-4`. -/
theorem q_irr : Irreducible q :=
  irreducible_int_of_no_rat_root (n := 0) (by simp [q]) (d := 2)
    (by show natDegree (2 * X ^ 2 - 2 * X + 1 : ℤ[X]) = 2; compute_degree!)
    (by norm_num) (by norm_num)
    (by intro x; simp [q]; nlinarith [sq_nonneg (2 * x - 1)])

/-- The ring `ℤ[i][1/2] = ℤ[v]`, a domain because `q` is irreducible. -/
abbrev R : Type := AdjoinRoot q

instance : IsDomain R :=
  AdjoinRoot.isDomain_of_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp q_irr)

/-- The generator `v = (1 + i) / 2`; note `i = 2 v - 1` and `1 / 2 = v - v ^ 2`. -/
abbrev th : R := AdjoinRoot.root q

theorem hq : 2 * th ^ 2 - 2 * th + 1 = 0 := by
  have h := AdjoinRoot.eval₂_root q
  simp only [q, eval₂_sub, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-! The residue maps, each given by a root of `q` modulo `m`. -/

/-- Reduction modulo `5`, sending `v` to `2`. -/
def r5_2 : R →+* ZMod 5 := AdjoinRoot.lift (Int.castRingHom (ZMod 5)) 2
  (by simp only [q, eval₂_sub, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one]
      decide)

@[simp] theorem r5_2_th : r5_2 th = 2 := by simp [r5_2]

/-- Reduction modulo `13`, sending `v` to `3`. -/
def r13_3 : R →+* ZMod 13 := AdjoinRoot.lift (Int.castRingHom (ZMod 13)) 3
  (by simp only [q, eval₂_sub, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one]
      decide)

@[simp] theorem r13_3_th : r13_3 th = 3 := by simp [r13_3]

/-! One coefficient modulus needs a residue *field* instead; `CubicC.F = F_9` is
already built in `Definability/LinearOrdersFF.lean`. -/

/-- Reduction to `F_9`, sending `v` to `φ`. -/
def f9 : R →+* CubicC.F :=
  AdjoinRoot.lift ((AdjoinRoot.of CubicC.g).comp (Int.castRingHom (ZMod 3))) CubicC.ph
    (by
      simp only [q, eval₂_sub, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one]
      linear_combination (2 : CubicC.F) * CubicC.hg + CubicC.hchar)

@[simp] theorem f9_th : f9 th = CubicC.ph := by simp [f9]

/-! #### The model `x ◇ y = (-th) * x + (2 * th - 1) * y`, with coefficient modulus `c = th - 2`. -/

theorem hcA (x : R) : (1 : R) + (th - 2) * x ≠ 0 :=
  Magma.add_mul_ne_zero_of_hom r5_2 1 _
    (by simp [map_ofNat])
    (by simp only [map_one]; decide) x

theorem hP3279A (z : R) : z ^ 3 - 2 * z ^ 2 + z - 1 ≠ 0 := by
  intro h
  have hr := congrArg r13_3 h
  simp only [map_sub, map_add, map_mul, map_pow, map_one, map_ofNat, map_zero] at hr
  revert hr
  generalize r13_3 z = y
  revert y
  decide

theorem hQA (z : R) : z ^ 2 + 3 * z + 1 ≠ 0 := by
  intro h
  have hr := congrArg r13_3 h
  simp only [map_add, map_mul, map_pow, map_one, map_ofNat, map_zero] at hr
  revert hr
  generalize r13_3 z = y
  revert y
  decide

theorem hP3269A (z : R) : z ^ 3 - 3 * z ^ 2 + 2 * z - 1 ≠ 0 := by
  intro h
  have hr := congrArg r13_3 h
  simp only [map_sub, map_add, map_mul, map_pow, map_one, map_ofNat, map_zero] at hr
  revert hr
  generalize r13_3 z = y
  revert y
  decide

theorem hP3475A (z : R) : z ^ 3 - z ^ 2 + 1 ≠ 0 := by
  intro h
  have hr := congrArg r13_3 h
  simp only [map_sub, map_add, map_pow, map_one, map_zero] at hr
  revert hr
  generalize r13_3 z = y
  revert y
  decide

/-- Equation `467`, `x = y ◇ (x ◇ (x ◇ (y ◇ y)))`, holds in the model. -/
theorem sat_467A : @Equation467 R (Magma.lin (-th) (2 * th - 1)) := by
  intro x y
  simp only [Magma.lin_op]
  linear_combination (-4 * th ^ 2 * y + 2 * th * x + 6 * th * y + x - y) * hq

/-! #### The model `x ◇ y = (2 * th - 1) * x + (th - 1) * y`, with coefficient modulus `c = 3 * th - 3`. -/

theorem hcB (x : R) : (1 : R) + (3 * th - 3) * x ≠ 0 :=
  Magma.add_mul_ne_zero_of_hom f9 1 _
    (by simp only [map_sub, map_mul, map_ofNat, f9_th]
        linear_combination (CubicC.ph - 1) * CubicC.hchar)
    (by rw [map_one]; exact one_ne_zero) x

theorem hP3678B (z : R) : z ^ 2 - z + 1 ≠ 0 := by
  intro h
  have hr := congrArg r5_2 h
  simp only [map_sub, map_add, map_pow, map_one, map_zero] at hr
  revert hr
  generalize r5_2 z = y
  revert y
  decide

/-- Equation `3106`, `x = (((y ◇ x) ◇ x) ◇ y) ◇ y`, holds in the model. -/
theorem sat_3106B : @Equation3106 R (Magma.lin (2 * th - 1) (th - 1)) := by
  intro x y
  simp only [Magma.lin_op]
  linear_combination (-4 * th ^ 2 * x - 8 * th ^ 2 * y + 4 * th * x + 8 * th * y + x - y) * hq

end HalfGauss

