import equational_theories.Definability.AutBox
import equational_theories.Superposition

/-!
# Structurality from `Equation618` through the companion `x □ y = ((x ◇ x) ◇ y)`

Generated by `defwork/wffit.py`.  `Equation618` is `x = x ◇ (x ◇ ((x ◇ y) ◇ z))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation618` on one carrier with the same table of
`((x ◇ x) ◇ y)` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation618` on one carrier with the same `((x ◇ x) ◇ y)` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) Law618 := by
  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law618.models_iff G M).mp hM
  have hn := (@Law618.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X0 (M.op (M.op X0 X1) X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op X0 (N.op (N.op X0 X1) X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) X1) = (N.op (N.op X0 X0) X1) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X0 X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X0 X1 (M.op (M.op X0 X1) (M.op (M.op (M.op X0 X1) x) x))
       have i₂ := eq5 (M.op X0 X1) x x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq14 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq10 X0 (M.op X0 x)
       have i₂ := eq10 X0 x
       grind)
    | exact superpose eq10 eq10
    | exact resolve eq10 eq10
    | grind
    | grind (splits := 40)
  clear eq10
  have eq20 : ∀ X0 X1 : G, (N.op X0 (N.op X0 (N.op X0 X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 X1 (N.op (N.op X0 X1) (N.op (N.op (N.op X0 X1) x) x))
       have i₂ := eq6 (N.op X0 X1) x x
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq50 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq20 X0 (N.op X0 x)
       have i₂ := eq20 X0 x
       grind)
    | exact superpose eq20 eq20
    | exact resolve eq20 eq20
    | grind
    | grind (splits := 40)
  clear eq20
  have eq98 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op (M.op X0 X0) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X0 X1
       have i₂ := eq50 X0
       grind)
    | exact superpose eq50 eq7
    | exact resolve eq7 eq50
    | grind
    | grind (splits := 40)
  clear eq50
  have eq105 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq98 X0 X1
       have i₂ := eq14 X0
       grind)
    | exact superpose eq14 eq98
    | exact resolve eq98 eq14
    | grind
    | grind (splits := 40)
  clear eq14 eq98
  have eq208 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq105 a b
       grind)
    | exact superpose eq105 eq8
    | exact resolve eq8 eq105
    | grind
    | grind (splits := 40)
  clear eq105
  have eq209 : False := by grind
  exact eq209

/-- `Equation48` from `Equation618`: `x = x ◇ (x ◇ ((x ◇ y) ◇ z))` ⊢ `x = x ◇ (x ◇ (x ◇ y))`,
through the companion `x □ y = ((x ◇ x) ◇ y)`. -/
theorem Equation48_StructuralFromFin_Equation618 : Law48.StructuralFromFin Law618 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law618.models_iff G M).mp hM
  rw [@Law48.models_iff _ ((AutBox.wordOf ((Lf 0 ⋆ Lf 0) ⋆ Lf 1)).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

