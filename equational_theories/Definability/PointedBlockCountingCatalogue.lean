theorem Equation99_not_StructuralFrom_Equation3659_pointedBlocksC2 :
    ¬ Law99.StructuralFrom Law3659 :=
  PointedBlockCounting.not_structural (H := PointedBlockCounting.C2.H) (by decide) (by decide)
    (by rw [PointedBlockCounting.C2.count99]; decide)
    (by rw [PointedBlockCounting.C2.count99, PointedBlockCounting.C2.count3659]; decide)

/-- info: 'Equation99_not_StructuralFrom_Equation3659_pointedBlocksC2' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms Equation99_not_StructuralFrom_Equation3659_pointedBlocksC2

