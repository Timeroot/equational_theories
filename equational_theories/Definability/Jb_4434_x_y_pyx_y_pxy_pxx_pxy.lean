/-- `Equation3457` from `Equation4434`: `x ◇ (y ◇ x) = (x ◇ x) ◇ z` ⊢ `x ◇ x = x ◇ ((x ◇ x) ◇ y)`,
through `x □ y = if a = b then (M.op a b) else if (M.op b a) = b then (M.op a a) else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation3457_StructuralFromFin_Equation4434 : Law3457.StructuralFromFin Law4434 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_x_y_pyx_y_pxy_pxx_pxy_Equation4434 (fun {G} M hM ↦ ?_)
  have hm := (@Law4434.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, a ≠ b ∨ N.op a b = (M.op a b)) →
      (∀ a b : G, a = b ∨ (M.op b a) ≠ b ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, a = b ∨ (M.op b a) = b ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law3457 := by
    intro N h1 h2 h3
    rw [@Law3457.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).imp id (fun h ↦
      (eq_or_ne ((M.op b a)) (b)).symm.imp id (fun h' ↦ (if_neg h).trans (if_pos h')))
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).imp id (fun h ↦
      (eq_or_ne ((M.op b a)) (b)).imp id (fun h' ↦ (if_neg h).trans (if_neg h')))

