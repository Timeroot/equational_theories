import Mathlib.Tactic.Ring
import equational_theories.Definability.CloneTraps
import equational_theories.Equations.All

/-!
# The clone of an affine magma, in closed form

`Definability/Linear.lean` handles `x ◇ y = a x + b y` by the one congruence its coefficients obey.
Add a constant and the same idea gives something better: not a congruence but an exact
parametrization.

For `x ◇ y = a x + b y + k` over a commutative ring `R`, every binary term is again affine, so the
clone lives in the coefficient space `R³`, where composition is the affine map
`F(A, B) = a A + b B + C` with `C = (0, 0, 1)` (the last coordinate counting copies of `k`). Write
`e₁ = (1,0,0)` and `e₂ = (0,1,0)` for the two projections and put `s := a + b - 1`. Then

    F(e₁ + m₁, e₁ + m₂) = e₁ + (s e₁ + C) + a m₁ + b m₂,

so the coset `e₁ + M`, with `M` the submodule generated by `e₂ - e₁` and `s e₁ + C`, contains both
projections and is closed under `F`. Hence **every** term of `◇` is

    □(x, y) = (1 - q + r s) x + q y + r k,        q, r ∈ R,

which is `Magma.AffClone`. The containment is all a refutation needs, and it is proved by `ring`
with no hypothesis whatsoever on `a`, `b`, `k`: the composite of `(q₁, r₁)` and `(q₂, r₂)` is
`(a q₁ + b q₂, a r₁ + b r₂ + 1)`, and the first coefficient comes out right because
`(a + b) - 1 = s` is the only fact used.

Two things follow that the linear file cannot do. The parametrization is by a plain pair `(q, r)`,
so over a finite ring the refutation is a scan of `|R|²` pairs rather than of the whole clone; and
because the shift is carried symbolically, models with `k ≠ 0` — the ones whose automorphism group
is only the translations — are in reach. `Definability/Aff692.lean` is the first customer.

Like every clone argument this refutes term-definability and says nothing about definability.
-/

open Law Law.MagmaLaw

namespace Magma

variable {R : Type} [CommRing R]

/-- The affine magma `x ◇ y = a * x + b * y + k` over a commutative ring. -/
@[implicit_reducible]
def aff (a b k : R) : Magma R := Magma.mk fun x y ↦ a * x + b * y + k

@[simp] theorem aff_op (a b k x y : R) : (aff a b k).op x y = a * x + b * y + k := rfl

/-- `AffClone a b k f` says that `f` is the affine operation with coefficients `(1 - q + r s, q)`
and shift `r k`, where `s = a + b - 1`. This is a superset of the clone of `Magma.aff a b k`, and
over a field it is normally the clone on the nose. -/
def AffClone (a b k : R) (f : R → R → R) : Prop :=
  ∃ q r : R, ∀ x y, f x y = (1 - q + r * (a + b - 1)) * x + q * y + r * k

/-- The coset is a clone invariant of `Magma.aff a b k` — unconditionally. Both projections are in
it (`(q, r) = (0, 0)` and `(1, 0)`), and composing `(q₁, r₁)` with `(q₂, r₂)` along `◇` gives
`(a q₁ + b q₂, a r₁ + b r₂ + 1)`; that the `x`-coefficient of the composite is again
`1 - q + r s` is the identity `1 - (a + b) + s = 0`. -/
theorem aff_isCloneInvariant (a b k : R) : (aff a b k).IsCloneInvariant (AffClone a b k) where
  fst := ⟨0, 0, fun x y ↦ by ring⟩
  snd := ⟨1, 0, fun x y ↦ by ring⟩
  comp := by
    rintro f g ⟨q₁, r₁, hf⟩ ⟨q₂, r₂, hg⟩
    refine ⟨a * q₁ + b * q₂, a * r₁ + b * r₂ + 1, fun x y ↦ ?_⟩
    show (aff a b k).op (f x y) (g x y) = _
    rw [aff_op, hf, hg]
    ring

/-- The members of `Magma.AffClone a b k`, indexed by the plain pair `(q, r)`. Over a finite ring
this makes the refutation a scan of `|R|²` operations. -/
@[implicit_reducible]
def affFam (a b k q r : R) : Magma R :=
  Magma.mk fun x y ↦ (1 - q + r * (a + b - 1)) * x + q * y + r * k

@[simp] theorem affFam_op (a b k q r x y : R) :
    (affFam a b k q r).op x y = (1 - q + r * (a + b - 1)) * x + q * y + r * k := rfl

/-- The magma is the member `(q, r) = (b, 1)`. -/
theorem aff_eq_affFam (a b k : R) : aff a b k = affFam a b k b 1 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ by
    show a * x + b * y + k = (1 - b + 1 * (a + b - 1)) * x + b * y + 1 * k
    ring)

end Magma

namespace Law.MagmaLaw

variable {β : Type*} {L L' : Law.MagmaLaw β}

/-- **The affine obstruction.** If `L'` holds in `Magma.aff a b k` over a finite commutative ring,
and no member of `Magma.affFam a b k` satisfies `L`, then `L` is not term-definable from `L'` over
finite magmas — hence not over all magmas either.

Unlike `not_termDefinableFrom_of_lin` there is no side condition: the coset is closed under
composition for every `(a, b, k)`. -/
theorem not_termDefinableFromFin_of_aff {R : Type} [CommRing R] [Finite R] (a b k : R)
    (hM : @satisfies _ R (Magma.aff a b k) L')
    (hL : ∀ q r : R, ¬ @satisfies _ R (Magma.affFam a b k q r) L) :
    ¬ L.TermDefinableFromFin L' := by
  refine not_termDefinableFromFin_of_invariant (Magma.aff a b k) hM
    (Magma.aff_isCloneInvariant a b k) ?_
  rintro op ⟨q, r, hop⟩ h
  refine hL q r ?_
  have : Magma.mk op = Magma.affFam a b k q r :=
    congrArg Magma.mk (funext fun x ↦ funext fun y ↦ hop x y)
  exact this ▸ h

end Law.MagmaLaw
