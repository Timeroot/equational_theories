import equational_theories.Definability.AutBox

/-!
# Structurality from `Equation168` through a word companion

Generated by `defwork/wcell.py`.  `Equation168` is `x = (y ◇ x) ◇ (x ◇ z)`.  The companion is
`x □ y = W(x, y)` for a word `W` below: `haut` says the companion
has no automorphism the magma lacks, which is the whole reverse half of `StructuralOnMagma` on a
finite carrier, and each theorem then only has to check that the source forces its target of `W`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

/-- Every bijection of a model of `Equation168` respecting `(x ◇ (y ◇ x))` respects `◇`. -/
private theorem haut0 : ∀ {G : Type} [Finite G] (M : Magma G), satisfies G Law168 →
    ∀ σ τ : G → G, (∀ a : G, τ (σ a) = a) → (∀ a : G, σ (τ a) = a) →
    (∀ a b : G, σ (@evalInMagma _ _ M ![a, b] (Lf 0 ⋆ (Lf 1 ⋆ Lf 0)))
      = @evalInMagma _ _ M ![σ a, σ b] (Lf 0 ⋆ (Lf 1 ⋆ Lf 0))) →
    ∀ a b : G, σ (M.op a b) = M.op (σ a) (σ b) := by
  intro G _ M hM σ τ h1 h2 hw a b
  have h := (@Law168.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hw
  grind

/-- `Equation323` from `Equation168`: `x = (y ◇ x) ◇ (x ◇ z)` ⊢ `x ◇ y = x ◇ (x ◇ y)`,
through the companion `x □ y = (x ◇ (y ◇ x))`. -/
theorem Equation323_StructuralFromFin_Equation168 : Law323.StructuralFromFin Law168 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law168.models_iff G M).mp hM
  rw [@Law323.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ Lf 0))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  -- `(y ◇ x) ◇ (x ◇ (y ◇ x)) = x` is the source at `z := y ◇ x`, and rewriting by it turns the
  -- source at `x := x ◇ (y ◇ x)` into the goal.
  have h1 := (h x y (y ◇ x)).symm
  have h2 := h (x ◇ (y ◇ x)) (y ◇ x) x
  rw [h1] at h2
  exact h2

/-- `Equation3306` from `Equation168`: `x = (y ◇ x) ◇ (x ◇ z)` ⊢ `x ◇ y = x ◇ (x ◇ (x ◇ y))`,
through the companion `x □ y = (x ◇ (y ◇ x))`. -/
theorem Equation3306_StructuralFromFin_Equation168 : Law3306.StructuralFromFin Law168 := by
  classical
  refine AutBox.structuralFromFin_word (Lf 0 ⋆ (Lf 1 ⋆ Lf 0)) (fun {G} _ M hM ↦ ?_) haut0
  have h := (@Law168.models_iff G M).mp hM
  rw [@Law3306.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ Lf 0))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  -- `W (x, ·)` is idempotent by the same two instances, so a third application changes nothing.
  have key : ∀ t : G, x ◇ (t ◇ x) = x ◇ ((x ◇ (t ◇ x)) ◇ x) := fun t ↦ by
    have h1 := (h x t (t ◇ x)).symm
    have h2 := h (x ◇ (t ◇ x)) (t ◇ x) x
    rw [h1] at h2
    exact h2
  rw [← key (x ◇ (y ◇ x)), ← key y]
