/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `56`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R806Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R8060 : Array (Array Nat) := #[#[4, 2, 5, 6, 4, 7, 1, 9, 0, 3], #[3, 4, 9, 7, 4, 6, 2, 5, 1, 0], #[6, 5, 4, 0, 4, 3, 9, 1, 2, 7], #[7, 9, 1, 4, 4, 0, 5, 2, 3, 6], #[8, 8, 8, 8, 4, 8, 8, 8, 4, 8], #[1, 3, 7, 9, 4, 4, 0, 6, 5, 2], #[9, 7, 3, 1, 4, 2, 4, 0, 6, 5], #[2, 0, 6, 5, 4, 9, 3, 4, 7, 1], #[8, 8, 8, 8, 8, 8, 8, 8, 4, 8], #[5, 6, 0, 2, 4, 1, 7, 3, 9, 4]]

def opsrch10R8060 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R8060[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R8060 :
    ∀ x y, Magma.transport S10R806.E S10R806.tr vsrch10R8060.1 x y = opsrch10R8060 x y := by
  native_decide

theorem esrch10R8060 : Magma.srch10R806 vsrch10R8060 = Magma.mk opsrch10R8060 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R8060 x y)

