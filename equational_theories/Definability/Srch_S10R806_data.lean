namespace Magma

/-- A member of the class, as the `10` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup10R806 : Type := {w : Fin 10 → Fin 10 // Magma.tupOK S10R806.E S10R806.tr S10R806.z S10R806.st S10R806.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch10R806 (v : tup10R806) : Magma (Fin 10) :=
  Magma.mk (Magma.transport S10R806.E S10R806.tr v.1)

end Magma

