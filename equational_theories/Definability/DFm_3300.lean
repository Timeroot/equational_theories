import equational_theories.Definability.AutBox
import equational_theories.Definability.SBox_01

/-!
# The diagonal obligation for `Equation3300`, inherited

Generated by `defwork/dfmono.py`.  `Equation3300` is `x ◇ x = y ◇ (z ◇ (w ◇ x))`, which implies
`Equation3292` (`x ◇ x = y ◇ (z ◇ (y ◇ x))`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation3300 : AutBox.DiagFix Law3300 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation3292
  rw [@Law3292.models_iff G M]
  rw [@Law3300.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y z; grind (splits := 60) (ematch := 40))
