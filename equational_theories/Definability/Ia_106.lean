/-!
# Structurality from `Equation106` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation106` is `x = x ◇ ((y ◇ x) ◇ z)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,Y) = X then m(X,Y) else m(Y,X)`
is an automorphism -- is `GuardAut_pxy_x_pxy_pyx_Equation106`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation823` from `Equation106`: `x = x ◇ ((y ◇ x) ◇ z)` ⊢ `x = x ◇ ((x ◇ y) ◇ (x ◇ y))`,
through `x □ y = if m(X,Y) = X then m(X,Y) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation823_StructuralFromFin_Equation106 : Law823.StructuralFromFin Law106 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxy_x_pxy_pyx_Equation106 (fun {G} M hM ↦ ?_)
  have hm := (@Law106.models_iff G M).mp hM
  rw [@Law823.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

