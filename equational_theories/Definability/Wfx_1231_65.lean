  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq9 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X0 (M.op (M.op (M.op X0 X1) X1) X0)) X0)) = X0 := by
    intro X0 X1
