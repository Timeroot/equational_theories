/-!
# Structurality from `Equation318` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation318` is `x ◇ x = y ◇ (z ◇ x)`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a a) = a then (M.op a b) else if (M.op a a) = (M.op a b) then b else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pxx_x_pxx_pxy_pxy_y_pxy_Equation318`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation333` from `Equation318`: `x ◇ x = y ◇ (z ◇ x)` ⊢ `x ◇ y = y ◇ (x ◇ y)`,
through `x □ y = if (M.op a a) = a then (M.op a b) else if (M.op a a) = (M.op a b) then b else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation333_StructuralFromFin_Equation318 : Law333.StructuralFromFin Law318 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_x_pxx_pxy_pxy_y_pxy_Equation318 (fun {G} M hM ↦ ?_)
  have hm := (@Law318.models_iff G M).mp hM
  rw [@Law333.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

