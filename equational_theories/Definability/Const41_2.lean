  have h41 : Equation41 G := Law41.models_iff.mp hM
  refine structuralOn_of_diag M t20 (t20_diag M h41) ?_
  rw [@Law1184.models_iff]
  intro x y z
  obtain ⟨c, hc⟩ : ∃ c : G, ∀ u v : G, M.op u v = c := ⟨M.op x x, const_of_41 M h41 x x⟩
  simp only [t20_apply M c _ _ hc]
  by_cases hx : x = c <;>
    by_cases hy : y = c <;>
    by_cases hz : z = c <;>
    by_cases hxy : x = y <;>
    by_cases hxz : x = z <;>
    by_cases hyz : y = z <;>
    simp_all [eq_comm]

