import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.AdjoinRoot
import equational_theories.Definability.AffineClone
import equational_theories.Definability.PolyIrreducible

/-!
# The characteristic-zero affine model of 1516, and the forty-two targets it kills

`commentary/Equation1516.md` classifies the affine models of `1516`, `x = (y ◇ y) ◇ (x ◇ (x ◇ y))`.
Over a commutative ring `x ◇ y = a x + b y + k` satisfies it exactly when

    a b (1 + b) = 1,    a² + a b + b³ = 0,    k (a + b² + b + 1) = 0,

and eliminating `a` leaves `h(b) = 0` for `h = (b³ - b + 1) (b⁴ + 2b³ + 2b² + b + 1)`. So every
affine model is a ring-hom image of

* `R₁ = ℤ[b]/(b³ - b + 1)`, where `a = 1 - b`, `s := a + b - 1 = 0` and `k = 0`; or
* `R₂ = ℤ[b]/(b⁴ + 2b³ + 2b² + b + 1)`, where `a = -(1 + b + b²)` is a primitive cube root of
  unity, `s = -(2 + b²) ≠ 0`, and `k` is unconstrained.

This file is the second branch, with `k = 1`. By `Definability/AffineClone.lean` every binary term
of the magma is `(1 - q + r s) x + q y + r k`, so a target law imposes three conditions on the pair
`(q, r)`: the coefficient of `x`, the coefficient of `y`, and the constant. The constant of *every*
term is a multiple of `r` — `E_{u ◇ v} = P E_u + q E_v + 1` with `E_x = E_y = 0` — so the third
condition always reads `r * W (q, r) = 0`, and in a **domain** that is a free case split. No
Groebner basis appears anywhere.

`R₂` is a domain because `b⁴ + 2b³ + 2b² + b + 1` is irreducible, which
`Definability/PolyIrreducible.lean` reads off its reduction `X⁴ + X + 1` modulo two. Both branches
of the split then die in a degree-one residue field:

* `r = 0` forces the `x`-coefficient to be `1 - q`, and the two coefficient equations have no
  common root modulo `13` at `b = 6`;
* `W = 0` kills the rest modulo `19` at `b = 13` — the prime where the two branches glue, since
  `res(h₁, h₂) = 19`, and the one prime at which `s` vanishes.

Two primes are genuinely needed, and the carrier genuinely has to be infinite: over `ℤ/19^e` the
offending solution lifts to every level `e` (Hensel: the derivative is a unit), and at every other
prime `s` is a unit, so `r s` can be anything. No finite affine model of `1516` refutes any of
these forty-two targets — the four that a finite model does refute, `467`, `667`, `2900` and
`3140`, are already closed elsewhere. Accordingly the flavour closed here is `TermDefinableFrom`
over all magmas.

The same clone serves `2091`, `x = ((y ◇ x) ◇ x) ◇ (y ◇ y)`, which the *opposite* magma satisfies:
swapping `a` and `b` leaves `s` alone, so `Magma.affFam` is literally the same family.

Generated by `gen1516r2.py`.
-/

set_option maxHeartbeats 1000000
-- the simp sets below are uniform across the forty-two lemmas, so some arguments idle
set_option linter.unusedSimpArgs false

open Law Law.MagmaLaw Polynomial

noncomputable section

namespace R1516

/-- The defining polynomial of the second branch. -/
abbrev qp : ℤ[X] := X ^ 4 + 2 * X ^ 3 + 2 * X ^ 2 + X + 1

/-- `qp` is irreducible because its reduction modulo `2` is `X ^ 4 + X + 1`, which has no root and
is not a square of the only irreducible quadratic. -/
theorem qp_irr : Irreducible qp :=
  irreducible_quartic_int 2 2 1 1 2
    (by simp only [qp, map_one, map_ofNat]; ring) (by decide) (by decide)

/-- `R₂ = ℤ[b]/(b⁴ + 2b³ + 2b² + b + 1)`, a domain because `qp` is irreducible. -/
abbrev R : Type := AdjoinRoot qp

instance : IsDomain R :=
  AdjoinRoot.isDomain_of_prime (UniqueFactorizationMonoid.irreducible_iff_prime.mp qp_irr)

/-- The algebraic integer `b`. -/
abbrev th : R := AdjoinRoot.root qp

theorem hq : th ^ 4 + 2 * th ^ 3 + 2 * th ^ 2 + th + 1 = 0 := by
  have h := AdjoinRoot.eval₂_root qp
  simp only [qp, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

/-- Reduction modulo `13`, sending `b` to `6`. This is where the branch `r = 0` dies. -/
def r13 : R →+* ZMod 13 := AdjoinRoot.lift (Int.castRingHom (ZMod 13)) 6
  (by simp only [qp, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r13_th : r13 th = 6 := by simp [r13]

/-- Reduction modulo `19`, sending `b` to `13`: the prime where the two affine branches glue, and
the only one at which `s = -(2 + b²)` vanishes. This is where the branch `W = 0` dies. -/
def r19 : R →+* ZMod 19 := AdjoinRoot.lift (Int.castRingHom (ZMod 19)) 13
  (by simp only [qp, eval₂_add, eval₂_mul, eval₂_ofNat, eval₂_pow, eval₂_X, eval₂_one]; decide)

@[simp] theorem r19_th : r19 th = 13 := by simp [r19]

/-- The first coefficient: a primitive cube root of unity. -/
def aa : R := -(1 + th + th ^ 2)

/-- The second coefficient. -/
def bb : R := th

theorem aa_def : aa = -(1 + th + th ^ 2) := rfl
theorem bb_def : bb = th := rfl

/-- The clone coset of the model, indexed by a pair `(q, r)`. It does not depend on which of the
two coefficient orders is used, because `s = a + b - 1` is symmetric. -/
@[implicit_reducible]
def famR (q r : R) : Magma R := Magma.affFam aa bb 1 q r

/-- The same member as a bare operation. -/
abbrev opR (q r : R) : R → R → R := (famR q r).op

/-- Swapping the coefficients gives literally the same clone family. -/
theorem famSwap (q r : R) : Magma.affFam bb aa 1 q r = famR q r :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ by
    show (1 - q + r * (bb + aa - 1)) * x + q * y + r * 1
       = (1 - q + r * (aa + bb - 1)) * x + q * y + r * 1
    ring)


/-! ### The model satisfies both source laws -/


/-- The model satisfies `x = (y ◇ y) ◇ (x ◇ (x ◇ y))`. -/
theorem sat1516 : @Equation1516 R (Magma.aff aa bb 1) := by
  intro x y
  simp only [Magma.aff_op, aa_def, bb_def]
  linear_combination (x - y) * hq

/-- The model satisfies `x = ((y ◇ x) ◇ x) ◇ (y ◇ y)`. -/
theorem sat2091 : @Equation2091 R (Magma.aff bb aa 1) := by
  intro x y
  simp only [Magma.aff_op, aa_def, bb_def]
  linear_combination (x - y) * hq


