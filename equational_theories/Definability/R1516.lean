  have hc : r * (-th ^ 4 * r ^ 2 - 2 * th ^ 2 * q * r - 4 * th ^ 2 * r ^ 2 + 3 * th ^ 2 * r - q ^ 2 - 4 * q * r + 3 * q - 4 * r ^ 2 + 6 * r - 2) = 0 := by linear_combination h0
  rcases mul_eq_zero.mp hc with hr | hw
  · subst hr
    have g1 := congrArg r13 h1
    have g2 := congrArg r13 h2
    simp only [map_add, map_sub, map_mul, map_pow, map_neg, map_one, map_zero,
      map_ofNat, r13_th] at g1 g2
    revert g1 g2
    generalize r13 q = u
    revert u
    decide
  · have g0 := congrArg r19 hw
    have g1 := congrArg r19 h1
    have g2 := congrArg r19 h2
    simp only [map_add, map_sub, map_mul, map_pow, map_neg, map_one, map_zero,
      map_ofNat, r19_th] at g0 g1 g2
    revert g0 g1 g2
    generalize r19 q = u
    generalize r19 r = v
    revert u v
    decide


end R1516
