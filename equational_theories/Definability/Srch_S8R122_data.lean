@[reducible] def tup8R122 : Type := {w : Fin 3 → Fin 8 // Magma.tupOK S8R122.E S8R122.tr S8R122.z S8R122.st S8R122.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch8R122 (v : tup8R122) : Magma (Fin 8) :=
  Magma.mk (Magma.transport S8R122.E S8R122.tr v.1)

end Magma

