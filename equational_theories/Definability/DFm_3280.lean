import equational_theories.Definability.AutBox
import equational_theories.Definability.RigBox_00

/-!
# The diagonal obligation for `Equation3280`, inherited

Generated by `defwork/dfmono.py`.  `Equation3280` is `x ◇ x = y ◇ (y ◇ (x ◇ z))`, which implies
`Equation3254` (`x ◇ x = x ◇ (x ◇ (x ◇ y))`).  `AutBox.DiagFix` is antitone, so the obligation proved for the
weaker law covers the stronger one.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option maxHeartbeats 1000000

theorem DiagFix_Equation3280 : AutBox.DiagFix Law3280 := by
  refine AutBox.diagFix_mono (fun {G} M h ↦ ?_) DiagFix_Equation3254
  rw [@Law3254.models_iff G M]
  rw [@Law3280.models_iff G M] at h
  first
  | grind
  | grind (splits := 30) (ematch := 20)
  | (intro x y; grind (splits := 60) (ematch := 40))
