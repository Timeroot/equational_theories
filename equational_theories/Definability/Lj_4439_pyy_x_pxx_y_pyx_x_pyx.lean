    GuardAut2_pyy_x_pxx_y_pyx_x_pyx_Equation4439 (fun {G} M hM ↦ ?_)
  have hm := (@Law4439.models_iff G M).mp hM
  rw [@Law8.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
