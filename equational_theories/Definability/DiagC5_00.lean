        have eq10 : ((x ◇ x) ◇ (x ◇ x)) ≠ (x ◇ (x ◇ ((x ◇ x) ◇ (x ◇ x)))) := mod_symm nh
        have eq11 (X0 X1 : G) : (X0 ◇ ((X1 ◇ X1) ◇ ((X0 ◇ X0) ◇ (X0 ◇ X0)))) = X1 := by first | exact superpose eq7 eq7 | exact mod_symm (superpose eq7 eq7) | exact superpose eq7 eq7 | exact mod_symm (superpose eq7 eq7)
