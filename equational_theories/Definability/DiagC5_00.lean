        have eq14 (X0 X1 : G) : ((X0 ◇ X0) ◇ (X0 ◇ X0)) = (X1 ◇ (X0 ◇ ((X1 ◇ X1) ◇ (X1 ◇ X1)))) := by first | exact superpose eq7 eq11 | exact mod_symm (superpose eq7 eq11) | exact superpose eq11 eq7 | exact mod_symm (superpose eq11 eq7)
        have eq32 (X0 : G) : ((X0 ◇ X0) ◇ (x ◇ X0)) ≠ (x ◇ (x ◇ ((X0 ◇ X0) ◇ (x ◇ X0)))) := by first | exact superpose eq12 eq10 | exact mod_symm (superpose eq12 eq10) | exact superpose eq10 eq12 | exact mod_symm (superpose eq10 eq12)
