/-- the companion: `x □ y = if x = y then ((x ◇ x) ◇ (x ◇ x)) else x ◇ y` -/
private def qA : QFOp := QFOp.diagOf ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0))

private theorem qA_ne {G : Type} (M : Magma G) (a b : G) (h : a ≠ b) :
    (qA.magma M).op a b = M.op a b := QFOp.diagOf_ne _ M a b h

private theorem qA_eq {G : Type} (M : Magma G) (a b : G) (h : a = b) :
    (qA.magma M).op a b = (M.op (M.op a a) (M.op a a)) := by
  refine (QFOp.diagOf_eq ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) M a b h).trans ?_
  first | rfl | simp [evalInMagma]

private theorem qA_diag {G : Type} (M : Magma G) (a : G) :
    (qA.magma M).op a a = (M.op (M.op a a) (M.op a a)) := qA_eq M a a rfl

/-- `x = (y ◇ y) ◇ ((x ◇ x) ◇ y)`: the word `((x □ x) □ (x □ x))` names `x ◇ x` whenever `a ≠ x`. -/
private theorem sound1719 {G : Type} (M : Magma G) (hM : satisfies G Law1719) (x a : G)
    (hax : a ≠ x) :
    @evalInMagma _ _ (qA.magma M) ![x, a] ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) = M.op x x := by
  have h := (@Law1719.models_iff G M).mp hM
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]
  simp only [qA_diag]
  all_goals
    by_contra nh
    have eq6 (X0 X1 : G) : ((X1 ◇ X1) ◇ ((X0 ◇ X0) ◇ X1)) = X0 := mod_symm (h ..)
    have eq8 : (x ◇ x) ≠ ((((x ◇ x) ◇ (x ◇ x)) ◇ ((x ◇ x) ◇ (x ◇ x))) ◇ (((x ◇ x) ◇ (x ◇ x)) ◇ ((x ◇ x) ◇ (x ◇ x)))) := mod_symm nh
    have eq13 : (x ◇ x) ≠ (x ◇ x) := by first | exact superpose eq6 eq8 | exact mod_symm (superpose eq6 eq8) | exact superpose eq8 eq6 | exact mod_symm (superpose eq8 eq6)
    first | exact eq13 rfl | exact eq13 _ rfl | exact eq13 _ _ rfl | exact eq13 _ _ _ rfl

