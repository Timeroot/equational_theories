import equational_theories.Definability.DiagRow

/-!
# `Equation2850` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2850` is `x = ((x ◇ (x ◇ x)) ◇ y) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2850`: `x = ((x ◇ (x ◇ x)) ◇ y) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2850 : DiagRow.ColQG Law2850 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2850.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op z (M.op z z)) u), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 (M.op X0 X0)) X1) X1) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op X0 (M.op X0 X0)) = (M.op X0 (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) := by
    intro X0
    first
    | (have i₁ := eq4 (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))
       have i₂ := eq4 X0 (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 : G, (M.op (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) (M.op (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))))) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 (M.op (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))))
       have i₂ := eq7 (M.op X0 (M.op X0 X0))
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : ∀ X0 : G, (M.op (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) (M.op X0 X0)) = X0 := by
    intro X0
    first
    | (have i₁ := eq7 (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0))))
       have i₂ := eq8 X0
       grind)
    | exact superpose eq8 eq7
    | exact resolve eq7 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq11 : ∀ X0 X1 : G, (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) = (M.op (M.op X0 X1) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op X0 (M.op X0 X0)) (M.op (M.op X0 (M.op X0 X0)) (M.op X0 (M.op X0 X0)))) X1
       have i₂ := eq8 X0
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq21 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X1) X1) (M.op X0 X0)) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq10 X0
       have i₂ := eq11 X0 X1
       grind)
    | exact superpose eq11 eq10
    | exact resolve eq10 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq22 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X1) X1) (M.op (M.op (M.op X0 X1) X1) (M.op (M.op X0 X1) X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq8 X0
       have i₂ := eq11 X0 X1
       grind)
    | exact superpose eq11 eq8
    | exact resolve eq8 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq28 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X0 X0)) = (M.op (M.op (M.op (M.op X0 X1) X1) X2) X2) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op X0 (M.op X0 X0)) X2
       have i₂ := eq11 X0 X1
       grind)
    | exact superpose eq11 eq4
    | exact resolve eq4 eq11
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq11
  have eq80 : y = (M.op (M.op (M.op x x) x) (M.op y y)) := by
    first
    | (have i₁ := eq21 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq21
    | exact resolve eq21 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq21
  have eq205 : ∀ X0 : G, (M.op (M.op (M.op x x) x) (M.op (M.op (M.op x x) x) (M.op (M.op x x) x))) = (M.op (M.op (M.op y (M.op y y)) X0) X0) := by
    intro X0
    first
    | (have i₁ := eq28 (M.op (M.op x x) x) (M.op y y) X0
       have i₂ := eq80
       grind)
    | exact superpose eq80 eq28
    | exact resolve eq28 eq80
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq28 eq80
  have eq212 : y = (M.op (M.op (M.op x x) x) (M.op (M.op (M.op x x) x) (M.op (M.op x x) x))) := by
    first
    | (have i₁ := eq205 x
       have i₂ := eq4 y x
       grind)
    | exact superpose eq4 eq205
    | exact resolve eq205 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq205
  have eq213 : y = x := by
    first
    | (have i₁ := eq212
       have i₂ := eq22 x x
       grind)
    | exact superpose eq22 eq212
    | exact resolve eq212 eq22
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq22 eq212
  have eq214 : False := by grind
  exact eq214

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2850` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2850 : Law3.StructuralFrom Law2850 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2850
