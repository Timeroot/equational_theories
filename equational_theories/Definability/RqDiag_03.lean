/-!
# `StructuralFrom` by diagonal replacement `A(x) = x`, batch `RqDiag_03`

Generated by `defwork/rqdiag.py`.  The companion is `x □ y = if x = y then A(x) else x ◇ y`.
Unlike the `DiagRepair` batches it carries no recovery word: every source here is a `RowQG` or a
`ColQG`, so the discarded diagonal is *definable* from `□` and `DiagRow.structuralFrom_diagOf_row`
supplies the backward half of `StructuralFrom` on its own.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxErrors 10000
set_option maxHeartbeats 1000000
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

attribute [local instance] instFOStructure

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace Law.MagmaLaw

/-- the companion: `x □ y = if x = y then x else x ◇ y` -/
private def qA : QFOp := QFOp.diagOf (Lf 0)

private theorem qA_ne {G : Type} (M : Magma G) (a b : G) (h : a ≠ b) :
    (qA.magma M).op a b = M.op a b := QFOp.diagOf_ne _ M a b h

private theorem qA_eq {G : Type} (M : Magma G) (a b : G) (h : a = b) :
    (qA.magma M).op a b = a := by
  refine (QFOp.diagOf_eq (Lf 0) M a b h).trans ?_
  first | rfl | simp [evalInMagma]

private theorem qA_diag {G : Type} (M : Magma G) (a : G) :
    (qA.magma M).op a a = a := qA_eq M a a rfl

