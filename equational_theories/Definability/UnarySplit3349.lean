theorem t8_fpf (h : Equation3349 G) (hf : ∀ v : G, M.op v v ≠ v) (y z : G) :
    @evalInMagma _ _ (t8.magma M) ![y, z] (Lf 1)
        = @evalInMagma _ _ (t8.magma M) ![y, z] (Lf 0 ⋆ Lf 0)
      ↔ z = M.op y y := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary3349.name_s M h
  show z = (t8.magma M).op y y ↔ _
  simp only [t8_apply M, hs] at hf ⊢
  grind (splits := 24)

/-- Where `s` fixes a point and moves another, `w = (y □ y)` holds exactly at `z = s y`. -/
theorem t8_mix (h : Equation3349 G) (hfx : ∃ q : G, M.op q q = q)
    (hmv : ∃ q : G, M.op q q ≠ q) (y z : G) :
    @evalInMagma _ _ (t8.magma M) ![y, z] (Lf 1)
        = @evalInMagma _ _ (t8.magma M) ![y, z] (Lf 0 ⋆ Lf 0)
      ↔ z = M.op y y := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary3349.name_s M h
  obtain ⟨q₀, hq₀⟩ := hfx
  obtain ⟨q₁, hq₁⟩ := hmv
  show z = (t8.magma M).op y y ↔ _
  simp only [t8_apply M, hs] at hq₀ hq₁ ⊢
  grind (splits := 24)

end UnarySplit3349
