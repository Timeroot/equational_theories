/-- `x □ y := if s² x = x then if y = x then x else if s y = x then x else if s² y = y then s x
else x else if y = s² x then s x else x`. -/
def t0 : QFOp :=
  .ite ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) (Lf 0)
        (.ite (Lf 1) (Lf 0)
          (.leaf (Lf 0))
          (.ite (Lf 1 ⋆ Lf 1) (Lf 0)
            (.leaf (Lf 0))
            (.ite ((Lf 1 ⋆ Lf 1) ⋆ (Lf 1 ⋆ Lf 1)) (Lf 1) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0)))))
        (.ite (Lf 1) ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0)))

open scoped Classical in
theorem t0_apply (a b : G) :
    (t0.magma M).op a b =
      if M.op (M.op a a) (M.op a a) = a then
        if b = a then a
        else if M.op b b = a then a
        else if M.op (M.op b b) (M.op b b) = b then M.op a a
        else a
      else if b = M.op (M.op a a) (M.op a a) then M.op a a
      else a := by
  show @QFOp.eval _ M t0 ![a, b] = _
  simp only [t0, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` fixes a point and moves another, `(y □ w)` sweeps exactly `{y, s y}`. -/
theorem t0_mix (h : Equation3349 G) (hfx : ∃ q : G, M.op q q = q)
    (hmv : ∃ q : G, M.op q q ≠ q) (y z : G) :
    (∃ p : G, @evalInMagma _ _ (t0.magma M) ![y, p] (Lf 0 ⋆ Lf 1) = z)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary3349.name_s M h
  obtain ⟨q₀, hq₀⟩ := hfx
  obtain ⟨q₁, hq₁⟩ := hmv
  show (∃ p : G, (t0.magma M).op y p = z) ↔ _
  simp only [t0_apply M, hs] at hq₀ hq₁ ⊢
  constructor
  · rintro ⟨p, rfl⟩
    grind (splits := 24)
  · intro hz
    rcases hz with hz | hz <;>
      first
        | exact ⟨y, by grind (splits := 24)⟩
        | exact ⟨q₀, by grind (splits := 24)⟩
        | exact ⟨q₁, by grind (splits := 24)⟩
        | exact ⟨s y, by grind (splits := 24)⟩
        | exact ⟨s (s y), by grind (splits := 24)⟩
        | grind (splits := 24)

