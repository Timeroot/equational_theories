/-- Two models of `Equation102` on one carrier with the same `((x ◇ x) ◇ y)` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) Law102 := by
  classical
  refine AutBox.wordRigidFull_of ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law102.models_iff G M).mp hM
  have hn := (@Law102.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X0 X1) X1)) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 (N.op (N.op X0 X1) X1)) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op (M.op X0 X0) X1) = (N.op (N.op X0 X0) X1) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq9 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op (M.op X0 X1) X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq5 X0 (M.op (M.op X0 X1) X1)
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq10 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq9 X0 x
       have i₂ := eq5 X0 x
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
  clear eq9
  have eq13 : ∀ X0 X1 : G, (N.op X0 (N.op X0 (N.op (N.op X0 X1) X1))) = X0 := by
    intro X0 X1
    first
    | (have i₁ := eq6 X0 (N.op (N.op X0 X1) X1)
       have i₂ := eq6 X0 X1
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq14 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq13 X0 x
       have i₂ := eq6 X0 x
       grind)
    | exact superpose eq6 eq13
    | exact resolve eq13 eq6
    | grind
    | grind (splits := 40)
  clear eq13
  have eq17 : ∀ X0 X1 : G, (N.op X0 X1) = (M.op (M.op X0 X0) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X0 X1
       have i₂ := eq14 X0
       grind)
    | exact superpose eq14 eq7
    | exact resolve eq7 eq14
    | grind
    | grind (splits := 40)
  clear eq14
  have eq32 : ∀ X0 X1 : G, (M.op X0 X1) = (N.op X0 X1) := by
    intro X0 X1
    first
    | (have i₁ := eq17 X0 X1
       have i₂ := eq10 X0
       grind)
    | exact superpose eq10 eq17
    | exact resolve eq17 eq10
    | grind
    | grind (splits := 40)
  clear eq10 eq17
  have eq50 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq32 a b
       grind)
    | exact superpose eq32 eq8
    | exact resolve eq8 eq32
    | grind
    | grind (splits := 40)
  clear eq32
  have eq57 : False := by grind
  exact eq57

/-- `Equation826` from `Equation102`: `x = x ◇ ((x ◇ y) ◇ y)` ⊢ `x = x ◇ ((x ◇ y) ◇ (y ◇ y))`,
through the companion `x □ y = ((x ◇ x) ◇ y)`. -/
theorem Equation826_StructuralFromFin_Equation102 : Law826.StructuralFromFin Law102 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull ((Lf 0 ⋆ Lf 0) ⋆ Lf 1) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law102.models_iff G M).mp hM
  rw [@Law826.models_iff _ ((AutBox.wordOf ((Lf 0 ⋆ Lf 0) ⋆ Lf 1)).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

