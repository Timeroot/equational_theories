/-!
# Source 463: the order-four map, split four ways

`Definability/UnarySplit463.lean` splits the models of `Equation463` three ways on the fixed points
of `s` and settles 103 targets.  For the rest the fixed-point-free branch has no reverse witness at
all, and the reason is not that the words are too short -- searching to five leaves rather than
three changes nothing -- but that the branch is too coarse.  An involution and a genuine order-four
map are both fixed-point-free and they want different words.

So halve that branch on `s² = id`, which is `∀ v, (v ◇ v) ◇ (v ◇ v) = v` and hence `∅`-definable in
the source like the other two predicates:

* **`s = id`.** The source is the right projection and `M.Graph` is `z = y`, definable in any
  structure whatever -- `Unary.structuralOnMagma_rproj`.
* **`s` fixed-point-free and an involution.** A `□`-word equation cuts out the orbit `{y, s y}` and
  one quantifier separates its two elements -- `Unary.structuralOnMagma_pair`.
* **`s` fixed-point-free of order four.** No equation cuts the orbit out, but a word *sweeps* it --
  `Unary.structuralOnMagma_img`.
* **`s` neither.** The sweep again, starting from the fixed point the branch guarantees.

    x □ y := if s² x = x then if y = x then x else if s y = x then x else s x else if s y = x then
      s x else x
      id RPROJ, inv PAIR, deep IMG, mix IMG  (15 targets, 2,052 cells)

    x □ y := if y = x then x else if s y = x then x else if s³ y = x then x else s x
      id RPROJ, inv PAIR, deep IMG, mix IMG  (1 targets, 108 cells)

    x □ y := if y = x then x else if s² y = x then s² x else if s³ y = x then s x else s y
      id RPROJ, inv PAIR, deep IMG, mix IMG  (1 targets, 108 cells)

Generated by `defwork/emitfine463.py`; the trees and the branch assignment come from
`defwork/unaryfine463.py`. The proofs live in `UnaryFine463_*.lean`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace UnaryFine463

variable {G : Type} (M : Magma G)

-- the reverse-half lemmas pick their existential witness with a `first` chain, and every branch
-- but the one that fires is dead code by construction
set_option linter.unreachableTactic false
set_option linter.unusedTactic false
-- several of the branch lemmas hold without their branch hypothesis
set_option linter.unusedVariables false

/-- `x □ y := if s² x = x then if y = x then x else if s y = x then x else s x else if s y = x
then s x else x`. -/
def t0 : QFOp :=
  .ite ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0)) (Lf 0)
        (.ite (Lf 1) (Lf 0)
          (.leaf (Lf 0))
          (.ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 0)) (.leaf (Lf 0 ⋆ Lf 0))))
        (.ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0)))

open scoped Classical in
theorem t0_apply (a b : G) :
    (t0.magma M).op a b =
      if M.op (M.op a a) (M.op a a) = a then
        if b = a then a else if M.op b b = a then a else M.op a a
      else if M.op b b = a then M.op a a
      else a := by
  show @QFOp.eval _ M t0 ![a, b] = _
  simp only [t0, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` moves every point and squares to the identity, `y = (y □ w)` holds exactly at `z =
y` and `z = s y`. -/
theorem t0_inv (h : Equation463 G) (hf : ∀ v : G, M.op v v ≠ v)
    (hin : ∀ v : G, M.op (M.op v v) (M.op v v) = v) (y z : G) :
    @evalInMagma _ _ (t0.magma M) ![y, z] (Lf 0)
        = @evalInMagma _ _ (t0.magma M) ![y, z] (Lf 0 ⋆ Lf 1)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary463.name_s M h
  show y = (t0.magma M).op y z ↔ _
  simp only [t0_apply M, hs] at hf hin ⊢
  grind (splits := 24)

/-- Where `s` moves every point and does not square to the identity, `(y □ w)` sweeps exactly `{y,
s y}`. -/
theorem t0_deep (h : Equation463 G) (hf : ∀ v : G, M.op v v ≠ v)
    (hdp : ∃ v : G, M.op (M.op v v) (M.op v v) ≠ v) (y z : G) :
    (∃ p : G, @evalInMagma _ _ (t0.magma M) ![y, p] (Lf 0 ⋆ Lf 1) = z)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary463.name_s M h
  obtain ⟨q₁, hq₁⟩ := hdp
  show (∃ p : G, (t0.magma M).op y p = z) ↔ _
  simp only [t0_apply M, hs] at hf hq₁ ⊢
  constructor
  · rintro ⟨p, rfl⟩
    grind (splits := 24)
  · intro hz
    rcases hz with hz | hz <;>
      first
        | exact ⟨y, by grind (splits := 24)⟩
        | exact ⟨q₀, by grind (splits := 24)⟩
        | exact ⟨q₁, by grind (splits := 24)⟩
        | exact ⟨s y, by grind (splits := 24)⟩
        | exact ⟨s (s y), by grind (splits := 24)⟩
        | exact ⟨s (s (s y)), by grind (splits := 24)⟩
        | grind (splits := 24)

