import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_19

/-!
# Structurality from `Equation3735` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation3735` is `x ◇ y = (x ◇ z) ◇ (y ◇ x)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = X then m(X,X) else m(X,Y)`
is an automorphism -- is `GuardAut_pxx_x_pxx_pxy_Equation3735`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3663` from `Equation3735`: `x ◇ y = (x ◇ z) ◇ (y ◇ x)` ⊢ `x ◇ x = (x ◇ x) ◇ (y ◇ z)`,
through `x □ y = if m(X,X) = X then m(X,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3663_StructuralFromFin_Equation3735 : Law3663.StructuralFromFin Law3735 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_pxx_pxy_Equation3735 (fun {G} M hM ↦ ?_)
  have hm := (@Law3735.models_iff G M).mp hM
  rw [@Law3663.models_iff G ((AutBox.iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y z
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

