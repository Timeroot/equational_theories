namespace Magma

/-- A member of the class, as the `3` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup8R207 : Type := {w : Fin 3 → Fin 8 // Magma.tupOK S8R207.E S8R207.tr S8R207.z S8R207.st S8R207.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch8R207 (v : tup8R207) : Magma (Fin 8) :=
  Magma.mk (Magma.transport S8R207.E S8R207.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `123` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `64` cells times
the `1152` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch8R2070 : Array Nat := #[0, 0, 4]

def vsrch8R2070 : Magma.tup8R207 :=
  ⟨fun i ↦ ⟨vdsrch8R2070[i.1]! % 8, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch8R2071 : Array Nat := #[0, 1, 0]

def vsrch8R2071 : Magma.tup8R207 :=
  ⟨fun i ↦ ⟨vdsrch8R2071[i.1]! % 8, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `1152`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 8` asks for `4,096` cells. Below
is the same operation as a plain `8 x 8` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch8R207Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch8R2070 : Array (Array Nat) := #[#[0, 0, 0, 0, 4, 5, 6, 7], #[1, 1, 1, 1, 4, 5, 6, 7], #[2, 2, 2, 2, 4, 5, 6, 7], #[3, 3, 3, 3, 4, 5, 6, 7], #[0, 1, 2, 3, 4, 4, 4, 4], #[0, 1, 2, 3, 5, 5, 5, 5], #[0, 1, 2, 3, 6, 6, 6, 6], #[0, 1, 2, 3, 7, 7, 7, 7]]

def opsrch8R2070 (x y : Fin 8) : Fin 8 :=
  ⟨(tdsrch8R2070[x.1]!)[y.1]! % 8, Nat.mod_lt _ (by decide)⟩

theorem htsrch8R2070 :
    ∀ x y, Magma.transport S8R207.E S8R207.tr vsrch8R2070.1 x y = opsrch8R2070 x y := by
  native_decide

theorem esrch8R2070 : Magma.srch8R207 vsrch8R2070 = Magma.mk opsrch8R2070 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch8R2070 x y)

