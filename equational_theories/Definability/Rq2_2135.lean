import equational_theories.Definability.DiagRow

/-!
# `Equation2135` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2135` is `x = ((y ◇ y) ◇ y) ◇ (x ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2135`: `x = ((y ◇ y) ◇ y) ◇ (x ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation2135 : DiagRow.ColQG Law2135 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2135.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op (M.op (M.op u u) u) z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 : G, (M.op (M.op (M.op X1 X1) X1) (M.op X0 X1)) = X0 := by
      intro X0 X1
      grind
    have eq4 : z ≠ (M.op (M.op (M.op (M.op u u) u) z) u) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 : G, (M.op (M.op X1 X1) X1) = (M.op (M.op (M.op (M.op X0 X1) (M.op X0 X1)) (M.op X0 X1)) X0) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op X1 X1) X1) (M.op X0 X1)
         have i₂ := eq3 X0 X1
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq20 : ∀ X0 X1 : G, (M.op (M.op (M.op X1 X0) (M.op X1 X0)) (M.op X1 X0)) = (M.op (M.op (M.op X1 X1) X1) (M.op (M.op X0 X0) X0)) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op (M.op X1 X0) (M.op X1 X0)) (M.op X1 X0)) X1
         have i₂ := eq6 X1 X0
         grind)
      | exact superpose eq6 eq3
      | exact resolve eq3 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq46 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1)) (M.op X2 (M.op X0 X1))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X0 X1)
         have i₂ := eq20 X1 X0
         grind)
      | exact superpose eq20 eq3
      | exact resolve eq3 eq20
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq48 : ∀ X0 X1 : G, (M.op (M.op X0 X1) (M.op X0 X1)) = (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1)) (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X1 X1) X1))) := by
      intro X0 X1
      first
      | (have i₁ := eq3 (M.op (M.op X1 X0) (M.op X1 X0)) (M.op X1 X0)
         have i₂ := eq20 X0 X1
         grind)
      | exact superpose eq20 eq3
      | exact resolve eq3 eq20
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq20
    have eq138 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X0 X0) X0) (M.op X2 (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq46 (M.op (M.op (M.op X1 X1) X1) X0) X1 X2
         have i₂ := eq6 (M.op (M.op X1 X1) X1) X0
         grind)
      | exact superpose eq6 eq46
      | exact resolve eq46 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq46
    have eq1103 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) = (M.op (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1) (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1)) := by
      intro X0 X1
      first
      | (have i₁ := eq48 (M.op (M.op (M.op X1 X1) X1) X1) X1
         have i₂ := eq6 (M.op (M.op X1 X1) X1) X1
         grind)
      | exact superpose eq6 eq48
      | exact resolve eq48 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6 eq48
    have eq1160 : ∀ X0 X1 : G, (M.op X0 X0) = (M.op (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1) (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1)) := by
      intro X0 X1
      first
      | (have i₁ := eq1103 X0 X1
         have i₂ := eq3 (M.op X0 X0) X0
         grind)
      | exact superpose eq3 eq1103
      | exact resolve eq1103 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq1103
    have eq1192 : ∀ X0 X1 : G, (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1) = (M.op (M.op (M.op X0 X0) X0) (M.op X0 X0)) := by
      intro X0 X1
      first
      | (have i₁ := eq138 X0 X1 (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1)
         have i₂ := eq1160 X0 X1
         grind)
      | exact superpose eq1160 eq138
      | exact resolve eq138 eq1160
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq138 eq1160
    have eq1234 : ∀ X0 X1 : G, (M.op (M.op (M.op (M.op X1 X1) X1) X0) X1) = X0 := by
      intro X0 X1
      first
      | (have i₁ := eq1192 X0 X1
         have i₂ := eq3 X0 X0
         grind)
      | exact superpose eq3 eq1192
      | exact resolve eq1192 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq1192
    have eq1311 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq1234 z u
         grind)
      | exact superpose eq1234 eq4
      | (have r₁ := eq4
         have r₂ := eq1234 z u
         grind)
      | exact resolve eq4 eq1234
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq1234
    have eq1312 : False := by grind
    exact eq1312
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u u) u) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op (M.op (M.op X1 X1) X1) (M.op X0 X1)) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq8 : y = (M.op (M.op (M.op x x) x) (M.op x x)) := by
    first
    | (have i₁ := eq4 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq10 : y = x := by
    first
    | (have i₁ := eq8
       have i₂ := eq4 x x
       grind)
    | exact superpose eq4 eq8
    | exact resolve eq8 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq11 : False := by grind
  exact eq11

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2135` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2135 : Law3.StructuralFrom Law2135 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2135
