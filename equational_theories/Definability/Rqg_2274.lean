import equational_theories.Definability.DiagRow

/-!
# `Equation2274` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2274` is `x = (x ◇ (y ◇ (z ◇ x))) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2274`: `x = (x ◇ (y ◇ (z ◇ x))) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2274 : DiagRow.ColQG Law2274 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2274.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op z (M.op u (M.op u z))), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X0 (M.op X1 (M.op X2 X0))) X1) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X0)) X2) = X1 := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 X1 X2 (M.op X0 (M.op X1 (M.op x X0)))
       have i₂ := eq4 X0 X1 x
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X1 X0) (M.op X0 (M.op (M.op X2 X1) (M.op X3 X0)))) = X1 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X1 (M.op X0 (M.op (M.op X2 X1) (M.op X3 X0))) X2
       have i₂ := eq4 X0 (M.op X2 X1) X3
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X1 X0) (M.op X0 (M.op X2 X3))) = X1 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq8 X2 X1 (M.op X0 (M.op X2 X3))
       have i₂ := eq8 X3 X0 X2
       grind)
    | exact superpose eq8 eq8
    | exact resolve eq8 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq23 : ∀ X0 X1 : G, y = (M.op (M.op x x) (M.op x (M.op (M.op X0 y) (M.op X1 x)))) := by
    intro X0 X1
    first
    | (have i₁ := eq9 x y X0 X1
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq9
    | exact resolve eq9 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq48 : y = x := by
    first
    | (have i₁ := eq23 x x
       have i₂ := eq12 x x (M.op x y) (M.op x x)
       grind)
    | exact superpose eq12 eq23
    | exact resolve eq23 eq12
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq12 eq23
  have eq49 : False := by grind
  exact eq49

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2274` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2274 : Law3.StructuralFrom Law2274 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2274
