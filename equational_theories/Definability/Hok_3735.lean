    GuardAut2_pxy_x_x_y_pxx_pxx_x_Equation3735 (fun {G} M hM ↦ ?_)
  have hm := (@Law3735.models_iff G M).mp hM
  rw [@Law1229.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) (Lf 0) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 0)) (Lf 0)).magma M)]
