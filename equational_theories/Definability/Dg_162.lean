import equational_theories.Definability.AutBox
import equational_theories.Definability.SBox_00

/-!
# Structurality from `Equation162` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation162` is `x = (x ◇ y) ◇ (z ◇ x)`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation162`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation825` from `Equation162`: `x = (x ◇ y) ◇ (z ◇ x)` ⊢ `x = x ◇ ((x ◇ y) ◇ (y ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation825_StructuralFromFin_Equation162 : Law825.StructuralFromFin Law162 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation162
    (fun {G} M hM ↦ ?_)
  have hm := (@Law162.models_iff G M).mp hM
  have key : ∀ N : Magma G, (∀ a b : G, a = b ∨ N.op a b = M.op a b) →
      (∀ a : G, N.op a a = a) → @satisfies _ G N Law825 := by
    intro N hne heq
    rw [@Law825.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ (eq_or_ne a b).imp id (QFOp.diagOf_ne (Lf 0) M a b))
    (fun a ↦ ?_)
  rw [QFOp.diagOf_eq (Lf 0) M a a rfl]
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]

