import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_20

/-!
# Structurality from `Equation3744` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation3744` is `x ◇ y = (x ◇ z) ◇ (w ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,Y) = Y then X else m(Y,X)`
is an automorphism -- is `GuardAut_pxy_y_x_pyx_Equation3744`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 5 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation819` from `Equation3744`: `x ◇ y = (x ◇ z) ◇ (w ◇ y)` ⊢ `x = x ◇ ((x ◇ x) ◇ (y ◇ x))`,
through `x □ y = if m(X,Y) = Y then X else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation819_StructuralFromFin_Equation3744 : Law819.StructuralFromFin Law3744 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxy_y_x_pyx_Equation3744 (fun {G} M hM ↦ ?_)
  have hm := (@Law3744.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op a b) ≠ b ∨ N.op a b = a) →
      (∀ a b : G, (M.op a b) = b ∨ N.op a b = (M.op b a)) → @satisfies _ G N Law819 := by
    intro N hthen helse
    rw [@Law819.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a b)) (b)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a b)) (b)).imp id (fun h ↦ if_neg h)

