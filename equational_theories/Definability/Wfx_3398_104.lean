/-- Two models of `Equation3398` on one carrier with the same `(x ◇ (x ◇ (y ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 0 ⋆ (Lf 1 ⋆ Lf 0))) Law3398 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 0 ⋆ (Lf 1 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law3398.models_iff G M).mp hM
  have hn := (@Law3398.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 X1) = (M.op X2 (M.op X1 (M.op X0 X2))) := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 X1) = (N.op X2 (N.op X1 (N.op X0 X2))) := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X1 X0))) = (N.op X0 (N.op X0 (N.op X1 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq16 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X1 X0))) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq6 X1 X0 X0
       have i₂ := eq7 X0 X1
       grind)
    | exact superpose eq7 eq6
    | exact resolve eq6 eq7
    | grind
    | grind (splits := 40)
  have eq21 : ∀ X0 X1 : G, (M.op X1 X0) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq16 X0 X1
       have i₂ := eq5 X1 X0 X0
       grind)
    | exact superpose eq5 eq16
    | exact resolve eq16 eq5
    | grind
    | grind (splits := 40)
  clear eq16
  have eq33 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq21 b a
       grind)
    | exact superpose eq21 eq8
    | exact resolve eq8 eq21
    | grind
    | grind (splits := 40)
  clear eq21
  have eq40 : False := by grind
  exact eq40

