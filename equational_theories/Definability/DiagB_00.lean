/-- the companion: `x □ y = if x = y then (x ◇ (x ◇ x)) else x ◇ y` -/
private def qA : QFOp := QFOp.diagOf (Lf 0 ⋆ (Lf 0 ⋆ Lf 0))

private theorem qA_ne {G : Type} (M : Magma G) (a b : G) (h : a ≠ b) :
    (qA.magma M).op a b = M.op a b := QFOp.diagOf_ne _ M a b h

private theorem qA_eq {G : Type} (M : Magma G) (a b : G) (h : a = b) :
    (qA.magma M).op a b = (M.op a (M.op a a)) := by
  refine (QFOp.diagOf_eq (Lf 0 ⋆ (Lf 0 ⋆ Lf 0)) M a b h).trans ?_
  first | rfl | simp [evalInMagma]

private theorem qA_diag {G : Type} (M : Magma G) (a : G) :
    (qA.magma M).op a a = (M.op a (M.op a a)) := qA_eq M a a rfl

