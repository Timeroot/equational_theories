import equational_theories.Definability.DiagRow

/-!
# `Equation1571` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1571` is `x = (y ◇ z) ◇ (y ◇ (x ◇ z))`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1571`: `x = (y ◇ z) ◇ (y ◇ (x ◇ z))`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation1571 : DiagRow.ColQG Law1571 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1571.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op u z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op X1 (M.op X0 X2))) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op u z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op X1 X2) (M.op X3 (M.op X1 (M.op X0 X2))))) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op X1 X2) (M.op X1 (M.op X0 X2))
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq26 : ∀ X0 X1 X2 X3 : G, (M.op X0 (M.op (M.op (M.op X1 X2) (M.op X1 (M.op X3 X2))) X0)) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq5 X0 (M.op X1 X2) (M.op X1 (M.op X3 X2)) X3
         have i₂ := eq5 X3 X1 X2 X0
         grind)
      | exact superpose eq5 eq5
      | exact resolve eq5 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5
    have eq34 : ∀ X0 X3 : G, (M.op X0 (M.op X3 X0)) = X3 := by
      intro X0 X3
      first
      | (have i₁ := eq26 X0 x x X3
         have i₂ := eq3 X3 x x
         grind)
      | exact superpose eq3 eq26
      | exact resolve eq26 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq26
    have eq38 : ∀ X0 X1 : G, (M.op (M.op X0 X1) X0) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq34 (M.op X0 X1) X1
         have i₂ := eq34 X1 X0
         grind)
      | exact superpose eq34 eq34
      | exact resolve eq34 eq34
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq34
    have eq150 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq38 u z
         grind)
      | exact superpose eq38 eq4
      | (have r₁ := eq4
         have r₂ := eq38 u z
         grind)
      | exact resolve eq4 eq38
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq38
    have eq164 : False := by grind
    exact eq164
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X2) (M.op X1 (M.op X0 X2))) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op X0 x) (M.op X0 (M.op x x))) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : y = x := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation1571` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1571 : Law3.StructuralFrom Law1571 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation1571
