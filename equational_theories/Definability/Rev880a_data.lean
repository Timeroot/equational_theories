theorem rev880a_subFacts :
    (∀ k x y, (rev880aSub k (rev880aP 0 k)).op x y = x) ∧
      (∀ k x y, (rev880aSub k (rev880aP 1 k)).op x y = y) ∧
      (∀ k i j l x y, (rev880aSub k (rev880aSc k i j l)).op x y =
        (rev880aSub k i).op ((rev880aSub k j).op x y) ((rev880aSub k l).op x y)) ∧
      ∀ k j, ¬ ∀ x y, (rev880aSub k j).op x y = rev880a.op x y := by
  decideFin!

theorem rev880a_isSubclone (k : Fin 3) : IsSubclone (rev880aSub k) :=
  IsSubclone.of_table (rev880aP 0 k) (rev880aP 1 k) (rev880aSc k)
    (rev880a_subFacts.1 k) (rev880a_subFacts.2.1 k) (rev880a_subFacts.2.2.1 k)

theorem rev880a_notInSub (k : Fin 3) : ¬ InClone (rev880aSub k) rev880a.op :=
  notInClone_of (rev880a_subFacts.2.2.2 k)

