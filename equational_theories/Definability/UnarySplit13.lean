import equational_theories.Definability.Unary13
import equational_theories.Definability.UnaryCore

/-!
# Source 13: the involution, split three ways

`Definability/Unary13.lean` settles the targets reachable by one operation that works on every
model at once. That shape is exhausted, and the 82 targets left over are not short of operations
but short of *uniformity*: on a two-point carrier the swap and the identity induce the same `□` for
all 288 pattern operations, so no single tree can name `s` back across the whole model class.

`StructuralFrom` is proved model by model, so the defining formula is allowed to depend on the
model. Split the involutions on how `s` sits relative to its fixed points:

* **`s = id`.** Then `x ◇ y = y`: the source magma *is* the right projection and `M.Graph` is the
  pure-equality set `z = y`, definable in any structure whatever. The tree is unconstrained, so
  either projection will do -- `Unary.structuralOnMagma_rproj`.
* **`s` fixed-point-free.** A `□`-word equation cuts out the orbit,
  `{w | u(y, w) = y} = {y, s y}`, and one universal quantifier separates its two elements --
  `Unary.structuralOnMagma_pair`.
* **`s` neither.** Now `Fix(s)` and its complement are both nonempty, and the tree can *sweep* the
  orbit rather than cut it out: `{u(y, p) | p} = {y, s y}` -- `Unary.structuralOnMagma_img`.

The two nondegenerate branches want opposite things -- the equation shape needs every point moved,
the image shape needs a fixed point to sweep from -- which is why one tree could never do both.

    x □ y := if y = x then x else if s y = x then x else if s y = y then x else s x
      fpf branch, PAIR `y □ z = y`  (53 targets, 30,016 cells)

    x □ y := if s x = x then y else if y = x then x else if s y = x then s x else s y
      fpf branch, PAIR `z □ y = y`  (29 targets, 14,784 cells)

    x □ y := if s y = y then s x else x
      fix branch, IMG `y □ p`  (53 targets, 30,016 cells)

    x □ y := if s x = x then s y else y
      fix branch, IMG `p □ y`  (29 targets, 14,784 cells)

Generated by `defwork/emitsplit13.py`; the trees and the branch assignment come from
`defwork/ne13.py`. The proofs live in `UnarySplit13_*.lean`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

namespace UnarySplit13

variable {G : Type} (M : Magma G)

/-! ## The degenerate branch

Where `s = id` the source is a projection and its graph needs no `□` at all, so all that is asked
of the tree is that it satisfy the target. Both projections are available. -/

/-- `x □ y := x`. -/
def tl : QFOp :=
  .leaf (Lf 0)

theorem tl_apply (a b : G) : (tl.magma M).op a b = a := by
  show @QFOp.eval _ M tl ![a, b] = _
  simp only [tl, QFOp.eval, evalInMagma, Matrix.cons_val_zero]

/-- `x □ y := y`. -/
def tr : QFOp :=
  .leaf (Lf 1)

theorem tr_apply (a b : G) : (tr.magma M).op a b = b := by
  show @QFOp.eval _ M tr ![a, b] = _
  simp only [tr, QFOp.eval, evalInMagma, Matrix.cons_val_one, Matrix.cons_val_fin_one]

/-! ## The nondegenerate branches -/

/-- `x □ y := if y = x then x else if s y = x then x else if s y = y then x else s x`. -/
def t1 : QFOp :=
  .ite (Lf 1) (Lf 0)
    (.leaf (Lf 0))
    (.ite (Lf 1 ⋆ Lf 1) (Lf 0)
      (.leaf (Lf 0))
      (.ite (Lf 1 ⋆ Lf 1) (Lf 1) (.leaf (Lf 0)) (.leaf (Lf 0 ⋆ Lf 0))))

open scoped Classical in
theorem t1_apply (a b : G) :
    (t1.magma M).op a b =
      if b = a then a else if M.op b b = a then a else if M.op b b = b then a else M.op a a := by
  show @QFOp.eval _ M t1 ![a, b] = _
  simp only [t1, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` moves every point, `y □ z = y` holds exactly at `z = y` and `z = s y`. -/
theorem t1_pair (h : Equation13 G) (hf : ∀ v : G, M.op v v ≠ v) (y z : G) :
    @evalInMagma _ _ (t1.magma M) ![y, z] (Lf 0 ⋆ Lf 1)
        = @evalInMagma _ _ (t1.magma M) ![y, z] (Lf 0)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary13.name_s M h
  show (t1.magma M).op y z = y ↔ _
  simp only [t1_apply M, hs] at hf ⊢
  grind

/-- `x □ y := if s x = x then y else if y = x then x else if s y = x then s x else s y`. -/
def t215 : QFOp :=
  .ite (Lf 0 ⋆ Lf 0) (Lf 0)
    (.leaf (Lf 1))
    (.ite (Lf 1) (Lf 0)
      (.leaf (Lf 0))
      (.ite (Lf 1 ⋆ Lf 1) (Lf 0) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 1 ⋆ Lf 1))))

open scoped Classical in
theorem t215_apply (a b : G) :
    (t215.magma M).op a b =
      if M.op a a = a then b else if b = a then a else if M.op b b = a then M.op a a else M.op b b
      := by
  show @QFOp.eval _ M t215 ![a, b] = _
  simp only [t215, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` moves every point, `z □ y = y` holds exactly at `z = y` and `z = s y`. -/
theorem t215_pair (h : Equation13 G) (hf : ∀ v : G, M.op v v ≠ v) (y z : G) :
    @evalInMagma _ _ (t215.magma M) ![y, z] (Lf 1 ⋆ Lf 0)
        = @evalInMagma _ _ (t215.magma M) ![y, z] (Lf 0)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary13.name_s M h
  show (t215.magma M).op z y = y ↔ _
  simp only [t215_apply M, hs] at hf ⊢
  grind

/-- `x □ y := if s y = y then s x else x`. -/
def t4 : QFOp :=
  .ite (Lf 1 ⋆ Lf 1) (Lf 1) (.leaf (Lf 0 ⋆ Lf 0)) (.leaf (Lf 0))

open scoped Classical in
theorem t4_apply (a b : G) :
    (t4.magma M).op a b = if M.op b b = b then M.op a a else a := by
  show @QFOp.eval _ M t4 ![a, b] = _
  simp only [t4, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` fixes a point and moves another, `y □ p` sweeps exactly `{y, s y}`. -/
theorem t4_img (h : Equation13 G) (hfx : ∃ q : G, M.op q q = q) (hmv : ∃ q : G, M.op q q ≠ q)
    (y z : G) :
    (∃ p : G, @evalInMagma _ _ (t4.magma M) ![y, p] (Lf 0 ⋆ Lf 1) = z)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary13.name_s M h
  obtain ⟨q₀, hq₀⟩ := hfx
  obtain ⟨q₁, hq₁⟩ := hmv
  show (∃ p : G, (t4.magma M).op y p = z) ↔ _
  simp only [t4_apply M, hs] at hq₀ hq₁ ⊢
  constructor
  · rintro ⟨p, rfl⟩
    grind
  · rintro (rfl | rfl)
    · exact ⟨q₁, by grind⟩
    · exact ⟨q₀, by grind⟩

/-- `x □ y := if s x = x then s y else y`. -/
def t262 : QFOp :=
  .ite (Lf 0 ⋆ Lf 0) (Lf 0) (.leaf (Lf 1 ⋆ Lf 1)) (.leaf (Lf 1))

open scoped Classical in
theorem t262_apply (a b : G) :
    (t262.magma M).op a b = if M.op a a = a then M.op b b else b := by
  show @QFOp.eval _ M t262 ![a, b] = _
  simp only [t262, QFOp.eval, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one]

/-- Where `s` fixes a point and moves another, `p □ y` sweeps exactly `{y, s y}`. -/
theorem t262_img (h : Equation13 G) (hfx : ∃ q : G, M.op q q = q) (hmv : ∃ q : G, M.op q q ≠ q)
    (y z : G) :
    (∃ p : G, @evalInMagma _ _ (t262.magma M) ![y, p] (Lf 1 ⋆ Lf 0) = z)
      ↔ (z = y ∨ z = M.op y y) := by
  classical
  obtain ⟨s, hs, hss⟩ := Unary13.name_s M h
  obtain ⟨q₀, hq₀⟩ := hfx
  obtain ⟨q₁, hq₁⟩ := hmv
  show (∃ p : G, (t262.magma M).op p y = z) ↔ _
  simp only [t262_apply M, hs] at hq₀ hq₁ ⊢
  constructor
  · rintro ⟨p, rfl⟩
    grind
  · rintro (rfl | rfl)
    · exact ⟨q₁, by grind⟩
    · exact ⟨q₀, by grind⟩

end UnarySplit13
