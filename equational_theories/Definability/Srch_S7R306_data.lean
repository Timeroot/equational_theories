/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch7R306 (v : tup7R306) : Magma (Fin 7) :=
  Magma.mk (Magma.transport S7R306.E S7R306.tr v.1)

end Magma

