    | grind
    | grind (splits := 40)
  clear eq10
  have eq14 : ∀ X0 : G, (N.op (N.op X0 X0) X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq6 X0 X0 (N.op (N.op x X0) x)
