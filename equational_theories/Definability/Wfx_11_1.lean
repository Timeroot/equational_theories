/-!
# Structurality from `Equation11` through the companion `x □ y = (x ◇ (y ◇ (x ◇ x)))`

Generated by `defwork/wffit.py`.  `Equation11` is `x = x ◇ (y ◇ y)`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation11` on one carrier with the same table of
`(x ◇ (y ◇ (x ◇ x)))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation11` on one carrier with the same `(x ◇ (y ◇ (x ◇ x)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) Law11 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law11.models_iff G M).mp hM
  have hn := (@Law11.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X1)) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 (N.op X1 X1)) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op X0 X0))) = (N.op X0 (N.op X1 (N.op X0 X0))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq12 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op X1 X1))) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq6 X0 X1
       grind)
    | exact superpose eq6 eq7
    | exact resolve eq7 eq6
    | grind
    | grind (splits := 40)
  have eq19 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq12 X0 X1
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq12
    | exact resolve eq12 eq5
    | grind
    | grind (splits := 40)
  clear eq12
  have eq36 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq19 b a
       grind)
    | exact superpose eq19 eq8
    | exact resolve eq8 eq19
    | grind
    | grind (splits := 40)
  clear eq19
  have eq37 : False := by grind
  exact eq37

/-- `Equation820` from `Equation11`: `x = x ◇ (y ◇ y)` ⊢ `x = x ◇ ((x ◇ x) ◇ (y ◇ y))`,
through the companion `x □ y = (x ◇ (y ◇ (x ◇ x)))`. -/
theorem Equation820_StructuralFromFin_Equation11 : Law820.StructuralFromFin Law11 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law11.models_iff G M).mp hM
  rw [@Law820.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ (Lf 0 ⋆ Lf 0)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

