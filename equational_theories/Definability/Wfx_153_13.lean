/-- Two models of `Equation153` on one carrier with the same `(x ◇ ((y ◇ y) ◇ (x ◇ y)))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 0 ⋆ Lf 1))) Law153 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law153.models_iff G M).mp hM
  have hn := (@Law153.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op (M.op X0 X0) (M.op X1 X0)) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op (N.op X0 X0) (N.op X1 X0)) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op (M.op X1 X1) (M.op X0 X1))) = (N.op X0 (N.op (N.op X1 X1) (N.op X0 X1))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq16 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 (M.op (M.op X0 X0) (M.op X1 X0))) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq6 X0 X1
       grind)
    | exact superpose eq6 eq7
    | exact resolve eq7 eq6
    | grind
    | grind (splits := 40)
  have eq19 : ∀ X0 X1 : G, (M.op X1 X0) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq16 X0 X1
       have i₂ := eq5 X0 X1
       grind)
    | exact superpose eq5 eq16
    | exact resolve eq16 eq5
    | grind
    | grind (splits := 40)
  clear eq16
  have eq38 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq19 b a
       grind)
    | exact superpose eq19 eq8
    | exact resolve eq8 eq19
    | grind
    | grind (splits := 40)
  clear eq19
  have eq46 : False := by grind
  exact eq46

/-- `Equation3258` from `Equation153`: `x = (x ◇ x) ◇ (y ◇ x)` ⊢ `x ◇ x = x ◇ (y ◇ (x ◇ x))`,
through the companion `x □ y = (x ◇ ((y ◇ y) ◇ (x ◇ y)))`. -/
theorem Equation3258_StructuralFromFin_Equation153 : Law3258.StructuralFromFin Law153 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 0 ⋆ Lf 1))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law153.models_iff G M).mp hM
  rw [@Law3258.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ ((Lf 1 ⋆ Lf 1) ⋆ (Lf 0 ⋆ Lf 1)))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

