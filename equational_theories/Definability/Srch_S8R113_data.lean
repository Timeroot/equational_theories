namespace Magma

/-- A member of the class, as the `4` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup8R113 : Type := {w : Fin 4 → Fin 8 // Magma.tupOK S8R113.E S8R113.tr S8R113.z S8R113.st S8R113.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch8R113 (v : tup8R113) : Magma (Fin 8) :=
  Magma.mk (Magma.transport S8R113.E S8R113.tr v.1)

end Magma

