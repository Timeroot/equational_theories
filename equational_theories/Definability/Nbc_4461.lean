/-- `Equation820` from `Equation4461`: `x ◇ (y ◇ x) = (z ◇ z) ◇ y` ⊢ `x = x ◇ ((x ◇ x) ◇ (y ◇ y))`,
through `x □ y = if (M.op a a) = b then a else if (M.op b b) = b then a else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation820_StructuralFromFin_Equation4461 : Law820.StructuralFromFin Law4461 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pxx_y_pyy_y_x_x_pyx_Equation4461 (fun {G} M hM ↦ ?_)
  have hm := (@Law4461.models_iff G M).mp hM
  rw [@Law820.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

