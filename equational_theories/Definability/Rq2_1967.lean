import equational_theories.Definability.DiagRow

/-!
# `Equation1967` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation1967` is `x = (y ◇ (z ◇ x)) ◇ (z ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1967`: `x = (y ◇ (z ◇ x)) ◇ (z ◇ y)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation1967 : DiagRow.RowQG Law1967 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law1967.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op u (M.op u (M.op u z))) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X0)) (M.op X2 X1)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op u (M.op u (M.op u z)))) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X2 (M.op X1 (M.op X2 X0)))) = X1 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X1 (M.op X1 (M.op X2 X0)) X2
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq11 : ∀ X0 X1 : G, (M.op (M.op X1 X0) X0) = X1 := by
      intro X0 X1
      first
      | (have i₁ := eq6 (M.op X1 X0) X1 X0
         have i₂ := eq6 X0 X0 X1
         grind)
      | exact superpose eq6 eq6
      | exact resolve eq6 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq44 : ∀ X0 X1 X2 : G, (M.op X0 (M.op X1 (M.op X0 (M.op X1 X2)))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X0 (M.op X1 X2)) X1
         have i₂ := eq11 (M.op X1 X2) X0
         grind)
      | exact superpose eq11 eq3
      | exact resolve eq3 eq11
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq11
    have eq681 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq44 u u z
         grind)
      | exact superpose eq44 eq4
      | (have r₁ := eq4
         have r₂ := eq44 u u z
         grind)
      | exact resolve eq4 eq44
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq44
    have eq682 : False := by grind
    exact eq682
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op u (M.op u z))), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 X0)) (M.op X2 X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, y = (M.op (M.op X0 (M.op x x)) (M.op x X0)) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : x = y := by
    first
    | (have i₁ := eq7 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq7
    | exact resolve eq7 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq13 : False := by grind
  exact eq13

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation1967` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation1967 : Law3.StructuralFrom Law1967 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation1967
