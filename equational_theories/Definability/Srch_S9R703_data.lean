namespace Magma

/-- A member of the class, as the `5` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R703 : Type := {w : Fin 5 → Fin 9 // Magma.tupOK S9R703.E S9R703.tr S9R703.z S9R703.st S9R703.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R703 (v : tup9R703) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R703.E S9R703.tr v.1)

end Magma

