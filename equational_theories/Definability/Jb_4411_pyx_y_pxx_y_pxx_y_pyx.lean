/-!
# Structurality from `Equation4411` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation4411` is `x ◇ (x ◇ y) = (y ◇ z) ◇ x`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b a) = b then (M.op a a) else if (M.op a a) = b then b else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pyx_y_pxx_y_pxx_y_pyx_Equation4411`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3254` from `Equation4411`: `x ◇ (x ◇ y) = (y ◇ z) ◇ x` ⊢ `x ◇ x = x ◇ (x ◇ (x ◇ y))`,
through `x □ y = if (M.op b a) = b then (M.op a a) else if (M.op a a) = b then b else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation3254_StructuralFromFin_Equation4411 : Law3254.StructuralFromFin Law4411 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyx_y_pxx_y_pxx_y_pyx_Equation4411 (fun {G} M hM ↦ ?_)
  have hm := (@Law4411.models_iff G M).mp hM
  rw [@Law3254.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

