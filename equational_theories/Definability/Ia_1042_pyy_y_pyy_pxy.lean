/-!
# Structurality from `Equation1042` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation1042` is `x = x ◇ ((y ◇ (x ◇ z)) ◇ y)`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then m(Y,Y) else m(X,Y)`
is an automorphism -- is `GuardAut_pyy_y_pyy_pxy_Equation1042`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 6 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation307` from `Equation1042`: `x = x ◇ ((y ◇ (x ◇ z)) ◇ y)` ⊢ `x ◇ x = x ◇ (x ◇ x)`,
through `x □ y = if m(Y,Y) = Y then m(Y,Y) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation307_StructuralFromFin_Equation1042 : Law307.StructuralFromFin Law1042 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pyy_y_pyy_pxy_Equation1042 (fun {G} M hM ↦ ?_)
  have hm := (@Law1042.models_iff G M).mp hM
  rw [@Law307.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

