import equational_theories.Definability.AutBox
import equational_theories.Definability.Vdfy_00

/-!
# Structurality from `Equation3296` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation3296` is `x ◇ x = y ◇ (z ◇ (z ◇ x))`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation3296`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 12 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation47` from `Equation3296`: `x ◇ x = y ◇ (z ◇ (z ◇ x))` ⊢ `x = x ◇ (x ◇ (x ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation47_StructuralFromFin_Equation3296 : Law47.StructuralFromFin Law3296 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation3296
    (fun {G} M hM ↦ ?_)
  have hm := (@Law3296.models_iff G M).mp hM
  rw [@Law47.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

