@[reducible] def tup8R54 : Type := {w : Fin 8 → Fin 8 // Magma.tupOK S8R54.E S8R54.tr S8R54.z S8R54.st S8R54.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch8R54 (v : tup8R54) : Magma (Fin 8) :=
  Magma.mk (Magma.transport S8R54.E S8R54.tr v.1)

end Magma

