def opsrch10R3000 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R3000[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R3000 :
    ∀ x y, Magma.transport S10R300.E S10R300.tr vsrch10R3000.1 x y = opsrch10R3000 x y := by
  native_decide

theorem esrch10R3000 : Magma.srch10R300 vsrch10R3000 = Magma.mk opsrch10R3000 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R3000 x y)

