import equational_theories.Definability.DiagRow

/-!
# `Equation2152` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2152` is `x = ((y ◇ y) ◇ z) ◇ (z ◇ x)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2152`: `x = ((y ◇ y) ◇ z) ◇ (z ◇ x)`.  Rows are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem RowQG_Equation2152 : DiagRow.RowQG Law2152 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2152.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op u (M.op (M.op (M.op u u) u) z) = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X1) X2) (M.op X2 X0)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op u (M.op (M.op (M.op u u) u) z)) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op (M.op X1 X1) X0) X2)) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X1 X1) (M.op (M.op X1 X1) X0)
         have i₂ := eq3 X0 X1 (M.op X1 X1)
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq14 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq6 u u z
         grind)
      | exact superpose eq6 eq4
      | (have r₁ := eq4
         have r₂ := eq6 u u z
         grind)
      | exact resolve eq4 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq15 : False := by grind
    exact eq15
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op (M.op u u) u) z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X1) X2) (M.op X2 X0)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hdiv hxy nh hM
  have eq9 : ∀ X0 : G, y = (M.op (M.op (M.op X0 X0) x) (M.op x x)) := by
    intro X0
    first
    | (have i₁ := eq4 y X0 x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq11 : x = y := by
    first
    | (have i₁ := eq9 x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq9
    | exact resolve eq9 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq12 : False := by grind
  exact eq12

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation2152` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2152 : Law3.StructuralFrom Law2152 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation2152
