/-!
# Structurality from `Equation727` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation727` is `x = y ◇ (y ◇ ((z ◇ y) ◇ x))`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if a = b then (M.op a a) else if (M.op b a) = b then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_x_y_pyx_y_pxx_x_pxy_Equation727`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation104` from `Equation727`: `x = y ◇ (y ◇ ((z ◇ y) ◇ x))` ⊢ `x = x ◇ ((y ◇ x) ◇ x)`,
through `x □ y = if a = b then (M.op a a) else if (M.op b a) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation104_StructuralFromFin_Equation727 : Law104.StructuralFromFin Law727 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_x_y_pyx_y_pxx_x_pxy_Equation727 (fun {G} M hM ↦ ?_)
  have hm := (@Law727.models_iff G M).mp hM
  rw [@Law104.models_iff G ((AutBox.iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

