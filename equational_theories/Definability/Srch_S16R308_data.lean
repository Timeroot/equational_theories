def Xinv (j : Fin 2) (x : Fin 16) : Fin 16 := ⟨(Xid[j.1]!)[x.1]! % 16, Nat.mod_lt _ (by decide)⟩

/-- One ordered pair per orbit (3 of them), and for each pair the orbit it lies in together with
a permutation carrying that orbit's representative to it. -/
def repd : Array (Array Nat) := #[#[0, 0], #[0, 1], #[0, 2]]

