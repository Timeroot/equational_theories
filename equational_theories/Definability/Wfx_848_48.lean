/-!
# Structurality from `Equation848` through the companion `x □ y = (x ◇ (y ◇ ((x ◇ x) ◇ (y ◇ y))))`

Generated by `defwork/wffit.py`.  `Equation848` is `x = x ◇ ((y ◇ y) ◇ (z ◇ x))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation848` on one carrier with the same table of
`(x ◇ (y ◇ ((x ◇ x) ◇ (y ◇ y))))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation848` on one carrier with the same `(x ◇ (y ◇ ((x ◇ x) ◇ (y ◇ y))))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ (Lf 1 ⋆ Lf 1)))) Law848 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ (Lf 1 ⋆ Lf 1)))) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law848.models_iff G M).mp hM
  have hn := (@Law848.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X1 X1) (M.op X2 X0))) = X0 := by
    intro X0 X1 X2
    grind
  have eq6 : ∀ X0 X1 X2 : G, (N.op X0 (N.op (N.op X1 X1) (N.op X2 X0))) = X0 := by
    intro X0 X1 X2
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 (M.op (M.op X0 X0) (M.op X1 X1)))) = (N.op X0 (N.op X1 (N.op (N.op X0 X0) (N.op X1 X1)))) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq14 : ∀ X0 X1 : G, (M.op X1 (M.op X0 (M.op (M.op X1 X1) (M.op X0 X0)))) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq6 X0 X1 X0
       grind)
    | exact superpose eq6 eq7
    | exact resolve eq7 eq6
    | grind
    | grind (splits := 40)
  have eq23 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq14 X0 X1
       have i₂ := eq5 X0 X1 X0
       grind)
    | exact superpose eq5 eq14
    | exact resolve eq14 eq5
    | grind
    | grind (splits := 40)
  clear eq14
  have eq34 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq23 b a
       grind)
    | exact superpose eq23 eq8
    | exact resolve eq8 eq23
    | grind
    | grind (splits := 40)
  clear eq23
  have eq44 : False := by grind
  exact eq44

/-- `Equation845` from `Equation848`: `x = x ◇ ((y ◇ y) ◇ (z ◇ x))` ⊢ `x = x ◇ ((y ◇ y) ◇ (y ◇ x))`,
through the companion `x □ y = (x ◇ (y ◇ ((x ◇ x) ◇ (y ◇ y))))`. -/
theorem Equation845_StructuralFromFin_Equation848 : Law845.StructuralFromFin Law848 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ (Lf 1 ⋆ Lf 1)))) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law848.models_iff G M).mp hM
  rw [@Law845.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ ((Lf 0 ⋆ Lf 0) ⋆ (Lf 1 ⋆ Lf 1))))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

