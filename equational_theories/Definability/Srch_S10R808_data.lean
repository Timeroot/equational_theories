namespace Magma

/-- A member of the class, as the `6` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup10R808 : Type := {w : Fin 6 → Fin 10 // Magma.tupOK S10R808.E S10R808.tr S10R808.z S10R808.st S10R808.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch10R808 (v : tup10R808) : Magma (Fin 10) :=
  Magma.mk (Magma.transport S10R808.E S10R808.tr v.1)

end Magma

/-! ### The source exhibits

`3` members of the class, chosen by greedy cover so that between them they model all `28` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `100` cells times
the `400` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch10R8080 : Array Nat := #[0, 0, 6, 0, 1, 7]

def vsrch10R8080 : Magma.tup10R808 :=
  ⟨fun i ↦ ⟨vdsrch10R8080[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch10R8081 : Array Nat := #[0, 0, 5, 0, 1, 4]

def vsrch10R8081 : Magma.tup10R808 :=
  ⟨fun i ↦ ⟨vdsrch10R8081[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch10R8082 : Array Nat := #[0, 0, 8, 0, 1, 9]

def vsrch10R8082 : Magma.tup10R808 :=
  ⟨fun i ↦ ⟨vdsrch10R8082[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `400`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R808Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R8080 : Array (Array Nat) := #[#[0, 0, 0, 6, 0, 3, 8, 0, 5, 0], #[0, 1, 7, 3, 2, 5, 6, 9, 8, 4], #[0, 7, 2, 3, 9, 5, 6, 4, 8, 1], #[6, 3, 3, 3, 3, 8, 5, 3, 0, 3], #[0, 2, 9, 3, 4, 5, 6, 1, 8, 7], #[3, 5, 5, 8, 5, 5, 0, 5, 6, 5], #[8, 6, 6, 5, 6, 0, 6, 6, 3, 6], #[0, 9, 4, 3, 1, 5, 6, 7, 8, 2], #[5, 8, 8, 0, 8, 6, 3, 8, 8, 8], #[0, 4, 1, 3, 7, 5, 6, 2, 8, 9]]

def opsrch10R8080 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R8080[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R8080 :
    ∀ x y, Magma.transport S10R808.E S10R808.tr vsrch10R8080.1 x y = opsrch10R8080 x y := by
  native_decide

theorem esrch10R8080 : Magma.srch10R808 vsrch10R8080 = Magma.mk opsrch10R8080 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R8080 x y)

