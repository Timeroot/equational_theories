/-- `Magma.shift692Data` as bytes, for constant-time indexing. -/
def shift692Bytes : ByteArray := shift692Data.toUTF8

/-- `Magma.shift692Comp` as bytes, for constant-time indexing. -/
def shift692CompBytes : ByteArray := shift692Comp.toUTF8

/-- The `- 48` undoes the ASCII offset and the `%` keeps the index in range without a
proof about the string. -/
private def shift692Digit (p : Nat) : Fin 9 :=
  ⟨((shift692Bytes.get! p).toNat - 48) % 9, Nat.mod_lt _ (by omega)⟩

/-- The clone of `Magma.shift692`, read out of `Magma.shift692Data`. -/
@[implicit_reducible]
def shift692Clone (i : Fin 81) : Magma (Fin 9) :=
  ⟨fun x y ↦ shift692Digit (i.val * 81 + x.val * 9 + y.val)⟩

/-- The composition table, read out of `Magma.shift692Comp`. -/
def shift692Comp' (i j : Fin 81) : Fin 81 :=
  ⟨(((shift692CompBytes.get! (2 * (i.val * 81 + j.val))).toNat - 48) * 9 +
      ((shift692CompBytes.get! (2 * (i.val * 81 + j.val) + 1)).toNat - 48)) % 81,
    Nat.mod_lt _ (by omega)⟩

/-- The three clone-family facts in one `native_decide`. -/
theorem shift692_cloneFacts :
    (∀ x y, (shift692Clone 0).op x y = x) ∧ (∀ x y, (shift692Clone 1).op x y = y) ∧
      ∀ i j x y, (shift692Clone (shift692Comp' i j)).op x y =
        shift692.op ((shift692Clone i).op x y) ((shift692Clone j).op x y) := by
  native_decide

theorem shift692_isCloneFamily :
    shift692.IsCloneFamily shift692Clone 0 1 shift692Comp' :=
  ⟨shift692_cloneFacts.1, shift692_cloneFacts.2.1, shift692_cloneFacts.2.2⟩

/-- Translation by `(1, 0)` in the affine coordinates. -/
def shift692Sigma : Fin 9 → Fin 9 := ![1, 2, 0, 4, 5, 3, 7, 8, 6]

/-- Translation by `(0, 1)` in the affine coordinates. -/
def shift692Tau : Fin 9 → Fin 9 := ![3, 4, 5, 8, 6, 7, 1, 2, 0]

/-- The three maximal proper subclones, as shift invariants. -/
def shift692Q : Fin 3 → (Fin 9 → Fin 9 → Fin 9) → Prop
  | 0 => SplitShift shift692Sigma
  | 1 => RespShift shift692Tau
  | 2 => DiagShift shift692Sigma

/-- Membership in the union of the three, which is exactly the set of clone members that fail to
generate `◇` back. -/
def shift692Good (u : Fin 9 → Fin 9 → Fin 9) : Prop :=
  SplitShift shift692Sigma u ∨ RespShift shift692Tau u ∨ DiagShift shift692Sigma u

instance (u : Fin 9 → Fin 9 → Fin 9) : Decidable (shift692Good u) :=
  inferInstanceAs (Decidable (_ ∨ _ ∨ _))

theorem shift692Q_of_good {u : Fin 9 → Fin 9 → Fin 9} (h : shift692Good u) :
    ∃ k, shift692Q k u := by
  rcases h with h | h | h
  exacts [⟨0, h⟩, ⟨1, h⟩, ⟨2, h⟩]

/-- Each of the three predicates is a clone invariant of any magma satisfying it: this is the whole
content of the certificate, and none of it mentions `692`. -/
theorem shift692Q_isCloneInvariant (k : Fin 3) (N : Magma (Fin 9)) :
    shift692Q k N.op → N.IsCloneInvariant (shift692Q k) := by
  fin_cases k
  · exact fun h ↦ SplitShift.isCloneInvariant h
  · exact fun h ↦ RespShift.isCloneInvariant (by decide) h
  · exact fun h ↦ DiagShift.isCloneInvariant (by decide) h

/-- The diamond itself is in none of the three subclones. -/
theorem shift692_notQ : ∀ k, ¬ shift692Q k shift692.op := by
  intro k
  fin_cases k
  · exact (by decide : ¬ SplitShift shift692Sigma shift692.op)
  · exact (by decide : ¬ RespShift shift692Tau shift692.op)
  · exact (by decide : ¬ DiagShift shift692Sigma shift692.op)

end Magma

