import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_38

/-!
# Structurality from `Equation844` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation844` is `x = x ◇ ((y ◇ y) ◇ (x ◇ z))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = X then m(X,X) else m(Y,X)`
is an automorphism -- is `GuardAut_pxx_x_pxx_pyx_Equation844`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3660` from `Equation844`: `x = x ◇ ((y ◇ y) ◇ (x ◇ z))` ⊢ `x ◇ x = (x ◇ x) ◇ (x ◇ y)`,
through `x □ y = if m(X,X) = X then m(X,X) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3660_StructuralFromFin_Equation844 : Law3660.StructuralFromFin Law844 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pxx_x_pxx_pyx_Equation844 (fun {G} M hM ↦ ?_)
  have hm := (@Law844.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op a a) ≠ a ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, (M.op a a) = a ∨ N.op a b = (M.op b a)) → @satisfies _ G N Law3660 := by
    intro N hthen helse
    rw [@Law3660.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).imp id (fun h ↦ if_neg h)

