import equational_theories.Definability.AutBox
import equational_theories.Definability.Iax_41

/-!
# Structurality from `Equation978` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation978` is `x = y ◇ ((z ◇ z) ◇ (x ◇ y))`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(X,X) = X then m(Y,X) else m(X,Y)`
is an automorphism -- is `GuardAut_pxx_x_pyx_pxy_Equation978`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation1429` from `Equation978`: `x = y ◇ ((z ◇ z) ◇ (x ◇ y))` ⊢ `x = (x ◇ x) ◇ (x ◇ (y ◇ y))`,
through `x □ y = if m(X,X) = X then m(Y,X) else m(X,Y)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation1429_StructuralFromFin_Equation978 : Law1429.StructuralFromFin Law978 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut_pxx_x_pyx_pxy_Equation978 (fun {G} M hM ↦ ?_)
  have hm := (@Law978.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, (M.op a a) ≠ a ∨ N.op a b = (M.op b a)) →
      (∀ a b : G, (M.op a a) = a ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law1429 := by
    intro N hthen helse
    rw [@Law1429.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf_apply ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne ((M.op a a)) (a)).imp id (fun h ↦ if_neg h)

