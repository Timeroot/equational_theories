/-- `Equation3660` from `Equation2571`: `x = (y ◇ ((z ◇ x) ◇ y)) ◇ x` ⊢ `x ◇ x = (x ◇ x) ◇ (x ◇ y)`,
through `x □ y = if (M.op a b) = a then b else if (M.op a b) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation3660_StructuralFromFin_Equation2571 : Law3660.StructuralFromFin Law2571 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxy_x_pxy_y_y_x_pxy_Equation2571 (fun {G} M hM ↦ ?_)
  have hm := (@Law2571.models_iff G M).mp hM
  rw [@Law3660.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 1)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 1) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

