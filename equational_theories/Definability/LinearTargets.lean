    linear_combination (β - 1) * h₁ + (-α) * h₂
  rcases mul_eq_zero.mp key with h | h
  · exact Or.inl h
  · refine Or.inr ?_
    linear_combination (β + 1) * h₁ + (1 - α) * h₂ + (-1) * h

