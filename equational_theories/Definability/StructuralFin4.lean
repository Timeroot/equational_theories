import equational_theories.Definability.StructuralFin3

/-!
# Structural certificates from the *exact* automorphism group on `Fin 4`

`Definability/StructuralFin3.lean` spends the `Aut`-equality obstruction on the two middle
subgroups of `S₃`. At order `4` the subgroup lattice is much richer, and most of its classes are
out of reach: the trivial one would need all `4 ^ 16` tables. One class is exactly as cheap as the
`Fin 3` pair, though, and it is the largest of the enumerable ones — the cyclic group `C₄`
generated by the shift `x ↦ x + 1`.

What makes it cheap is that only two subgroups of `S₄` properly contain `C₄`. A `4`-cycle lies in
no subgroup of order `12` — `A₄` has no element of order `4` — so a subgroup strictly between
`C₄` and `S₄` has order `8`, and the Sylow `2`-subgroup containing a given `C₄` is unique. Both
that dihedral group and `S₄` contain the reflection `x ↦ -x`, so, exactly as on `Fin 3`,

  `Aut(M) = C₄`  ⟺  `M` admits the shift and not the reflection,

and `Magma.cyclic4` of `Definability/Certificates.lean` already enumerates the magmas admitting
the shift, `256` of them, one per first row. `16` of those rows are reflection-symmetric, so
`Magma.cyclic4Exact` below is a family of `240` magmas; `996` equations have such a model and
`3698` do not.

`Definability/Certs/Cyclic4Exact*.lean` records the rectangle.
-/

open Law Law.MagmaLaw

namespace Magma

/-- The `240` magmas on `Fin 4` whose automorphism group is exactly the cyclic group of order `4`,
as a family indexed by the `256` first rows of `Magma.cyclic4`: the `16` reflection-symmetric rows,
which have at least the dihedral group, are redirected onto the row `0, 0, 0, 1`, which is not. -/
@[implicit_reducible]
def cyclic4Exact (a b c d : Fin 4) : Magma (Fin 4) :=
  if (cyclic4 a b c d).IsEndo ⇑(Equiv.neg (Fin 4)) then cyclic4 0 0 0 1 else cyclic4 a b c d

theorem cyclic4Exact_isEndo_addRight (a b c d : Fin 4) :
    (cyclic4Exact a b c d).IsEndo ⇑(Equiv.addRight (1 : Fin 4)) := by
  revert a b c d; decide

theorem cyclic4Exact_not_isEndo_neg (a b c d : Fin 4) :
    ¬ (cyclic4Exact a b c d).IsEndo ⇑(Equiv.neg (Fin 4)) := by
  revert a b c d; decide

/-- A magma on `Fin 4` admitting the cyclic shift but not the reflection *is* the member of
`Magma.cyclic4Exact` named by its first row. -/
theorem cyclic4Exact_eq_self {M : Magma (Fin 4)}
    (h₁ : M.IsEndo ⇑(Equiv.addRight (1 : Fin 4))) (h₂ : ¬ M.IsEndo ⇑(Equiv.neg (Fin 4))) :
    cyclic4Exact (M.op 0 0) (M.op 0 1) (M.op 0 2) (M.op 0 3) = M := by
  have key : cyclic4 (M.op 0 0) (M.op 0 1) (M.op 0 2) (M.op 0 3) = M := by
    obtain ⟨op⟩ := M
    refine congrArg Magma.mk (funext fun x ↦ funext fun y ↦ ?_)
    calc ![op 0 0, op 0 1, op 0 2, op 0 3] (y - x) + x
        = op 0 (y - x) + x := by
          congr 1
          generalize y - x = t
          fin_cases t <;> rfl
      _ = op x y := (Magma.op_eq_of_isEndo_add_one h₁ x y).symm
  simp only [cyclic4Exact, key, if_neg h₂]

end Magma

namespace Law.MagmaLaw

/-- **Exact-`C₄` certificate on `Fin 4`.** If `L'` has a model on `Fin 4` whose automorphism group
is exactly the cyclic group generated by `x ↦ x + 1`, and no such magma satisfies `L`, then `L` is
not structural from `L'`, not even over finite carriers. -/
theorem not_structuralFromFin_of_cyclic4Exact {L L' : Law.NatMagmaLaw} {a b c d : Fin 4}
    (hsrc : @satisfies _ (Fin 4) (Magma.cyclic4Exact a b c d) L')
    (htgt : ∀ a b c d : Fin 4, ¬ @satisfies _ (Fin 4) (Magma.cyclic4Exact a b c d) L) :
    ¬ L.StructuralFromFin L' := by
  intro h
  obtain ⟨M', hM', hfwd, hback⟩ := h (Magma.cyclic4Exact a b c d) hsrc
  have h₁ : M'.IsEndo ⇑(Equiv.addRight (1 : Fin 4)) :=
    (Magma.cyclic4Exact_isEndo_addRight a b c d).of_definable hfwd
  have h₂ : ¬ M'.IsEndo ⇑(Equiv.neg (Fin 4)) := fun hn ↦
    Magma.cyclic4Exact_not_isEndo_neg a b c d (hn.of_definable hback)
  refine htgt (M'.op 0 0) (M'.op 0 1) (M'.op 0 2) (M'.op 0 3) ?_
  rw [Magma.cyclic4Exact_eq_self h₁ h₂]
  exact hM'

end Law.MagmaLaw
