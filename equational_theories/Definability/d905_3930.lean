import equational_theories.Definability.AutBox
import equational_theories.Definability.DFn_3930

/-!
# Structurality from `Equation3930` through a repaired diagonal

Generated by `defwork/dcell.py`.  `Equation3930` is `x ◇ y = (x ◇ (y ◇ z)) ◇ x`.  Its diagonal obligation --
an off-diagonal automorphism of a finite model is an automorphism -- is `DiagFix_Equation3930`,
proved elsewhere for a different cell.  That obligation names no target, so every law the repaired
companion satisfies is another cell for free, and there are 2 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3714` from `Equation3930`: `x ◇ y = (x ◇ (y ◇ z)) ◇ x` ⊢ `x ◇ y = (x ◇ x) ◇ (y ◇ x)`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation3714_StructuralFromFin_Equation3930 : Law3714.StructuralFromFin Law3930 := by
  classical
  refine AutBox.structuralFromFin_diagOf (Lf 0) DiagFix_Equation3930
    (fun {G} M hM ↦ ?_)
  have hm := (@Law3930.models_iff G M).mp hM
  rw [@Law3714.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

/-- `Equation4433` from `Equation3930`: `x ◇ y = (x ◇ (y ◇ z)) ◇ x` ⊢ `x ◇ (y ◇ x) = (x ◇ x) ◇ y`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation4433_StructuralFromFin_Equation3930 : Law4433.StructuralFromFin Law3930 := by
