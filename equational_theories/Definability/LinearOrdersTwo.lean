import equational_theories.Definability.LinearOrdersHalf

/-!
# The last cells, from `2` not being a unit

One block of the board is reached by exactly one linear model, `x ◇ y = (-θ ^ 2 - 1) x + θ y` over
`ℤ[θ]` with `θ ^ 3 + θ = 1`, and only for the target `3272`. That target normally wants `h₃` -- the
integer `3` outside the ideal generated by the coefficient modulus `c = -θ ^ 2 + θ - 2` -- but here
`3 / c = -(θ + 1)` is an algebraic integer, so `3` *is* in `(c)` and `h₃` is false.

`Magma.linFam_not_3272'` is the way around it: the branch `h₃` was closing is `2 s + 1 = 0` for the
coefficient sum `s`, which says `2` is a unit, and that has nothing to do with `c`. Killing it needs
only a ring map out of `ℤ[θ]` in which `2` vanishes and `1` does not, and `ℤ[θ] / (2) = F_8` is one,
built exactly as the residue fields of `Definability/LinearOrdersFF.lean` are. The ring and the
other two facts, `hc` and `hP`, are already in `CubicC`.

Being a clone argument over an infinite model, the certificate refutes `TermDefinableFrom`, and
only over all magmas.
-/

open Law Law.MagmaLaw Polynomial

noncomputable section

namespace CubicC

/-- The reduction of `q = X ^ 3 + X - 1` modulo `2`. -/
abbrev g₂ : (ZMod 2)[X] := X ^ 3 + X + 1

/-- The residue field `ℤ[θ] / (2) = F_8`. As in `Definability/LinearOrdersFF.lean`, nothing here
needs `g₂` irreducible -- only `1 ≠ 0`. -/
abbrev F₂ : Type := AdjoinRoot g₂

instance : Nontrivial F₂ :=
  AdjoinRoot.nontrivial g₂
    (by rw [show (X ^ 3 + X + 1 : (ZMod 2)[X]).degree = 3 by compute_degree!]; decide)

/-- The image of `θ`, a root of `g₂`. -/
abbrev ph₂ : F₂ := AdjoinRoot.root g₂

theorem hg₂ : ph₂ ^ 3 + ph₂ + 1 = 0 := by
  have h := AdjoinRoot.eval₂_root g₂
  simp only [g₂, eval₂_add, eval₂_pow, eval₂_X, eval₂_one] at h
  linear_combination h

theorem hchar₂ : (2 : F₂) = 0 := by
  calc (2 : F₂) = AdjoinRoot.of g₂ 2 := (map_ofNat (AdjoinRoot.of g₂) 2).symm
    _ = 0 := by rw [show (2 : ZMod 2) = 0 by decide, map_zero]

/-- Reduction to `F_8`, sending `θ` to `φ₂`. -/
def f8 : R →+* F₂ :=
  AdjoinRoot.lift ((AdjoinRoot.of g₂).comp (Int.castRingHom (ZMod 2))) ph₂
    (by
      simp only [q, eval₂_sub, eval₂_add, eval₂_pow, eval₂_X, eval₂_one]
      linear_combination hg₂ - hchar₂)

@[simp] theorem f8_th : f8 th = ph₂ := by simp [f8]

/-- `2` is not a unit: it dies in `F_8`, where `1` does not. -/
theorem hc₂ (x : R) : (1 : R) + 2 * x ≠ 0 :=
  Magma.add_mul_ne_zero_of_hom f8 1 2 (by rw [map_ofNat]; exact hchar₂)
    (by rw [map_one]; exact one_ne_zero) x

end CubicC

end
