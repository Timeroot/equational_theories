/-- `Magma.bigCert1Data` as bytes, for constant-time indexing. -/
def bigCert1Bytes : ByteArray := bigCert1Data.toUTF8

/-- `Magma.bigCert1Comp` as bytes, for constant-time indexing. -/
def bigCert1CompBytes : ByteArray := bigCert1Comp.toUTF8

/-- The `%` keeps the index in range without a proof about the string. -/
private def bigCert1Digit (p : Nat) : Fin 6 :=
  ⟨(bigCert1Bytes.get! p).toNat % 6, Nat.mod_lt _ (by omega)⟩

/-- The clone of `Magma.bigCert1`, read out of `Magma.bigCert1Data`. -/
@[implicit_reducible]
def bigCert1Clone (i : Fin 1304) : Magma (Fin 6) :=
  ⟨fun x y ↦ bigCert1Digit (i.val * 36 + x.val * 6 + y.val)⟩

/-- The composition table, read out of `Magma.bigCert1Comp`. -/
def bigCert1Comp' (i j : Fin 1304) : Fin 1304 :=
  ⟨(((bigCert1CompBytes.get! (2 * (i.val * 1304 + j.val))).toNat - 48) * 40 +
      ((bigCert1CompBytes.get! (2 * (i.val * 1304 + j.val) + 1)).toNat - 48)) % 1304,
    Nat.mod_lt _ (by omega)⟩

/-- The three clone-family facts in one `native_decide`: each call recompiles the module, and the
module carries megabytes of string, so the calls are what the build time is made of. -/
theorem bigCert1_cloneFacts :
    (∀ x y, (bigCert1Clone 0).op x y = x) ∧ (∀ x y, (bigCert1Clone 1).op x y = y) ∧
      ∀ i j x y, (bigCert1Clone (bigCert1Comp' i j)).op x y =
        bigCert1.op ((bigCert1Clone i).op x y) ((bigCert1Clone j).op x y) := by
  native_decide

theorem bigCert1_isCloneFamily :
    bigCert1.IsCloneFamily bigCert1Clone 0 1 bigCert1Comp' :=
  ⟨bigCert1_cloneFacts.1, bigCert1_cloneFacts.2.1, bigCert1_cloneFacts.2.2⟩

end Magma

theorem bigCert1_satisfies_3352 : @Equation3352 (Fin 6) Magma.bigCert1 := by decide!

/-- No member of the clone satisfies any of the targets, again in one call. -/
theorem bigCert1_refutes :
    ∀ i, ¬ @Equation335 (Fin 6) (Magma.bigCert1Clone i) ∧
      ¬ @Equation3558 (Fin 6) (Magma.bigCert1Clone i) ∧
      ¬ @Equation3748 (Fin 6) (Magma.bigCert1Clone i) ∧
      ¬ @Equation4290 (Fin 6) (Magma.bigCert1Clone i) := by native_decide

theorem bigCert1_refutes_335 :
    ∀ i, ¬ @Equation335 (Fin 6) (Magma.bigCert1Clone i) := fun i ↦ (bigCert1_refutes i).1

theorem bigCert1_refutes_3558 :
    ∀ i, ¬ @Equation3558 (Fin 6) (Magma.bigCert1Clone i) := fun i ↦ (bigCert1_refutes i).2.1

theorem bigCert1_refutes_3748 :
    ∀ i, ¬ @Equation3748 (Fin 6) (Magma.bigCert1Clone i) := fun i ↦ (bigCert1_refutes i).2.2.1

theorem bigCert1_refutes_4290 :
    ∀ i, ¬ @Equation4290 (Fin 6) (Magma.bigCert1Clone i) := fun i ↦ (bigCert1_refutes i).2.2.2


theorem Equation335_not_termDefinableFromFin_Equation3352 :
    ¬ Law335.TermDefinableFromFin Law3352 :=
  not_termDefinableFromFin_of_clone Magma.bigCert1
    ((@Law3352.models_iff (Fin 6) Magma.bigCert1).mpr bigCert1_satisfies_3352)
    Magma.bigCert1_isCloneFamily fun i h ↦ bigCert1_refutes_335 i
      ((@Law335.models_iff (Fin 6) (Magma.bigCert1Clone i)).mp h)

