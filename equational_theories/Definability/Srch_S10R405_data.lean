namespace Magma

/-- A member of the class, as the `4` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup10R405 : Type := {w : Fin 4 → Fin 10 // Magma.tupOK S10R405.E S10R405.tr S10R405.z S10R405.st S10R405.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch10R405 (v : tup10R405) : Magma (Fin 10) :=
  Magma.mk (Magma.transport S10R405.E S10R405.tr v.1)

end Magma

/-! ### The source exhibits

`2` members of the class, chosen by greedy cover so that between them they model all `88` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `native_decide` rather than `decide` because the invariance test is `100` cells times
the `320` group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch10R4050 : Array Nat := #[0, 0, 6, 0]

def vsrch10R4050 : Magma.tup10R405 :=
  ⟨fun i ↦ ⟨vdsrch10R4050[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩

def vdsrch10R4051 : Array Nat := #[0, 1, 7, 6]

def vsrch10R4051 : Magma.tup10R405 :=
  ⟨fun i ↦ ⟨vdsrch10R4051[i.1]! % 10, Nat.mod_lt _ (by decide)⟩, by native_decide⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `320`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 10` asks for `10,000` cells.
Below is the same operation as a plain `10 x 10` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch10R405Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch10R4050 : Array (Array Nat) := #[#[0, 0, 6, 0, 6, 6, 0, 6, 0, 0], #[1, 1, 1, 1, 3, 3, 1, 1, 3, 3], #[7, 2, 2, 2, 2, 2, 7, 2, 7, 7], #[3, 3, 3, 3, 1, 1, 3, 3, 1, 1], #[5, 5, 4, 5, 4, 4, 5, 4, 4, 4], #[4, 4, 5, 4, 5, 5, 4, 5, 5, 5], #[6, 6, 0, 6, 0, 0, 6, 0, 6, 6], #[2, 7, 7, 7, 7, 7, 2, 7, 2, 2], #[8, 9, 9, 9, 8, 8, 8, 9, 8, 8], #[9, 8, 8, 8, 9, 9, 9, 8, 9, 9]]

def opsrch10R4050 (x y : Fin 10) : Fin 10 :=
  ⟨(tdsrch10R4050[x.1]!)[y.1]! % 10, Nat.mod_lt _ (by decide)⟩

theorem htsrch10R4050 :
    ∀ x y, Magma.transport S10R405.E S10R405.tr vsrch10R4050.1 x y = opsrch10R4050 x y := by
  native_decide

theorem esrch10R4050 : Magma.srch10R405 vsrch10R4050 = Magma.mk opsrch10R4050 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch10R4050 x y)

