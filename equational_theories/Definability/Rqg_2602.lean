import equational_theories.Definability.DiagRow

/-!
# `Equation2602` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2602` is `x = (y ◇ ((z ◇ z) ◇ x)) ◇ y`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2602`: `x = (y ◇ ((z ◇ z) ◇ x)) ◇ y`.  Columns are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem ColQG_Equation2602 : DiagRow.ColQG Law2602 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2602.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op u u) z)), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op (M.op X2 X2) X0)) X1) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 X1 X2 : G, (M.op (M.op X2 X2) X0) = (M.op (M.op X1 X0) X1) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op (M.op X2 X2) X0) X1 (M.op (M.op X2 X2) X0)
       have i₂ := eq4 X0 (M.op (M.op X2 X2) X0) X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq13 : ∀ X0 : G, (M.op (M.op X0 X0) x) = (M.op (M.op x x) y) := by
    intro X0
    first
    | (have i₁ := eq7 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq7
    | exact resolve eq7 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq205 : ∀ X0 X1 : G, y = (M.op (M.op X1 (M.op (M.op X0 X0) x)) X1) := by
    intro X0 X1
    first
    | (have i₁ := eq4 y X1 x
       have i₂ := eq13 X0
       grind)
    | exact superpose eq13 eq4
    | exact resolve eq4 eq13
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq13
  have eq212 : y = x := by
    first
    | (have i₁ := eq205 x x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq205
    | exact resolve eq205 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq205
  have eq220 : False := by grind
  exact eq220

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2602` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2602 : Law3.StructuralFrom Law2602 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2602
