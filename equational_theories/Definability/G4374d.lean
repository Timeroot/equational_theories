/-! ### The operations

Each is a decision tree over `t x`, `t y`, `x = y`, `x ◇ x = x` and `y ◇ y = y`, whose leaves are
words in `x` and `y`. The three facts a tree has to satisfy are that its values stay in `T`, that
it keeps `γ` on the diagonal of `T`, and how it reads the columns of `S`; `gker_image` turns those
into the whole reverse read. -/

section Ops

variable (M : Magma G) (K : GKer M)

/-! #### Operation `9428500`

60 cells, in 1 rows of the open list over 1 sources.  Its diagonal of `S` is read `tcol`, its
columns direct on `T × S` and direct on `S × S`. -/

/-- The tree of operation `9428500`. -/
def q9428500 : EOp :=
  .ite (.mem (Lf 1))
    (.ite (.eq (Lf 1 ⋆ Lf 1) (Lf 1))
      (.ite (.eq (Lf 0 ⋆ Lf 0) (Lf 0)) (.leaf (Lf 1)) (.leaf (Lf 0 ⋆ Lf 0)))
      (.leaf (Lf 0 ⋆ Lf 0)))
    (.ite (.eq (Lf 0) (Lf 1)) (.leaf ((Lf 0 ⋆ Lf 0) ⋆ (Lf 0 ⋆ Lf 0))) (.leaf (Lf 0 ⋆ Lf 1)))

open scoped Classical in
theorem q9428500_apply (a b : G) :
    (q9428500.magma M).op a b =
      if K.t b then
        if M.op b b = b then if M.op a a = a then b else M.op a a else M.op a a
      else if a = b then M.op (M.op a a) (M.op a a) else M.op a b := by
  show @EOp.eval _ M q9428500 ![a, b] = _
  simp only [q9428500, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    gtimex M K]

include K in
theorem q9428500_diag (y : G) (hy : K.t y) : (q9428500.magma M).op y y = M.op y y := by
  classical
  rw [q9428500_apply M K]
  have h2 : ∀ p q : G, K.t (M.op p q) := K.tim
  have h3 : ∀ p q : G, K.t q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
open scoped Classical in
/-- The tree on a right argument that is already in `T` -- which every product is, so this is what
a *nested* application reads, and it never has to look at the inner tree at all. -/
theorem q9428500_tb (a b : G) (hb : K.t b) :
    (q9428500.magma M).op a b =
      if M.op b b = b then if M.op a a = a then b else M.op a a else M.op a a := by
  rw [q9428500_apply M K, if_pos hb]

include K in
theorem q9428500_le (a b : G) : K.t ((q9428500.magma M).op a b) := by
  classical
  rw [q9428500_apply M K]
  have h2 : ∀ p q : G, K.t (M.op p q) := K.tim
  split_ifs <;> grind

include K in
theorem q9428500_dd (x c : G) (hx : ¬ K.t x) (hc : K.t c) :
    (q9428500.magma M).op x c = M.op x x := by
  classical
  rw [q9428500_apply M K]
  have h2 : ∀ p q : G, K.t (M.op p q) := K.tim
  have h3 : ∀ p q : G, K.t q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
theorem q9428500_out (x y : G) (hy : ¬ K.t y) (hxy : x ≠ y) :
    (q9428500.magma M).op x y = M.op x y := by
  classical
  rw [q9428500_apply M K]
  have h2 : ∀ p q : G, K.t (M.op p q) := K.tim
  have h3 : ∀ p q : G, K.t q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
/-- The whole of `StructuralOnMagma` for operation `9428500`, bar the law itself. -/
theorem structural_q9428500 {β : Type*} {L : Law.MagmaLaw β}
    (hL : @satisfies _ G (q9428500.magma M) L) : L.StructuralOnMagma M :=
  structuralOn_tcolGamma M K q9428500 hL (q9428500_le M K) (q9428500_diag M K)
    (q9428500_dd M K) (q9428500_out M K)

