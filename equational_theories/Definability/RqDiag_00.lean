        have eq27 (X1 X2 : G) : ((X1 ◇ X2) ◇ X2) = X1 := by first | exact superpose eq7 eq17 | exact mod_symm (superpose eq7 eq17) | exact superpose eq17 eq7 | exact mod_symm (superpose eq17 eq7)
