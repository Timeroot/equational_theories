/-!
# Structurality from `Equation4520` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation4520` is `x ◇ (y ◇ z) = (x ◇ w) ◇ z`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if a = b then (M.op a a) else if (M.op b a) = b then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_x_y_pyx_y_pxx_x_pxy_Equation4520`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 3 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation107` from `Equation4520`: `x ◇ (y ◇ z) = (x ◇ w) ◇ z` ⊢ `x = x ◇ ((y ◇ y) ◇ x)`,
through `x □ y = if a = b then (M.op a a) else if (M.op b a) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation107_StructuralFromFin_Equation4520 : Law107.StructuralFromFin Law4520 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_x_y_pyx_y_pxx_x_pxy_Equation4520 (fun {G} M hM ↦ ?_)
  have hm := (@Law4520.models_iff G M).mp hM
  have key : ∀ N : Magma G,
      (∀ a b : G, a ≠ b ∨ N.op a b = (M.op a a)) →
      (∀ a b : G, a = b ∨ (M.op b a) ≠ b ∨ N.op a b = a) →
      (∀ a b : G, a = b ∨ (M.op b a) = b ∨ N.op a b = (M.op a b)) → @satisfies _ G N Law107 := by
    intro N h1 h2 h3
    rw [@Law107.models_iff G N]
    intro x y
    first
      | (grind)
      | (grind (splits := 30) (ematch := 20))
      | (grind (splits := 60) (ematch := 40))
  refine key _ (fun a b ↦ ?_) (fun a b ↦ ?_) (fun a b ↦ ?_)
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).symm.imp id (fun h ↦ if_pos h)
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).imp id (fun h ↦
      (eq_or_ne ((M.op b a)) (b)).symm.imp id (fun h' ↦ (if_neg h).trans (if_pos h')))
  · rw [AutBox.iteOf2_apply (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) (Lf 0) ((Lf 0) ⋆ (Lf 1)) M a b]
    simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
    exact (eq_or_ne (a) (b)).imp id (fun h ↦
      (eq_or_ne ((M.op b a)) (b)).imp id (fun h' ↦ (if_neg h).trans (if_neg h')))

