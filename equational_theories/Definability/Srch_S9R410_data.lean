namespace Magma

/-- A member of the class, as the `7` orbit values it takes together with the proof that they name
one. `Magma.tupOK` is three tests: every orbit value is one the group's action allows, the operation
the tuple builds really is invariant, and no excess permutation is an automorphism of it. -/
@[reducible] def tup9R410 : Type := {w : Fin 7 → Fin 9 // Magma.tupOK S9R410.E S9R410.tr S9R410.z S9R410.st S9R410.X w = true}

/-- The class, as a family of magmas indexed by its own membership test. -/
@[implicit_reducible]
def srch9R410 (v : tup9R410) : Magma (Fin 9) :=
  Magma.mk (Magma.transport S9R410.E S9R410.tr v.1)

end Magma

/-! ### The source exhibits

`1` members of the class, chosen by greedy cover so that between them they model all `8` equations
that have a model in the class at all. Each check is `Magma.tupOK`: the tuple names a member of the
class. It is `decide!` rather than `decide` because the invariance test is `81` cells times the `48`
group elements, which the elaborator will not walk inside its heartbeat limit.
-/

def vdsrch9R4100 : Array Nat := #[4, 4, 7, 7, 7, 7, 7]

def vsrch9R4100 : Magma.tup9R410 :=
  ⟨fun i ↦ ⟨vdsrch9R4100[i.1]! % 9, Nat.mod_lt _ (by decide)⟩, by decide!⟩


/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `48`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R410Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R4100 : Array (Array Nat) := #[#[4, 4, 4, 7, 7, 4, 7, 7, 7], #[6, 6, 6, 7, 7, 6, 7, 7, 7], #[8, 8, 8, 7, 7, 8, 7, 7, 7], #[7, 7, 7, 5, 5, 7, 5, 7, 5], #[7, 7, 7, 0, 0, 7, 0, 7, 0], #[3, 3, 3, 7, 7, 3, 7, 7, 7], #[7, 7, 7, 1, 1, 7, 1, 7, 1], #[7, 7, 7, 7, 7, 7, 7, 7, 7], #[7, 7, 7, 2, 2, 7, 2, 7, 2]]

def opsrch9R4100 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R4100[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R4100 :
    ∀ x y, Magma.transport S9R410.E S9R410.tr vsrch9R4100.1 x y = opsrch9R4100 x y := by
  native_decide

theorem esrch9R4100 : Magma.srch9R410 vsrch9R4100 = Magma.mk opsrch9R4100 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R4100 x y)
