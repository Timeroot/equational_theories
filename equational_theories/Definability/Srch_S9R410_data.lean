def X (j : Fin 2) (x : Fin 9) : Fin 9 := ⟨(Xd[j.1]!)[x.1]! % 9, Nat.mod_lt _ (by decide)⟩

def Xinv (j : Fin 2) (x : Fin 9) : Fin 9 := ⟨(Xid[j.1]!)[x.1]! % 9, Nat.mod_lt _ (by decide)⟩

