import equational_theories.Definability.DiagRow

/-!
# `Equation2170` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2170` is `x = ((y ◇ z) ◇ x) ◇ (z ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2170`: `x = ((y ◇ z) ◇ x) ◇ (z ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation2170 : DiagRow.ColQG Law2170 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2170.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op u z) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X2 X1)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op u z) u) := by grind
    clear hm nh hM
    have eq5 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 X3) (M.op (M.op X2 X1) (M.op (M.op X1 X2) X0))) = X3 := by
      intro X0 X1 X2 X3
      first
      | (have i₁ := eq3 X3 (M.op (M.op X1 X2) X0) (M.op X2 X1)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq6 : ∀ X0 X1 X2 : G, (M.op X2 X1) = (M.op X0 (M.op X0 (M.op X1 X2))) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 (M.op X2 X1) (M.op X1 X2) X0
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq11 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X0) X2) = (M.op X2 (M.op X0 X1)) := by
      intro X0 X1 X2
      first
      | (have i₁ := eq6 X2 X2 (M.op X1 X0)
         have i₂ := eq6 X2 X1 X0
         grind)
      | exact superpose eq6 eq6
      | exact resolve eq6 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq35 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X1)) = X0 := by
      intro X0 X1
      first
      | (have i₁ := eq6 (M.op X1 X0) (M.op X0 X1) X1
         have i₂ := eq5 X1 X0 X1 X0
         grind)
      | exact superpose eq5 eq6
      | exact resolve eq6 eq5
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq5 eq6
    have eq290 : z ≠ (M.op u (M.op z u)) := by
      first
      | (have i₁ := eq4
         have i₂ := eq11 z u u
         grind)
      | exact superpose eq11 eq4
      | exact resolve eq4 eq11
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq11
    have eq338 : False := by grind
    exact eq338
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u z), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X2 X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, (M.op (M.op (M.op x x) X0) (M.op x y)) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 y x
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op X0 X3) (M.op (M.op X2 X1) (M.op (M.op X1 X2) X0))) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op X1 X2) X0) (M.op X2 X1)
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 X1 X2 : G, (M.op X2 X1) = (M.op X0 (M.op X0 (M.op X1 X2))) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op X2 X1) (M.op X1 X2) X0
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq12 : ∀ X0 : G, (M.op x y) = (M.op X0 (M.op X0 (M.op x x))) := by
    intro X0
    first
    | (have i₁ := eq4 (M.op x y) (M.op x x) X0
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq15 : (M.op x x) = (M.op x y) := by
    first
    | (have i₁ := eq12 x
       have i₂ := eq9 x x x
       grind)
    | exact superpose eq9 eq12
    | exact resolve eq12 eq9
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9 eq12
  have eq62 : ∀ X0 X1 : G, y = (M.op (M.op x x) (M.op (M.op X0 X1) (M.op (M.op X1 X0) x))) := by
    intro X0 X1
    first
    | (have i₁ := eq8 x X1 X0 y
       have i₂ := eq15
       grind)
    | exact superpose eq15 eq8
    | exact resolve eq8 eq15
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq15
  have eq111 : y = x := by
    first
    | (have i₁ := eq62 x x
       have i₂ := eq8 x x x x
       grind)
    | exact superpose eq8 eq62
    | exact resolve eq62 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq62
  have eq123 : False := by grind
  exact eq123

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2170` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2170 : Law3.StructuralFrom Law2170 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2170
