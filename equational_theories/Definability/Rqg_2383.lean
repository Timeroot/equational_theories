    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq26 : ∀ X0 X2 : G, (M.op X0 X2) = (M.op X2 X0) := by
    intro X0 X2
    first
    | (have i₁ := eq8 X0 x (M.op X2 X0) X2
