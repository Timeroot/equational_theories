/-- `Equation99` from `Equation50`: `x = x ◇ (x ◇ (y ◇ y))` ⊢ `x = x ◇ ((x ◇ x) ◇ x)`,
through `x □ y = if (M.op a a) = b then (M.op b a) else if (M.op b b) = a then (M.op b a) else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation99_StructuralFromFin_Equation50 : Law99.StructuralFromFin Law50 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_y_pyy_x_pyx_pyx_pxy_Equation50 (fun {G} M hM ↦ ?_)
  have hm := (@Law50.models_iff G M).mp hM
  rw [@Law99.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 0) ((Lf 1) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0)) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))
