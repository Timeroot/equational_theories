import equational_theories.Definability.DiagRow

/-!
# `Equation2116` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation2116` is `x = ((y ◇ x) ◇ z) ◇ (z ◇ y)`.

The law divides -- the division term is searched for and proved in place -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation2116`: `x = ((y ◇ x) ◇ z) ◇ (z ◇ y)`.  Columns are permutations.  The
law does not divide by substitution, so the quotient is a searched word proved in place; the
diagonal is then injective by a second Vampire refutation, replayed one step at a time. -/
theorem ColQG_Equation2116 : DiagRow.ColQG Law2116 := by
  classical
  refine DiagRow.colQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law2116.models_iff G M).mp hM
  have hdiv : ∀ u z : G, M.op (M.op u (M.op z (M.op u u))) u = z := by
    intro u z
    by_contra nh
    have eq3 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X0) X2) (M.op X2 X1)) = X0 := by
      intro X0 X1 X2
      grind
    have eq4 : z ≠ (M.op (M.op u (M.op z (M.op u u))) u) := by grind
    clear hm nh hM
    have eq6 : ∀ X0 X1 X2 : G, (M.op X0 (M.op (M.op X2 X1) (M.op X1 X0))) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq3 X2 (M.op X1 X0) (M.op X2 X1)
         have i₂ := eq3 X0 X1 X2
         grind)
      | exact superpose eq3 eq3
      | exact resolve eq3 eq3
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    have eq12 : ∀ X0 X1 X2 : G, (M.op (M.op X1 (M.op X2 (M.op X0 X1))) X0) = X2 := by
      intro X0 X1 X2
      first
      | (have i₁ := eq6 (M.op X1 (M.op X2 (M.op X0 X1))) (M.op X0 X1) X2
         have i₂ := eq6 (M.op X2 (M.op X0 X1)) X1 X0
         grind)
      | exact superpose eq6 eq6
      | exact resolve eq6 eq6
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq6
    have eq47 : z ≠ z := by
      first
      | (have i₁ := eq4
         have i₂ := eq12 u u z
         grind)
      | exact superpose eq12 eq4
      | (have r₁ := eq4
         have r₂ := eq12 u u z
         grind)
      | exact resolve eq4 eq12
      | grind
      | grind (splits := 40)
      | grind (splits := 40) (ematch := 20)
    clear eq12
    have eq55 : False := by grind
    exact eq55
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op z (M.op u u))), hdiv u z⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op (M.op (M.op X1 X0) X2) (M.op X2 X1)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op y x) = (M.op x x) := by grind
  have eq6 : y ≠ x := by grind
  clear hm hdiv hxy nh hM
  have eq7 : ∀ X0 : G, x = (M.op (M.op (M.op x x) X0) (M.op X0 y)) := by
    intro X0
    first
    | (have i₁ := eq4 x y X0
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq4
    | exact resolve eq4 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op X2 X1) = (M.op (M.op X0 X3) (M.op X3 (M.op (M.op X1 X0) X2))) := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 (M.op X2 X1) (M.op (M.op X1 X0) X2) X3
       have i₂ := eq4 X0 X1 X2
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq14 : ∀ X0 X1 : G, (M.op X0 y) = (M.op (M.op x X1) (M.op X1 (M.op (M.op x x) X0))) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op X0 y) (M.op (M.op x x) X0) X1
       have i₂ := eq7 X0
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq15 : ∀ X0 : G, (M.op X0 y) = (M.op X0 x) := by
    intro X0
    first
    | (have i₁ := eq14 X0 x
       have i₂ := eq8 x x X0 x
       grind)
    | exact superpose eq8 eq14
    | exact resolve eq14 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8 eq14
  have eq18 : ∀ X0 X1 : G, y = (M.op (M.op (M.op X0 x) X1) (M.op X1 X0)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 y X0 X1
       have i₂ := eq15 X0
       grind)
    | exact superpose eq15 eq4
    | exact resolve eq4 eq15
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq15
  have eq22 : y = x := by
    first
    | (have i₁ := eq18 x x
       have i₂ := eq4 x x x
       grind)
    | exact superpose eq4 eq18
    | exact resolve eq18 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq18
  have eq23 : False := by grind
  exact eq23

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `ColQG_Equation2116` its diagonal is recoverable from the rest of
its column -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation2116 : Law3.StructuralFrom Law2116 :=
  DiagRow.structuralFrom_idem_col ColQG_Equation2116
