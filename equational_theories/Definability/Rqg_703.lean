import equational_theories.Definability.DiagRow

/-!
# `Equation703` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation703` is `x = y ◇ (y ◇ ((x ◇ x) ◇ x))`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation703`: `x = y ◇ (y ◇ ((x ◇ x) ◇ x))`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation703 : DiagRow.RowQG Law703 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law703.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op u (M.op (M.op z z) z)), (hm z u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 : G, (M.op X1 (M.op X1 (M.op (M.op X0 X0) X0))) = X0 := by
    intro X0 X1
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq7 : ∀ X0 : G, (M.op (M.op X0 X0) X0) = (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) X0) := by
    intro X0
    first
    | (have i₁ := eq4 (M.op (M.op X0 X0) X0) (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0))
       have i₂ := eq4 X0 (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0))
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq8 : ∀ X0 : G, (M.op (M.op (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0)) (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0))) (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0))) = X0 := by
    intro X0
    first
    | (have i₁ := eq4 X0 (M.op (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0)) (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0)))
       have i₂ := eq7 (M.op (M.op X0 X0) X0)
       grind)
    | exact superpose eq7 eq4
    | exact resolve eq4 eq7
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq9 : ∀ X0 : G, (M.op (M.op X0 X0) (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0))) = X0 := by
    intro X0
    first
    | (have i₁ := eq7 (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0))
       have i₂ := eq8 X0
       grind)
    | exact superpose eq8 eq7
    | exact resolve eq7 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq7
  have eq10 : ∀ X0 X1 : G, (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0)) = (M.op X1 (M.op X1 X0)) := by
    intro X0 X1
    first
    | (have i₁ := eq4 (M.op (M.op (M.op (M.op X0 X0) X0) (M.op (M.op X0 X0) X0)) (M.op (M.op X0 X0) X0)) X1
       have i₂ := eq8 X0
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq21 : ∀ X0 X1 : G, (M.op (M.op X1 X1) (M.op X0 (M.op X0 X1))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq9 X1
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq9
    | exact resolve eq9 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq9
  have eq22 : ∀ X0 X1 : G, (M.op (M.op (M.op X0 (M.op X0 X1)) (M.op X0 (M.op X0 X1))) (M.op X0 (M.op X0 X1))) = X1 := by
    intro X0 X1
    first
    | (have i₁ := eq8 X0
       have i₂ := eq10 X0 X1
       grind)
    | exact superpose eq10 eq8
    | exact resolve eq8 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq27 : ∀ X0 X1 X2 : G, (M.op (M.op X1 X1) X1) = (M.op X2 (M.op X2 (M.op X0 (M.op X0 X1)))) := by
    intro X0 X1 X2
    first
    | (have i₁ := eq4 (M.op (M.op X1 X1) X1) X2
       have i₂ := eq10 X1 X0
       grind)
    | exact superpose eq10 eq4
    | exact resolve eq4 eq10
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq10
  have eq80 : y = (M.op (M.op y y) (M.op x (M.op x x))) := by
    first
    | (have i₁ := eq21 x y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq21
    | exact resolve eq21 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq21
  have eq220 : ∀ X0 : G, (M.op (M.op (M.op x (M.op x x)) (M.op x (M.op x x))) (M.op x (M.op x x))) = (M.op X0 (M.op X0 (M.op (M.op y y) y))) := by
    intro X0
    first
    | (have i₁ := eq27 (M.op y y) (M.op x (M.op x x)) X0
       have i₂ := eq80
       grind)
    | exact superpose eq80 eq27
    | exact resolve eq27 eq80
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq27 eq80
  have eq227 : y = (M.op (M.op (M.op x (M.op x x)) (M.op x (M.op x x))) (M.op x (M.op x x))) := by
    first
    | (have i₁ := eq220 x
       have i₂ := eq4 y x
       grind)
    | exact superpose eq4 eq220
    | exact resolve eq220 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq220
  have eq228 : x = y := by
    first
    | (have i₁ := eq227
       have i₂ := eq22 x x
       grind)
    | exact superpose eq22 eq227
    | exact resolve eq227 eq22
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq22 eq227
  have eq229 : False := by grind
  exact eq229

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation703` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation703 : Law3.StructuralFrom Law703 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation703
