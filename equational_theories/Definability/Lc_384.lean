/-!
# Structurality from `Equation384` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation384` is `x ◇ y = (y ◇ x) ◇ x`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op b a) = b then a else if (M.op b a) = a then b else (M.op b a)` is an automorphism of `◇` --
is `GuardAut2_pyx_y_pyx_x_x_y_pyx_Equation384`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 10 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation8` from `Equation384`: `x ◇ y = (y ◇ x) ◇ x` ⊢ `x = x ◇ (x ◇ x)`,
through `x □ y = if (M.op b a) = b then a else if (M.op b a) = a then b else (M.op b a)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation8_StructuralFromFin_Equation384 : Law8.StructuralFromFin Law384 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0))
    GuardAut2_pyx_y_pyx_x_x_y_pyx_Equation384 (fun {G} M hM ↦ ?_)
  have hm := (@Law384.models_iff G M).mp hM
  rw [@Law8.models_iff G ((AutBox.iteOf2 ((Lf 1) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 0)) (Lf 0) (Lf 0) (Lf 1) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

