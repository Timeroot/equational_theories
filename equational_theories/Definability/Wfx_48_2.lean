import equational_theories.Definability.AutBox
import equational_theories.Superposition

/-!
# Structurality from `Equation48` through the companion `x □ y = (x ◇ (y ◇ y))`

Generated by `defwork/wffit.py`.  `Equation48` is `x = x ◇ (x ◇ (x ◇ y))`.  The source half is
`AutBox.WordRigidFull`: two finite models of `Equation48` on one carrier with the same table of
`(x ◇ (y ◇ y))` are the same model.  That is what makes the companion's automorphisms automorphisms of
`◇`, and it mentions no map, so `grind` can do it.  Each theorem below then only has to check that
the source forces its target of the companion.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 400000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- Two models of `Equation48` on one carrier with the same `(x ◇ (y ◇ y))` are
equal.  Vampire refutation replayed step by step. -/
private theorem hrig : AutBox.WordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ Lf 1)) Law48 := by
  classical
  refine AutBox.wordRigidFull_of (Lf 0 ⋆ (Lf 1 ⋆ Lf 1)) (fun {G} _ M N hM hN hall a b ↦ ?_)
  have hm := (@Law48.models_iff G M).mp hM
  have hn := (@Law48.models_iff G N).mp hN
  simp only [evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one] at hall
  by_contra nh
  have eq5 : ∀ X0 X1 : G, (M.op X0 (M.op X0 (M.op X0 X1))) = X0 := by
    intro X0 X1
    grind
  have eq6 : ∀ X0 X1 : G, (N.op X0 (N.op X0 (N.op X0 X1))) = X0 := by
    intro X0 X1
    grind
  have eq7 : ∀ X0 X1 : G, (M.op X0 (M.op X1 X1)) = (N.op X0 (N.op X1 X1)) := by
    intro X0 X1
    grind
  have eq8 : (M.op a b) ≠ (N.op a b) := by grind
  clear hm hn hall nh hM hN
  have eq10 : ∀ X0 : G, (M.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq5 X0 (M.op X0 x)
       have i₂ := eq5 X0 x
       grind)
    | exact superpose eq5 eq5
    | exact resolve eq5 eq5
    | grind
    | grind (splits := 40)
  have eq15 : ∀ X0 : G, (N.op X0 X0) = X0 := by
    intro X0
    first
    | (have i₁ := eq6 X0 (N.op X0 x)
       have i₂ := eq6 X0 x
       grind)
    | exact superpose eq6 eq6
    | exact resolve eq6 eq6
    | grind
    | grind (splits := 40)
  have eq22 : ∀ X0 X1 : G, (M.op X1 (M.op X0 X0)) = (N.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq7 X1 X0
       have i₂ := eq15 X0
       grind)
    | exact superpose eq15 eq7
    | exact resolve eq7 eq15
    | grind
    | grind (splits := 40)
  clear eq15
  have eq31 : ∀ X0 X1 : G, (N.op X1 X0) = (M.op X1 X0) := by
    intro X0 X1
    first
    | (have i₁ := eq22 X0 X1
       have i₂ := eq10 X0
       grind)
    | exact superpose eq10 eq22
    | exact resolve eq22 eq10
    | grind
    | grind (splits := 40)
  clear eq10 eq22
  have eq40 : (M.op a b) ≠ (M.op a b) := by
    first
    | (have i₁ := eq8
       have i₂ := eq31 b a
       grind)
    | exact superpose eq31 eq8
    | exact resolve eq8 eq31
    | grind
    | grind (splits := 40)
  clear eq31
  have eq47 : False := by grind
  exact eq47

/-- `Equation412` from `Equation48`: `x = x ◇ (x ◇ (x ◇ y))` ⊢ `x = x ◇ (x ◇ (x ◇ (x ◇ y)))`,
through the companion `x □ y = (x ◇ (y ◇ y))`. -/
theorem Equation412_StructuralFromFin_Equation48 : Law412.StructuralFromFin Law48 := by
  classical
  refine AutBox.structuralFromFin_wordRigidFull (Lf 0 ⋆ (Lf 1 ⋆ Lf 1)) (fun {G} _ M hM ↦ ?_) hrig
  have h := (@Law48.models_iff G M).mp hM
  rw [@Law412.models_iff _ ((AutBox.wordOf (Lf 0 ⋆ (Lf 1 ⋆ Lf 1))).magma M)]
  intro x y
  simp only [AutBox.wordOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_fin_one]
  first
  | done
  | grind
  | grind (splits := 30) (ematch := 20)

