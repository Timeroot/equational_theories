/-! ### The exhibits, spelled out

`Magma.transport` reads a cell as `E (tr x y).2 (v (tr x y).1)`, so the kernel walks the `81`-row
group table once per cell -- and a `Satisfies` certificate on `Fin 9` asks for `6,561` cells. Below
is the same operation as a plain `9 x 9` table, checked once against `Magma.transport` by
`native_decide`, so that the certificates in `Definability/Certs/Srch9R412Sources*.lean` can be
`decide!` against the table instead. Without this the two heaviest classes were killed at `55 GB`.
-/

def tdsrch9R4120 : Array (Array Nat) := #[#[1, 0, 3, 6, 5, 7, 2, 4, 1], #[8, 8, 3, 6, 5, 7, 2, 4, 1], #[1, 8, 6, 6, 7, 4, 2, 5, 0], #[1, 8, 3, 2, 7, 4, 2, 5, 0], #[8, 0, 6, 2, 5, 4, 3, 5, 1], #[8, 0, 6, 2, 7, 7, 3, 5, 1], #[1, 8, 3, 6, 7, 4, 3, 5, 0], #[8, 0, 6, 2, 7, 4, 3, 4, 1], #[8, 0, 3, 6, 5, 7, 2, 4, 0]]

def opsrch9R4120 (x y : Fin 9) : Fin 9 :=
  ⟨(tdsrch9R4120[x.1]!)[y.1]! % 9, Nat.mod_lt _ (by decide)⟩

theorem htsrch9R4120 :
    ∀ x y, Magma.transport S9R412.E S9R412.tr vsrch9R4120.1 x y = opsrch9R4120 x y := by
  native_decide

theorem esrch9R4120 : Magma.srch9R412 vsrch9R4120 = Magma.mk opsrch9R4120 :=
  congrArg Magma.mk (funext fun x ↦ funext fun y ↦ htsrch9R4120 x y)

