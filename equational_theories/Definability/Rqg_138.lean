import equational_theories.Definability.DiagRow

/-!
# `Equation138` is a quasigroup on one side, over every carrier

Generated by `defwork/rowqg.py`.  `Equation138` is `x = y ◇ ((z ◇ y) ◇ x)`.

The law divides -- the division term is read off the law's own syntax tree -- and the row (or
column) through the diagonal is injective; together those say the row is a permutation, which is
what `AutBox`'s finite device was really using.  So `DiagRow.structuralFrom_idem_row` promotes the
`Equation3` cell from `StructuralFromFin` to `StructuralFrom`.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation138`: `x = y ◇ ((z ◇ y) ◇ x)`.  Rows are permutations -- the law itself divides, and the
diagonal is injective by a Vampire refutation replayed one superposition step at a time. -/
theorem RowQG_Equation138 : DiagRow.RowQG Law138 := by
  classical
  refine DiagRow.rowQG_of (fun {G} M hM ↦ ?_)
  have hm := (@Law138.models_iff G M).mp hM
  refine ⟨fun x y hxy ↦ ?_, fun u z ↦ ⟨(M.op (M.op u u) z), (hm z u u).symm⟩⟩
  by_contra nh
  have eq4 : ∀ X0 X1 X2 : G, (M.op X1 (M.op (M.op X2 X1) X0)) = X0 := by
    intro X0 X1 X2
    grind
  have eq5 : (M.op x y) = (M.op x x) := by grind
  have eq6 : x ≠ y := by grind
  clear hm hxy nh hM
  have eq8 : ∀ X0 X1 X2 X3 : G, (M.op (M.op (M.op X1 X2) X0) (M.op X0 X3)) = X3 := by
    intro X0 X1 X2 X3
    first
    | (have i₁ := eq4 X3 (M.op (M.op X1 X2) X0) X2
       have i₂ := eq4 X0 X2 X1
       grind)
    | exact superpose eq4 eq4
    | exact resolve eq4 eq4
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq27 : ∀ X0 X1 : G, y = (M.op (M.op (M.op X0 X1) x) (M.op x x)) := by
    intro X0 X1
    first
    | (have i₁ := eq8 x X0 X1 y
       have i₂ := eq5
       grind)
    | exact superpose eq5 eq8
    | exact resolve eq8 eq5
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  have eq30 : ∀ X0 X1 X4 : G, (M.op (M.op X1 X0) (M.op X0 X4)) = X4 := by
    intro X0 X1 X4
    first
    | (have i₁ := eq4 X4 (M.op X1 X0) (M.op (M.op x x) X1)
       have i₂ := eq8 X1 x x X0
       grind)
    | exact superpose eq8 eq4
    | exact resolve eq4 eq8
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq8
  have eq31 : x = y := by
    first
    | (have i₁ := eq27 x x
       have i₂ := eq30 x (M.op x x) x
       grind)
    | (have i₁ := eq27 x x
       have i₂ := eq30 x x (M.op (M.op (M.op x x) x) (M.op x x))
       grind)
    | exact superpose eq30 eq27
    | exact resolve eq27 eq30
    | grind
    | grind (splits := 40)
    | grind (splits := 40) (ematch := 20)
  clear eq27 eq30
  have eq32 : False := by grind
  exact eq32

/-- The `Equation3` companion: `x □ y = if x = y then x ◇ x else x ◇ y` is idempotent, agrees with
`◇` off the diagonal, and by `RowQG_Equation138` its diagonal is recoverable from the rest of
its row -- so the two magmas define each other. -/
theorem Equation3_StructuralFrom_Equation138 : Law3.StructuralFrom Law138 :=
  DiagRow.structuralFrom_idem_row RowQG_Equation138

/-- `Equation619` from `Equation138`: `x = y ◇ ((z ◇ y) ◇ x)` ⊢ `x = x ◇ (x ◇ ((y ◇ x) ◇ x))`,
through the companion `x □ y = if x = y then x else x ◇ y`. -/
theorem Equation619_StructuralFrom_Equation138 : Law619.StructuralFrom Law138 := by
  classical
  refine DiagRow.structuralFrom_diagOf_row (Lf 0) RowQG_Equation138
    (fun {G} M hM ↦ ?_)
  have hm := (@Law138.models_iff G M).mp hM
  rw [@Law619.models_iff G ((QFOp.diagOf (Lf 0)).magma M)]
  intro x y
  simp only [QFOp.diagOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

