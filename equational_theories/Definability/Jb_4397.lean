/-!
# Structurality from `Equation4397` through a two-guard companion

Generated by `defwork/itautcell2.py`.  `Equation4397` is `x ◇ (x ◇ y) = (x ◇ x) ◇ z`.  Its guarded obligation
-- a bijection of a finite model commuting with `x □ y = if (M.op a a) = b then a else if (M.op a b) = b then a else (M.op a b)` is an automorphism of `◇` --
is `GuardAut2_pxx_y_pxy_y_x_x_pxy_Equation4397`, proved elsewhere.  That obligation names no target, so every
law the companion satisfies is another cell for free, and there
are 4 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation100` from `Equation4397`: `x ◇ (x ◇ y) = (x ◇ x) ◇ z` ⊢ `x = x ◇ ((x ◇ x) ◇ y)`,
through `x □ y = if (M.op a a) = b then a else if (M.op a b) = b then a else (M.op a b)`, writing `a`, `b` for `x`, `y`. -/
theorem Equation100_StructuralFromFin_Equation4397 : Law100.StructuralFromFin Law4397 := by
  classical
  refine AutBox.structuralFromFin_iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 0) ⋆ (Lf 1))
    GuardAut2_pxx_y_pxy_y_x_x_pxy_Equation4397 (fun {G} M hM ↦ ?_)
  have hm := (@Law4397.models_iff G M).mp hM
  rw [@Law100.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 0) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 0) ⋆ (Lf 1))).magma M)]
  intro x y
  simp only [AutBox.iteOf2_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

