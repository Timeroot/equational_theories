/-! ### The operations

Each is a decision tree over `d x`, `d y`, `x = y`, `x ◇ x = x` and `y ◇ y = y`, whose leaves are
words in `x` and `y`. A tree has to satisfy two things and only two: that it keeps `γ` on the
diagonal of `D`, and how it reads the columns of `S`. `D` itself is named by the tree's own
diagonal, which every read below leaves alone. -/

section Ops

variable (M : Magma G) (K : DKer M)

/-! #### Operation `7038766`

4,220 cells, in 464 rows of the open list over 61 sources.  Its diagonal of `S` is read `self`, its
columns direct on `D × S` and direct on `S × S`. -/

/-- The tree of operation `7038766`. -/
def q7038766 : EOp :=
  .ite (.sq (Lf 1))
    (.ite (.eq (Lf 0) (Lf 1)) (.leaf (Lf 0 ⋆ Lf 1)) (.leaf (Lf 0)))
    (.leaf (Lf 0 ⋆ Lf 1))

open scoped Classical in
theorem q7038766_apply (a b : G) :
    (q7038766.magma M).op a b =
      if K.d b then if a = b then M.op a b else a else M.op a b := by
  show @EOp.eval _ M q7038766 ![a, b] = _
  simp only [q7038766, EOp.eval, Tst.holds, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    dsqex M K]

include K in
theorem q7038766_diag (y : G) (hy : K.d y) : (q7038766.magma M).op y y = M.op y y := by
  classical
  rw [q7038766_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
/-- The tree keeps the source's diagonal everywhere, on `D` because that is `γ` and off it because
the off-`D` clause copies the source cell.  This is what names `D`, and it is also the only
rewrite a nested application gets: `□ c c` is `M c c`, which is a square, so the hub's own shape
`x ◇ (y ◇ y)` still collapses inside a target. -/
theorem q7038766_dg (a : G) : (q7038766.magma M).op a a = M.op a a := by
  classical
  rw [q7038766_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
theorem q7038766_out (x y : G) (hy : ¬ K.d y) :
    (q7038766.magma M).op x y = M.op x y := by
  classical
  rw [q7038766_apply M K]
  have h2 : ∀ p : G, K.d (M.op p p) := K.dsq
  have h3 : ∀ p q : G, K.d q → M.op p q = M.op q q := K.hin
  split_ifs <;> grind

include K in
/-- The whole of `StructuralOnMagma` for operation `7038766`, bar the law itself. -/
theorem structural_q7038766 {β : Type*} {L : Law.MagmaLaw β}
    (hL : @satisfies _ G (q7038766.magma M) L) : L.StructuralOnMagma M :=
  structuralOn_selfGammaD M K q7038766 hL (q7038766_diag M K)
    (q7038766_out M K)

