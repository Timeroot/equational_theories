    GuardAut2_pxx_y_pyy_y_x_x_pyx_Equation4574 (fun {G} M hM ↦ ?_)
  have hm := (@Law4574.models_iff G M).mp hM
  rw [@Law1229.models_iff G ((AutBox.iteOf2 ((Lf 0) ⋆ (Lf 0)) (Lf 1) ((Lf 1) ⋆ (Lf 1)) (Lf 1) (Lf 0) (Lf 0) ((Lf 1) ⋆ (Lf 0))).magma M)]
