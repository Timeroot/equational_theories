/-!
# Structurality from `Equation4428` through a guarded companion

Generated by `defwork/itautcell.py`.  `Equation4428` is `x ◇ (x ◇ y) = (z ◇ w) ◇ y`.  Its guarded obligation
-- a bijection of a finite model commuting with the companion `if m(Y,Y) = Y then m(X,X) else m(Y,X)`
is an automorphism -- is `GuardAut_pyy_y_pxx_pyx_Equation4428`, proved elsewhere.  That obligation
names no target, so every law the companion satisfies is another cell for free, and there
are 5 of them below.
-/

open FirstOrder FirstOrder.Language Law Law.MagmaLaw FreeMagma

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-- `Equation3262` from `Equation4428`: `x ◇ (x ◇ y) = (z ◇ w) ◇ y` ⊢ `x ◇ x = x ◇ (y ◇ (y ◇ y))`,
through `x □ y = if m(Y,Y) = Y then m(X,X) else m(Y,X)`, writing `X`, `Y` for `x`, `y`. -/
theorem Equation3262_StructuralFromFin_Equation4428 : Law3262.StructuralFromFin Law4428 := by
  classical
  refine AutBox.structuralFromFin_iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0))
    GuardAut_pyy_y_pxx_pyx_Equation4428 (fun {G} M hM ↦ ?_)
  have hm := (@Law4428.models_iff G M).mp hM
  rw [@Law3262.models_iff G ((AutBox.iteOf ((Lf 1) ⋆ (Lf 1)) (Lf 1) ((Lf 0) ⋆ (Lf 0)) ((Lf 1) ⋆ (Lf 0))).magma M)]
  intro x y
  simp only [AutBox.iteOf_apply, evalInMagma, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons, Matrix.cons_val_fin_one]
  first
    | (split_ifs <;> grind)
    | (split_ifs <;> grind (splits := 30) (ematch := 20))
    | (split_ifs <;> grind (splits := 60) (ematch := 40))

