import equational_theories.Parastrophes.Equation917RegularUnit

/-!
# Quotienting the remaining E917 unit-map obstruction

Assume the crossed identity and the regularity hypothesis of
`RegularUnit.reduction`. The equivalence relation generated by `x ~ U(x)`
is a magma congruence. Its finite quotient satisfies BOTH identities of the
E917 left-division image, not just the crossed identity.

Also, if an iterate of U fixes one point, it fixes every point. Consequently
all cycles of U have the same length. A nontrivial counterexample to the
remaining regular-unit conjecture would therefore be a uniform cyclic cover
of a genuine image. This does not prove that such covers are impossible;
there is deliberately no catalogue characterization attribute here.
-/
namespace Parastrophes.Eq917Image.RegularUnit
open SandwichCandidate (U)

/-- The quotient identifies a point with its successor under the unit map.
`Quot` automatically takes the equivalence closure of these generating pairs. -/
def UnitOrbit {A : Type} (D : Magma A) := Quot (fun x y => U D x = y)

def orbit {A : Type} (D : Magma A) (x : A) : UnitOrbit D := Quot.mk _ x

@[simp] theorem orbit_unit {A : Type} (D : Magma A) (x : A) :
    orbit D (U D x) = orbit D x :=
  (@Quot.sound A (fun a b => U D a = b) x (U D x) rfl).symm

/-- The left shift and simultaneous shift identities suffice to descend
multiplication. In the right argument a generating step reverses direction. -/
@[implicit_reducible] def orbitMagma {A : Type} (D : Magma A)
    (left : ∀ x y, D.op (U D x) y = U D (D.op x y))
    (both : ∀ x y, D.op (U D x) (U D y) = D.op x y) : Magma (UnitOrbit D) :=
  ⟨fun x y => Quot.liftOn₂ x y (fun a b => orbit D (D.op a b))
    (by
      intro a b c h
      change U D b = c at h
      subst c
      apply Eq.symm
      exact Quot.sound ((left a (U D b)).symm.trans (both a b)))
    (by
      intro a b c h
      change U D a = b at h
      subst b
      change orbit D (D.op a c) = orbit D (D.op (U D a) c)
      rw [left, orbit_unit])⟩

@[simp] theorem orbit_op {A : Type} (D : Magma A)
    (left : ∀ x y, D.op (U D x) y = U D (D.op x y))
    (both : ∀ x y, D.op (U D x) (U D y) = D.op x y) (x y : A) :
    (orbitMagma D left both).op (orbit D x) (orbit D y) = orbit D (D.op x y) := rfl

/-- The quotient's unit law holds by construction; its crossed law descends
from the original magma. -/
theorem orbit_basis {A : Type} (D : Magma A) (h : Cross D)
    (left : ∀ x y, D.op (U D x) y = U D (D.op x y))
    (both : ∀ x y, D.op (U D x) (U D y) = D.op x y) :
    Basis (orbitMagma D left both) := by
  constructor
  · intro x
    refine Quot.inductionOn x ?_
    intro a
    change orbit D a = orbit D (U D a)
    exact (orbit_unit D a).symm
  · intro x y
    refine Quot.inductionOn x ?_
    intro a
    refine Quot.inductionOn y ?_
    intro b
    exact congrArg (orbit D) (h a b)

/-- Every regular-unit crossed magma has a quotient which really is an
E917 left-division image. The quotient is permitted to have just one point. -/
theorem orbit_inImage {A : Type} [Finite A] (D : Magma A) (h : Cross D)
    (w : A → A) (hw : ∀ x y, D.op x (U D y) = w (D.op x y)) :
    ∃ Q : Magma (UnitOrbit D), InImage Law917 .left Q ∧
      ∀ x y, Q.op (orbit D x) (orbit D y) = orbit D (D.op x y) := by
  letI : Finite (UnitOrbit D) := Quot.finite _
  obtain ⟨_, _, _, _, left, both, _⟩ := reduction D h w hw
  refine ⟨orbitMagma D left both, ?_, orbit_op D left both⟩
  exact (characterizes_fin _).1 (orbit_basis D h left both)

/-- A period at one point is a period everywhere. This gives equal cycle
lengths without choosing or enumerating the cycles. -/
theorem iterate_eq_of_fixed_point {A : Type} [Finite A] (D : Magma A) (h : Cross D)
    (w : A → A) (hw : ∀ x y, D.op x (U D y) = w (D.op x y))
    (n : ℕ) (a : A) (ha : (U D)^[n] a = a) : ∀ x, (U D)^[n] x = x := by
  have left := (reduction D h w hw).2.2.2.2.1
  have shift (n : ℕ) (x y : A) :
      D.op ((U D)^[n] x) y = (U D)^[n] (D.op x y) := by
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [Function.iterate_succ_apply', left, ih, Function.iterate_succ_apply']
  have rows := (Candidate.quasigroup_of_frame D (fun x _ => core D x)
    (fun x y _ => h x y)).1
  intro x
  obtain ⟨y, rfl⟩ := (rows a).2 x
  rw [← shift, ha]

/-- The core is constant on each unit orbit, even before passing to its
value's orbit. This is stronger than compatibility with the congruence. -/
def orbitCore {A : Type} [Finite A] (D : Magma A) (h : Cross D)
    (w : A → A) (hw : ∀ x y, D.op x (U D y) = w (D.op x y)) : UnitOrbit D → A :=
  Quot.lift (core D) (by
    intro x y hxy
    change U D x = y at hxy
    subst y
    exact (reduction D h w hw).2.2.2.2.2.2 x |>.symm)

/-- A quotient idempotent forces a genuine idempotent upstairs, and therefore
forces U=id everywhere. Thus every nontrivial counterexample must have an
idempotent-free quotient image. -/
theorem unit_eq_of_square_orbit {A : Type} [Finite A] (D : Magma A) (h : Cross D)
    (w : A → A) (hw : ∀ x y, D.op x (U D y) = w (D.op x y))
    (a : A) (ha : orbit D (D.op a a) = orbit D a) : ∀ x, U D x = x := by
  have hc : core D (D.op a a) = core D a := congrArg (orbitCore D h w hw) ha
  have hi : D.op (core D a) (core D a) = core D a := by
    rw [← CrossCalculations.core_core D h (core D a),
      CrossCalculations.core_core D h a]
    exact hc
  apply unit_eq_of_fixed_point D h w hw (core D a)
  let c := core D a
  have hcc : D.op c c = c := hi
  change D.op c (D.op (D.op c (D.op c c)) c) = c
  simp only [hcc]

end Parastrophes.Eq917Image.RegularUnit
