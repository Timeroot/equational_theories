/-- Every order at least 27 is realized. -/
theorem all_large (n : ℕ) (hn : 27 ≤ n) : Law1486.HasModel n := by
  by_cases h : 63 ≤ n
  · exact graph_atLeast63 n h
  have hu : n ≤ 62 := by omega
  interval_cases n <;> first
    | exact c27
    | exact c28
    | exact c29
    | exact c30
    | exact c31
    | exact c32
    | exact c33
    | exact c34
    | exact c35
    | exact c36
    | exact c37
    | exact c38
