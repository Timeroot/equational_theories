    | exact c53
    | exact c54
    | exact c55
    | exact c56
    | exact c57
    | exact c58
    | exact c59
    | exact c60
    | exact c61
    | exact c62

/-- The remaining possible exceptions to the constructive lower bound.
This list does not assert nonexistence at its entries. -/
def remaining : Finset ℕ := {2, 3, 5, 6, 7, 8, 10, 12, 14, 15, 17, 26}

theorem lower (n : ℕ) (hn : 0 < n) (he : n ∉ remaining) : Law1486.HasModel n := by
  by_cases h : 27 ≤ n
  · exact all_large n h
  have hu : n ≤ 26 := by omega
  interval_cases n <;> simp [remaining] at he <;> first
    | exact c1
    | exact c4
    | exact c9
    | exact c11
    | exact c13
    | exact c16
    | exact c18
    | exact c19
    | exact c20
    | exact c21
    | exact c22
    | exact c23
    | exact c24
    | exact c25

/-- The original shifted-square family is now completely proved. -/
theorem shifted_squares : shiftedSquares ⊆ Law1486.spectrum := by
  rintro n ⟨k, hk, rfl⟩
  refine ⟨by positivity, ?_⟩
  by_cases h : 5 ≤ k
  · exact all_large _ (by nlinarith)
  have h34 : k = 3 ∨ k = 4 := by omega
  rcases h34 with rfl | rfl
  · exact c11
  · exact c18

theorem lower_spectrum : positiveExcept remaining ⊆ Law1486.spectrum := by
  rintro n ⟨hn, he⟩
  exact ⟨hn, lower n hn he⟩

theorem cofinite : CofiniteSpectrum Law1486 :=
  ⟨27, fun n hn => ⟨by omega, all_large n hn⟩⟩

