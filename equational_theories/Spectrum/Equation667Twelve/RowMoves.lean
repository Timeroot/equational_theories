def forward (m : Move) (x : Fin 12) : Fin 12 := m[x.val]!.1
def backward (m : Move) (x : Fin 12) : Fin 12 := m[x.val]!.2

def Valid (i : Fin 77) (m : Move) : Prop :=
  (∀ x, backward m (forward m x) = x) ∧
  (∀ x, forward m (backward m x) = x) ∧
  forward m 0 = 0 ∧
  ∀ x, forward m (FixedSquare.Cases.table i x) = FixedSquare.Cases.table i (forward m x)

@[spectrum_native]
theorem moves_valid : ∀ i : Fin 77, ∀ m ∈ moves i, Valid i m := by
  unfold Valid
  native_decide

