theorem modelLaw (M : Magma (Fin 9)) (h : @Equation883 (Fin 9) M) :
    testLaw (rows M 0) (rows M 1) (rows M 2) (rows M 3) (rows M 4) (rows M 5) (rows M 6) (rows M 7) (rows M 8) := by
  have H (x y : Fin 9) : bv x =
