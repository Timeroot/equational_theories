def lengthsMinusOne (i : Fin 77) : List ℕ := lengthsData[i.val]!

def parts (i : Fin 77) : Multiset ℕ := ((lengthsMinusOne i).map (· + 1) : List ℕ)

@[spectrum_native]
private theorem sum_parts : ∀ i, (parts i).sum = 12 := by native_decide

def partition (i : Fin 77) : Nat.Partition 12 :=
  Nat.Partition.ofSums 12 (parts i) (sum_parts i)

@[spectrum_native]
theorem partition_representative : ∀ i, (representative i).partition = partition i := by
  native_decide

@[spectrum_native]
theorem partitions_complete : ∀ p : Nat.Partition 12, ∃ i, partition i = p := by
  native_decide

theorem exists_conjugate (d : Equiv.Perm (Fin 12)) :
    ∃ i : Fin 77, IsConj d (representative i) := by
  obtain ⟨i,hi⟩ := partitions_complete d.partition
  refine ⟨i, Equiv.Perm.partition_eq_of_isConj.mpr ?_⟩
  rw [partition_representative, hi]

spectrum_assert exists_conjugate complete
