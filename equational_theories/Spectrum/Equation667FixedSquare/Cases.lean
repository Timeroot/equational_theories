@[spectrum_native]
private theorem inverses : ∀ i x, inverse i (table i x) = x ∧ table i (inverse i x) = x := by
  native_decide

def representative (i : Fin 77) : Equiv.Perm (Fin 12) where
  toFun := table i
  invFun := inverse i
  left_inv x := (inverses i x).1
  right_inv x := (inverses i x).2

