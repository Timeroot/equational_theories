theorem model {n : ℕ} (hn : n ∉ remaining) : Model (Fin n) true := by
  by_cases he : n ∈ extraOrders
  · exact extra_model he
  · apply FieldBounds.model
    intro h
    exact hn (Finset.mem_sdiff.mpr ⟨h,he⟩)

private theorem bound : ∀ n ∈ remaining, n < 689 := by decide +kernel

theorem all_large {n : ℕ} (hn : 689 ≤ n) : Model (Fin n) true := by
