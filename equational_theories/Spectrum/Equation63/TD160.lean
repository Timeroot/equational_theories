def encode (x : Q) : ℕ :=
  32*x.1.val + ((List.finRange 5).map (fun i => (x.2 i).val * 2^i.val)).sum

def decode (a : ℕ) : Q :=
  ((a / 32 : ℕ), fun i => if a.testBit i.val then 1 else 0)

def matrix (x : Q) (i : Fin 7) : Q := decode entries[160*i.val + encode x]!

@[spectrum_native]
theorem differences : ∀ i j : Fin 7, i ≠ j →
    Function.Injective (fun x : Q => matrix x i - matrix x j) := by
  native_decide

theorem exists_td : HasTD 160 := by
  let D : Transversal Groups (Fin 160) (Q × Q) := (differenceDesign matrix differences).relabel
    (Fintype.equivFinOfCardEq (by simp [Q]))
  exact ⟨D.reindex (Fintype.equivFinOfCardEq (by simp [Q])).symm⟩

spectrum_assert exists_td complete

end Spectrum.E63.TD160
