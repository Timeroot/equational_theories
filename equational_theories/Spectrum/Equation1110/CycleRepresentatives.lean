def inverseData12 (i : Fin 77) (x : Fin 12) : Fin 12 := ⟨(inverseDataRows12[i.val]!)[x.val]! % 12, Nat.mod_lt _ (by decide)⟩

@[spectrum_native]
private theorem inverseCheck12 : ∀ i : Fin 77, ∀ x : Fin 12,
    inverseData12 i (data12 i x) = x ∧ data12 i (inverseData12 i x) = x := by native_decide

def representative12 (i : Fin 77) : Equiv.Perm (Fin 12) where
  toFun := data12 i
  invFun := inverseData12 i
  left_inv x := (inverseCheck12 i x).1
  right_inv x := (inverseCheck12 i x).2

@[spectrum_native]
theorem partitions12 : ∀ p : Nat.Partition 12, ∃ i : Fin 77,
    (representative12 i).partition = p := by native_decide

theorem conjugate12 (d : Equiv.Perm (Fin 12)) :
    ∃ i : Fin 77, ∃ e : Equiv.Perm (Fin 12),
      e * d * e⁻¹ = representative12 i := by
  obtain ⟨i, hi⟩ := partitions12 d.partition
  have hc : IsConj d (representative12 i) :=
    Equiv.Perm.partition_eq_of_isConj.mpr hi.symm
  obtain ⟨e,he⟩ := isConj_iff.mp hc
  exact ⟨i,e,he⟩

