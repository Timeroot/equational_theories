    inverseData13 i (data13 i x) = x ∧ data13 i (inverseData13 i x) = x := by native_decide

def representative13 (i : Fin 101) : Equiv.Perm (Fin 13) where
  toFun := data13 i
  invFun := inverseData13 i
  left_inv x := (inverseCheck13 i x).1
  right_inv x := (inverseCheck13 i x).2

@[spectrum_native]
theorem partitions13 : ∀ p : Nat.Partition 13, ∃ i : Fin 101,
    (representative13 i).partition = p := by native_decide

theorem conjugate13 (d : Equiv.Perm (Fin 13)) :
    ∃ i : Fin 101, ∃ e : Equiv.Perm (Fin 13),
      e * d * e⁻¹ = representative13 i := by
  obtain ⟨i, hi⟩ := partitions13 d.partition
  have hc : IsConj d (representative13 i) :=
    Equiv.Perm.partition_eq_of_isConj.mpr hi.symm
  obtain ⟨e,he⟩ := isConj_iff.mp hc
  exact ⟨i,e,he⟩

