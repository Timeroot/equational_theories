import equational_theories.Spectrum.Equation667BinaryFive
import equational_theories.Spectrum.Equation667BinaryExtensions

/-! Completeness of the binary five-point formula. The 25 coordinate cases
below are small linear combinations of the cocycle identities, checked by
ordinary ring arithmetic. Generated by spectrum_667_binary_classification.py. -/
namespace Spectrum.E667.BinaryFive

set_option maxHeartbeats 500000 in
/-- Every normalized binary cocycle over the five-point mean algebra has the
explicit form v(i)+v(2j-i), with v recovered from the first row. -/
theorem normalized_complete (C : ZMod 5 → ZMod 5 → ZMod 2)
    (hd : ∀ i, C i i = 0) (hc : BinaryExtensions.Cocycle base C) (i j : ZMod 5) :
    C i j = cocycle (fun k => C 0 (3 * k)) i j := by
  have H (i j : ZMod 5) : C i j + C i (base i j) + C j (base i (base i j)) = 0 := by
    simpa only [base_idem, hd, zero_add] using hc i j
  have double_zero (a : ZMod 2) : a+a=0 := by ring_nf; reduce_mod_char
  have h01 : C 0 1 + C 0 3 + C 1 4 = 0 := H 0 1
  have h02 : C 0 2 + C 0 1 + C 2 3 = 0 := H 0 2
  have h03 : C 0 3 + C 0 4 + C 3 2 = 0 := H 0 3
  have h04 : C 0 4 + C 0 2 + C 4 1 = 0 := H 0 4
  have h10 : C 1 0 + C 1 3 + C 0 2 = 0 := H 1 0
  have h12 : C 1 2 + C 1 4 + C 2 0 = 0 := H 1 2
  have h13 : C 1 3 + C 1 2 + C 3 4 = 0 := H 1 3
  have h14 : C 1 4 + C 1 0 + C 4 3 = 0 := H 1 4
  have h20 : C 2 0 + C 2 1 + C 0 4 = 0 := H 2 0
  have h21 : C 2 1 + C 2 4 + C 1 3 = 0 := H 2 1
  have h23 : C 2 3 + C 2 0 + C 3 1 = 0 := H 2 3
  have h24 : C 2 4 + C 2 3 + C 4 0 = 0 := H 2 4
  have h30 : C 3 0 + C 3 4 + C 0 1 = 0 := H 3 0
  have h31 : C 3 1 + C 3 2 + C 1 0 = 0 := H 3 1
  have h32 : C 3 2 + C 3 0 + C 2 4 = 0 := H 3 2
  have h34 : C 3 4 + C 3 1 + C 4 2 = 0 := H 3 4
  have h40 : C 4 0 + C 4 2 + C 0 3 = 0 := H 4 0
  have h41 : C 4 1 + C 4 0 + C 1 2 = 0 := H 4 1
  have h42 : C 4 2 + C 4 3 + C 2 1 = 0 := H 4 2
  have h43 : C 4 3 + C 4 1 + C 3 0 = 0 := H 4 3
  have e00 : C 0 0 = C 0 0 + C 0 0 := by
    simp only [hd, zero_add]
  have e01 : C 0 1 = C 0 0 + C 0 1 := by
    simp only [hd, zero_add]
  have e02 : C 0 2 = C 0 0 + C 0 2 := by
    simp only [hd, zero_add]
  have e03 : C 0 3 = C 0 0 + C 0 3 := by
    simp only [hd, zero_add]
  have e04 : C 0 4 = C 0 0 + C 0 4 := by
    simp only [hd, zero_add]
  have e11 : C 1 1 = C 0 3 + C 0 3 := by
    rw [hd, double_zero]
  have e14 : C 1 4 = C 0 3 + C 0 1 := by
    linear_combination (norm := skip) (h01)
    ring_nf
    reduce_mod_char
  have e22 : C 2 2 = C 0 1 + C 0 1 := by
    rw [hd, double_zero]
  have e23 : C 2 3 = C 0 1 + C 0 2 := by
    linear_combination (norm := skip) (h02)
    ring_nf
    reduce_mod_char
  have e32 : C 3 2 = C 0 4 + C 0 3 := by
    linear_combination (norm := skip) (h03)
    ring_nf
    reduce_mod_char
  have e33 : C 3 3 = C 0 4 + C 0 4 := by
    rw [hd, double_zero]
  have e41 : C 4 1 = C 0 2 + C 0 4 := by
    linear_combination (norm := skip) (h04)
    ring_nf
    reduce_mod_char
  have e44 : C 4 4 = C 0 2 + C 0 2 := by
    rw [hd, double_zero]
  have e10 : C 1 0 = C 0 3 + C 0 2 := by
    linear_combination (norm := skip) (h02) + (h24) + (h30) + (h31) + (h32) + (h34) + (h40)
    ring_nf
    reduce_mod_char
  have e13 : C 1 3 = C 0 3 + C 0 0 := by
    linear_combination (norm := skip) (h10) + (hd 0) + (e10)
    ring_nf
    reduce_mod_char
  have e31 : C 3 1 = C 0 4 + C 0 2 := by
    linear_combination (norm := skip) (h03) + (h31) + (e10)
    ring_nf
    reduce_mod_char
  have e20 : C 2 0 = C 0 1 + C 0 4 := by
    linear_combination (norm := skip) (h02) + (h23) + (e31)
    ring_nf
    reduce_mod_char
  have e12 : C 1 2 = C 0 3 + C 0 4 := by
    linear_combination (norm := skip) (h01) + (h12) + (e20)
    ring_nf
    reduce_mod_char
  have e21 : C 2 1 = C 0 1 + C 0 0 := by
    linear_combination (norm := skip) (h20) + (hd 0) + (e20)
    ring_nf
    reduce_mod_char
  have e24 : C 2 4 = C 0 1 + C 0 3 := by
    linear_combination (norm := skip) (h21) + (e13) + (e21)
    ring_nf
    reduce_mod_char
  have e30 : C 3 0 = C 0 4 + C 0 1 := by
    linear_combination (norm := skip) (h03) + (h32) + (e24)
    ring_nf
    reduce_mod_char
  have e34 : C 3 4 = C 0 4 + C 0 0 := by
    linear_combination (norm := skip) (h13) + (e13) + (e12)
    ring_nf
    reduce_mod_char
  have e40 : C 4 0 = C 0 2 + C 0 3 := by
    linear_combination (norm := skip) (h02) + (h24) + (e24)
    ring_nf
    reduce_mod_char
  have e42 : C 4 2 = C 0 2 + C 0 0 := by
    linear_combination (norm := skip) (h34) + (e31) + (e34)
    ring_nf
    reduce_mod_char
  have e43 : C 4 3 = C 0 2 + C 0 1 := by
    linear_combination (norm := skip) (h01) + (h14) + (e10)
    ring_nf
    reduce_mod_char
  fin_cases i <;> fin_cases j
  · exact e00
  · exact e01
  · exact e02
  · exact e03
  · exact e04
  · exact e10
  · exact e11
  · exact e12
  · exact e13
  · exact e14
  · exact e20
  · exact e21
  · exact e22
  · exact e23
  · exact e24
  · exact e30
  · exact e31
  · exact e32
  · exact e33
  · exact e34
  · exact e40
  · exact e41
  · exact e42
  · exact e43
  · exact e44

spectrum_assert normalized_complete complete
end Spectrum.E667.BinaryFive
