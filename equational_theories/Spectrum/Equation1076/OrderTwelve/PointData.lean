def sigma (j : Fin 6) (z x : Fin 12) : Fin 12 := sigmaData[j.val]![z.val]![x.val]!
def tau (j : Fin 6) (z x : Fin 12) : Fin 12 := tauData[j.val]![z.val]![x.val]!
def point (j : Fin 6) (z : Fin 12) : Fin 12 := pointData[j.val]![z.val]!

theorem checked : ∀ j : Fin 6, ∀ z : Fin 12,
    (∀ x, tau j z (sigma j z x) = x) ∧
    (∀ x, sigma j z (tau j z x) = x) ∧
    sigma j z 0 = 0 ∧ sigma j z 1 = 1 ∧ sigma j z z = point j z ∧
    (∀ y, sigma j z (row (representative j) (tau j z y)) = row (representative j) y) := by
  decide +kernel

def permutation (j : Fin 6) (z : Fin 12) : Equiv.Perm (Fin 12) where
  toFun := sigma j z
  invFun := tau j z
  left_inv := (checked j z).1
  right_inv := (checked j z).2.1

theorem zero_fixed (j : Fin 6) (z : Fin 12) : permutation j z 0 = 0 := (checked j z).2.2.1
theorem one_fixed (j : Fin 6) (z : Fin 12) : permutation j z 1 = 1 := (checked j z).2.2.2.1
theorem maps_point (j : Fin 6) (z : Fin 12) : permutation j z z = point j z := (checked j z).2.2.2.2.1
theorem conjugates (j : Fin 6) (z y : Fin 12) :
    permutation j z (row (representative j) ((permutation j z).symm y)) =
      row (representative j) y := (checked j z).2.2.2.2.2 y
end Spectrum.E1076.OrderTwelve.PointData
