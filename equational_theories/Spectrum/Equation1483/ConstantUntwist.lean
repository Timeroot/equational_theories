    (hzero : ∀ t : G, zero ◇ t = one) (x y : G) :
    ((one ◇ (one ◇ x)) ◇ y) = ((one ◇ (one ◇ y)) ◇ x) := by
  have axiom_1 (v_X : G) : (v_X ◇ zero) = one := by
    exact constant_column h zero one hzero v_X
  have axiom_2 (v_X : G) : (one ◇ (v_X ◇ one)) = v_X := by
    exact left_inverse h zero one hzero v_X
  have axiom_3 (v_X : G) : ((one ◇ v_X) ◇ one) = v_X := by
    exact right_inverse h zero one hzero v_X
  have axiom_4 (v_X v_Y v_Z : G) : ((v_X ◇ v_Y) ◇ (v_Y ◇ (v_X ◇ v_Z))) = v_Y := by
    exact (h v_Y v_X v_Z).symm
  have axiom_5 (v_X v_Y v_Z : G) : (((v_X ◇ v_Y) ◇ v_Z) ◇ (v_Z ◇ v_Y)) = v_Z := by
    exact CentralDual.dual h v_Z v_Y v_X
