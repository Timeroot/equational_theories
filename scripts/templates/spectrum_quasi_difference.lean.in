import equational_theories.Spectrum.Equation63.QuasiDifference
import Mathlib.Data.Fin.VecNotation
import equational_theories.Spectrum.Status

/-! Generated by scripts/spectrum_quasi_difference_designs.py.
A V(@M@,@H@) vector over Z/@P@ supplies a quasi-difference matrix with an
@H@-point hole. Fill that hole by a field design over Z/@H@. All numerical
conditions use the registered native checker for difference inverses and the
Lean kernel for the remaining short checks; the generation script is untrusted.
The V(@M@,@H@) vector is recorded in Sage's design database (Colbourn table). -/
set_option maxRecDepth 65536
set_option maxHeartbeats 0
namespace Spectrum.E63.Design@N@
open QuasiDifference

def index : Groups → Fin 8
  | none => 0
  | some i => ⟨i.val+1,by omega⟩

private def roots : Fin @H@ → ZMod @P@ := @ROOTS@
private def vector : Fin @COLS@ → ZMod @P@ := @VECTOR@

def matrix (r : Fin @ROWS@) (i : Groups) : ZMod @P@ ⊕ Fin @H@ :=
  if hr : r.val < @LAST@ then
    let j := ((index i).val+@COLS@-r.val%@COLS@)%@COLS@
    if j=0 then .inr ⟨r.val/@COLS@,by omega⟩
    else .inl (roots ⟨r.val/@COLS@,by omega⟩ * vector ⟨j,Nat.mod_lt _ (by decide)⟩)
  else .inl 0

private def inverseTable : Array Nat :=
  @INVERSES@

private def diffInverse (i j : Groups) : Option (ZMod @P@) → Fin @ROWS@
  | none => 0
  | some x => ⟨inverseTable[((8*(index i).val+(index j).val)*@P@)+x.val]!.mod @ROWS@,
      Nat.mod_lt _ (by decide)⟩

private def holeInverse (i : Groups) : Option (Fin @H@) → Fin @ROWS@
  | none => 0
  | some h => ⟨@COLS@*h.val+(index i).val,by
      have hi := (index i).isLt
      omega⟩

@[spectrum_native] private theorem differences : ∀ i j, i ≠ j → ∀ r,
    difference (matrix r i) (matrix r j) = none ∨
    diffInverse i j (difference (matrix r i) (matrix r j)) = r := by native_decide

private theorem holes : ∀ i r, hole (matrix r i) = none ∨
    holeInverse i (hole (matrix r i)) = r := by decide +kernel

private theorem single : ∀ i j, i ≠ j → ∀ r,
    hole (matrix r i) = none ∨ hole (matrix r j) = none := by decide +kernel

theorem checked : Checked matrix :=
  Checked.of_leftInverses matrix diffInverse holeInverse differences holes single

private instance : Fact (Nat.Prime @H@) := ⟨by decide⟩

private noncomputable def holeDesign :
    Transversal Groups (Fin @H@) (ZMod @H@ × ZMod @H@) :=
  (fieldDesign (ZMod @H@) (by decide)).relabel (ZMod.finEquiv @H@).toEquiv.symm

theorem hasTD : HasTD @N@ := by
  let D := QuasiDifference.design matrix checked holeDesign (by
    simp [Fintype.card_sum, Fintype.card_prod])
  let E := D.relabel (Fintype.equivFinOfCardEq (show Fintype.card (ZMod @P@ ⊕ Fin @H@) = @N@ by simp))
  exact ⟨E.reindex (Fintype.equivFinOfCardEq (by simp)).symm⟩

spectrum_assert hasTD complete

end Spectrum.E63.Design@N@
