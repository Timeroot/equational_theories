theorem identity_mem : ∀ x : Fin 8, unary 0 x = x := by decide

theorem closed : ∀ i j x, source.op (unary i x) (unary j x) = unary (combine i j) x := by
  decide

def eval (t : FreeMagma Unit) (x : Fin 8) : Fin 8 :=
  @FreeMagma.evalInMagma Unit (Fin 8) source (fun _ => x) t

theorem term_mem (t : FreeMagma Unit) : ∃ i, ∀ x, eval t x = unary i x := by
  induction t with
  | Leaf _ => exact ⟨0, fun x => (identity_mem x).symm⟩
  | Fork a b ha hb =>
    obtain ⟨i, hi⟩ := ha
    obtain ⟨j, hj⟩ := hb
    refine ⟨combine i j, fun x => ?_⟩
    change source.op (eval a x) (eval b x) = _
    rw [hi, hj]
    exact closed i j x

@[implicit_reducible] def candidate (i : Fin 32) : Magma (Fin 8) where
  op x y := unary i (source.op x y)

theorem finite_failure : ∀ i, ¬ @Equation4408 (Fin 8) (candidate i) := by decide

@[implicit_reducible] def post (t : FreeMagma Unit) : Magma (Fin 8) where
  op x y := eval t (source.op x y)

theorem unary_post_failure (t : FreeMagma Unit) : ¬ @Equation4408 (Fin 8) (post t) := by
  obtain ⟨i, hi⟩ := term_mem t
  have he : post t = candidate i := by
    apply congrArg Magma.mk
    funext x y
    exact hi (source.op x y)
  rw [he]
  exact finite_failure i

/-- info: 'ResidualUnaryCandidates.unary_post_failure' depends on axioms: [propext, Quot.sound] -/
#guard_msgs in
#print axioms unary_post_failure

